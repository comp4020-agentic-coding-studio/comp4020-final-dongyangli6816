---
// Draws a sprite grid as crisp SVG, one path per colour.
// Size it with `scale` (whole numbers only) or with CSS on the class.
import { paths, type Sprite } from "../sprites/sprite.ts";

interface Props {
  sprite: Sprite;
  scale?: number;
  class?: string;
  // rows above this go in <g class="sprite-top">, for a two-frame bob
  split?: number;
}
const { sprite, scale, class: className, split = 0 } = Astro.props;
const w = sprite.grid[0].length;
const h = sprite.grid.length;
const fill = (ch: string) => (ch === "c" ? "currentColor" : sprite.palette[ch]);
const top = [...paths(sprite.grid, 0, split)];
const rest = [...paths(sprite.grid, split)];
---

<svg
  class={className}
  viewBox={`0 0 ${w} ${h}`}
  width={scale ? w * scale : undefined}
  height={scale ? h * scale : undefined}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {top.length > 0 && <g class="sprite-top">{top.map(([ch, d]) => <path fill={fill(ch)} d={d} />)}</g>}
  {rest.map(([ch, d]) => <path fill={fill(ch)} d={d} />)}
</svg>
