---
// The gym map (GYM-1, GYM-2, GYM-9, GYM-10, GYM-15; docs/design/room/spec.md
// 3.2): the room's sign, the live badge, the floor, its twelve stations and
// everyone on it. The server draws the room as it is (so it works without
// JavaScript and after a reload, GYM-8); the room's script keeps it live.
// Its styles are global under .map-panel because the script adds avatars
// and stations that a scoped style wouldn't reach.
import Avatar from "./Avatar.astro";
import Sprite from "./Sprite.astro";
import { avatarLabel, floorLine, spots } from "../lib/floor.ts";
import type { RoomView } from "../lib/presence.ts";
import { EQUIPMENT, type Equipment } from "../lib/exercises.ts";
import { HAIR_STYLES, lookKey, type Look, type Pose } from "../sprites/avatar.ts";
import { bay, CLAIM, GEAR, GYM_PALETTE, MAP, SCENERY, STATIONS, TILES } from "../sprites/gym.ts";
import { phoneOffIcon } from "../sprites/icons.ts";

interface Props {
  view: RoomView;
  me: number;
  passcode: string;
}
const { view, me, passcode } = Astro.props;

const art = (grid: readonly string[]) => ({ grid, palette: GYM_PALETTE });
// runs of one colour in a row, as rects, for the tile symbols
function rects(grid: readonly string[]) {
  const out: { x: number; y: number; w: number; fill: string }[] = [];
  grid.forEach((row, y) => {
    for (let x = 0; x < row.length; ) {
      let end = x + 1;
      while (row[end] === row[x]) end++;
      if (row[x] !== ".") out.push({ x, y, w: end - x, fill: GYM_PALETTE[row[x]] });
      x = end;
    }
  });
  return out;
}
// one symbol per kind of tile; scenery is its wall tile with the art over it
const kinds = [...new Set(MAP.join(""))];
const symbolOf = (ch: string) => TILES[SCENERY[ch]?.base ?? ch];
const mine = view.members.find((m) => m.id === me)?.station?.slot;
const placed = spots(view, view.now);
const byId = new Map(view.members.map((m) => [m.id, m]));
const POSES: Pose[] = ["stand", "lift", "rest", "sit"];
const anyLook: Look = { skin: "3", hair: HAIR_STYLES[0].id, hairColour: "black", shirt: "teal" };
---

<section class="panel map-panel" aria-labelledby="room-title" aria-describedby="floor">
  <h1 class="map-sign" id="room-title"><span class="vh">Room </span><span class="passcode">{passcode}</span></h1>
  <p class="conn" role="status"><span class="badge">Live</span></p>
  <p class="vh" id="floor">{floorLine(view.stations)}</p>
  <div class="map" data-me={me}>
    <svg class="tiles" viewBox="0 0 160 160" aria-hidden="true">
      <defs>
        {
          kinds.map((ch) => (
            <symbol id={`tile-${ch.charCodeAt(0)}`} viewBox="0 0 16 16">
              {rects(symbolOf(ch)).map((r) => (
                <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />
              ))}
              {SCENERY[ch] &&
                rects(SCENERY[ch].grid).map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
            </symbol>
          ))
        }
      </defs>
      {
        MAP.flatMap((row, y) =>
          [...row].map((ch, x) => <use href={`#tile-${ch.charCodeAt(0)}`} x={x * 16} y={y * 16} width="16" height="16" />),
        )
      }
    </svg>
    {
      view.stations.map((s) => (
        <div
          class:list={["station", { mine: s.slot === mine }]}
          style={`--x: ${STATIONS[s.slot - 1][0]}; --y: ${STATIONS[s.slot - 1][1]}`}
          data-slot={s.slot}
          data-equipment={s.equipment ?? undefined}
          aria-hidden="true"
        >
          <Sprite sprite={art(s.equipment ? GEAR[s.equipment] : bay(s.slot))} />
          {s.slot === mine && <Sprite sprite={art(CLAIM)} class="claim" />}
        </div>
      ))
    }
    {
      placed.map((p) => {
        const m = byId.get(p.id)!;
        return (
          <button
            type="button"
            class:list={["avatar", { "on-station": p.onStation, me: m.id === me, away: m.away }]}
            style={`--x: ${p.tile[0]}; --y: ${p.tile[1]}`}
            data-id={m.id}
            data-state={p.state}
            data-pose={p.pose}
            data-look={lookKey(m.look)}
            aria-label={avatarLabel(m, p.state, m.id === me)}
          >
            <span class={`tag state-${p.state}`}>
              <span class="nm">{m.name}</span>
              {m.away && <Sprite sprite={phoneOffIcon} scale={2} />}
            </span>
            <Avatar look={m.look} pose={p.pose} />
          </button>
        );
      })
    }
  </div>
  {/* what the script draws avatars and stations from */}
  {
    POSES.map((pose) => (
      <template data-pose={pose}>
        <Avatar look={anyLook} pose={pose} allHair vars={false} />
      </template>
    ))
  }
  {
    (Object.keys(EQUIPMENT) as Equipment[]).map((e) => (
      <template data-gear={e}>
        <Sprite sprite={art(GEAR[e])} />
      </template>
    ))
  }
  {
    STATIONS.map((_, i) => (
      <template data-bay={i + 1}>
        <Sprite sprite={art(bay(i + 1))} />
      </template>
    ))
  }
  <template data-claim><Sprite sprite={art(CLAIM)} class="claim" /></template>
  <template data-tag-away><Sprite sprite={phoneOffIcon} scale={2} /></template>
</section>

<style is:global>
  /* ---------- the gym map (GYM-1) ----------
     10 x 10 tiles of 16 px, drawn at --s, the largest whole number that fits
     (the room's script sets it; these media queries are the no-JS fallback) */
  /* specific enough to beat the room's .gym .panel padding */
  .gym .panel.map-panel {
    margin-bottom: 1.5rem;
    padding: 1rem var(--px) var(--px);
  }
  .map-panel .map {
    --s: 2;
    --t: calc(16px * var(--s));
    position: relative;
    width: calc(var(--t) * 10);
    height: calc(var(--t) * 10);
    margin: 0 auto;
  }
  @media (min-width: 900px) and (min-height: 600px) {
    .map-panel .map {
      --s: 3;
    }
  }
  .map-panel .map svg {
    display: block;
    shape-rendering: crispEdges;
  }
  .map-panel .tiles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* the room's sign: its passcode on the map's top border */
  .map-panel .map-sign {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    z-index: 20;
    transform: translateY(-50%);
    margin: 0;
    line-height: 1;
  }
  .map-panel .map-sign .passcode {
    padding: 0.5rem 0.75rem;
    font-size: 16px;
  }
  /* stations: equipment, or an empty numbered bay, on its tile */
  .map-panel .station {
    position: absolute;
    left: calc(var(--x) * var(--t));
    top: calc(var(--y) * var(--t));
    width: var(--t);
    height: var(--t);
  }
  .map-panel .station svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* avatars (GYM-9, GYM-10): a button whose sprite stands on its tile, with
     the name tag above it. The whole thing is the hit area, at least 44 px. */
  .map-panel .avatar {
    position: absolute;
    left: calc((var(--x) + 0.5) * var(--t));
    top: calc((var(--y) + 1) * var(--t));
    z-index: var(--y);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font: 20px/20px var(--body);
    text-transform: none;
    color: var(--ink);
    background: none;
    box-shadow: none;
    transform: translate(-50%, -100%);
    transition: none;
  }
  .map-panel .avatar:hover,
  .map-panel .avatar:active {
    background: none;
    box-shadow: none;
    transform: translate(-50%, -100%);
  }
  .map-panel .avatar:hover,
  .map-panel .avatar:focus-visible {
    z-index: 15;
  }
  .map-panel .avatar .av {
    width: var(--t);
    height: var(--t);
  }
  /* two-frame loops (system 11): standing, resting and lifting bob a pixel;
     slacking's phone glow blinks */
  .map-panel .avatar .av-top {
    animation: av-bob 800ms steps(1) infinite;
  }
  .map-panel .avatar .pose-lift .av-top {
    animation-duration: 500ms;
  }
  .map-panel .avatar .pose-sit .av-top {
    animation: none;
  }
  .map-panel .avatar .pose-sit .pw {
    animation: av-glow 800ms steps(1) infinite;
  }
  @keyframes av-bob {
    50% {
      transform: translateY(1px);
    }
  }
  @keyframes av-glow {
    50% {
      fill: var(--dim);
    }
  }
  /* on a station the avatar stands in front of the equipment: its feet drop
     6 sprite pixels into the aisle, and the tag stays in the row above, so
     the top of the equipment shows between them */
  .map-panel .avatar.on-station {
    top: calc((var(--y) + 1.375) * var(--t));
  }
  .map-panel .avatar.on-station .tag {
    margin-bottom: calc(var(--t) * 0.375);
  }
  /* Away (GYM-14): the sprite fades; the tag stays readable */
  .map-panel .avatar.away .av {
    opacity: 0.5;
  }
  /* the name tag (ACC-4): the name in ink on the state colour, with the
     phone-off icon after it while Away */
  .map-panel .tag {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 var(--px);
    white-space: nowrap;
    border: 2px solid var(--ink);
  }
  .map-panel .tag .nm {
    max-width: 6ch;
    overflow: hidden;
    text-overflow: clip;
  }
  /* you: a leaf ring on your tag (past an ink gap, so it shows on the leaf
     Lifting tag too) */
  .map-panel .avatar.me .tag {
    box-shadow:
      0 0 0 2px var(--ink),
      0 0 0 4px var(--leaf);
  }
  @media (prefers-reduced-motion: reduce) {
    .map-panel .avatar .av-top,
    .map-panel .avatar .pose-sit .pw {
      animation: none;
    }
  }
</style>
