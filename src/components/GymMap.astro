---
// The gym map (GYM-1, GYM-2, GYM-9, GYM-10, GYM-15; docs/design/room/spec.md
// 3.2 and "Exercise animations, Oct 19"): the room's sign, the live badge,
// the floor, its twelve stations and everyone on it. Someone on a machine is
// drawn inside their avatar button, bottom up: the machine's back layer, the
// person, its front layer; the station's own drawing hides meanwhile, its bar
// with it (GYM-10.13). The server draws the room as it is (so it works without
// JavaScript and after a reload, GYM-8); the room's script keeps it live.
// Its styles are global under .map-panel because the script adds avatars
// and stations that a scoped style wouldn't reach.
import Avatar from "./Avatar.astro";
import MachineArt from "./MachineArt.astro";
import Sprite from "./Sprite.astro";
import { avatarLabel, everyone, floorLine, spots } from "../lib/floor.ts";
import type { RoomView } from "../lib/presence.ts";
import { EQUIPMENT, type Equipment } from "../lib/exercises.ts";
import { HAIR_STYLES, lookKey, type Look } from "../sprites/avatar.ts";
import { bay, CLAIM, GYM_PALETTE, MAP, SCENERY, STATIONS, TILES } from "../sprites/gym.ts";
import { POSTER, POSTER_PALETTE } from "../sprites/dony.ts";
import { isMachine, type Pose } from "../sprites/poses.ts";
import { phoneOffIcon } from "../sprites/icons.ts";
import { paths, TILE } from "../sprites/sprite.ts";

interface Props {
  view: RoomView;
  me: number;
  passcode: string;
}
const { view, me, passcode } = Astro.props;

const art = (grid: readonly string[]) => ({ grid, palette: GYM_PALETTE });
// a grid as one path per colour, for the tile and poster symbols
const filled = (grid: readonly string[], palette: Record<string, string> = GYM_PALETTE) =>
  [...paths(grid)].map(([ch, d]) => ({ fill: palette[ch], d }));
// one symbol per kind of tile; scenery is its wall tile with the art over it,
// and the poster's place is plain wall under its button
const kinds = [...new Set(MAP.join(""))];
const symbolOf = (ch: string) => TILES[SCENERY[ch]?.base ?? (ch === "P" ? "W" : ch)];
// BOT-1, BOT-4: Dony's poster, full while he's in it, empty while he's out,
// resting for 30 s after any change
const poster = view.dony;
const resting = view.now < poster.restingUntil;
const posterLabel =
  (poster.out ? "Send Dony back to his poster" : "Call Dony out of his poster") + (resting ? " (not ready yet)" : "");
const posterArt = (grid: readonly string[]) => filled(grid, POSTER_PALETTE);
const mine = view.members.find((m) => m.id === me)?.station?.slot;
const placed = spots(view, view.now);
const byId = new Map(everyone(view).map((m) => [m.id, m]));
const MACHINE_IDS = Object.keys(EQUIPMENT) as Equipment[];
const POSES: Pose[] = ["stand", "rest", "sit", "walk", ...MACHINE_IDS];
// the stations someone is on, using the machine (the first render: nobody walks)
const slotAt = ([x, y]: [number, number]) => STATIONS.findIndex(([sx, sy]) => sx === x && sy === y) + 1;
const occupied = new Set(placed.filter((p) => isMachine(p.pose)).map((p) => slotAt(p.tile)));
const anyLook: Look = { skin: "3", hair: HAIR_STYLES[0].id, hairColour: "black", shirt: "teal" };
---

<section class="panel map-panel" aria-labelledby="room-title" aria-describedby="floor">
  <h1 class="map-sign" id="room-title"><span class="vh">Room </span><span class="passcode">{passcode}</span></h1>
  <p class="conn" role="status"><span class="badge">Live</span></p>
  <p class="vh" id="floor">{floorLine(view.stations)}</p>
  <div class="map" data-me={me}>
    <svg class="tiles" viewBox={`0 0 ${TILE * 10} ${TILE * 10}`} aria-hidden="true">
      <defs>
        {
          kinds.map((ch) => (
            <symbol id={`tile-${ch.charCodeAt(0)}`} viewBox={`0 0 ${TILE} ${TILE}`}>
              {filled(symbolOf(ch)).map((p) => (
                <path fill={p.fill} d={p.d} />
              ))}
              {SCENERY[ch] && filled(SCENERY[ch].grid).map((p) => <path fill={p.fill} d={p.d} />)}
            </symbol>
          ))
        }
      </defs>
      {
        MAP.flatMap((row, y) =>
          [...row].map((ch, x) => <use href={`#tile-${ch.charCodeAt(0)}`} x={x * TILE} y={y * TILE} width={TILE} height={TILE} />),
        )
      }
    </svg>
    <button
      type="submit"
      form="dony"
      name="intent"
      value={poster.out ? "send-back" : "summon"}
      class:list={["poster", { resting }]}
      aria-label={posterLabel}
      aria-disabled={resting ? "true" : undefined}
      data-out={String(poster.out)}
      data-resting-until={poster.restingUntil}
    >
      <svg viewBox={`0 0 ${TILE} ${TILE}`} aria-hidden="true">
        <use href={poster.out ? "#poster-empty" : "#poster-full"} />
        {!poster.out && <use href="#poster-glint" class="glint" />}
        {
          poster.fresh && (
            <>
              <use href="#poster-bulbs" class="bulbs" />
              <use href="#poster-bulbs-alt" class="bulbs alt" />
            </>
          )
        }
      </svg>
    </button>
    {
      view.stations.map((s) => (
        <div
          class:list={["station", { mine: s.slot === mine, occupied: occupied.has(s.slot) }]}
          style={`--x: ${STATIONS[s.slot - 1][0]}; --y: ${STATIONS[s.slot - 1][1]}`}
          data-slot={s.slot}
          data-equipment={s.equipment ?? undefined}
          aria-hidden="true"
        >
          {s.equipment ? <MachineArt e={s.equipment} part="idle" /> : <Sprite sprite={art(bay(s.slot))} />}
          {s.slot === mine && <Sprite sprite={art(CLAIM)} class="claim" />}
        </div>
      ))
    }
    {
      placed.map((p) => {
        const m = byId.get(p.id)!;
        return (
          <button
            type="button"
            class:list={["avatar", { "on-station": p.onStation, "on-machine": isMachine(p.pose), me: m.id === me, away: m.away }]}
            style={`--x: ${p.tile[0]}; --y: ${p.tile[1]}`}
            data-id={m.id}
            data-state={p.state}
            data-pose={p.pose}
            data-look={"dony" in m ? "dony" : lookKey(m.look)}
            aria-label={avatarLabel(m, p.state, m.id === me)}
          >
            <span class={`tag state-${p.state}`}>
              <span class="nm">{m.name}</span>
              {m.away && <Sprite sprite={phoneOffIcon} scale={2} />}
            </span>
            {isMachine(p.pose) && <MachineArt e={p.pose} part="back" />}
            {"dony" in m ? <Avatar dony pose={p.pose} /> : <Avatar look={m.look} pose={p.pose} />}
            {isMachine(p.pose) && <MachineArt e={p.pose} part="front" />}
          </button>
        );
      })
    }
  </div>
  {/* what the script draws avatars and stations from */}
  {
    POSES.map((pose) => (
      <template data-pose={pose}>
        <Avatar look={anyLook} pose={pose} allHair vars={false} />
      </template>
    ))
  }
  {
    POSES.map((pose) => (
      <template data-dony={pose}>
        <Avatar dony pose={pose} />
      </template>
    ))
  }
  <template data-dony="hop"><Avatar dony pose="hop" /></template>
  {
    MACHINE_IDS.map((e) => (
      <>
        <template data-gear={e}>
          <MachineArt e={e} part="idle" />
        </template>
        <template data-layers={e}>
          <MachineArt e={e} part="back" />
          <MachineArt e={e} part="front" />
        </template>
      </>
    ))
  }
  {
    STATIONS.map((_, i) => (
      <template data-bay={i + 1}>
        <Sprite sprite={art(bay(i + 1))} />
      </template>
    ))
  }
  <svg width="0" height="0" class="poster-art" aria-hidden="true">
    <defs>
      {
        Object.entries(POSTER).map(([name, grid]) => (
          <symbol id={`poster-${name}`} viewBox={`0 0 ${TILE} ${TILE}`}>
            {posterArt(grid).map((p) => (
              <path fill={p.fill} d={p.d} />
            ))}
          </symbol>
        ))
      }
    </defs>
  </svg>
  <template data-claim><Sprite sprite={art(CLAIM)} class="claim" /></template>
  <template data-tag-away><Sprite sprite={phoneOffIcon} scale={2} /></template>
</section>

<style is:global>
  /* ---------- the gym map (GYM-1) ----------
     10 x 10 tiles of 32 px (ADR 0005), drawn at --s, the largest whole
     number that fits: 1 (320 px) on a phone, 2 (640 px) where that fits. The
     room's script sets it; these media queries are the no-JS fallback */
  /* specific enough to beat the room's .gym .panel padding */
  .gym .panel.map-panel {
    margin-bottom: 1.5rem;
    padding: 1rem var(--px) var(--px);
  }
  .map-panel .map {
    --s: 1;
    --t: calc(32px * var(--s));
    position: relative;
    width: calc(var(--t) * 10);
    height: calc(var(--t) * 10);
    margin: 0 auto;
  }
  @media (min-width: 1120px) and (min-height: 760px) {
    .map-panel .map {
      --s: 2;
    }
  }
  .map-panel .map svg {
    display: block;
    shape-rendering: crispEdges;
  }
  .map-panel .tiles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* the room's sign: its passcode on the map's top border */
  .map-panel .map-sign {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    z-index: 20;
    transform: translateY(-50%);
    margin: 0;
    line-height: 1;
  }
  .map-panel .map-sign .passcode {
    padding: 0.5rem 0.75rem;
    font-size: 16px;
  }
  /* stations: equipment, or an empty numbered bay, on its tile */
  .map-panel .station {
    position: absolute;
    left: calc(var(--x) * var(--t));
    top: calc(var(--y) * var(--t));
    width: var(--t);
    height: var(--t);
  }
  .map-panel .station svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* avatars (GYM-9, GYM-10): a button whose sprite stands on its tile, with
     the name tag above it. The whole thing is the hit area, at least 44 px. */
  .map-panel .avatar {
    position: absolute;
    left: calc((var(--x) + 0.5) * var(--t));
    top: calc((var(--y) + 1) * var(--t));
    z-index: var(--y);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    min-width: 44px;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font: 20px/20px var(--body);
    text-transform: none;
    color: var(--ink);
    background: none;
    box-shadow: none;
    transform: translate(-50%, -100%);
    transition: none;
  }
  .map-panel .avatar:hover,
  .map-panel .avatar:active {
    background: none;
    box-shadow: none;
    transform: translate(-50%, -100%);
  }
  .map-panel .avatar:hover,
  .map-panel .avatar:focus-visible {
    z-index: 15;
  }
  .map-panel .avatar .av {
    position: relative;
    z-index: 1;
    width: var(--t);
    height: var(--t);
  }
  /* a machine's layers, on the same tile as the person: the back under, the
     front over (GYM-10.12), inside the button so a tap on either selects
     them (GYM-15.3) */
  .map-panel .avatar .machine {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: var(--t);
    height: var(--t);
    transform: translateX(-50%);
  }
  .map-panel .avatar .machine.front {
    z-index: 2;
  }
  /* the station's own drawing steps aside while someone is on the machine,
     its bar with it (GYM-10.13); your claim corners stay over them (GYM-9.4) */
  .map-panel .station.occupied .machine {
    visibility: hidden;
  }
  .map-panel .station .claim {
    z-index: calc(var(--y) + 1);
  }
  /* motion (system 11): standing and resting bob a pixel; a machine's two
     frames and the walk's two strides swap, person and machine together, at
     the pose's pace (D4); slacking doesn't bob, and its phone glows */
  .map-panel .avatar {
    --frame: 400ms;
  }
  .map-panel .avatar[data-pose="treadmill"] {
    --frame: 250ms;
  }
  .map-panel .avatar[data-pose="walk"] {
    --frame: 125ms;
  }
  .map-panel .avatar .pose-stand .av-top,
  .map-panel .avatar .pose-rest .av-top {
    animation: av-bob 800ms steps(1) infinite;
  }
  .map-panel .avatar .frame-2 {
    display: inline;
    visibility: hidden;
  }
  .map-panel .avatar .frame-1 {
    animation: av-frame-1 calc(var(--frame) * 2) steps(1) infinite;
  }
  .map-panel .avatar .frame-2 {
    animation: av-frame-2 calc(var(--frame) * 2) steps(1) infinite;
  }
  .map-panel .avatar .pose-sit .glow {
    animation: av-glow 800ms steps(1) infinite;
  }
  /* in sprite units */
  @keyframes av-bob {
    50% {
      transform: translateY(2px);
    }
  }
  @keyframes av-frame-1 {
    50% {
      visibility: hidden;
    }
  }
  @keyframes av-frame-2 {
    50% {
      visibility: visible;
    }
  }
  @keyframes av-glow {
    50% {
      fill: var(--dim);
    }
  }
  /* slacking sits in front of the machine (D3): the feet drop 12 sprite
     pixels into the aisle, and the tag stays in the row above, so the top of
     the machine shows between them. On the machine, the person is on its
     tile, the tag just above it, the same for every machine (GYM-15.5). */
  .map-panel .avatar.on-station:not(.on-machine) {
    top: calc((var(--y) + 1.375) * var(--t));
  }
  .map-panel .avatar.on-station:not(.on-machine) .tag {
    margin-bottom: calc(var(--t) * 0.375);
  }
  /* Away (GYM-14): the person fades, never the machine; the tag stays readable */
  .map-panel .avatar.away .av {
    opacity: 0.5;
  }
  /* the name tag (ACC-4): the name in ink on the state colour, with the
     phone-off icon after it while Away */
  .map-panel .tag {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 0 var(--px);
    white-space: nowrap;
    border: 2px solid var(--ink);
  }
  .map-panel .tag .nm {
    max-width: 6ch;
    overflow: hidden;
    text-overflow: clip;
  }
  /* you: a leaf ring on your tag (past an ink gap, so it shows on the leaf
     Lifting tag too) */
  .map-panel .avatar.me .tag {
    box-shadow:
      0 0 0 2px var(--ink),
      0 0 0 4px var(--leaf);
  }
  /* reduced motion: the still frame (Frame 1), no bob, the phone lit (GYM-10.23) */
  @media (prefers-reduced-motion: reduce) {
    .map-panel .avatar .pose-stand .av-top,
    .map-panel .avatar .pose-rest .av-top,
    .map-panel .avatar .frame-1,
    .map-panel .avatar .frame-2,
    .map-panel .avatar .pose-sit .glow {
      animation: none;
    }
  }

  /* ---------- Dony's poster (BOT-1, BOT-4) ----------
     The back wall's P tile, as a button on the map. Its tap area is at least
     48 px square, centred on the tile: the tile itself at 3x, and at 2x the
     tile plus 8 px all round (up into the panel's padding, down onto the
     walkway, where nobody stands still). It sits under the avatars (z 0), so
     a name tag drawn over it takes the tap; focused, it rises over everything. */
  .map-panel .poster-art {
    position: absolute;
  }
  .map .poster {
    --a: max(48px, var(--t));
    position: absolute;
    left: calc(5.5 * var(--t) - var(--a) / 2);
    top: calc(var(--t) / 2 - var(--a) / 2);
    z-index: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--a);
    height: var(--a);
    min-height: 0;
    margin: 0;
    padding: 0;
    background: none;
    box-shadow: none;
    transform: none;
    transition: none;
  }
  .map .poster:hover,
  .map .poster:active {
    background: none;
    box-shadow: none;
    transform: none;
  }
  .map .poster:focus-visible {
    z-index: 16;
  }
  .poster svg {
    width: var(--t);
    height: var(--t);
    flex: none;
  }
  /* pressed: the poster sinks a sprite pixel while the tap is on its way
     (pending), and can't be tapped again; nothing spins */
  .map .poster:active svg,
  .poster.pending svg {
    transform: translateY(calc(var(--t) / 16));
  }
  .poster.pending {
    cursor: progress;
  }
  /* resting 30 s after any summon or send back: dimmed, no countdown */
  .poster.resting svg {
    opacity: 0.5;
  }
  .poster.resting {
    cursor: default;
  }
  /* his glasses catch the light for one frame every 8 s (full only) */
  .poster .glint {
    visibility: hidden;
    animation: poster-glint 8s steps(1) infinite;
  }
  @keyframes poster-glint {
    98% {
      visibility: visible;
    }
  }
  /* the hint, until anyone first calls him out in this room: marquee bulbs
     round the poster, two sets swapping lit and unlit every 500 ms for the
     page's first minute, then all lit and still */
  .poster .bulbs {
    color: var(--paper);
    animation: poster-bulbs 1s steps(1) 60;
  }
  .poster .bulbs.alt {
    animation-delay: -0.5s;
  }
  @keyframes poster-bulbs {
    50% {
      color: var(--edge);
    }
  }
  /* the summon and the send back: two 125 ms frames, a sprite pixel left then
     right, before the poster swaps */
  .poster.shake svg {
    animation: poster-shake 250ms steps(1);
  }
  @keyframes poster-shake {
    0% {
      transform: translateX(calc(var(--t) / -16));
    }
    50% {
      transform: translateX(calc(var(--t) / 16));
    }
  }
  /* the hop between the wall and the walkway: one frame half a tile up */
  .map .avatar.hop,
  .map .avatar.hop:hover {
    transform: translate(-50%, calc(-100% - var(--t) / 2));
  }
  /* the tap didn't reach the server: one line under the map */
  .map-panel .poster-error {
    margin: var(--px) 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .poster .glint,
    .poster .bulbs,
    .poster.shake svg {
      animation: none;
    }
  }
</style>
