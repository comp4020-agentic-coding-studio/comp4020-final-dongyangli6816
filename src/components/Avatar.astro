---
// One person's avatar as crisp SVG (AV-2): the body in a pose, with the hair
// (or Dony's head) drawn over it and props over both, inside the bobbing
// group (g.av-top). Each pixel carries its slot as a class (k, s, t, h, the
// shades S, T, H; pm, pw, pr for the fixed colours) rather than a fill, and
// the look's colours arrive as custom properties, so a palette swap is three
// variables. A pose with two drawings (a machine's frames, the walk) draws
// both, as g.frame-1 and g.frame-2, and CSS swaps them (GymMap.astro). On a
// machine the machine's own layers are drawn by the station, around this.
import { AVATAR_UPPER_ROWS, HAIR_STYLES, HEAD_CROP, lookVars, type HairStyle, type Look } from "../sprites/avatar.ts";
import { DONY_VARS } from "../sprites/dony.ts";
import { drawingsOf, headOf, isMachine, type Pose } from "../sprites/poses.ts";
import { paths, TILE } from "../sprites/sprite.ts";

interface Props {
  // Dony's head and colours instead of a look (BOT-2, D2)
  dony?: boolean;
  // no look draws the body alone, as the invite's empty spot (with class "ghost")
  look?: Look | null;
  // the gym's poses (GYM-10); standing everywhere else
  pose?: Pose;
  // the head and shoulders only, for lists
  head?: boolean;
  // every hair style, with the look's chosen by data-hair: for the editor's
  // live preview and for avatars a script redraws
  allHair?: boolean;
  // set the look's colours on the svg; off when a parent sets them
  vars?: boolean;
  class?: string;
}
const { dony = false, look, pose = "stand", head = false, allHair = false, vars = !!look, class: className } = Astro.props;

// one path per slot; m, w and r are the fixed colours, in the body as in the
// props, and any body letter in the props (the fingers round the bottle)
// keeps its slot. The sitting figure's phone screen is its props' only paper,
// so it also carries .glow, which blinks.
const FIXED: Record<string, string> = { m: "pm", w: "pw", r: "pr" };
const slotted = (map: Map<string, string>, glow = false) =>
  [...map].map(([ch, d]) => ({ slot: (FIXED[ch] ?? ch) + (glow && ch === "w" ? " glow" : ""), d }));
const styles: (HairStyle | "dony")[] = dony ? ["dony"] : !look ? [] : allHair ? HAIR_STYLES.map((s) => s.id) : [look.hair];
// rows above the split bob, the rest stay planted; a machine's people, the
// walk and the slacker don't bob, so their whole body goes under the hair
const bobs = !isMachine(pose) && pose !== "sit" && pose !== "walk";
const split = bobs ? AVATAR_UPPER_ROWS : TILE;
const drawings = drawingsOf(pose).map((d, i, all) => {
  return {
    frame: all.length > 1 ? `frame-${i + 1}` : undefined,
    top: slotted(paths(d.body, 0, split)),
    bottom: slotted(paths(d.body, split)),
    hair: styles.map((style) => ({ style, parts: slotted(paths(headOf(style), 0, Infinity, d.hairRow)) })),
    propsTop: slotted(paths(d.props, 0, split), pose === "sit"),
    propsBottom: slotted(paths(d.props, split), pose === "sit"),
  };
});
---

<svg
  class:list={["av", `pose-${pose}`, className]}
  viewBox={head ? HEAD_CROP : `0 0 ${TILE} ${TILE}`}
  shape-rendering="crispEdges"
  aria-hidden="true"
  data-hair={allHair && look && !dony ? look.hair : undefined}
  style={dony ? DONY_VARS : vars && look ? lookVars(look) : undefined}
>
  {
    drawings.map((d) => (
      <g class={d.frame}>
        <g class="av-top">
          {d.top.map((p) => (
            <path class={p.slot} d={p.d} />
          ))}
          {d.hair.map((h) => (
            <g class={h.style === "dony" ? "head-dony" : `hair hair-${h.style}`}>
              {h.parts.map((p) => (
                <path class={p.slot} d={p.d} />
              ))}
            </g>
          ))}
          {d.propsTop.map((p) => (
            <path class={p.slot} d={p.d} />
          ))}
        </g>
        {!head && d.bottom.map((p) => <path class={p.slot} d={p.d} />)}
        {!head && d.propsBottom.map((p) => <path class={p.slot} d={p.d} />)}
      </g>
    ))
  }
</svg>

<style is:global>
  /* the avatar's palette slots (docs/design/avatar/spec.md) */
  .av {
    display: block;
    flex: none;
  }
  .av .k {
    fill: var(--ink);
  }
  .av .s {
    fill: var(--av-skin);
  }
  .av .h {
    fill: var(--av-hair);
  }
  .av .t {
    fill: var(--av-shirt);
  }
  /* the shades (ADR 0005): a palette's own shade when it has one, else its
     colour mixed a third of the way to ink */
  .av .S {
    fill: var(--av-skin-2, color-mix(in srgb, var(--av-skin), var(--ink) 30%));
  }
  .av .H {
    fill: var(--av-hair-2, color-mix(in srgb, var(--av-hair), var(--ink) 30%));
  }
  .av .T {
    fill: var(--av-shirt-2, color-mix(in srgb, var(--av-shirt), var(--ink) 30%));
  }
  /* the fixed colours: catchlights, sneakers, the bar, the bottle, the phone */
  .av .pm {
    fill: var(--dim);
  }
  .av .pw {
    fill: var(--paper);
  }
  .av .pr {
    fill: var(--resting);
  }
  /* every style drawn, the look's shown */
  .av[data-hair] .hair {
    display: none;
  }
  .av[data-hair="crop"] .hair-crop,
  .av[data-hair="curls"] .hair-curls,
  .av[data-hair="long"] .hair-long,
  .av[data-hair="ponytail"] .hair-ponytail {
    display: inline;
  }
  /* two drawings: the first shows until something swaps them (GymMap.astro) */
  .av .frame-2 {
    display: none;
  }
  /* the invite's empty spot: the body as an outline in the muted ink */
  .av.ghost {
    --av-skin: var(--card);
    --av-shirt: var(--card);
    --av-skin-2: var(--card);
    --av-shirt-2: var(--card);
  }
  .av.ghost .k {
    fill: var(--muted);
  }
  .av.ghost .pw,
  .av.ghost .pm {
    fill: var(--card);
  }
</style>
