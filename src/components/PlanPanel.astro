---
// LB-3.13 to LB-3.21: the plan loaded in the room's sheet
// (docs/design/room/spec.md, "Logbook refactor, Nov 4", L.3 item 9). Each
// lift is a one-tap Choose (exactly the sheet's choose, LB-3.16) with its
// planned sets as boxes and "n of m"; Up next lit with the menu's cursor.
// Nothing here acts by itself (LB-3.18). The server decides whether it's
// open or folded; a tap on its line flips it either way.
interface Props {
  plan: {
    id: number;
    name: string;
    items: { exerciseId: number; name: string; sets: number; done: number }[];
    next: number | undefined;
    complete: boolean;
  };
  // the lift chosen now, if any
  current?: number;
  open: boolean;
  // every plan of the person's, for Swap
  others: readonly { id: number; name: string }[];
}
const { plan, current, open, others } = Astro.props;
const fullLifts = plan.items.filter((i) => i.done >= i.sets).length;
const swaps = others.filter((p) => p.id !== plan.id);
---

<details class="plan" data-plan="" open={open}>
  <summary>
    <span class="badge">Plan</span>
    <span class="plan-name">{plan.name}</span>
    <span class="plan-sum">{fullLifts} of {plan.items.length} lifts</span>
  </summary>
  <form method="post" class="plan-choose">
    <input type="hidden" name="action" value="choose" />
    <ol class="plan-items">
      {
        plan.items.map((i) => {
          const next = plan.next === i.exerciseId;
          return (
            <li data-plan-item="" data-exercise={i.exerciseId} data-next={next ? "" : undefined} class:list={{ full: i.done >= i.sets }}>
              <button
                type="submit"
                name="exercise"
                value={i.exerciseId}
                class:list={{ hot: next }}
                aria-current={current === i.exerciseId ? "true" : undefined}
              >
                <span class="cur" aria-hidden="true">
                  ▶
                </span>
                {/* the name reads straight into its count ("Bench press 2 of
                    4", LB-3.13); the Up next badge follows, drawn after the name */}
                <span class="ex">{i.name}</span>{" "}
                <span class="count">
                  <span class="planned" aria-hidden="true">
                    {Array.from({ length: Math.max(i.sets, i.done) }, (_, k) => (
                      <i class:list={{ done: k < i.done, over: k >= i.sets }} />
                    ))}
                  </span>
                  {i.done} of {i.sets}
                </span>
                {next && (
                  <>
                    {" "}
                    <span class="badge up">Up next</span>
                  </>
                )}
              </button>
            </li>
          );
        })
      }
    </ol>
  </form>
  {plan.complete && <p class="plan-done" role="status">Plan done. Anything else is a bonus 🏆</p>}
  <div class="plan-tools">
    {
      swaps.length > 0 && (
        <form method="post" class="plan-pick">
          <input type="hidden" name="action" value="plan-load" />
          {current !== undefined && <input type="hidden" name="exercise_id" value={current} />}
          <label class="vh" for="swap">
            Load another plan
          </label>
          <select id="swap" name="plan_id">
            {swaps.map((p) => (
              <option value={p.id}>{p.name}</option>
            ))}
          </select>
          <button type="submit" class="button secondary tool">
            Swap
          </button>
        </form>
      )
    }
    <form method="post">
      <input type="hidden" name="action" value="plan-clear" />
      {current !== undefined && <input type="hidden" name="exercise_id" value={current} />}
      <button type="submit" class="button secondary tool">Clear</button>
    </form>
  </div>
</details>

<style>
  .plan {
    margin: 0 0 1rem;
    background: var(--night);
    border: 2px solid var(--edge);
  }
  .plan > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.5rem;
    list-style: none;
    cursor: pointer;
  }
  .plan > summary::-webkit-details-marker {
    display: none;
  }
  .plan > summary .badge {
    margin: 0;
  }
  .plan-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .plan-sum {
    margin-left: auto;
    padding-right: 1.5rem;
    color: var(--dim);
    white-space: nowrap;
    background:
      linear-gradient(45deg, transparent 50%, var(--paper) 50%) calc(100% - 12px) 50% / 8px 8px no-repeat,
      linear-gradient(135deg, var(--paper) 50%, transparent 50%) calc(100% - 4px) 50% / 8px 8px no-repeat;
  }
  .plan-choose {
    margin: 0;
  }
  .plan-items {
    display: grid;
    gap: var(--px);
    margin: 0;
    padding: 0 0.5rem 0.5rem;
    list-style: none;
  }
  .plan-items button {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 0.25rem 0.5rem 0.25rem 0.25rem;
    font: inherit;
    line-height: 1.1;
    text-align: left;
    text-transform: none;
    color: var(--paper);
    background: var(--panel);
    border: 2px solid var(--edge);
    box-shadow: none;
    transform: none;
  }
  .plan-items button:hover {
    background: var(--floor);
  }
  .plan-items .cur {
    visibility: hidden;
  }
  .plan-items button.hot {
    color: var(--ink);
    background: var(--leaf);
    border-color: var(--ink);
  }
  .plan-items .hot .cur {
    visibility: visible;
  }
  /* the lift you're on: a paper edge */
  .plan-items button[aria-current="true"] {
    border-color: var(--paper);
  }
  .plan-items .full .ex {
    color: var(--dim);
  }
  .plan-items .badge.up {
    grid-column: 2;
    justify-self: start;
    margin: 0;
    color: var(--leaf);
    background: var(--ink);
  }
  .plan-items .count {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  /* planned sets as boxes, the room's .pips shape: filled when done, an
     outline past the plan */
  .planned {
    display: flex;
    gap: var(--px);
  }
  .planned i {
    width: calc(var(--px) * 2);
    height: calc(var(--px) * 3);
    background: var(--night);
    box-shadow: inset 0 0 0 2px var(--edge);
  }
  .planned i.done {
    background: var(--leaf);
    box-shadow: none;
  }
  .planned i.done.over {
    background: transparent;
    box-shadow: inset 0 0 0 2px var(--leaf);
  }
  .hot .planned i {
    background: var(--leaf);
    box-shadow: inset 0 0 0 2px var(--ink);
  }
  .hot .planned i.done {
    background: var(--ink);
  }
  .plan-done {
    margin: 0 0.5rem 0.5rem;
  }
  .plan-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.5rem;
    border-top: 2px dashed var(--edge);
  }
  .plan-tools form {
    margin: 0;
  }
  .plan-pick {
    display: flex;
    flex: 1 1 15rem;
    align-items: center;
    gap: 0.5rem;
  }
  .plan-pick select {
    flex: 1;
    min-width: 0;
  }
</style>
