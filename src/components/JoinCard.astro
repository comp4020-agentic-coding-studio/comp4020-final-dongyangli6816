---
// The join card (docs/design/join/), shared by /join and /join/CODE: the
// passcode form for someone signed in, or the invite for someone who isn't.
import Sprite from "./Sprite.astro";
import { avatar, AVATAR_UPPER_ROWS, ghostAvatar } from "../sprites/avatar.ts";
import { doorway } from "../sprites/door.ts";

interface Props {
  // "invite": signed out, arrived by an invite link (ROOM-3)
  mode: "join" | "invite";
  passcode?: string;
  // ROOM-2's one generic error, or ROOM-4's full room
  error?: "none" | "full";
  name?: string;
}
const { mode, passcode = "", error, name = "" } = Astro.props;
const invalid = error === "none";
const next = encodeURIComponent(`/join/${passcode}`);
---

{
  mode === "invite" ? (
    <>
      <div class="card join-card">
        <h1>You're invited</h1>
        <p class="lead">Your squad's training. Sign up and you'll walk straight in 🏋️</p>
        <div class="floor scene" aria-hidden="true">
          <Sprite sprite={doorway} class="doorway" />
          <div class="stand">
            <span class="nametag is-empty">You?</span>
            <Sprite sprite={ghostAvatar} class="av" split={AVATAR_UPPER_ROWS} />
          </div>
        </div>
        <p class="code-label" id="invite-code-label">
          Room passcode
        </p>
        <div class="code-input" role="group" aria-labelledby="invite-code-label">
          <span class="code">{passcode}</span>
        </div>
        <div class="actions">
          <a class="button wide" href={`/signup?next=${next}`}>
            Sign up
          </a>
        </div>
      </div>
      <div class="lobby-alt join-alt">
        <p class="hint">Already on Spotter? You'll land in the same room.</p>
        <a class="button secondary" href={`/signin?next=${next}`}>
          Sign in
        </a>
      </div>
    </>
  ) : (
    <>
      <div class="card join-card">
        <h1>Join your squad</h1>
        <p class="lead">Got the code? Pop it in 📲</p>
        <div class="floor scene" aria-hidden="true">
          <Sprite sprite={doorway} class="doorway" />
          <div class="stand">
            <span class="nametag">{name}</span>
            <Sprite sprite={avatar} class="av" split={AVATAR_UPPER_ROWS} />
          </div>
        </div>
        <form method="post" action="/join" class="join-form">
          <label for="passcode">Passcode</label>
          <p class="hint" id="passcode-hint">
            6 characters · no 0 O 1 I L
          </p>
          <div class:list={["code-input", { invalid }]}>
            <input
              id="passcode"
              name="passcode"
              value={passcode}
              autocomplete="off"
              autocapitalize="characters"
              maxlength="8"
              required
              spellcheck="false"
              autocorrect="off"
              enterkeyhint="go"
              autofocus={!!error}
              aria-describedby={error ? "passcode-hint passcode-error" : "passcode-hint"}
              aria-invalid={invalid ? "true" : undefined}
            />
          </div>
          {error && (
            <p class="error" id="passcode-error">
              {error === "full"
                ? "This gym's full: 12 of 12 are in. Wait for someone to leave, or start a new room below."
                : "No open room has that passcode. Check it with your squad."}
            </p>
          )}
          <div class="actions">
            <button type="submit" class="wide">
              Join
            </button>
          </div>
          <p class="hint status-line" role="status" />
        </form>
      </div>
      <div class="lobby-alt join-alt">
        <p class="hint">Room closed or full? Start a new one and send the squad the code.</p>
        <form method="post" action="/rooms">
          <button type="submit" class="button secondary">
            New room
          </button>
        </form>
      </div>
    </>
  )
}

<script>
  // Runs on every page load (ADR 0003), so it checks it's on join first.
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>(".join-form");
    if (!form) return;
    const input = form.querySelector("input[name=passcode]") as HTMLInputElement;
    const button = form.querySelector("button") as HTMLButtonElement;
    const status = form.querySelector(".status-line")!;
    // passcodes never use 0 O 1 I L, so drop them as they're typed
    input.addEventListener("input", () => {
      const v = input.value.toUpperCase().replace(/[^ABCDEFGHJKMNPQRSTUVWXYZ2-9]/g, "").slice(0, 6);
      if (v !== input.value) input.value = v;
    });
    form.addEventListener("submit", () => {
      button.disabled = true;
      input.readOnly = true;
      status.textContent = "Checking the code…";
    });
  });
  // coming Back from the room must not leave the form stuck as pending
  addEventListener("pageshow", () => {
    const form = document.querySelector<HTMLFormElement>(".join-form");
    if (!form) return;
    form.querySelector("button")!.disabled = false;
    form.querySelector<HTMLInputElement>("input[name=passcode]")!.readOnly = false;
    form.querySelector(".status-line")!.textContent = "";
  });
</script>

<style>
  .join-card,
  .join-alt {
    max-width: 30rem;
    margin-inline: auto;
  }
  /* the line under a card's h1 (signup's .lead) */
  .lead {
    margin: -0.5rem 0 1rem;
  }

  /* a patch of gym floor, as on signup: a deep wall along the top with a
     green skirting line, and the page's own 16 px checker */
  .floor {
    --s: 4px;
    position: relative;
    display: flex;
    gap: 0.5rem;
    min-height: calc(var(--s) * 16 + 88px);
    padding: 0 0.5rem 0.75rem;
    border: var(--px) solid var(--ink);
    border-top: calc(var(--px) * 4) solid var(--deep);
    box-shadow: inset 0 var(--px) 0 var(--green);
    background-color: var(--paper);
    background-image: conic-gradient(var(--tile) 25%, transparent 0 50%, var(--tile) 0 75%, transparent 0);
    background-size: 32px 32px;
  }
  /* the scene: the gym's open doorway, and you about to walk in */
  .scene {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    gap: 1.5rem;
  }
  .scene :global(.doorway) {
    flex: none;
    display: block;
    width: 64px; /* 16 px sprite at 4x */
    height: 64px;
  }
  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }
  .nametag {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.5rem;
    font: 22px/1.3 var(--body);
    white-space: nowrap;
    color: var(--paper);
    background: rgb(0 0 0 / 70%);
  }
  .nametag.is-empty {
    color: var(--leaf);
  }
  .floor :global(.av) {
    display: block;
    flex: none;
    width: calc(var(--s) * 16);
    height: calc(var(--s) * 16);
  }
  .floor :global(.sprite-top) {
    animation: idle 800ms steps(1) infinite;
  }
  @keyframes idle {
    50% {
      transform: translateY(1px); /* one sprite pixel */
    }
  }

  .join-form label,
  .code-label {
    margin-top: 1.5rem;
  }
  .code-label {
    margin-bottom: 0.35rem;
    color: var(--deep);
  }
  .join-form .hint {
    margin: 0 0 0.5rem;
  }
  .status-line {
    margin: 0.5rem 0 0;
  }
  .status-line:empty {
    display: none;
  }

  /* .code-input: ONE real <input name="passcode">, drawn as six slots, or
     the invite's read-only code on the same slots. Press Start 2P is
     monospaced at 1em per glyph, so letter-spacing = cell - glyph drops each
     character into its own slot with no JavaScript. The input is wider than
     the frame (room for the 8-character maxlength) and the frame clips it,
     so the 6th character never scrolls the row. */
  .code-input {
    --cell: 44px; /* one slot + one divider */
    --glyph: 24px;
    --slot-h: 48px;
    --pad: calc((var(--cell) - var(--px) - var(--glyph)) / 2);
    width: calc(6 * var(--cell) + var(--px) * 3);
    max-width: 100%;
    height: calc(var(--slot-h) + var(--px) * 4);
    overflow: hidden;
    border: var(--px) solid var(--ink);
    background-color: var(--green);
    background-image:
      /* name-entry underline in each slot */
      repeating-linear-gradient(
        90deg,
        transparent 0 calc(var(--px) + var(--pad)),
        var(--green) 0 calc(var(--px) + var(--pad) + var(--glyph)),
        transparent 0 var(--cell)
      ),
      /* the six ink slots, green dividers between */ repeating-linear-gradient(90deg, transparent 0 var(--px), var(--ink) 0 var(--cell));
    background-size:
      100% var(--px),
      100% var(--slot-h);
    background-position:
      0 calc(var(--slot-h) - var(--px)),
      0 var(--px);
    background-repeat: no-repeat;
  }
  .code-input input,
  .code-input .code {
    display: block;
    width: calc(100% + 2 * var(--cell));
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0 0 0 calc(var(--px) + var(--pad));
    font: var(--glyph) / 1 var(--display);
    letter-spacing: calc(var(--cell) - var(--glyph));
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--leaf);
    caret-color: var(--leaf);
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .code-input .code {
    line-height: calc(var(--slot-h) + var(--px) * 2);
  }
  .code-input input::selection {
    color: var(--ink);
    background: var(--leaf);
  }
  /* the ring goes on the frame, because the frame clips the input */
  .code-input input:focus-visible {
    outline: none;
  }
  .code-input:focus-within {
    outline: var(--px) solid var(--ink);
    outline-offset: var(--px);
  }
  .code-input.invalid {
    border-color: var(--error);
  }

  /* the line under the card: a short hint and one secondary way out */
  .lobby-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .lobby-alt p {
    flex: 1 1 14rem;
    margin: 0;
  }
  .lobby-alt form {
    margin: 0;
  }
  @media (min-width: 900px) {
    .code-input {
      --cell: 64px;
      --glyph: 32px;
      --slot-h: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .floor :global(.sprite-top) {
      animation: none;
    }
  }
</style>
