---
import { history } from "../lib/workouts.ts";
import Layout from "../layouts/Layout.astro";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/signin?next=/history", 303);
const workouts = history(user.id);
const when = (ms: number) => new Date(ms).toLocaleString("en-AU", { dateStyle: "medium", timeStyle: "short" });
---

<Layout title="History">
  <h1>History</h1>
  {workouts.length === 0 && <div class="card"><p>No workouts yet.</p><a href="/" class="button">Start one</a></div>}
  {
    workouts.map((w) => (
      <section class="card">
        <h2>{when(w.startedAt)}{!w.endedAt && <span class="badge">Live</span>}</h2>
        <table>
          <thead><tr><th>Exercise</th><th class="num">kg</th><th class="num">Reps</th></tr></thead>
          <tbody>
            {w.sets.map((s) => <tr><td>{s.name}</td><td class="num">{s.weightKg}</td><td class="num">{s.reps}</td></tr>)}
          </tbody>
        </table>
      </section>
    ))
  }
</Layout>
