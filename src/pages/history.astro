---
import Sprite from "../components/Sprite.astro";
import WorkoutSets from "../components/WorkoutSets.astro";
import WorkoutTally from "../components/WorkoutTally.astro";
import Layout from "../layouts/Layout.astro";
import { dayLabel, distanceKm, kg, km, midnight, minutes, timeOfDay, timeRange, volume } from "../lib/logbook.ts";
import { history } from "../lib/workouts.ts";
import { arrowIcon } from "../sprites/icons.ts";
import { bigDumbbell } from "../sprites/props.ts";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/signin?next=/history", 303);
const workouts = history(user.id);
const now = Date.now();

// Dates are calendar dates in the server's time zone, Monday-first weeks.
const DAY = 86_400_000;
const monday = (ms: number) => {
  const d = new Date(midnight(ms));
  d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  return d.getTime();
};
const dayIndex = (ms: number) => (new Date(ms).getDay() + 6) % 7;
const fmt = (ms: number, o: Intl.DateTimeFormatOptions) => new Date(ms).toLocaleString("en-AU", o);

const DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
function weekLabel(start: number): string {
  const weeksAgo = Math.round((monday(now) - start) / (7 * DAY));
  if (weeksAgo === 0) return "This week";
  if (weeksAgo === 1) return "Last week";
  const end = new Date(start);
  end.setDate(end.getDate() + 6);
  const sameMonth = new Date(start).getMonth() === end.getMonth();
  return `${fmt(start, sameMonth ? { day: "numeric" } : { day: "numeric", month: "short" })} – ${fmt(end.getTime(), { day: "numeric", month: "short" })}`;
}

// newest week first; history() is already newest first
const weeks: { start: number; workouts: typeof workouts }[] = [];
for (const w of workouts) {
  const start = monday(w.startedAt);
  const last = weeks.at(-1);
  if (last?.start === start) last.workouts.push(w);
  else weeks.push({ start, workouts: [w] });
}
const weekHeads = weeks.map((wk) => {
  const on = new Set(wk.workouts.map((w) => dayIndex(w.startedAt)));
  return {
    ...wk,
    label: weekLabel(wk.start),
    on,
    trained: `Trained ${[...on].sort().map((i) => DAYS[i]).join(" and ").replace(/ and (?=.* and )/g, ", ")}`,
    count: `${wk.workouts.length} workout${wk.workouts.length === 1 ? "" : "s"}`,
  };
});

const allSets = workouts.flatMap((w) => w.sets);
const total = volume(allSets);
const distance = distanceKm(allSets);
const live = workouts.find((w) => w.endedAt === null && w.roomId !== null);
---

<Layout title="History">
  <h1>History</h1>
  {
    workouts.length === 0 ? (
      <div class="card empty">
        <Sprite sprite={bigDumbbell} scale={4} />
        <p>No workouts yet. Your future self is waiting 🏋️</p>
        <a href="/" class="button">Start one</a>
      </div>
    ) : (
      <>
        <p class="lede">
          {workouts.length} workout{workouts.length === 1 ? "" : "s"} · {kg(total)} kg
          {distance > 0 && ` · ${km(distance)} km`} in the book
        </p>
        {weekHeads.map((wk, i) => {
          const head = (
            <>
              <h2 id={`wk-${wk.start}`}>{wk.label}</h2>
              <span class="week-row">
                <span class="days" role="img" aria-label={wk.trained}>
                  {"MTWTFSS".split("").map((d, j) => (
                    <span class:list={{ on: wk.on.has(j) }}>{d}</span>
                  ))}
                </span>
                <span class="count">{wk.count}</span>
                {i >= 2 && <span class="toggle" />}
              </span>
            </>
          );
          const cards = wk.workouts.map((w) => {
            const [from, to] = w.endedAt ? timeRange(w.startedAt, w.endedAt) : ["", ""];
            return (
              <article class="card entry">
                <header class="entry-head">
                  {w.endedAt ? (
                    <h3>
                      <a href={`/workouts/${w.id}`}>
                        {dayLabel(w.startedAt, now)}
                        <span class="vh">, summary</span>
                        <Sprite sprite={arrowIcon} scale={2} class="go" />
                      </a>
                    </h3>
                  ) : (
                    <h3>
                      {dayLabel(w.startedAt, now)}
                      <span class="badge">Live</span>
                    </h3>
                  )}
                  <p class="when">
                    {w.endedAt ? (
                      <>
                        <time datetime={new Date(w.startedAt).toISOString()}>{from}</time> –{" "}
                        <time datetime={new Date(w.endedAt).toISOString()}>{to}</time>
                      </>
                    ) : (
                      <>
                        Started <time datetime={new Date(w.startedAt).toISOString()}>{timeOfDay(w.startedAt)}</time>
                      </>
                    )}
                  </p>
                </header>
                <WorkoutTally sets={w.sets} startedAt={w.startedAt} endedAt={w.endedAt} now={now} />
                <WorkoutSets sets={w.sets} />
              </article>
            );
          });
          return i < 2 ? (
            <section class="week" aria-labelledby={`wk-${wk.start}`}>
              <div class="week-head">{head}</div>
              {cards}
            </section>
          ) : (
            <details class="week">
              <summary class="week-head">{head}</summary>
              {cards}
            </details>
          );
        })}
        {live && (
          <div class="resume">
            <p>
              Still on the floor{" "}
              <small>
                {live.sets.length} set{live.sets.length === 1 ? "" : "s"} in, {minutes(live.startedAt, now)} min
              </small>
            </p>
            <a href={`/rooms/${live.roomId}`} class="button">Resume</a>
          </div>
        )}
      </>
    )
  }
</Layout>

<style>
  .lede {
    margin: -0.5rem 0 1.5rem;
    color: var(--muted);
  }
  .when {
    margin: 0;
    color: var(--muted);
  }
  /* text for screen readers only */
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* a week of the logbook: a ruled divider, the label, the day strip */
  .week {
    margin: 0 0 1.5rem;
    padding-top: 1rem;
    border-top: var(--px) solid var(--ink);
  }
  .week-head {
    margin: 0 0 1rem;
  }
  .week-head h2 {
    margin: 0 0 0.5rem;
  }
  .week-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .days {
    display: inline-flex;
    gap: var(--px);
  }
  .days span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    font: 8px/1 var(--display);
    color: var(--muted);
    background: var(--card);
    border: 2px solid var(--ink);
  }
  .days .on {
    color: var(--leaf);
    background: var(--ink);
  }
  .count {
    color: var(--muted);
  }

  /* older weeks fold away; the whole head is the tap target */
  details.week > summary {
    display: block;
    margin: 0;
    cursor: pointer;
    list-style: none;
  }
  details.week > summary::-webkit-details-marker {
    display: none;
  }
  .toggle {
    margin-left: auto;
    color: var(--green);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .toggle::before {
    content: "Show";
  }
  details[open] .toggle::before {
    content: "Hide";
  }
  details.week[open] > summary {
    margin-bottom: 1rem;
  }

  /* one workout: a logbook page. Its day is the link to its summary. */
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    margin: -0.5rem 0 0.75rem;
  }
  .entry-head h3 {
    margin: 0;
  }
  .entry-head h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    text-underline-offset: 6px;
  }
  .entry-head h3 a:hover {
    color: var(--deep);
  }
  .entry-head :global(.go) {
    flex: none;
  }
  .entry-head .badge {
    vertical-align: 2px;
  }
  /* the live entry has no link, so it keeps the same 44 px line */
  .entry-head h3:not(:has(a)) {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  /* a workout still open: the way back to the gym, pinned in thumb reach */
  .resume {
    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem 0 0;
    padding: 0.5rem 0.75rem 0.25rem;
    background: var(--card);
    border: var(--px) solid var(--ink);
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--green),
      0 calc(var(--px) * -2) 0 var(--ink);
  }
  .resume p {
    margin: 0;
    line-height: 1.15;
  }
  .resume small {
    display: block;
    font-size: inherit;
    color: var(--muted);
  }

  .empty {
    text-align: center;
  }
  .empty :global(svg) {
    display: block;
    margin: 0.5rem auto 1rem;
  }
</style>
