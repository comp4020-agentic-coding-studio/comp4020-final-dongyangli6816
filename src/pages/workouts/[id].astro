---
import Sprite from "../../components/Sprite.astro";
import WorkoutSets from "../../components/WorkoutSets.astro";
import WorkoutTally from "../../components/WorkoutTally.astro";
import Layout from "../../layouts/Layout.astro";
import PendingForms from "../../components/PendingForms.astro";
import PlanList from "../../components/PlanList.astro";
import { byExercise, dateLabel, dayLabel, distanceKm, isWorking, km, recordsBySet, timeRange, volume } from "../../lib/logbook.ts";
import Avatar from "../../components/Avatar.astro";
import { lookOf } from "../../lib/avatars.ts";
import { log, who } from "../../lib/log.ts";
import { readPlanName, saveAsPlan, setsForRecords, workoutSummary } from "../../lib/workouts.ts";
import { recordIcon, trophyIcon } from "../../sprites/icons.ts";
import { checkUnlocks, isLongHaul, unlockedIn, wearOne } from "../../lib/unlocks.ts";
import { ACC_REASON, accEmoji, accessoryById, NOTHING } from "../../sprites/accessories.ts";
import { tickIcon } from "../../sprites/icons.ts";
import { wearOf } from "../../lib/avatars.ts";
import { broadcastRoomsOf } from "../../lib/realtime.ts";

// LOG-6: one finished workout, drawn as its history entry at full size.
const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname)}`, 303);

const id = Number(Astro.params.id);
const here = `/workouts/${id}`;
const notFound = () => new Response("Not found", { status: 404 });

// LB-3.1 to LB-3.7: Save as plan. Refusals re-render the page with the
// reason under the form, and keep what was typed.
let planError = "";
let planErrorField = "";
let typedName = "";
let justSaved = "";
// AV-6.6, AV-6.2: Wear it from the summary's list, with no script needed
let wearError = "";
let wearFailedFor = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (form.get("action") === "wear" && Number.isInteger(id)) {
    if (!workoutSummary(user.id, id)) {
      log("acc.denied", { ...who(user), workout: Astro.params.id });
      return notFound();
    }
    const acc = String(form.get("acc") ?? "");
    const r = wearOne(user.id, acc);
    if (r.ok) {
      log("acc.wear", { ...who(user), acc, workout: id });
      broadcastRoomsOf(user.id);
      // summary spec, Not decided 8: back to the card, keeping done=1
      return Astro.redirect(`${here}?${form.get("done") === "1" ? "done=1&" : ""}worn=${encodeURIComponent(acc)}#unlocked`, 303);
    }
    log("acc.refused", { ...who(user), acc: acc.slice(0, 20), reason: r.reason });
    wearError = "That didn't save. Try again.";
    wearFailedFor = acc;
    Astro.response.status = 400;
  }
  else if (form.get("action") !== "save-plan" || !Number.isInteger(id)) return notFound();
  else {
  typedName = String(form.get("name") ?? "");
  const own = workoutSummary(user.id, id);
  if (!own) {
    log("plan.denied", { ...who(user), workout: Astro.params.id });
    return notFound();
  }
  if (own.endedAt === null) {
    log("plan.refused", { ...who(user), workout: id, reason: "open" });
    return new Response("That workout is still going", { status: 409 });
  }
  const name = readPlanName(typedName, dateLabel(own.startedAt));
  if ("error" in name) {
    planError = name.error;
    planErrorField = "name";
    log("plan.refused", { ...who(user), workout: id, reason: "name", length: [...typedName.trim()].length });
  } else {
    const r = saveAsPlan(user.id, id, name.name);
    if (r.ok) {
      log("plan.save", { ...who(user), workout: id, plan: r.planId, length: [...name.name].length });
      return Astro.redirect(`${here}?saved=${r.planId}`, 303);
    }
    planError =
      r.reason === "only-warmups"
        ? "Only warm-ups in this one. Nothing to plan yet."
        : r.reason === "full"
          ? "That's 20 plans. Delete one to make room."
          : "That didn't save. Try again.";
    log("plan.refused", { ...who(user), workout: id, reason: r.reason });
  }
  Astro.response.status = 400;
  }
}

const w = Number.isInteger(id) ? workoutSummary(user.id, id) : undefined;
// someone else's workout looks the same as no workout
if (!w) {
  log("workout.denied", { ...who(user), workout: Astro.params.id });
  return notFound();
}
if (w.endedAt === null) return Astro.redirect(w.roomId ? `/rooms/${w.roomId}` : "/history", 303);
if (w.savedPlan && Astro.url.searchParams.get("saved") === String(w.savedPlan.id)) justSaved = w.savedPlan.name;

// AV-5.15: opening a summary works unlocks out (they belong to no workout
// then); AV-6.6: this workout's, in the order earned, and what's worn now
checkUnlocks(user.id, null);
const unlocked = unlockedIn(w.id);
const wearing = wearOf(user.id);
const wornNow = (id: string) => Object.values(wearing).includes(id as never);
// the bubble after a Wear it (summary spec 3): only for one this page lists
const wornParam = Astro.url.searchParams.get("worn") ?? "";
const justWorn = unlocked.some((u) => u.acc === wornParam) && wornNow(wornParam) ? accessoryById(wornParam) : undefined;
// a refusal for something with no row here (a hand-made post) is still said,
// at the top of the card, or on its own when there's no card
const strayWearError = wearError && !unlocked.some((u) => u.acc === wearFailedFor);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const bare = (slot: "head" | "face" | "neck", acc: string) => ({ ...NOTHING, [slot]: acc });

// LB-4.10, LB-4.12 (D24): the marks, and how many sets carry one
const records = recordsBySet(setsForRecords(user.id, w.sets.map((s) => s.exerciseId)));
const recordSets = w.sets.filter((s) => records.has(s.id)).length;

// LB-3.2: the plan this workout would make, the same rule saveAsPlan uses
const preview = byExercise(w.sets)
  .map((g) => ({ exerciseId: g.sets[0].exerciseId, name: g.name, sets: Math.min(10, g.sets.filter(isWorking).length) }))
  .filter((i) => i.sets > 0);

const now = Date.now();
const day = dayLabel(w.startedAt, now);
const [from, to] = timeRange(w.startedAt, w.endedAt);
const done = Astro.url.searchParams.has("done");

// the celebration, first match wins (docs/design/summary/spec.md)
const vol = volume(w.sets);
const dist = distanceKm(w.sets);
const WORDS = ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const utes = Math.max(1, Math.round(vol / 2000)); // a dual-cab ute is about 2 tonnes
const cheer =
  w.sets.length === 0
    ? ""
    : vol >= 1000
      ? `In the book: about ${WORDS[utes - 1] ?? utes} ute${utes === 1 ? "" : "s"} of iron 🛻`
      : dist > 0
        ? `In the book: ${km(dist)} km down 🏃`
        : vol > 0
          ? "In the book. Every kilo counts 🏆"
          : "In the book. No plates needed 🤸";
---

<Layout title={`Workout · ${day}`}>
  <section class="card trophy" aria-labelledby="day">
    {done && cheer && <p class="bubble" role="status">{cheer}</p>}
    <div class="who">
      <div class="me-box">
        <Avatar look={lookOf(user.id)} class="me" />
        <span class="chip state-finished"><Sprite sprite={trophyIcon} scale={2} />Finished</span>
      </div>
      <div>
        <h1 id="day">{day}</h1>
        <p class="when">
          <time datetime={new Date(w.startedAt).toISOString()}>{from}</time> –{" "}
          <time datetime={new Date(w.endedAt).toISOString()}>{to}</time>
        </p>
      </div>
    </div>
    {
      w.passcode &&
        (done && w.roomClosedAt ? (
          <p class="room">
            Room <span class="passcode">{w.passcode}</span> closed
          </p>
        ) : (
          <p class="room">
            Trained in <span class="passcode">{w.passcode}</span>
          </p>
        ))
    }
    <WorkoutTally sets={w.sets} startedAt={w.startedAt} endedAt={w.endedAt} now={now} big />
    {
      recordSets > 0 && (
        <p class="records-line">
          <span class="badge record">
            <Sprite sprite={recordIcon} scale={2} />
            {recordSets} new record{recordSets === 1 ? "" : "s"}
          </span>
          Past you just got beaten 🏆
        </p>
      )
    }
  </section>

  <div class="actions after">
    <a href="/" class="button">Back home</a>
    <a href="/history" class="button secondary">All history</a>
  </div>

  {/* AV-6.6: what this workout unlocked (summary spec, "Accessories, Nov 9") */}
  {strayWearError && unlocked.length === 0 && <p class="error" role="alert">That didn't save. Try again.</p>}
  {
    unlocked.length > 0 && (
      <section class="card new-kit" id="unlocked" data-swap aria-labelledby="unlocked-h">
        <h2 id="unlocked-h">Unlocked</h2>
        {justWorn && (
          <p class="bubble" role="status">
            Wearing the {justWorn.name.toLowerCase()} now {accEmoji(justWorn.id)}
          </p>
        )}
        <p class="hint">Nice one. New kit to wear 🔥</p>
        {strayWearError && <p class="error" role="alert">That didn't save. Try again.</p>}
        <ol class="kit-list">
          {unlocked.map((u) => {
            const a = accessoryById(u.acc)!;
            const name = a.name.toLowerCase();
            const failed = wearFailedFor === a.id;
            return (
              <li class:list={{ trophy: isLongHaul(a.id) }} data-unlocked={a.id}>
                <span class="acc-frame">
                  <Avatar look={lookOf(user.id)} bust vars wear={bare(a.slot, a.id)} class="bust" />
                </span>
                <p class="kit-name">
                  New: {name}
                  <span class="kit-why">{cap(ACC_REASON[a.id] ?? "")}</span>
                </p>
                {wornNow(a.id) ? (
                  <p class="kit-act wearing">
                    <Sprite sprite={tickIcon} scale={2} />
                    Wearing it
                  </p>
                ) : a.id === "nightcap" ? (
                  <p class="kit-act in-editor">
                    Put it on in <a href="/avatar">Edit avatar</a>
                  </p>
                ) : (
                  <form class="kit-act" method="post" action={here} data-pending>
                    <input type="hidden" name="action" value="wear" />
                    <input type="hidden" name="acc" value={a.id} />
                    {done && <input type="hidden" name="done" value="1" />}
                    <button type="submit" class="button secondary" aria-describedby={failed ? `wear-error-${a.id}` : undefined}>
                      Wear it<span class="vh">: {name}</span>
                    </button>
                  </form>
                )}
                {failed && (
                  <p class="error" role="alert" id={`wear-error-${a.id}`}>
                    That didn't save. Try again.
                  </p>
                )}
              </li>
            );
          })}
        </ol>
        <a class="to-editor" href="/avatar">Edit avatar</a>
      </section>
    )
  }

  <section class="card" aria-labelledby="every-set">
    <h2 id="every-set">Every set</h2>
    {
      w.sets.length > 0 ? (
        <WorkoutSets sets={w.sets} records={records} notes={w.notes} look={lookOf(user.id)} />
      ) : (
        <p class="nothing">No sets this time. The bar's not going anywhere 🏋️</p>
      )
    }
  </section>

  {
    w.sets.length > 0 && (
      <section class="card save-plan" id="save-card" data-swap aria-labelledby="save-plan">
        {w.savedPlan && !justSaved ? (
          <>
            <h2 id="save-plan">Plan</h2>
            <p class="saved">
              Saved as <a href="/plans">{w.savedPlan.name}</a>. Load it from your sheet next time.
            </p>
          </>
        ) : (
          <>
            <h2 id="save-plan">Save as plan</h2>
            {justSaved && (
              <p class="bubble" role="status">
                Saved as <a href="/plans">{justSaved}</a>. Load it from the sheet next time 📋
              </p>
            )}
            <p class="hint">Do this one again: the lifts in order, a box per working set. Warm-ups stay out.</p>
            {preview.length > 0 && <PlanList items={preview} />}
            {!justSaved && (
              <form method="post" data-pending>
                <input type="hidden" name="action" value="save-plan" />
                <label for="plan-name">Name (optional)</label>
                <div class="save-row">
                  <input
                    id="plan-name"
                    name="name"
                    maxlength="30"
                    placeholder={dateLabel(w.startedAt)}
                    value={typedName}
                    aria-invalid={planErrorField === "name" ? "true" : undefined}
                    aria-describedby={planError ? "plan-error" : undefined}
                  />
                  <button type="submit" class="button secondary">
                    Save plan
                  </button>
                </div>
                {planError && (
                  <p class="error" id="plan-error" role="alert">
                    {planError}
                  </p>
                )}
              </form>
            )}
          </>
        )}
        <a class="to-plans" href="/plans">
          Your plans
        </a>
      </section>
    )
  }
  <PendingForms />
</Layout>


<style>
  .when {
    margin: 0;
    color: var(--muted);
  }

  /* the trophy card: you, Finished, and the numbers. Sized to fit the
     first phone screen, so one screenshot carries it to the group chat. */
  .trophy .bubble {
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.5rem;
  }
  .who {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin: 0 0 1rem;
  }
  /* your avatar with its state chip under it, as on the gym floor */
  .me-box {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .me-box :global(.me) {
    display: block;
    width: 64px;
    height: 64px;
    image-rendering: pixelated;
  }
  /* 2× on phones, 3× from 421 px: whole-number scales only */
  @media (min-width: 421px) {
    .me-box :global(.me) {
      width: 96px;
      height: 96px;
    }
  }
  .who h1 {
    margin: 0.5rem 0 0.5rem;
  }
  /* the room it happened in; "closed" only on the night it closed */
  .room {
    margin: 0 0 1rem;
    color: var(--muted);
  }
  /* the passcode as a key tag, the same as home's room list */
  .room .passcode {
    padding: 0.25rem 0.5rem;
    font-size: 16px;
  }

  /* the way out, straight under the trophy card, in the thumb zone */
  .after {
    margin: 0 0 1.5rem;
  }
  .nothing {
    margin: 0;
    color: var(--muted);
  }

  /* LB-4.12: the count of records, under the tally; only when > 0 */
  .records-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 0;
    font-size: 24px;
  }

  /* LB-3.1: Save as plan, the last card */
  .save-plan .hint {
    margin: -0.5rem 0 1rem;
  }
  .save-plan label {
    margin-top: 0;
  }
  .save-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 1rem;
  }
  .save-row input {
    flex: 1 1 14rem;
    width: auto;
  }
  .save-row button {
    flex: none;
    margin-top: var(--px);
  }
  .save-plan .error,
  .save-plan .bubble {
    width: fit-content;
    max-width: 100%;
  }
  .saved {
    margin: 0;
  }
  .to-plans {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* AV-6.6: what this workout unlocked, its own card under the way out (summary
     spec, "Accessories, Nov 9"). One row per accessory, in the order earned:
     your own bust wearing it on a square of floor (the editor's .acc-frame,
     at 2x), "New: …", what earned it, and Wear it (or "Wearing it"). */
  .new-kit .hint {
    margin: -0.5rem 0 1rem;
  }
  .kit-list {
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }
  .kit-list li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "art name act" "art err err";
    align-items: center;
    gap: 0 1rem;
    padding: 0.5rem 0;
    border-bottom: 2px solid var(--ink);
  }
  /* the editor's floor square, at 2x: the bust is 56 x 46 */
  .kit-list .acc-frame {
    grid-area: art;
    align-self: start;
    display: block;
    background-color: var(--paper);
    background-image: conic-gradient(var(--tile) 25%, transparent 0 50%, var(--tile) 0 75%, transparent 0);
    background-size: 16px 16px;
    border: 2px solid var(--ink);
  }
  .kit-list :global(.bust) {
    display: block;
    width: 56px;
    height: 46px;
  }
  /* a long-haul one keeps the editor's gold rule under its frame */
  .kit-list li.trophy .acc-frame {
    border-bottom: var(--px) solid var(--finished);
    box-shadow: 0 2px 0 var(--ink);
  }
  .kit-name {
    grid-area: name;
    margin: 0;
    font-size: 24px;
    line-height: 1.1;
  }
  .kit-why {
    display: block;
    font-size: 20px;
    color: var(--muted);
  }
  .kit-act {
    grid-area: act;
    margin: 0;
    justify-self: end;
  }
  .kit-act .button {
    margin-right: var(--px);
  }
  /* already worn: a plain line with the tick, never a button */
  .kit-act.wearing {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    font-size: 21px;
    white-space: nowrap;
  }
  /* the Nightcap: no Wear it (AV-6.15); worn only from the editor */
  .kit-act.in-editor {
    max-width: 12rem;
    font-size: 20px;
    line-height: 1.1;
    text-align: right;
    color: var(--muted);
  }
  .kit-list .error {
    grid-area: err;
    width: fit-content;
    max-width: 100%;
    margin: 0.5rem 0 0;
  }
  .new-kit .bubble {
    width: fit-content;
    max-width: 100%;
  }
  .to-editor {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  /* phones: the action goes under the name, beside the bust */
  @media (max-width: 420px) {
    .kit-list li {
      grid-template-columns: auto 1fr;
      grid-template-areas: "art name" "art act" ". err";
      row-gap: 0.25rem;
    }
    .kit-act {
      justify-self: start;
    }
    .kit-act.in-editor {
      max-width: none;
      text-align: left;
    }
    .kit-act.wearing {
      min-height: 0;
    }
  }
</style>
