---
// The avatar editor (AV-1, AV-3; docs/design/avatar/). Every choice is a real
// radio, the preview follows them with CSS alone, and Randomise works without
// JavaScript by posting for an unsaved roll.
import Avatar from "../components/Avatar.astro";
import Sprite from "../components/Sprite.astro";
import Layout from "../layouts/Layout.astro";
import { lookOf, saveLook } from "../lib/avatars.ts";
import { asLook, CHOICES, editorCss, lookVars, randomLook, type Look } from "../sprites/avatar.ts";
import { dieIcon, tickIcon } from "../sprites/icons.ts";
import { dumbbell, kettlebell } from "../sprites/props.ts";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/signin?next=/avatar", 303);

const param = (name: string) => Astro.url.searchParams.get(name);
let next = param("next") ?? "";
const saved = lookOf(user.id);
let look: Look = saved;
let unsaved = false;
let error = false;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  next = String(form.get("next") ?? next);
  if (form.get("intent") === "randomise") {
    // nothing stored: the roll is shown checked, ready to save
    look = randomLook();
    unsaved = true;
  } else {
    const posted = asLook(Object.fromEntries(CHOICES.map((c) => [c.key, form.get(c.field)])));
    if (posted) {
      saveLook(user.id, posted);
      return Astro.redirect(next.startsWith("/") ? next : "/avatar?saved=1", 303);
    }
    error = true;
    Astro.response.status = 400;
  }
}
if (!next.startsWith("/")) next = "";
const isNew = param("new") === "1" && !!next;
---

<Layout title="Your avatar">
  {/* the live preview's palette rules, generated from the palettes */}
  <Fragment set:html={`<style>${editorCss()}</style>`} />
  {isNew && <p class="bubble">We rolled you a random look. Keep it, or make it yours 🎲</p>}
  {param("saved") === "1" && (
    <p class="bubble" role="status">
      Saved. That's you in the gym now 💪
    </p>
  )}
  <div class="card" style={lookVars(saved)}>
    <h1>Your avatar</h1>
    <p class="lead">This is you in the gym.</p>
    <form method="post" action="/avatar" class="editor" data-saved={JSON.stringify(saved)}>
      {next && <input type="hidden" name="next" value={next} />}
      <div class="floor preview" aria-hidden="true">
        <Sprite sprite={kettlebell} class="floor-prop kettlebell" />
        <div class="stand">
          <span class="nametag">{user.displayName}</span>
          <Avatar look={look} allHair vars={false} />
        </div>
        <Sprite sprite={dumbbell} class="floor-prop dumbbell" />
      </div>
      <button type="submit" form="avatar-shuffle" class="button secondary shuffle">
        <Sprite sprite={dieIcon} scale={2} />
        Randomise
      </button>
      <div class="choices">
        {
          CHOICES.map((c) => (
            <fieldset class="pick-group">
              <legend>{{ skin: "Skin tone", hair: "Hair", hair_colour: "Hair colour", shirt: "Shirt" }[c.field]}</legend>
              {c.field === "hair" ? (
                <div class="styles">
                  {c.options.map((o) => (
                    <label class="pick style">
                      <input type="radio" name={c.field} value={o.id} checked={look[c.key] === o.id} />
                      <span class="face">
                        <Avatar look={{ ...look, hair: o.id }} head vars={false} />
                        {o.name}
                      </span>
                      <Sprite sprite={tickIcon} class="tick" />
                    </label>
                  ))}
                </div>
              ) : (
                <div class:list={["swatches", { "of-8": c.options.length === 8 }]}>
                  {c.options.map((o) => (
                    <label class="pick swatch" title={o.name} style={`--c: ${"hex" in o ? o.hex : ""}`}>
                      <input type="radio" name={c.field} value={o.id} checked={look[c.key] === o.id} />
                      <span class="face" />
                      <Sprite sprite={tickIcon} class="tick" />
                      <span class="sr-only">{o.name}</span>
                    </label>
                  ))}
                </div>
              )}
            </fieldset>
          ))
        }
      </div>
      {
        error && (
          <p class="error" id="save-error">
            Couldn't save your avatar. Check your connection and try again.
          </p>
        )
      }
      <div class="actions">
        <button type="submit" class="wide" aria-describedby={error ? "save-error" : undefined}>Save</button>
      </div>
      <p class="hint status-line" role="status">{unsaved ? "Not saved yet." : ""}</p>
    </form>
    <form id="avatar-shuffle" method="post" action="/avatar">
      <input type="hidden" name="intent" value="randomise" />
      {next && <input type="hidden" name="next" value={next} />}
    </form>
  </div>
  {
    isNew && (
      <div class="lobby-alt">
        <p class="hint">Change it any time from home.</p>
        <a class="button secondary" href={next}>
          Later
        </a>
      </div>
    )
  }
</Layout>


<script>
  import { CHOICES, randomLook } from "../sprites/avatar.ts";

  // Runs on every page load (ADR 0003), so it checks it's on the editor first.
  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("form.editor");
    if (!form) return;
    const status = form.querySelector(".status-line")!;
    const save = form.querySelector<HTMLButtonElement>(".actions button")!;
    const saved = JSON.parse(form.dataset.saved!) as Record<string, string>;
    // "Not saved yet." whenever the choices differ from what's stored
    const sayIfChanged = () => {
      const changed = CHOICES.some((c) => new FormData(form).get(c.field) !== saved[c.key]);
      status.textContent = changed ? "Not saved yet." : "";
    };
    form.addEventListener("change", sayIfChanged);
    // Randomise rolls here, with no request
    document.querySelector("form#avatar-shuffle")!.addEventListener("submit", (e) => {
      e.preventDefault();
      const look = randomLook();
      for (const c of CHOICES) {
        form.querySelector<HTMLInputElement>(`input[name="${c.field}"][value="${look[c.key]}"]`)!.checked = true;
      }
      sayIfChanged();
    });
    form.addEventListener("submit", () => {
      save.disabled = true;
      form.setAttribute("aria-busy", "true");
      status.textContent = "Saving…";
    });
  });
  // Back restores the page from cache with Save still disabled
  addEventListener("pageshow", () => {
    const form = document.querySelector<HTMLFormElement>("form.editor");
    if (!form) return;
    form.querySelector<HTMLButtonElement>(".actions button")!.disabled = false;
    form.removeAttribute("aria-busy");
  });
</script>

<style>
  /* the line under a card's h1 (signup's .lead) */
  .lead {
    margin: -0.5rem 0 1rem;
  }
  /* a patch of gym floor, as on signup and join */
  .floor {
    --s: 6px; /* 16 px sprite at a whole 6x = 96 px */
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    min-height: calc(var(--s) * 16 + 88px);
    padding: 0 0.5rem 0.75rem;
    border: var(--px) solid var(--ink);
    border-top: calc(var(--px) * 4) solid var(--deep);
    box-shadow: inset 0 var(--px) 0 var(--green);
    background-color: var(--paper);
    background-image: conic-gradient(var(--tile) 25%, transparent 0 50%, var(--tile) 0 75%, transparent 0);
    background-size: 32px 32px;
  }
  .stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
  }
  .nametag {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 0.5rem;
    font: 22px/1.3 var(--body);
    white-space: nowrap;
    color: var(--paper);
    background: rgb(0 0 0 / 70%);
  }
  .floor :global(.av) {
    width: calc(var(--s) * 16);
    height: calc(var(--s) * 16);
  }
  .floor :global(.av-top) {
    animation: idle 800ms steps(1) infinite;
  }
  @keyframes idle {
    50% {
      transform: translateY(1px); /* one sprite pixel */
    }
  }
  .floor :global(.floor-prop) {
    position: absolute;
    bottom: 0.75rem;
  }
  .floor :global(.kettlebell) {
    left: calc(50% - var(--s) * 14 - 0.5rem);
    width: calc(var(--s) * 6);
    height: calc(var(--s) * 6);
  }
  .floor :global(.dumbbell) {
    left: calc(50% + var(--s) * 8 + 0.5rem);
    width: calc(var(--s) * 8);
    height: calc(var(--s) * 4);
  }
  /* the saved hair, for browsers without :has() */
  .preview :global(.hair) {
    display: none;
  }
  .preview :global(.av[data-hair="crop"] .hair-crop),
  .preview :global(.av[data-hair="curls"] .hair-curls),
  .preview :global(.av[data-hair="long"] .hair-long),
  .preview :global(.av[data-hair="ponytail"] .hair-ponytail) {
    display: inline;
  }

  /* phones: preview, Randomise, the four choices, Save, in one column. The
     preview sticks to the top while you scroll the swatches. */
  .editor {
    display: grid;
    align-items: start;
  }
  .preview {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .shuffle {
    justify-self: center;
    margin-top: 1rem;
  }
  .shuffle :global(svg) {
    flex: none;
  }
  @media (min-width: 900px) {
    .editor {
      grid-template-columns: 16rem 1fr;
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "preview choices"
        "shuffle choices"
        "actions actions";
      gap: 0 1.5rem;
    }
    .preview {
      --s: 7px; /* 112 px; 8x would push the props off the floor */
      grid-area: preview;
      position: relative;
    }
    .shuffle {
      grid-area: shuffle;
    }
    .choices {
      grid-area: choices;
    }
    .editor > .actions,
    .editor > .error {
      grid-area: actions;
    }
    .choices .pick-group:first-child {
      margin-top: 0;
    }
  }

  /* one radio group per choice (AV-1); real radios, so arrows, Tab and no-JS
     all work */
  .pick-group {
    min-width: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border: 0;
  }
  .pick-group legend {
    padding: 0;
    margin: 0 0 0.5rem;
    color: var(--deep);
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .swatches.of-8 {
    display: grid;
    grid-template-columns: repeat(4, 44px);
  }
  .styles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  /* .pick: one choice. The radio covers the whole tile, invisible but
     focusable and clickable; .face draws it. */
  .pick {
    position: relative;
    display: block;
    margin: 0;
    cursor: pointer;
  }
  .pick input {
    appearance: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    box-shadow: none;
    cursor: pointer;
  }
  .pick input:focus-visible {
    outline: none;
  }
  /* .swatch (system 9): a 44 px square of the colour, ink border */
  .swatch .face {
    display: block;
    width: 44px;
    height: 44px;
    background: var(--c);
    border: var(--px) solid var(--ink);
  }
  /* a hair style: your own head in that style, and its name */
  .style .face {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 64px;
    padding: 0.5rem 0.75rem;
    background: var(--paper);
    border: var(--px) solid var(--ink);
  }
  .style :global(.av) {
    width: 56px; /* the head, 14 x 11 sprite pixels at 4x */
    height: 44px;
  }
  /* chosen: a leaf inner ring and a tick, so it isn't colour alone */
  .pick input:checked ~ .face {
    box-shadow: inset 0 0 0 var(--px) var(--leaf);
  }
  .style input:checked ~ .face {
    background: var(--leaf);
    box-shadow: none;
  }
  .pick :global(.tick) {
    display: none;
    position: absolute;
    top: -8px;
    right: -8px;
    z-index: 2;
    width: 24px;
    height: 24px;
    padding: 2px;
    color: var(--ink);
    background: var(--leaf);
    border: 2px solid var(--ink);
    pointer-events: none;
  }
  .pick input:checked ~ :global(.tick) {
    display: block;
  }
  .pick input:focus-visible ~ .face {
    outline: var(--px) solid var(--ink);
    outline-offset: var(--px);
  }
  .pick:hover .face {
    border-color: var(--green);
  }
  .editor > .error {
    margin-top: 1.5rem;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .status-line {
    margin: 0.5rem 0 0;
  }
  .status-line:empty {
    display: none;
  }
  /* the line under the card: a short hint and one secondary way out */
  .lobby-alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .lobby-alt p {
    flex: 1 1 14rem;
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .floor :global(.av-top) {
      animation: none;
    }
  }
</style>
