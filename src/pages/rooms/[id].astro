      {/* INT-1: the menu (I.2), and the room log's icons (I.9) */}
      <template data-part="menu">
        <div class="menu" role="menu" aria-labelledby="menu-name" id="menu">
          <div class="menu-who">
            <p class="menu-name" id="menu-name"></p>
          </div>
          <p class="menu-news" hidden><Sprite sprite={pbIcon} scale={2} /><span></span></p>
          <ul class="menu-acts">
            {/* INT-9.10, INT-10.14: the answer row, filled by the script */}
            <li class="answer" hidden>
              <button type="button" class="act" role="menuitem" value="" aria-describedby="menu-why">
                <span class="cur" aria-hidden="true"></span>
                <span class="answer-icon"></span>
