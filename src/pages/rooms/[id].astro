---
import { and, eq, isNull } from "drizzle-orm";
import SetFields, { type FieldValues } from "../../components/SetFields.astro";
import Sprite from "../../components/Sprite.astro";
import { db } from "../../lib/db.ts";
import { EQUIPMENT, EXERCISES, exerciseById, type Exercise } from "../../lib/exercises.ts";
import { clock, distanceKm, kg, km, pace, setLabel, timeOfDay, volume } from "../../lib/logbook.ts";
import { AWAY_MS, roomView, setFinished, setLifting, SLACK_GRACE_S, type State } from "../../lib/presence.ts";
import { tapPoster } from "../../lib/dony.ts";
import { avatarLabel, everyone } from "../../lib/floor.ts";
import { STATE_WORD, stateAt, whatParts } from "../../lib/squad.ts";
import { log, who } from "../../lib/log.ts";
import { announce, broadcast, donyEmotes } from "../../lib/realtime.ts";
import { emote, interact, joinedAt, limitsFrom, roomLog, say } from "../../lib/interactions.ts";
import { EMOJI } from "../../sprites/emoji.ts";
import { ago, isEmoji, isKind, isPreset, logLine, PRESETS, slapRefusal, type LogEntry, type Refusal } from "../../lib/moves.ts";
import { endRoom, isMember, leaveRoom, ROOM_SIZE, touchRoom, wasMember } from "../../lib/rooms.ts";
import { roomMembers, rooms, users, workouts } from "../../lib/schema.ts";
import {
  adjustRest,
  deleteSet,
  editSet,
  finishWorkout,
  lastSet,
  logSet,
  openWorkoutStart,
  readSet,
  setsInOpenWorkout,
  setToEdit,
  type SetValues,
} from "../../lib/workouts.ts";
import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/Avatar.astro";
import GymMap from "../../components/GymMap.astro";
import { lookOf } from "../../lib/avatars.ts";
import { lookKey } from "../../sprites/avatar.ts";
import {
  dropIcon,
  dumbbellIcon,
  idleIcon,
  pencilIcon,
  phoneIcon,
  phoneOffIcon,
  playIcon,
  signalIcon,
  stopIcon,
  trophyIcon,
  claimIcon,
  clockIcon,
  tickIcon,
  cheerIcon,
  pokeIcon,
  slapIcon,
  sayIcon,
  emoteIcon,
} from "../../sprites/icons.ts";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname)}`, 303);

const roomId = Number(Astro.params.id);
const room = Number.isInteger(roomId) ? db.select().from(rooms).where(eq(rooms.id, roomId)).get() : undefined;
// ROOM-6: someone the room was closed on is told so, on home
if (room?.closedAt && wasMember(roomId, user.id)) {
  const hadWorkout = db
    .select({ id: workouts.id })
    .from(workouts)
    .where(and(eq(workouts.roomId, roomId), eq(workouts.userId, user.id)))
    .get();
  return Astro.redirect(`/?ended=${room.passcode}${hadWorkout ? "&logged=1" : ""}`, 303);
}
// someone without the passcode can't see that the room exists
if (!room || !isMember(roomId, user.id)) {
  log("room.denied", { ...who(user), room: Astro.params.id, method: Astro.request.method });
  return new Response("Not found", { status: 404 });
}
// whether this visit brings them back from Away (GYM-14), read before it counts
const wasAway = Date.now() - (db
  .select({ at: roomMembers.lastSeenAt })
  .from(roomMembers)
  .where(and(eq(roomMembers.roomId, roomId), eq(roomMembers.userId, user.id)))
  .get()?.at ?? 0) > AWAY_MS;
touchRoom(roomId, user.id);
const isHost = room.hostUserId === user.id;
const here = Astro.url.pathname;
const summary = (workoutId: number | undefined, otherwise: string) =>
  Astro.redirect(workoutId ? `/workouts/${workoutId}?done=1` : otherwise, 303);

let error = "";
let errorField = "";
let submitted: FormData | undefined;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "log");
  const setId = Number(form.get("set_id"));

  // GYM-13: whatever this request changes, everyone watching the room sees it
  const changed = <T,>(result: T): T => (broadcast(roomId), result);
  // OPS-1: one line per thing done in the room, saying who did it
  const did = (event: string, fields: Parameters<typeof log>[1] = {}) =>
    log(event, { ...who(user), room: roomId, ...fields });
  const lift = (ex: Exercise) => {
    const claim = setLifting(user.id, roomId, ex.id);
    did("station.claim", { exercise: ex.name, slot: claim?.slot, arrived: claim?.arrived });
  };
  const values = (v: SetValues) => ({ kg: v.weightKg, reps: v.reps, s: v.durationS, m: v.distanceM });

  if (action === "finish") {
    const workoutId = finishWorkout(user.id, roomId);
    setFinished(user.id, roomId);
    did("workout.finish", { workout: workoutId });
    return changed(summary(workoutId, "/"));
  }
  if (action === "choose") {
    const ex = exerciseById(Number(form.get("exercise")));
    if (!ex) return Astro.redirect(here, 303);
    lift(ex);
    return changed(Astro.redirect(`${here}?exercise=${ex.id}`, 303));
  }
  // INT-1 to INT-5, INT-8: a Cheer, Poke or Slap, a preset, or an emoji,
  // sent by the page's script, which reads the answer as JSON: accepted, or
  // refused with a reason it maps to the copy bank. Accepted ones go to
  // everyone watching as their own small event; the room is only re-sent if
  // the sender was Away, since sending brings them back (INT-5.13).
  if (action === "interact" || action === "say" || action === "emote") {
    const json = (status: number, body: object) =>
      new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
    const refuse = (status: number, reason: string, fields: Parameters<typeof log>[1] = {}) => {
      did(`${action}.refused`, { reason, ...fields });
      return json(status, { ok: false, reason });
    };
    const STATUS: Record<Refusal, number> = { self: 400, gone: 409, "target-lifting": 409, "target-finished": 409, "rate-limit": 429 };
    const me = { id: user.id, name: user.displayName };
    // `to` is a member's id, or Dony's (0), in decimal digits
    const toText = String(form.get("to") ?? "");
    const to = /^\d+$/.test(toText) ? Number(toText) : NaN;
    // touchRoom above already counted it as activity; back from Away for everyone
    const sent = (event: "interaction" | "say" | "emote", data: { at: number }, fields: Parameters<typeof log>[1]) => {
      did(`${action}.sent`, fields);
      announce(roomId, event, data);
      if (wasAway) broadcast(roomId);
      if (event === "interaction") donyEmotes(roomId);
      return json(200, { ok: true, at: data.at });
    };
    if (action === "emote") {
      const emoji = String(form.get("emoji") ?? "");
      if (!isEmoji(emoji)) return refuse(400, "invalid", { emoji: emoji.slice(0, 20) });
      const r = emote(me, emoji);
      return r.ok ? sent("emote", r.event, { emoji }) : refuse(STATUS[r.reason], r.reason, { emoji });
    }
    if (!Number.isSafeInteger(to)) return refuse(400, "invalid", { to: toText.slice(0, 20) });
    if (action === "interact") {
      const kind = String(form.get("kind") ?? "");
      if (!isKind(kind)) return refuse(400, "invalid", { kind: kind.slice(0, 20) });
      const r = interact(roomView(roomId), roomId, me, to, kind);
      return r.ok
        ? sent("interaction", r.event, { kind, to, target_state: r.event.targetState })
        : refuse(STATUS[r.reason], r.reason, { kind, to });
    }
    const preset = String(form.get("preset") ?? "");
    if (!isPreset(preset)) return refuse(400, "invalid", { preset: preset.slice(0, 20) });
    const r = say(roomView(roomId), roomId, me, to, preset);
    return r.ok ? sent("say", r.event, { preset, to }) : refuse(STATUS[r.reason], r.reason, { preset, to });
  }
  // BOT-1, BOT-4: a tap on Dony's poster. A tap that does nothing answers the
  // same, and the room's next update shows what really happened.
  if (action === "dony") {
    const intent = String(form.get("intent"));
    const took = (intent === "summon" || intent === "send-back") && tapPoster(roomId, user.id, intent);
    did("dony.tap", { intent, took });
    if (took) broadcast(roomId);
    return Astro.request.headers.get("x-spotter") === "poster" ? new Response(null, { status: 204 }) : Astro.redirect(here, 303);
  }
  if (action === "leave") {
    const workoutId = leaveRoom(user.id, roomId);
    did("room.leave", { workout: workoutId });
    return summary(workoutId, `/?left=${room.passcode}`);
  }
  if (action === "end") {
    const ended = endRoom(user.id, roomId);
    if (!ended) {
      did("room.end_denied", { host: room.hostUserId });
      return new Response("Only the host can end the room", { status: 403 });
    }
    did("room.end", { workout: ended.workoutId });
    return summary(ended.workoutId, "/");
  }
  if (action === "rest") {
    const delta = String(form.get("delta"));
    if (delta === "-15" || delta === "15" || delta === "skip") {
      adjustRest(user.id, roomId, delta);
      did("rest.adjust", { delta });
    }
    return changed(Astro.redirect(here + Astro.url.search.replace(/[?&]rested=1/, ""), 303));
  }
  if (action === "delete") {
    const own = Number.isInteger(setId) ? setToEdit(user.id, roomId, setId) : undefined;
    if (!own || !deleteSet(user.id, roomId, setId)) {
      did("set.denied", { action, set: form.get("set_id")?.toString() });
      return new Response("Not found", { status: 404 });
    }
    did("set.delete", { set: setId });
    return changed(Astro.redirect(`${here}?exercise=${own.exerciseId}`, 303));
  }
  // GYM-10: Start set ends the rest and puts you on the lift. The page comes
  // back as Lifting with whatever was typed still in the fields, ready for Done.
  if (action === "start") {
    const ex = exerciseById(Number(form.get("exercise_id")));
    adjustRest(user.id, roomId, "skip");
    did("rest.adjust", { delta: "skip" });
    if (ex) lift(ex);
    broadcast(roomId);
    submitted = form;
  } else if (action === "edit") {
    const own = Number.isInteger(setId) ? setToEdit(user.id, roomId, setId) : undefined;
    const ex = own && exerciseById(own.exerciseId);
    if (!own || !ex) {
      did("set.denied", { action, set: form.get("set_id")?.toString() });
      return new Response("Not found", { status: 404 });
    }
    const read = readSet(ex.kind, form);
    if ("values" in read) {
      editSet(user.id, roomId, setId, read.values);
      did("set.edit", { set: setId, exercise: ex.name, ...values(read.values) });
      return changed(Astro.redirect(`${here}?exercise=${ex.id}`, 303));
    }
    ({ error, field: errorField } = read);
  } else {
    const ex = exerciseById(Number(form.get("exercise_id")));
    if (!ex) error = "Pick an exercise.";
    else {
      const read = readSet(ex.kind, form);
      if ("values" in read) {
        logSet(user.id, roomId, ex, read.values);
        // the set says where it was done; a second station.claim would be noise
        const claim = setLifting(user.id, roomId, ex.id);
        did("set.log", { exercise: ex.name, ...values(read.values), slot: claim?.slot });
        return changed(Astro.redirect(`${here}?exercise=${ex.id}&rested=1`, 303));
      }
      ({ error, field: errorField } = read);
    }
  }
  if (action !== "start") {
    submitted = form;
    Astro.response.status = 400;
  }
}

const now = Date.now();
const mySets = setsInOpenWorkout(user.id, roomId);
const startedAt = openWorkoutStart(user.id, roomId);
const members = db
  .select({ id: users.id, name: users.displayName })
  .from(roomMembers)
  .innerJoin(users, eq(users.id, roomMembers.userId))
  .where(and(eq(roomMembers.roomId, roomId), isNull(roomMembers.leftAt)))
  .all();
const others = members.filter((m) => m.id !== user.id).map((m) => m.name);
const othersText = others.length > 1 ? `${others.slice(0, -1).join(", ")} and ${others.at(-1)}` : (others[0] ?? "");
// ROOM-3: the invite link joins whoever opens it, after signing up if need be
const inviteUrl = `${Astro.url.host}/join/${room.passcode}`;

// LOG-8: ?edit=<id> opens one of your sets in this workout; anything else
// falls back to the normal sheet
const editId = Number(Astro.url.searchParams.get("edit") ?? submitted?.get("set_id"));
const editing = Number.isInteger(editId) && editId > 0 ? setToEdit(user.id, roomId, editId) : undefined;
const exercise: Exercise | undefined = exerciseById(
  editing ? editing.exerciseId : Number(Astro.url.searchParams.get("exercise") ?? submitted?.get("exercise_id")),
);
const prefill = exercise && !editing ? lastSet(user.id, exercise.id) : undefined;

// LOG-4: the rest after your newest set runs until it's skipped or the next
// set is logged. Past half an hour over it's no longer a rest, just a gap.
const latest = mySets.at(-1);
// Done just landed: the GET after a log's redirect, on the lift logged.
// Not after Start set, which posts to the same URL.
const justLogged =
  Astro.request.method === "GET" &&
  Astro.url.searchParams.has("rested") &&
  !editing &&
  !!latest &&
  latest.exerciseId === exercise?.id;
const loggedNo = justLogged ? mySets.filter((s) => s.exerciseId === latest!.exerciseId).length : 0;
const restEnd = latest ? latest.completedAt + latest.restTargetS * 1000 : 0;
const resting = !!latest && latest.restTargetS > 0 && latest.restEndedAt === null && now < restEnd + 30 * 60_000;
const over = resting && now >= restEnd;
// GYM-11: red only once the server would call it Slacking, so your screen and
// your squad's turn at the same moment
const slacking = over && now >= restEnd + SLACK_GRACE_S * 1000;
const state = slacking ? "slacking" : resting ? "resting" : exercise ? "lifting" : "idle";
const baseState = exercise ? "lifting" : "idle";
const STATE_ICON: Record<State, typeof idleIcon> = {
  idle: idleIcon,
  lifting: dumbbellIcon,
  resting: dropIcon,
  slacking: phoneIcon,
  finished: trophyIcon,
};
const TAB = {
  idle: { icon: idleIcon, word: "Idle" },
  lifting: { icon: dumbbellIcon, word: "Lifting" },
  resting: { icon: dropIcon, word: "Resting" },
  slacking: { icon: phoneIcon, word: "Slacking" },
};

// GYM-15: everyone in the room as the server sees them, you first, then in
// the order they came in; the script keeps it live from the event stream
const view = roomView(roomId, now);
// (Dony, while he's out, last of all, BOT-5)
const squad = [...view.members].sort((a, b) => Number(b.id === user.id) - Number(a.id === user.id));
if (view.dony.member) squad.push(view.dony.member);
// INT-5.8: the room log, newest first, with "You walked in" where you came
// in (D14), shown only with lines on both sides of it (INT-5.23)
const log50 = roomLog(roomId);
const walkedIn = joinedAt(roomId, user.id);
const LOG_ICON = { cheer: cheerIcon, poke: pokeIcon, slap: slapIcon, say: sayIcon };
const showWalkedIn = walkedIn !== undefined && log50.some((e) => e.at >= walkedIn) && log50.some((e) => e.at < walkedIn);
type LogRow = { entry: LogEntry } | { walkedIn: number };
const logRows: LogRow[] = [];
for (const entry of log50) {
  if (showWalkedIn && entry.at < walkedIn! && !logRows.some((r) => "walkedIn" in r)) logRows.push({ walkedIn: walkedIn! });
  logRows.push({ entry });
}
// INT-4.7: when your 10 s on each person run out; INT-5.6: bubbles still
// within their 5 s, for a page opened mid-bubble
const limits = limitsFrom(roomId, user.id, now);
const liveSays = log50.filter((e) => e.kind === "say" && now - e.at < 5_000).reverse();
const LOG_SHOWN = 5;
const logShown = logRows.slice(0, LOG_SHOWN + Number(logRows.slice(0, LOG_SHOWN).some((r) => "walkedIn" in r)));
const logOlder = logRows.slice(logShown.length);
const isAboutMe = (e: LogEntry) => e.from.id === user.id || e.to.id === user.id;
// GYM-4: the station you claimed, shown in the sheet while you're on a lift
const myStation = !editing && exercise ? view.members.find((m) => m.id === user.id)?.station : undefined;

// The fields: what was just submitted after an error, the set being edited,
// or the last set of this exercise (LOG-3).
const str = (n: number | null | undefined) => (n === null || n === undefined ? "" : String(n));
function fieldsFrom(v: Partial<SetValues> | undefined, ex: Exercise): FieldValues {
  const first = !v;
  return {
    weight_kg: str(v?.weightKg ?? 0),
    reps: str(v?.reps ?? (first && ex.kind === "weight" ? 8 : null)),
    minutes: v?.durationS != null ? String(Math.floor(v.durationS / 60)) : "",
    seconds: v?.durationS != null ? String(v.durationS % 60) : "",
    distance_km: v?.distanceM != null ? String(v.distanceM / 1000) : "",
  };
}
const values: FieldValues | undefined =
  exercise &&
  (submitted
    ? {
        weight_kg: String(submitted.get("weight_kg") ?? ""),
        reps: String(submitted.get("reps") ?? ""),
        minutes: String(submitted.get("minutes") ?? ""),
        seconds: String(submitted.get("seconds") ?? ""),
        distance_km: String(submitted.get("distance_km") ?? ""),
      }
    : // timed kinds start empty, so the stopwatch counts from zero; the last
      // one stays in view as "Last time"
      fieldsFrom(editing ?? (exercise.kind === "weight" || exercise.kind === "bodyweight" ? prefill : undefined), exercise));

const groups = Object.entries(EQUIPMENT).map(([key, label]) => ({
  label,
  exercises: EXERCISES.filter((e) => e.equipment === key),
}));
// lifts already done this session, in first-done order, as one-tap chips
const recent = [...new Set(mySets.map((s) => s.exerciseId))].flatMap((id) => exerciseById(id) ?? []);
const setNo = editing
  ? mySets.filter((s) => s.exerciseId === editing.exerciseId).findIndex((s) => s.id === editing.id) + 1
  : exercise
    ? mySets.filter((s) => s.exerciseId === exercise.id).length + 1
    : 0;
const editingLabel = editing && exercise ? setLabel({ ...editing, name: exercise.name, kind: exercise.kind }) : "";
const showLast = !!exercise && !editing && !(resting && latest?.exerciseId === exercise.id);
const timed = exercise?.kind === "duration" || exercise?.kind === "cardio";

const vol = volume(mySets);
const dist = distanceKm(mySets);
const elapsedS = startedAt ? Math.floor((now - startedAt) / 1000) : 0;
// a set in the log with its units dimmed: "62.5 kg × 7" splits around " kg"
const unitSplit = (label: string) => label.split(/( kg| km)/);
---

<Layout title={`Room ${room.passcode}`} surface="night">
  <div class="gym" data-room={roomId} data-limits={JSON.stringify(limits)} data-says={JSON.stringify(liveSays)}>
    <GymMap view={view} me={user.id} passcode={room.passcode} />

    <section class="panel sheet" aria-labelledby="sheet-title" data-base-state={baseState}>
      <span class={`chip state-${state} tab`}>
        <Sprite sprite={TAB[state].icon} scale={2} />
        {TAB[state].word}
      </span>
      {/* LOG-6: your session's time, from the moment you walked in */}
      {
        startedAt && (
          <p class="panel-clock">
            <Sprite sprite={clockIcon} scale={2} />
            <span class="vh">Workout time </span>
            <time datetime={`PT${elapsedS}S`} data-start={startedAt}>
              {clock(elapsedS)}
            </time>
          </p>
        )
      }
      {
        resting && (
          <>
            {(["resting", "slacking", baseState] as const).map((s) => (
              <template data-tab={s}>
                <Sprite sprite={TAB[s].icon} scale={2} />
                {TAB[s].word}
              </template>
            ))}
          </>
        )
      }
      {!editing && exercise && <h2 class="vh" id="sheet-title">Log a set</h2>}
      {
        justLogged && latest!.kind === "cardio" && (
          <div class="set-done">
            <Sprite sprite={tickIcon} scale={4} />
            <p class="set-done-n">Set {loggedNo} logged</p>
            <p class="set-done-say">No rest timer after cardio. Go again, or change lift 🏃</p>
          </div>
        )
      }
      {
        resting && latest && (
          <div class:list={["rest", { over, slacking }]} data-end={restEnd} data-rest-target={latest.restTargetS}>
            {over && (
              <p class="rest-say" role="status">
                {slacking ? "Your squad can see you 👀" : "Rest's up. Back under the bar 🔔"}
              </p>
            )}
            <div class="rest-top">
              <p class="timer" role="timer" aria-label="Rest left" hidden>
                {over ? `+${clock((now - restEnd) / 1000)}` : clock((restEnd - now) / 1000)}
              </p>
              <p class="rest-what">
                <span>
                  {over ? "over a " : "of "}
                  <b class="rest-of">{clock(latest.restTargetS)}</b> rest
                </span>
                <span>
                  after{" "}
                  <b>
                    {latest.exerciseId !== exercise?.id && `${latest.name} `}
                    {setLabel(latest)}
                  </b>
                </span>
              </p>
            </div>
            <p class="rest-static">
              Rest {clock(latest.restTargetS)} · next set at {timeOfDay(restEnd).toLowerCase()}
            </p>
            <form method="post" class="rest-adjust">
              <input type="hidden" name="action" value="rest" />
              <button type="submit" name="delta" value="-15" class="button secondary tool" aria-label="15 seconds less rest">
                -15 s
              </button>
              <button type="submit" name="delta" value="15" class="button secondary tool" aria-label="15 seconds more rest">
                +15 s
              </button>
            </form>
          </div>
        )
      }
      {
        editing && exercise && values ? (
          <>
            <div class="lift-row">
              <h2 class="lift" id="sheet-title">
                {exercise.name}
              </h2>
              <span class="set-no">Set {setNo}</span>
              <span class="badge">Editing</span>
              <a href={`?exercise=${exercise.id}`} class="lift-cancel">
                Cancel
              </a>
            </div>
            <p class="hint logged-at">Logged at {timeOfDay(editing.completedAt).toLowerCase()}</p>
            <form method="post" id="set-edit" class="set-form">
              <input type="hidden" name="action" value="edit" />
              <input type="hidden" name="set_id" value={editing.id} />
              <SetFields kind={exercise.kind} values={values} invalid={errorField} />
              {error && (
                <p class="error" id="set-error" role="alert">
                  {error}
                </p>
              )}
            </form>
            <details class="confirm">
              <summary class="button secondary quiet">
                <span class="if-closed">Delete</span>
                <span class="if-open">Keep it</span>
              </summary>
              <form method="post" class="confirm-box">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="set_id" value={editing.id} />
                <p>
                  Delete {exercise.name} set {setNo}, {editingLabel}? It can't be undone.
                </p>
                <button type="submit" class="button secondary quiet">Delete set</button>
              </form>
            </details>
          </>
        ) : exercise && values ? (
          <>
            <details class="switch">
              <summary>
                <span class="lift">{exercise.name}</span>
                <span class="set-no">Set {setNo}</span>
                <span class="change">Change</span>
              </summary>
              <form method="post" class="picker">
                <input type="hidden" name="action" value="choose" />
                {recent.length > 0 && (
                  <>
                    <p class="recent-label">From this workout</p>
                    <ul class="recent">
                      {recent.map((e) => (
                        <li>
                          <button
                            type="submit"
                            name="exercise"
                            value={e.id}
                            aria-current={e.id === exercise.id ? "true" : undefined}
                          >
                            {e.name}
                          </button>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                <label for="exercise">Exercise</label>
                <select id="exercise" name="exercise">
                  {groups.map((g) => (
                    <optgroup label={g.label}>
                      {g.exercises.map((e) => (
                        <option value={e.id} selected={e.id === exercise.id}>
                          {e.name}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <div class="actions">
                  <button type="submit" class="secondary button">Choose</button>
                </div>
              </form>
            </details>
            {myStation && (
              <p class="spot">
                <Sprite sprite={claimIcon} scale={2} />
                <span>
                  Your spot:{" "}
                  <b>
                    {myStation.equipment} {myStation.slot}
                  </b>
                </span>
              </p>
            )}
            <form method="post" class="set-form" id="set-log" data-kind={exercise.kind} data-exercise={exercise.id}>
              <input type="hidden" name="exercise_id" value={exercise.id} />
              {showLast &&
                (prefill ? (
                  <p class="last">
                    Last time <b>{setLabel({ ...prefill, name: exercise.name, kind: exercise.kind })}</b>
                  </p>
                ) : (
                  <p class="last">First time on this one. Ease into it.</p>
                ))}
              <SetFields kind={exercise.kind} values={values} invalid={errorField} />
              {error && (
                <p class="error" id="set-error" role="alert">
                  {error}
                </p>
              )}
              {timed && (
                <div class="stopwatch">
                  <button type="button" class="button secondary tool sw-toggle" hidden>
                    <span class="sw-start">
                      <Sprite sprite={playIcon} scale={2} />
                      Start
                    </span>
                    <span class="sw-stop" hidden>
                      <Sprite sprite={stopIcon} scale={2} />
                      Stop
                    </span>
                  </button>
                  <button type="button" class="button secondary tool sw-reset" hidden>
                    Reset
                  </button>
                  <p class="say" hidden>
                    {exercise.kind === "duration" ? "Start, hold, Stop." : "Pace shows once there's a distance."}
                  </p>
                </div>
              )}
            </form>
          </>
        ) : (
          <form method="post" class="pick" id="pick">
            <input type="hidden" name="action" value="choose" />
            <h2 class="lift lift-row" id="sheet-title">Pick a lift</h2>
            {recent.length > 0 && (
              <>
                <p class="recent-label">From this workout</p>
                <ul class="recent">
                  {recent.map((e) => (
                    <li>
                      <button type="submit" name="exercise" value={e.id}>
                        {e.name}
                      </button>
                    </li>
                  ))}
                </ul>
              </>
            )}
            <label for="exercise">Exercise</label>
            <select id="exercise" name="exercise" aria-describedby="pick-hint">
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.exercises.map((e) => (
                    <option value={e.id}>{e.name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="hint" id="pick-hint">
              Choosing one claims a station in the gym.
            </p>
            {error && (
              <p class="error" id="set-error" role="alert">
                {error}
              </p>
            )}
          </form>
        )
      }
      {/* the dock: the sheet's one primary button, pointing back at its form.
          A set is Start set, then Done (GYM-10). On a phone it's pinned to the
          bottom of the screen, with a copy of the rest timer once the big one
          is out of view. */}
      <div class="dock">
        {/* INT-8: the emoji tab on the dock's top border, and its tray (I.7) */}
        <button type="button" class="emote" aria-haspopup="true" aria-expanded="false" aria-controls="tray" aria-label="Send an emoji">
          <Sprite sprite={emoteIcon} scale={3} />
        </button>
        <ul class="tray" id="tray" hidden>
          {
            EMOJI.map((e) => (
              <li>
                <button type="button" value={e.key}>
                  <svg viewBox="0 0 16 16" width="32" height="32" aria-hidden="true">
                    <use href={`#em-${e.key}`} />
                  </svg>
                  {e.word}
                </button>
              </li>
            ))
          }
        </ul>
        {
          justLogged && (
            <p class="stamp">
              <Sprite sprite={tickIcon} scale={2} />
              <span>
                Set {loggedNo} logged: <b>{setLabel(latest!)}</b>
              </span>
            </p>
          )
        }
        {
          editing && exercise && values ? (
            <button type="submit" form="set-edit" class="wide">
              Save
            </button>
          ) : exercise && values ? (
            <>
              {resting && <p class:list={["dock-timer", { slacking }]} aria-hidden="true" hidden />}
              {resting ? (
                <button type="submit" form="set-log" name="action" value="start" class="wide">
                  Start set
                </button>
              ) : (
                <button type="submit" form="set-log" class="wide">
                  Done
                </button>
              )}
            </>
          ) : (
            <button type="submit" form="pick" class="wide">
              Choose
            </button>
          )
        }
      </div>
    </section>

    <section class="panel squad" aria-labelledby="people-title">
      <h2 class="panel-title" id="people-title">Squad</h2>
      <ul class="people" data-me={user.id}>
        {
          squad.map((m) => {
            const row = (
              <>
                {"dony" in m ? <Avatar dony head /> : <Avatar look={m.look} head />}
                <span class="who">
                  {m.name}
                  {m.id === user.id && <span class="badge">You</span>}
                  {m.host && <span class="badge host">Host</span>}
                  <span class="what">
                    {whatParts(m, now).map(([text, keep]) => (keep ? <span class="n">{text}</span> : text))}
                  </span>
                </span>
                <span class="chips">
                  <span class={`chip state-${stateAt(m, now)}`}>
                    <Sprite sprite={STATE_ICON[stateAt(m, now)]} scale={2} />
                    {STATE_WORD[stateAt(m, now)]}
                  </span>
                  {m.away && (
                    <span class="chip away">
                      <Sprite sprite={phoneOffIcon} scale={2} />
                      Away
                    </span>
                  )}
                </span>
              </>
            );
            return (
              <li class:list={{ me: m.id === user.id, away: m.away }} data-id={m.id} data-look={"dony" in m ? "dony" : lookKey(m.look)}>
                {m.id === user.id ? (
                  row
                ) : (
                  <button type="button" class="person" aria-haspopup="menu" aria-expanded="false" aria-label={avatarLabel(m, stateAt(m, now), false)}>
                    {row}
                  </button>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="alone" hidden={members.length > 1}>
        {view.dony.out ? "Your squad's not in yet. Send them the passcode 📲" : "Just you so far. Send the passcode to the squad 📲"}
      </p>
      {/* what the script builds rows and the connection badge from */}
      <template data-part="head"><Avatar look={lookOf(user.id)} head allHair vars={false} /></template>
      <template data-part="dony-head"><Avatar dony head /></template>
      {
        (Object.keys(STATE_WORD) as State[]).map((s) => (
          <template data-part={s}>
            <Sprite sprite={STATE_ICON[s]} scale={2} />
          </template>
        ))
      }
      <template data-part="away"><Sprite sprite={phoneOffIcon} scale={2} /></template>
      {/* INT-1: the menu (I.2), and the room log's icons (I.9) */}
      <template data-part="menu">
        <div class="menu" role="menu" aria-labelledby="menu-name" id="menu">
          <div class="menu-who">
            <p class="menu-name" id="menu-name"></p>
          </div>
          <ul class="menu-acts">
            {
              (
                [
                  ["cheer", cheerIcon, "Cheer"],
                  ["poke", pokeIcon, "Poke"],
                  ["slap", slapIcon, "Slap"],
                  ["message", sayIcon, "Message"],
                ] as const
              ).map(([value, icon, word]) => (
                <li>
                  <button type="button" class="act" role="menuitem" value={value} aria-describedby="menu-why">
                    <span class="cur" aria-hidden="true"></span>
                    <Sprite sprite={icon} scale={2} />
                    {word}
                  </button>
                </li>
              ))
            }
          </ul>
          <p class="menu-why" id="menu-why" hidden></p>
          <div class="menu-message" hidden>
            <div class="menu-sub">
              <button type="button" class="back button secondary" role="menuitem"><span class="cur" aria-hidden="true"></span>Back</button>
              <p class="menu-to"></p>
            </div>
            {
              (
                [
                  ["Hype", "hype"],
                  ["Nudge", "nudge"],
                ] as const
              ).map(([title, group]) => (
                <>
                  <p class="menu-group" id={`menu-group-${group}`}>{title}</p>
                  <ul class="presets" role="group" aria-labelledby={`menu-group-${group}`}>
                    {Object.entries(PRESETS)
                      .filter(([key]) => key.startsWith(group))
                      .map(([key, text]) => (
                        <li>
                          <button type="button" class="preset" role="menuitem" value={key}>{text}</button>
                        </li>
                      ))}
                  </ul>
                </>
              ))
            }
          </div>
        </div>
      </template>
      <template data-part="log-cheer"><Sprite sprite={cheerIcon} scale={2} /></template>
      <template data-part="log-poke"><Sprite sprite={pokeIcon} scale={2} /></template>
      <template data-part="log-slap"><Sprite sprite={slapIcon} scale={2} /></template>
      <template data-part="log-say"><Sprite sprite={sayIcon} scale={2} /></template>
      <template data-part="lost">
        <span class="lost"><Sprite sprite={signalIcon} scale={2} />Reconnecting…</span>
      </template>
    </section>


    <section class="panel room-log" aria-labelledby="roomlog-title">
      <h2 class="panel-title" id="roomlog-title">Room log</h2>
      {log50.length === 0 && <p class="empty">Quiet in here. Tap someone on the map to cheer them on 👀</p>}
      <ol
        class="log-lines"
        data-me={user.id}
        data-joined={walkedIn}
        data-joined-text={walkedIn === undefined ? undefined : `You walked in · ${timeOfDay(walkedIn)}`}
      >
        {logShown.map((r: LogRow) =>
            "walkedIn" in r ? (
              <li class="joined">You walked in · {timeOfDay(r.walkedIn)}</li>
            ) : (
              <li class:list={{ you: isAboutMe(r.entry) }} data-at={r.entry.at}>
                <Sprite sprite={LOG_ICON[r.entry.kind]} scale={2} />
                {(() => {
                  const l = logLine(r.entry, user.id);
                  return l.text !== undefined ? (
                    <span class="line">
                      {l.who} <span class="to">{l.to}</span> "{l.text}"
                    </span>
                  ) : (
                    <span class="line">
                      {l.who}
                      {l.rest}
                    </span>
                  );
                })()}
                <span class="t">{ago(r.entry.at, now)}</span>
              </li>
            ))}
      </ol>
      <details class="older" hidden={logOlder.length === 0}>
        <summary>Show older ({logOlder.length} more)</summary>
        <ol class="log-lines">{logOlder.map((r: LogRow) =>
            "walkedIn" in r ? (
              <li class="joined">You walked in · {timeOfDay(r.walkedIn)}</li>
            ) : (
              <li class:list={{ you: isAboutMe(r.entry) }} data-at={r.entry.at}>
                <Sprite sprite={LOG_ICON[r.entry.kind]} scale={2} />
                {(() => {
                  const l = logLine(r.entry, user.id);
                  return l.text !== undefined ? (
                    <span class="line">
                      {l.who} <span class="to">{l.to}</span> "{l.text}"
                    </span>
                  ) : (
                    <span class="line">
                      {l.who}
                      {l.rest}
                    </span>
                  );
                })()}
                <span class="t">{ago(r.entry.at, now)}</span>
              </li>
            ))}</ol>
      </details>
    </section>

    {
      mySets.length > 0 && startedAt && (
        <section class="panel" aria-labelledby="log-title">
          <h2 class="panel-title" id="log-title">This workout</h2>
          <p class="tally">
            <b>{mySets.length}</b> set{mySets.length === 1 ? "" : "s"}
            {vol > 0 && (
              <>
                {" "}
                · <b>{kg(vol)} kg</b> moved
              </>
            )}
            {dist > 0 && (
              <>
                {" "}
                · <b>{km(dist)} km</b> covered
              </>
            )}{" "}
            so far
          </p>
          <table class="log">
            <thead>
              <tr>
                <th>Exercise</th>
                <th class="num">Set</th>
                <th class="fix">
                  <span class="vh">Edit</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {mySets.map((s, i) => {
                const label = setLabel(s);
                const current = editing?.id === s.id;
                return (
                  <tr aria-current={current ? "true" : undefined}>
                    {i > 0 && mySets[i - 1].exerciseId === s.exerciseId ? (
                      <td class="ditto">
                        <span aria-hidden="true">"</span>
                        <span class="vh">{s.name}</span>
                      </td>
                    ) : (
                      <td>{s.name}</td>
                    )}
                    <td class="num set">
                      {s.distanceM !== null && s.durationS !== null ? (
                        <>
                          {km(s.distanceM / 1000)} <span class="u">km</span> · {clock(s.durationS)}
                          <span class="sub">{pace(s.durationS, s.distanceM)} /km</span>
                        </>
                      ) : (
                        unitSplit(label).map((part) =>
                          part === " kg" || part === " km" ? (
                            <>
                              {" "}
                              <span class="u">{part.trim()}</span>
                            </>
                          ) : (
                            part
                          ),
                        )
                      )}
                    </td>
                    <td class="fix">
                      {current ? (
                        <a href={`?exercise=${s.exerciseId}`} aria-label="Editing this set. Cancel">
                          <Sprite sprite={pencilIcon} scale={2} />
                        </a>
                      ) : (
                        <a href={`?edit=${s.id}`}>
                          <Sprite sprite={pencilIcon} scale={2} />
                          <span class="vh">
                            Edit {s.name}, {label}
                          </span>
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <form method="post">
            <input type="hidden" name="action" value="finish" />
            <div class="actions">
              <button type="submit" class="secondary button quiet">Finish workout</button>
            </div>
          </form>
        </section>
      )
    }

    <section class="panel sign" aria-labelledby="room-panel-title">
      <h2 class="panel-title" id="room-panel-title">Room</h2>
      <div class="passcode-box">
        <p class="spots">
          <span class="pips" aria-hidden="true">
            {Array.from({ length: ROOM_SIZE }, (_, i) => <i class:list={{ in: i < members.length }} />)}
          </span>
          <span class="count">{members.length} of {ROOM_SIZE} in</span>
        </p>
      </div>
      <p class="hint">Send the code to the squad, or this link: <span class="room-link">{inviteUrl}</span></p>
      <div class="actions room-actions">
        <form method="post">
          <input type="hidden" name="action" value="leave" />
          <button type="submit" class="button secondary quiet" aria-describedby="leave-note">Leave room</button>
        </form>
      </div>
      <p class="hint leave-note" id="leave-note">
        {
          members.length === 1
            ? "You're the last one in, so leaving closes the room."
            : mySets.length === 0
              ? "Nothing logged yet, so there's no workout to save."
              : "Leaving finishes your workout. Your sets stay in the book."
        }
      </p>
      {
        isHost && others.length > 0 && (
          <details class="confirm end-room">
            <summary class="button secondary quiet">
              <span class="if-closed">End room</span>
              <span class="if-open">Cancel</span>
            </summary>
            <form method="post" class="confirm-box">
              <input type="hidden" name="action" value="end" />
              <p>
                End the room for everyone? {othersText} get{others.length === 1 ? "s" : ""} sent home and{" "}
                {others.length === 1 ? "their workout finishes" : "their workouts finish"}. Every set is kept.
              </p>
              <button type="submit" class="button secondary quiet">End room</button>
            </form>
          </details>
        )
      }
    </section>
  </div>
  {/* outside the room, so an in-place swap keeps it: what Done logged, said once */}
  <p class="sheet-news" id="sheet-news" role="status"></p>
  {/* BOT-1, BOT-4: what Dony's poster on the map submits */}
  <form method="post" id="dony"><input type="hidden" name="action" value="dony" /></form>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import type { RoomView } from "../../lib/presence.ts";
  import { STATE_WORD, stateAt, whatParts } from "../../lib/squad.ts";
  import { avatarLabel, DOOR, everyone, floorLine, route, spots, UNDER_POSTER, type Tile } from "../../lib/floor.ts";
  import { lookFromKey, lookKey, lookVars, type Look } from "../../sprites/avatar.ts";
  import { STATIONS } from "../../sprites/gym.ts";
  import { isMachine } from "../../sprites/poses.ts";
  import { TILE } from "../../sprites/sprite.ts";
  import { ago, logLine, slapRefusal, type Kind, type LogEntry, type Refusal } from "../../lib/moves.ts";
  import type { MemberView, State } from "../../lib/presence.ts";

  // Every timer here is worked out from Date.now() on each tick, never
  // counted, so a phone that slept wakes up showing the right time (GYM-12).
  const clock = (totalS: number) => {
    const s = Math.max(0, Math.floor(totalS));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = String(s % 60).padStart(2, "0");
    return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
  };

  let audio: AudioContext | undefined;
  addEventListener("pointerdown", () => (audio ??= new AudioContext()).resume(), { once: true });
  function beep() {
    try {
      audio ??= new AudioContext();
      for (const at of [0, 0.25]) {
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = "square";
        osc.frequency.value = 880;
        gain.gain.value = 0.08;
        osc.connect(gain).connect(audio.destination);
        osc.start(audio.currentTime + at);
        osc.stop(audio.currentTime + at + 0.15);
      }
    } catch {
      // no sound available; the flash and the red still say it
    }
  }

  // Binds the timers, the stopwatch and the pending state to the room as it
  // is in the page, and returns what to run each second. Runs again after
  // each in-place update (below), on the new content.
  function init(): () => void {
    const roomId = document.querySelector<HTMLElement>(".gym")!.dataset.room;
    const sheet = document.querySelector<HTMLElement>(".sheet")!;

    // ---------- the workout clock ----------
    const workoutClock = document.querySelector<HTMLTimeElement>("time[data-start]");
    const tickClock = () => {
      if (workoutClock) workoutClock.textContent = clock((Date.now() - Number(workoutClock.dataset.start)) / 1000);
    };

    // ---------- the rest timer (LOG-4, LOG-5) ----------
    const rest = document.querySelector<HTMLElement>(".rest");
    const timer = rest?.querySelector<HTMLElement>(".timer");
    rest?.querySelector(".rest-static")?.remove();
    if (timer) timer.hidden = false;
    const tab = sheet.querySelector<HTMLElement>(".tab")!;
    const setTab = (state: string) => {
      const t = sheet.querySelector<HTMLTemplateElement>(`template[data-tab="${state}"]`);
      if (!t || tab.classList.contains(`state-${state}`)) return;
      tab.className = `chip state-${state} tab`;
      tab.replaceChildren(t.content.cloneNode(true));
    };
    // the page was open when rest ran out, so this one gets the beep and flash
    let wasOver = rest?.classList.contains("over") ?? true;
    function say(text: string) {
      let line = rest!.querySelector<HTMLElement>(".rest-say");
      if (!line) {
        line = document.createElement("p");
        line.className = "rest-say";
        line.setAttribute("role", "status");
        rest!.prepend(line);
      }
      if (line.textContent !== text) line.textContent = text;
    }
    // the dock's copy of the timer, shown on a phone only while the big one
    // isn't fully in view (above the pinned dock)
    const dockTimer = document.querySelector<HTMLElement>(".dock-timer");
    const copy = (red: boolean) => {
      if (!dockTimer || !timer) return;
      dockTimer.textContent = timer.textContent;
      dockTimer.classList.toggle("slacking", red);
    };
    dockWatch?.disconnect();
    if (dockTimer && timer && "IntersectionObserver" in window) {
      const dock = dockTimer.closest<HTMLElement>(".dock")!;
      const phone = matchMedia("(max-width: 899px)");
      dockWatch = new IntersectionObserver(
        ([e]) => {
          dockTimer.hidden = !phone.matches || e.intersectionRatio >= 1;
        },
        { rootMargin: `0px 0px -${dock.offsetHeight}px 0px`, threshold: 1 },
      );
      dockWatch.observe(timer);
    }
    const tickRest = () => {
      if (!rest || !timer || !rest.isConnected) return;
      const left = (Number(rest.dataset.end) - Date.now()) / 1000;
      const over = left <= 0;
      rest.classList.toggle("over", over);
      rest.querySelector(".rest-what span")!.firstChild!.textContent = over ? "over a " : "of ";
      if (!over) {
        timer.textContent = clock(Math.ceil(left));
        copy(false);
        rest.querySelector(".rest-say")?.remove();
        setTab("resting");
        wasOver = false;
        return;
      }
      timer.textContent = `+${clock(-left)}`;
      // GYM-11: blue for the first 30 s over, red once the squad sees Slacking
      const slacking = -left >= 30;
      rest.classList.toggle("slacking", slacking);
      setTab(slacking ? "slacking" : "resting");
      say(slacking ? "Your squad can see you 👀" : "Rest's up. Back under the bar 🔔");
      copy(slacking);
      if (!wasOver) {
        wasOver = true;
        beep();
        sheet.classList.remove("flash");
        void sheet.offsetWidth;
        sheet.classList.add("flash");
      }
    };

    // ---------- the stopwatch, for holds and cardio ----------
    const setForm = document.querySelector<HTMLFormElement>("form.set-form[data-exercise]");
    const watch = setForm?.querySelector<HTMLElement>(".stopwatch");
    const minutes = setForm?.querySelector<HTMLInputElement>("#minutes");
    const seconds = setForm?.querySelector<HTMLInputElement>("#seconds");
    const distance = setForm?.querySelector<HTMLInputElement>("#distance_km");
    const key = `spotter:stopwatch:${roomId}:${setForm?.dataset.exercise}`;
    const store = {
      get: () => {
        try {
          return Number(sessionStorage.getItem(key)) || 0;
        } catch {
          return 0;
        }
      },
      set: (v: number) => {
        try {
          if (v) sessionStorage.setItem(key, String(v));
          else sessionStorage.removeItem(key);
        } catch {
          // private mode: the stopwatch just won't survive a reload
        }
      },
    };
    let startedAt = 0;
    const fieldSeconds = () => Number(minutes!.value || 0) * 60 + Number(seconds!.value || 0);
    const writeTime = (s: number) => {
      minutes!.value = String(Math.floor(s / 60));
      seconds!.value = String(Math.floor(s % 60));
    };
    const sayLine = watch?.querySelector<HTMLElement>(".say");
    function sayPace() {
      if (!sayLine || startedAt) return;
      if (setForm!.dataset.kind === "duration") return (sayLine.textContent = "Start, hold, Stop.");
      const km = Number(distance!.value);
      const s = fieldSeconds();
      // rounded, as the server's pace() is, so both lines agree
      if (km >= 0.01 && s > 0) sayLine.innerHTML = `Pace <b>${clock(Math.round(s / km))} /km</b>`;
      else sayLine.textContent = "Pace shows once there's a distance.";
    }
    function showRunning(on: boolean) {
      const toggle = watch!.querySelector<HTMLButtonElement>(".sw-toggle")!;
      toggle.querySelector<HTMLElement>(".sw-start")!.hidden = on;
      toggle.querySelector<HTMLElement>(".sw-stop")!.hidden = !on;
      toggle.setAttribute("aria-pressed", String(on));
      minutes!.readOnly = seconds!.readOnly = on;
      minutes!.closest(".big-time")!.classList.toggle("running", on);
      if (on) sayLine!.textContent = "Clock's running. Stop fills the time.";
      else sayPace();
    }
    function stopWatch() {
      if (!startedAt) return;
      writeTime((Date.now() - startedAt) / 1000);
      startedAt = 0;
      store.set(0);
      showRunning(false);
    }
    if (watch && minutes && seconds) {
      for (const el of watch.querySelectorAll<HTMLElement>("[hidden]:not(.sw-stop)")) el.hidden = false;
      watch.querySelector(".sw-toggle")!.addEventListener("click", () => {
        if (startedAt) return stopWatch();
        // carries on from whatever time is already in the fields
        startedAt = Date.now() - fieldSeconds() * 1000;
        store.set(startedAt);
        showRunning(true);
      });
      watch.querySelector(".sw-reset")!.addEventListener("click", () => {
        startedAt = 0;
        store.set(0);
        writeTime(0);
        showRunning(false);
      });
      for (const input of [minutes, seconds, distance]) input?.addEventListener("input", sayPace);
      startedAt = store.get();
      showRunning(!!startedAt);
    }
    const tickWatch = () => {
      if (startedAt) writeTime((Date.now() - startedAt) / 1000);
    };

    // ---------- pending: Done and Save keep their label while the post is out ----------
    const editForm = document.querySelector<HTMLFormElement>("#set-edit");
    for (const form of [setForm, editForm]) {
      form?.addEventListener("submit", () => {
        if (form === setForm) {
          stopWatch();
          store.set(0);
        }
        submitButton(form)!.disabled = true;
        for (const input of form.querySelectorAll("input")) input.readOnly = true;
        sheet.setAttribute("aria-busy", "true");
      });
    }
    unbusy = () => {
      for (const form of [setForm, editForm]) {
        if (!form) continue;
        submitButton(form)!.disabled = false;
        for (const input of form.querySelectorAll("input")) {
          input.readOnly = form === setForm && !!startedAt && input.closest(".mmss") !== null;
        }
      }
      sheet.removeAttribute("aria-busy");
    };

    return () => {
      tickClock();
      tickRest();
      tickWatch();
    };
  }

  const submitButton = (form: HTMLFormElement) =>
    form.querySelector<HTMLButtonElement>("button[type=submit]") ??
    document.querySelector<HTMLButtonElement>(`button[form="${form.id}"]`);
  let unbusy = () => {};
  let dockWatch: IntersectionObserver | undefined;
  // Back restores the page from cache, button and all
  addEventListener("pageshow", () => unbusy());

  // This script runs once, however many times the room is shown; the client
  // router (ADR 0003) says when a room is on screen, after the first load and
  // after every swap.
  let tick = () => {};
  document.addEventListener("astro:page-load", () => {
    const gym = document.querySelector<HTMLElement>(".gym");
    posterDrawn = undefined; // a new page: read the poster as the server drew it
    tick = gym ? init() : () => {};
    if (gym) connect(gym.dataset.room!);
    else disconnect();
    tick();
    liveTick();
  });
  setInterval(() => {
    tick();
    liveTick();
  }, 1000);

  // ---------- the room, live (GYM-13, GYM-15) ----------
  // One stream per room on screen. Each message is the whole room, so the
  // squad list is redrawn from it rather than patched; a stream that
  // reconnects is right again with its first message. The server's clock
  // decides when someone turns Slacking, so its offset from this one is kept.
  let live: { roomId: string; source: EventSource } | undefined;
  let view: RoomView | undefined;
  let offset = 0;
  let connected = true;
  let lostTimer: ReturnType<typeof setTimeout> | undefined;

  function connect(roomId: string) {
    if (live?.roomId === roomId) return;
    disconnect();
    const source = new EventSource(`/rooms/${roomId}/events`);
    live = { roomId, source };
    source.addEventListener("room", (e) => {
      view = JSON.parse((e as MessageEvent<string>).data) as RoomView;
      offset = view.now - Date.now();
      // the host ended it, or it closed: the room page says where to go
      if (view.closed) {
        disconnect();
        return navigate(location.pathname);
      }
      liveTick();
      catchingUp = false;
    });
    source.addEventListener("interaction", (e) => onInteraction(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("say", (e) => onSay(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("emote", (e) => onEmote(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("open", () => {
      clearTimeout(lostTimer);
      lostTimer = undefined;
      connected = true;
      // the first message on a new stream is news we missed: everyone is put
      // where it says, with no walk replayed (GYM-10.21)
      catchingUp = true;
      liveTick();
    });
    source.addEventListener("error", () => {
      // refused outright (no longer a member): the room page says why
      if (source.readyState === EventSource.CLOSED) {
        disconnect();
        return navigate(location.pathname);
      }
      // a blip isn't worth a word; a stream down for 3 s is
      lostTimer ??= setTimeout(() => {
        connected = false;
        liveTick();
      }, 3000);
    });
  }

  function disconnect() {
    live?.source.close();
    live = undefined;
    view = undefined;
    clearTimeout(lostTimer);
    lostTimer = undefined;
    connected = true;
  }

  // Draws the connection badge, the headcount and the squad list from the
  // newest message, at this second.
  function liveTick() {
    const conn = document.querySelector<HTMLElement>(".conn");
    if (conn && conn.dataset.connected !== String(connected)) {
      conn.dataset.connected = String(connected);
      const lost = document.querySelector<HTMLTemplateElement>('template[data-part="lost"]')!;
      if (connected) conn.innerHTML = '<span class="badge">Live</span>';
      else conn.replaceChildren(lost.content.cloneNode(true));
    }
    const list = document.querySelector<HTMLUListElement>(".people");
    if (!view || !list) return;
    const now = Date.now() + offset;
    const me = Number(list.dataset.me);
    const part = (name: string) =>
      document.querySelector<HTMLTemplateElement>(`template[data-part="${name}"]`)!.content.cloneNode(true);
    const el = (tag: string, className: string, ...children: (Node | string)[]) => {
      const node = document.createElement(tag);
      node.className = className;
      node.append(...children);
      return node;
    };
    const people = [...view.members].sort((a, b) => Number(b.id === me) - Number(a.id === me));
    // Dony, while he's out, is last, and counted nowhere (BOT-5)
    const members = view.dony.member ? [...people, view.dony.member] : people;
    // Rows are patched in place, not rebuilt: a head is only redrawn when
    // that person's look changes, and the words and chips only when they
    // read differently, so nothing repaints every second (a freshly inserted
    // svg can flash black for a frame before its colours apply).
    const rows = new Map([...list.querySelectorAll<HTMLLIElement>(":scope > li")].map((li) => [li.dataset.id, li]));
    const ordered = members.map((m) => {
      const li = rows.get(String(m.id)) ?? el("li", "");
      li.dataset.id = String(m.id);
      li.className = [m.id === me && "me", m.away && "away"].filter(Boolean).join(" ");
      const dony = "dony" in m;
      const look = dony ? "dony" : lookKey(m.look);
      // someone else's row is one button that opens the menu (INT-1.10)
      let row: HTMLElement = li;
      if (m.id !== me) {
        let button = li.querySelector<HTMLButtonElement>(":scope > .person");
        if (!button) {
          button = el("button", "person") as HTMLButtonElement;
          button.type = "button";
          button.setAttribute("aria-haspopup", "menu");
          button.setAttribute("aria-expanded", String(menuOn?.id === m.id && menuOn.from === "row"));
          button.append(...li.childNodes);
          li.append(button);
        }
        button.setAttribute("aria-label", avatarLabel(m, stateAt(m, now), false));
        row = button;
      }
      if (li.dataset.look !== look || !row.querySelector(".av")) {
        // the head is drawn with every hair style; the look picks one and its
        // colours. Dony's is his own.
        const head = part(dony ? "dony-head" : "head") as DocumentFragment;
        if (!dony) {
          const svg = head.querySelector("svg")!;
          svg.setAttribute("style", lookVars(m.look));
          svg.dataset.hair = m.look.hair;
        }
        row.querySelector(".av")?.remove();
        row.prepend(head);
        li.dataset.look = look;
      }
      const state = stateAt(m, now);
      const parts = whatParts(m, now);
      const words = [m.name, m.id === me, m.host, ...parts.flat()].join("|");
      if (li.dataset.words !== words || !row.querySelector(".who")) {
        const what = el("span", "what", ...parts.map(([text, keep]) => (keep ? el("span", "n", text) : text)));
        const who = el(
          "span",
          "who",
          m.name,
          ...(m.id === me ? [" ", el("span", "badge", "You")] : []),
          ...(m.host ? [" ", el("span", "badge host", "Host")] : []),
          what,
        );
        row.querySelector(".who")?.remove();
        row.querySelector(".av")!.after(who);
        li.dataset.words = words;
      }
      const flags = `${state}|${m.away}`;
      if (li.dataset.flags !== flags || !row.querySelector(".chips")) {
        const chips = el("span", "chips", el("span", `chip state-${state}`, part(state), STATE_WORD[state]));
        if (m.away) chips.append(el("span", "chip away", part("away"), "Away"));
        row.querySelector(".chips")?.remove();
        row.append(chips);
        li.dataset.flags = flags;
      }
      return li;
    });
    // only reorder (which moves nodes) when the order or the people changed
    const current = [...list.children];
    if (current.length !== ordered.length || ordered.some((li, i) => current[i] !== li)) list.replaceChildren(...ordered);
    const alone = document.querySelector<HTMLElement>(".alone");
    if (alone) {
      alone.hidden = people.length > 1;
      const line = view.dony.out
        ? "Your squad's not in yet. Send them the passcode 📲"
        : "Just you so far. Send the passcode to the squad 📲";
      if (alone.textContent!.trim() !== line) alone.textContent = line;
    }
    const count = document.querySelector<HTMLElement>(".spots .count");
    if (count) count.textContent = `${people.length} of 12 in`;
    document.querySelectorAll(".spots .pips i").forEach((pip, i) => pip.classList.toggle("in", i < people.length));
    drawMap(now);
    drawPoster();
    drawMenu();
    followSenders();
  }

  // ---------- the map (GYM-1, GYM-9, GYM-10) ----------
  // Stations and avatars are patched from the newest message, like the list:
  // equipment is swapped when a station's changes, an avatar's sprite when
  // its pose or look does, and an avatar whose tile changes walks there,
  // showing the walk, and takes its pose when it arrives (GYM-10.17). Someone
  // on a machine carries its back and front layers, and the station's own
  // drawing steps aside until they get off (GYM-10.13).
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const STEP_MS = 125; // about 8 tiles a second
  let catchingUp = false; // a stream just (re)opened: place, don't walk
  // Dony mid-hop out of his poster, and where he goes once he lands
  const landing = new WeakMap<HTMLElement, { tile: Tile; onStation: boolean; pose: string }>();

  function drawMap(now: number) {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map || !view) return;
    const me = Number(map.dataset.me);
    const panel = map.closest(".map-panel")!;
    const copy = (attr: string) =>
      panel.querySelector<HTMLTemplateElement>(`template[${attr}]`)!.content.cloneNode(true) as DocumentFragment;

    const mine = view.members.find((m) => m.id === me)?.station?.slot;
    for (const s of view.stations) {
      const div = map.querySelector<HTMLElement>(`.station[data-slot="${s.slot}"]`);
      if (!div) continue;
      const equipment = s.equipment ?? "";
      if ((div.dataset.equipment ?? "") !== equipment) {
        // new equipment simply appears this week; the worker carries it in next
        div.replaceChildren(copy(equipment ? `data-gear="${equipment}"` : `data-bay="${s.slot}"`));
        if (equipment) div.dataset.equipment = equipment;
        else delete div.dataset.equipment;
        div.classList.remove("mine");
      }
      if (div.classList.contains("mine") !== (s.slot === mine)) {
        div.classList.toggle("mine", s.slot === mine);
        div.querySelector(".claim")?.remove();
        if (s.slot === mine) div.append(copy("data-claim"));
      }
    }
    const floor = document.querySelector<HTMLElement>("#floor");
    if (floor) floor.textContent = floorLine(view.stations);

    const left = new Map(
      [...map.querySelectorAll<HTMLButtonElement>(".avatar:not(.leaving)")].map((b) => [b.dataset.id!, b]),
    );
    const all = everyone(view);
    for (const p of spots(view, now)) {
      const m = all.find((x) => x.id === p.id)!;
      const dony = "dony" in m;
      let b = left.get(String(p.id));
      left.delete(String(p.id));
      if (!b) {
        // someone new walks in from the door; Dony hops down from his poster,
        // once it has shaken (3.2a), or is simply there under reduced motion
        b = document.createElement("button");
        b.type = "button";
        b.className = "avatar";
        b.dataset.id = String(p.id);
        b.append(Object.assign(document.createElement("span"), { className: "tag" }));
        place(b, dony && !reducedMotion.matches ? UNDER_POSTER : dony ? p.tile : DOOR);
        if (dony && !reducedMotion.matches && posterDrawn === false) {
          // hidden while the poster shakes, then one hop frame, then he walks
          // to wherever the newest message puts him (landing holds it)
          b.hidden = true;
          const arriving = b;
          landing.set(arriving, { tile: p.tile, onStation: p.onStation, pose: p.pose });
          setTimeout(() => {
            arriving.hidden = false;
            show(arriving, "hop");
            arriving.classList.add("hop");
            setTimeout(() => {
              arriving.classList.remove("hop");
              const to = landing.get(arriving)!;
              landing.delete(arriving);
              walk(arriving, to.tile, to.onStation, to.pose);
            }, STEP_MS);
          }, 250);
        }
        map.append(b);
      }
      b.classList.toggle("me", m.id === me);
      b.classList.toggle("away", m.away);
      // someone else opens the menu (INT-1.9); you don't (INT-1.8)
      if (m.id === me) b.removeAttribute("aria-haspopup");
      else {
        b.setAttribute("aria-haspopup", "menu");
        if (!b.hasAttribute("aria-expanded")) b.setAttribute("aria-expanded", "false");
      }
      b.dataset.state = p.state;
      b.setAttribute("aria-label", avatarLabel(m, p.state, m.id === me));
      const tag = b.querySelector<HTMLElement>(".tag")!;
      const tagKey = `${p.state}|${m.name}|${m.away}`;
      if (tag.dataset.key !== tagKey) {
        tag.className = `tag state-${p.state}`;
        tag.replaceChildren(Object.assign(document.createElement("span"), { className: "nm", textContent: m.name }));
        if (m.away) tag.append(copy("data-tag-away"));
        tag.dataset.key = tagKey;
      }
      const look = dony ? "dony" : lookKey(m.look);
      if (b.dataset.look !== look) {
        b.dataset.look = look;
        delete b.dataset.pose; // redraw in the new look
      }
      // he waits on the walkway until the hop, then walks like anyone
      if (landing.has(b)) {
        landing.set(b, { tile: p.tile, onStation: p.onStation, pose: p.pose });
        if (!b.querySelector(".av")) show(b, "stand");
      } else {
        if (!b.querySelector(".av")) show(b, p.pose);
        walk(b, p.tile, p.onStation, p.pose);
      }
    }
    for (const b of left.values()) {
      if (b.dataset.look !== "dony" || reducedMotion.matches) {
        b.remove();
        continue;
      }
      // Dony sent back: he gets off any machine at once (BOT-2.5), walks to
      // the walkway under his poster and hops in; his row has already gone,
      // and the poster fills once he's in (3.2a)
      b.classList.add("leaving");
      b.inert = true;
      walk(b, UNDER_POSTER, false, "stand", () => {
        show(b, "hop");
        b.classList.add("hop");
        setTimeout(() => {
          b.remove();
          drawPoster();
        }, STEP_MS);
      });
    }
    drawStations();
  }

  // A station hides its machine while someone is on it, not while they walk
  // to it or from it.
  function drawStations() {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map) return;
    const using = new Set(
      [...map.querySelectorAll<HTMLElement>(".avatar:not(.leaving)")]
        .filter((b) => isMachine(b.dataset.pose ?? ""))
        .map((b) => STATIONS.findIndex(([x, y]) => tileOf(b).join(",") === `${x},${y}`) + 1),
    );
    for (const div of map.querySelectorAll<HTMLElement>(".station")) {
      div.classList.toggle("occupied", using.has(Number(div.dataset.slot)));
    }
  }

  // An avatar's sprite in a pose, with the machine's layers round it on a
  // machine. Same pose, same look: nothing redrawn, so the frames keep their
  // beat (GYM-10.20).
  function show(b: HTMLElement, pose: string) {
    if (b.dataset.pose === pose && b.querySelector(".av")) return;
    const panel = b.closest(".map-panel")!;
    const copy = (attr: string) =>
      panel.querySelector<HTMLTemplateElement>(`template[${attr}]`)!.content.cloneNode(true) as DocumentFragment;
    const dony = b.dataset.look === "dony";
    const sprite = copy(dony ? `data-dony="${pose}"` : `data-pose="${pose}"`);
    if (!dony) {
      const m = view && everyone(view).find((x) => String(x.id) === b.dataset.id);
      const svg = sprite.querySelector("svg")!;
      if (m && !("dony" in m)) {
        svg.setAttribute("style", lookVars(m.look));
        svg.dataset.hair = m.look.hair;
      }
    }
    b.querySelectorAll(".av, .machine").forEach((el) => el.remove());
    if (isMachine(pose)) {
      const [back, front] = copy(`data-layers="${pose}"`).querySelectorAll("svg");
      b.append(back, sprite, front);
    } else b.append(sprite);
    b.dataset.pose = pose;
    b.classList.toggle("on-machine", isMachine(pose));
  }

  // ---------- Dony's poster (BOT-1, BOT-4; spec 3.2a) ----------
  // Full while he's in it, empty while he's out. It changes when a room
  // message says so: a shake, then the swap, and the dim for 30 s. While he
  // is walking back, it waits for him to hop in.
  let posterDrawn: boolean | undefined; // what the poster shows: out or not
  let posterRest: ReturnType<typeof setTimeout> | undefined;
  function drawPoster() {
    const button = document.querySelector<HTMLButtonElement>(".map-panel .poster");
    if (!button || !view) return;
    const out = view.dony.out;
    if (posterDrawn === undefined) posterDrawn = button.dataset.out === "true";
    const leaving = document.querySelector(".map-panel .avatar.leaving");
    if (out !== posterDrawn && !(!out && leaving)) {
      const svg = button.querySelector("svg")!;
      const swap = () => {
        svg.innerHTML = out ? '<use href="#poster-empty" />' : '<use href="#poster-full" /><use href="#poster-glint" class="glint" />';
      };
      if (reducedMotion.matches) swap();
      else {
        button.classList.remove("shake");
        void button.offsetWidth;
        button.classList.add("shake");
        setTimeout(() => {
          button.classList.remove("shake");
          swap();
        }, 250);
      }
      posterDrawn = out;
      button.dataset.out = String(out);
      button.classList.remove("pending");
      clearTimeout(pendingTimer);
    }
    button.value = out ? "send-back" : "summon";
    const resting = Date.now() + offset < view.dony.restingUntil;
    button.classList.toggle("resting", resting);
    if (resting || button.classList.contains("pending")) button.setAttribute("aria-disabled", "true");
    else button.removeAttribute("aria-disabled");
    button.setAttribute(
      "aria-label",
      (out ? "Send Dony back to his poster" : "Call Dony out of his poster") + (resting ? " (not ready yet)" : ""),
    );
    // one timer, not a tick: nothing counts down on screen
    clearTimeout(posterRest);
    if (resting) posterRest = setTimeout(drawPoster, view.dony.restingUntil - (Date.now() + offset) + 50);
  }

  // A tap posts in the background; the room's next message, which every
  // screen gets, is the answer. Without JS the form posts and the page comes
  // back with the result.
  let pendingTimer: ReturnType<typeof setTimeout> | undefined;
  document.addEventListener(
    "click",
    (e) => {
      const button = (e.target as Element).closest?.<HTMLButtonElement>(".map-panel .poster");
      if (!button) return;
      e.preventDefault();
      document.querySelector(".map-panel .poster-error")?.remove();
      if (button.getAttribute("aria-disabled") === "true") return;
      const form = document.querySelector<HTMLFormElement>("#dony")!;
      const body = new URLSearchParams([...new FormData(form, button)] as [string, string][]);
      button.classList.add("pending");
      button.setAttribute("aria-disabled", "true");
      const settle = () => {
        button.classList.remove("pending");
        drawPoster();
      };
      fetch(location.pathname, { method: "POST", body, headers: { "x-spotter": "poster" } })
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          // a tap that did nothing gets no message: stop waiting after 3 s
          clearTimeout(pendingTimer);
          pendingTimer = setTimeout(settle, 3000);
        })
        .catch(() => {
          settle();
          const error = Object.assign(document.createElement("p"), {
            className: "error poster-error",
            textContent: "Dony didn't hear you. Try again.",
          });
          error.setAttribute("role", "alert");
          button.closest(".map-panel")!.append(error);
          setTimeout(() => error.remove(), 8000);
        });
    },
    true,
  );

  const tileOf = (b: HTMLElement): Tile => [Number(b.style.getPropertyValue("--x")), Number(b.style.getPropertyValue("--y"))];
  function place(b: HTMLElement, [x, y]: Tile) {
    b.style.setProperty("--x", String(x));
    b.style.setProperty("--y", String(y));
  }
  // Steps an avatar along the aisles to its tile, one tile a step, showing the
  // walk and holding nothing, and puts it in its pose when it arrives; a new
  // target mid-walk sets off again from wherever it has got to (GYM-10.17,
  // GYM-10.18).
  const walks = new WeakMap<HTMLElement, { to: string; pose: string; timer: ReturnType<typeof setInterval> }>();
  function walk(b: HTMLElement, to: Tile, onStation: boolean, pose: string, then?: () => void) {
    const key = to.join(",");
    const going = walks.get(b);
    if (going?.to === key) {
      going.pose = pose; // same place, new pose: taken on arrival
      return;
    }
    if (going) clearInterval(going.timer);
    const arrive = () => {
      place(b, to);
      b.classList.toggle("on-station", onStation);
      show(b, walks.get(b)?.pose ?? pose);
      walks.delete(b);
      then?.();
      drawStations();
    };
    const path = route(tileOf(b), to);
    if (path.length === 0 || reducedMotion.matches || catchingUp) {
      walks.delete(b);
      place(b, to);
      b.classList.toggle("on-station", onStation);
      show(b, pose);
      then?.();
      return;
    }
    b.classList.remove("on-station");
    show(b, "walk");
    const timer = setInterval(() => {
      const next = path.shift();
      if (next) place(b, next);
      if (path.length === 0) {
        clearInterval(timer);
        arrive();
      }
    }, STEP_MS);
    walks.set(b, { to: key, pose, timer });
  }

  // GYM-1: the map at the largest whole-number scale that fits the panel and
  // the screen, so its pixels stay square
  function fitMap() {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map) return;
    const panel = map.closest<HTMLElement>(".map-panel")!;
    const style = getComputedStyle(panel);
    const width = panel.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    const bar = document.querySelector<HTMLElement>(".topbar")?.offsetHeight ?? 0;
    const size = 10 * TILE;
    const s = Math.max(1, Math.floor(Math.min(width / size, (innerHeight - bar - 48) / size)));
    map.style.setProperty("--s", String(s));
  }
  addEventListener("resize", fitMap);
  document.addEventListener("astro:page-load", fitMap);

  // your own avatar is a shortcut to the sheet's button (Done, Start set…)
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest?.(".map-panel .avatar.me");
    if (b) document.querySelector<HTMLElement>(".dock button.wide")?.focus();
  });

  // ---------- staying in place ----------
  // Everything that stays in this room swaps only the room, in place, so the
  // scroll, the focus and anything typed but not yet logged stay where they
  // were: logging, editing, deleting, the rest buttons, choosing a lift and
  // Start set (POSTs), and the pencil and Cancel (GETs). The client router would
  // load them as a new page and scroll to the top. Finish, Leave and End room
  // go to another page, so the router takes them. Without JS all of these
  // are plain forms and links.
  const STAY = new Set(["log", "edit", "delete", "rest", "choose", "start"]);

  // after() runs once the new room is in, and names the control to focus
  // (the request is not called `init`, which would hide init() below)
  async function swap(url: URL, request: RequestInit, fallback: () => void, after: () => HTMLElement | null) {
    const focused = !!document.activeElement?.closest(".gym");
    let res: Response;
    try {
      res = await fetch(url, request);
    } catch {
      return fallback(); // offline or dropped: let the browser try
    }
    // the room closed under us, or anything unexpected: go where it says
    if (new URL(res.url).pathname !== location.pathname || (res.status !== 200 && res.status !== 400)) {
      return navigate(res.url);
    }
    const next = new DOMParser().parseFromString(await res.text(), "text/html");
    const gym = next.querySelector(".gym");
    if (!gym) return navigate(res.url);
    // the map carries on as it is: everyone walks on from where they are
    // (GYM-10.16) rather than jumping to where the new page draws them
    const oldMap = document.querySelector(".gym .map-panel .map");
    const newMap = gym.querySelector(".map-panel .map");
    if (oldMap && newMap) {
      newMap.querySelectorAll(".avatar").forEach((b) => b.remove());
      newMap.append(...oldMap.querySelectorAll(".avatar"));
      // pops, bubbles, a banner, an open menu and a refusal carry on too
      for (const sel of [".pops", ".says", ".banner-slot"]) newMap.querySelector(sel)?.replaceWith(oldMap.querySelector(sel)!);
      newMap.append(...oldMap.querySelectorAll(":scope > .menu, :scope > .note, :scope > .error"));
      for (const div of oldMap.querySelectorAll<HTMLElement>(".station")) {
        newMap.querySelector(`.station[data-slot="${div.dataset.slot}"]`)?.replaceWith(div);
      }
    }
    // the room log is the server's again, with the menu's limits; an open
    // menu on the old page goes with it
    const opened = menuOn;
    closeMenu(false);
    document.querySelector(".gym")!.replaceWith(document.adoptNode(gym));
    if (opened) reopenMenu(opened);
    document.title = next.title;
    // keep the router's own history state, so Back still works
    if (res.url !== location.href) history.replaceState(history.state, "", res.url);
    posterDrawn = undefined;
    tick = init();
    tick();
    liveTick();
    const target = after();
    // keyboard and screen-reader users carry on from where they were
    if (focused) (document.querySelector<HTMLElement>(".sheet [aria-invalid]") ?? target)?.focus({ preventScroll: true });
  }

  const firstField = () => document.querySelector<HTMLElement>(".sheet form input:not([type=hidden]), .sheet select");

  // Done landed (a 400 has no stamp): say what was logged, and on a phone,
  // if the sheet's top was scrolled away, jump it back to just under the top
  function afterDone() {
    const stamp = document.querySelector<HTMLElement>(".dock .stamp");
    if (!stamp) return;
    const news = document.querySelector<HTMLElement>("#sheet-news");
    if (news) {
      news.textContent = "";
      setTimeout(() => (news.textContent = stamp.textContent!.replace(/\s+/g, " ").trim()), 50);
    }
    const top = document.querySelector<HTMLElement>(".sheet")!.getBoundingClientRect().top;
    if (matchMedia("(max-width: 899px)").matches && top < 24) scrollBy({ top: top - 24, behavior: "instant" });
    // a reload shouldn't stamp the same set again
    const url = new URL(location.href);
    url.searchParams.delete("rested");
    history.replaceState(history.state, "", url);
  }

  document.addEventListener(
    "submit",
    (e) => {
      const form = e.target as HTMLFormElement;
      if (!form.closest(".gym")) return;
      // not form.action or form.method: these forms have a field named "action", which shadows it
      const url = new URL(form.getAttribute("action") ?? "", location.href);
      const data = new FormData(form, e.submitter);
      if ((form.getAttribute("method") ?? "get").toLowerCase() === "get") {
        url.search = new URLSearchParams([...data] as [string, string][]).toString();
        e.preventDefault();
        return swap(url, {}, () => location.assign(url), firstField);
      }
      const action = String(data.get("action") ?? "log");
      if (!STAY.has(action)) return;
      e.preventDefault(); // the form's own listeners still run: pending, the stopwatch

      // what was typed and not logged, to put back after a rest button
      const typed = new Map<string, string>();
      if (action === "rest") {
        for (const input of document.querySelectorAll<HTMLInputElement>(".set-form input:not([type=hidden])")) {
          typed.set(input.id, input.value);
        }
      }
      const delta = (e.submitter as HTMLButtonElement | null)?.value;
      swap(url, { method: "POST", body: new URLSearchParams([...data] as [string, string][]) }, () => form.submit(), () => {
        for (const [id, value] of typed) {
          const input = document.querySelector<HTMLInputElement>(`.set-form #${id}`);
          if (input && !input.readOnly) input.value = value;
        }
        if (action === "log") afterDone();
        return action === "rest"
          ? document.querySelector<HTMLElement>(`.rest-adjust button[value="${delta}"]`)
          : document.querySelector<HTMLElement>(".sheet .wide");
      });
    },
    true,
  );

  // ======================================================================
  // Interactions, presets and emoji (criteria/int.md; room spec I.2 to I.9)
  // ======================================================================
  // Everything here is a second layer over the room: it never sits between
  // the person and their set. Moves are posted in the background and answered
  // in JSON; what plays comes from the room's stream, so a screen only ever
  // plays what the server accepted (INT-3.10).

  const meId = () => Number(document.querySelector<HTMLElement>(".map-panel .map")?.dataset.me);
  const phone = matchMedia("(max-width: 899px)");
  const tpl = (name: string) =>
    document.querySelector<HTMLTemplateElement>(`template[data-part="${name}"]`)!.content.cloneNode(true) as DocumentFragment;
  // someone in the room, from the newest message, or before the first one
  // arrives (or with the stream down) from the room as the server drew it
  type Someone = { id: number; name: string; state: State; away: boolean; look?: Look; dony?: true };
  function personIn(id: number): Someone | undefined {
    if (view) {
      const m = everyone(view).find((m) => m.id === id) as MemberView | undefined;
      if (!m) return undefined;
      return { id: m.id, name: m.name, state: stateAt(m, nowServer()), away: m.away, ...("dony" in m ? { dony: true as const } : { look: m.look }) };
    }
    const b = avatarOf(id);
    const row = document.querySelector<HTMLElement>(`.people li[data-id="${id}"]`);
    if (!b) return undefined;
    const look = row?.dataset.look ?? b.dataset.look;
    return {
      id,
      name: b.querySelector(".tag .nm")?.textContent ?? "",
      state: b.dataset.state as State,
      away: b.classList.contains("away"),
      ...(look === "dony" ? { dony: true as const } : { look: lookFromKey(look) ?? undefined }),
    };
  }
  const avatarOf = (id: number) => document.querySelector<HTMLElement>(`.map-panel .avatar[data-id="${id}"]:not(.leaving)`);
  const nowServer = () => Date.now() + offset;

  // someone's head, as their squad row draws it
  function head(m: Someone): DocumentFragment {
    const h = tpl(m.dony ? "dony-head" : "head");
    if (!m.dony && m.look) {
      const svg = h.querySelector("svg")!;
      svg.setAttribute("style", lookVars(m.look));
      svg.dataset.hair = m.look.hair;
    }
    return h;
  }

  // the copy bank's words (system.md section 3)
  const REFUSED: Record<Refusal, (name: string) => string> = {
    "target-lifting": (n) => `${n} is mid-set. Cheer instead?`,
    "target-finished": (n) => `${n}'s done for today. Cheer instead?`,
    gone: (n) => `${n}'s left the gym.`,
    "rate-limit": () => "Easy, give them 10 seconds.",
    self: () => "",
  };
  const FAILED = "That didn't send. Try again.";

  // Posts a move as the page's forms would, and reads the JSON answer.
  async function send(fields: Record<string, string>): Promise<{ ok: true; at: number } | { ok: false; reason: Refusal | "failed" }> {
    try {
      const res = await fetch(location.pathname, { method: "POST", body: new URLSearchParams(fields) });
      const body = res.headers.get("content-type")?.includes("json") ? await res.json() : null;
      if (body && typeof body.ok === "boolean") return body;
      return { ok: false, reason: "failed" };
    } catch {
      return { ok: false, reason: "failed" };
    }
  }

  // ---------- the menu (INT-1, INT-2; I.2) ----------
  let menuOn: { id: number; from: "map" | "row" } | undefined;
  // INT-4.7: when your 10 s on each person run out, from the page, then
  // from each accepted interaction
  let limits = new Map<number, number>();
  const readLimits = () => {
    const gym = document.querySelector<HTMLElement>(".gym");
    limits = new Map(Object.entries(JSON.parse(gym?.dataset.limits ?? "{}")).map(([k, v]) => [Number(k), Number(v)]));
  };
  let limitTimer: ReturnType<typeof setTimeout> | undefined;
  const menuEl = () => document.querySelector<HTMLElement>(".menu");
  const opener = () =>
    menuOn &&
    (menuOn.from === "row"
      ? document.querySelector<HTMLElement>(`.people li[data-id="${menuOn.id}"] > .person`)
      : avatarOf(menuOn.id));

  // By keyboard (Enter or Space on the avatar or row), focus moves into the
  // menu (INT-1.2); a tap or click leaves it on the avatar, as before, and the
  // menu's own keys still work from there (INT-1.1).
  function openMenu(id: number, from: "map" | "row", byKeyboard = true) {
    if (id === meId() || !personIn(id)) return;
    closeMenu(false);
    menuOn = { id, from };
    const menu = tpl("menu").firstElementChild as HTMLElement;
    const map = document.querySelector<HTMLElement>(".map-panel .map")!;
    map.append(menu);
    drawMenu();
    placeMenu();
    for (const el of [avatarOf(id), document.querySelector(`.people li[data-id="${id}"] > .person`)]) el?.setAttribute("aria-expanded", "true");
    if (byKeyboard) (menu.querySelector<HTMLElement>(".act.hot:not([aria-disabled])") ?? menu.querySelector<HTMLElement>(".act"))!.focus({ preventScroll: true });
  }
  // after a swap: the same person, if they're still here
  function reopenMenu(was: { id: number; from: "map" | "row" }) {
    if (personIn(was.id)) openMenu(was.id, was.from);
  }

  function closeMenu(refocus = true) {
    const menu = menuEl();
    if (!menu) return void (menuOn = undefined);
    const back = opener();
    menu.remove();
    clearTimeout(limitTimer);
    document.querySelectorAll('[aria-haspopup="menu"][aria-expanded="true"]').forEach((el) => el.setAttribute("aria-expanded", "false"));
    menuOn = undefined;
    if (refocus) back?.focus({ preventScroll: true });
  }

  // The menu as the newest room message has it: the person's head, name and
  // state, which move fits, and why anything is unavailable (INT-1.6).
  function drawMenu() {
    const menu = menuEl();
    if (!menu || !menuOn) return;
    const m = personIn(menuOn.id);
    if (!m) {
      // they left (INT-1.7): focus the next avatar in tab order, else the dock's button
      const avatars = [...document.querySelectorAll<HTMLElement>(".map-panel .avatar:not(.leaving):not(.me)")];
      const was = menuOn.id;
      closeMenu(false);
      const next = avatars.find((a) => Number(a.dataset.id) !== was);
      (next ?? document.querySelector<HTMLElement>(".dock button.wide"))?.focus({ preventScroll: true });
      return;
    }
    const state = m.state;
    const who = menu.querySelector<HTMLElement>(".menu-who")!;
    const key = `${m.id}|${m.dony ? "dony" : m.look ? lookKey(m.look) : ""}`;
    if (who.dataset.key !== key) {
      who.querySelector(".av")?.remove();
      who.prepend(head(m));
      who.dataset.key = key;
    }
    const name = menu.querySelector<HTMLElement>(".menu-name")!;
    const chips = document.createElement("span");
    chips.className = "chips";
    const chip = document.createElement("span");
    chip.className = `chip state-${state}`;
    chip.append(tpl(state), STATE_WORD[state]);
    chips.append(chip);
    if (m.away) {
      const away = document.createElement("span");
      away.className = "chip away";
      away.append(tpl("away"), "Away");
      chips.append(away);
    }
    name.replaceChildren(m.name, chips);
    menu.querySelector(".menu-to")!.textContent = `To ${m.name}`;

    const limited = (limits.get(m.id) ?? 0) > nowServer();
    const slapNo = slapRefusal(state);
    const hot = state === "slacking" ? ["poke", "slap"] : state === "lifting" ? ["cheer"] : [];
    for (const b of menu.querySelectorAll<HTMLButtonElement>(".act")) {
      const kind = b.value;
      const off = kind !== "message" && (limited || (kind === "slap" && !!slapNo));
      if (off) b.setAttribute("aria-disabled", "true");
      else b.removeAttribute("aria-disabled");
      b.classList.toggle("hot", hot.includes(kind) && !off);
    }
    const why = menu.querySelector<HTMLElement>(".menu-why")!;
    const text = limited ? REFUSED["rate-limit"](m.name) : slapNo ? REFUSED[slapNo](m.name) : "";
    why.textContent = text;
    why.hidden = !text;
    // back by themselves when the 10 s run out, without reopening
    clearTimeout(limitTimer);
    if (limited) limitTimer = setTimeout(drawMenu, limits.get(m.id)! - nowServer() + 20);
  }

  // Laptop: beside the avatar (the side away from the nearer wall), or
  // under the squad row. Phone: CSS pins it above the dock.
  function placeMenu() {
    const menu = menuEl();
    const from = opener();
    if (!menu || !from || phone.matches) {
      if (menu) {
        menu.style.left = menu.style.top = "";
        document.documentElement.style.setProperty("--dock-h", `${document.querySelector<HTMLElement>(".dock")?.offsetHeight ?? 92}px`);
      }
      return;
    }
    const map = menu.parentElement!.getBoundingClientRect();
    const r = from.getBoundingClientRect();
    if (menuOn?.from === "row") {
      menu.style.left = `${r.left - map.left}px`;
      menu.style.top = `${r.bottom - map.top + 8}px`;
      return;
    }
    const tag = from.querySelector(".tag")?.getBoundingClientRect() ?? r;
    const left = Math.min(r.left, tag.left);
    const right = Math.max(r.right, tag.right);
    const west = r.left + r.width / 2 > map.left + map.width / 2;
    const x = west ? left - map.left - menu.offsetWidth - 16 : right - map.left + 16;
    const top = Math.min(Math.max(0, r.top - map.top), Math.max(0, map.height - menu.offsetHeight));
    menu.style.left = `${Math.max(-map.left + 8, x)}px`;
    menu.style.top = `${top}px`;
  }
  addEventListener("resize", () => placeMenu());

  // the message view, and back
  function showMessages(on: boolean) {
    const menu = menuEl();
    if (!menu) return;
    menu.querySelector<HTMLElement>(".menu-acts")!.hidden = on;
    menu.querySelector<HTMLElement>(".menu-why")!.hidden = on || !menu.querySelector(".menu-why")!.textContent;
    menu.querySelector<HTMLElement>(".menu-message")!.hidden = !on;
    menu.querySelector<HTMLElement>(on ? ".preset" : '.act[value="message"]')!.focus({ preventScroll: true });
    if (!on) drawMenu();
  }

  // A refusal (dashed) or a failure (red) where the menu was: beside the
  // target on a laptop, just above the dock on a phone (INT-3.14).
  function tell(text: string, failed: boolean, near: number | undefined, className = "") {
    document.querySelectorAll(`.gym .note, .gym .error${className ? "" : ":not(.emote-error)"}`).forEach((n) => {
      if (!className || n.classList.contains(className)) n.remove();
    });
    const line = document.createElement("p");
    line.className = [failed ? "error" : "note", className].filter(Boolean).join(" ");
    line.setAttribute("role", failed ? "alert" : "status");
    line.textContent = text;
    const target = near !== undefined ? avatarOf(near) : null;
    if (!phone.matches && target && !className) {
      const map = document.querySelector<HTMLElement>(".map-panel .map")!;
      map.append(line);
      const m = map.getBoundingClientRect();
      const r = target.getBoundingClientRect();
      const west = r.left + r.width / 2 > m.left + m.width / 2;
      line.style.top = `${Math.max(0, r.top - m.top + 8)}px`;
      line.style.left = west ? `${r.left - m.left - line.offsetWidth - 12}px` : `${r.right - m.left + 12}px`;
    } else document.querySelector(".dock")!.append(line);
    setTimeout(() => line.remove(), 4000);
  }

  let sending = false;
  async function act(kind: string) {
    if (!menuOn) return;
    const id = menuOn.id;
    const m = personIn(id);
    closeMenu(); // at once (INT-3.10)
    if (sending) return; // a double tap sends one (INT-4.5)
    sending = true;
    const r = await send({ action: "interact", to: String(id), kind });
    sending = false;
    if (r.ok) limits.set(id, r.at + 10_000);
    else if (r.reason === "failed") tell(FAILED, true, id);
    else if (r.reason !== "self") {
      if (r.reason === "rate-limit") limits.set(id, Math.max(limits.get(id) ?? 0, nowServer() + 1000));
      tell(REFUSED[r.reason](m?.name ?? "They"), false, id);
    }
  }

  async function sayPreset(preset: string) {
    if (!menuOn) return;
    const id = menuOn.id;
    const m = personIn(id);
    closeMenu();
    const r = await send({ action: "say", to: String(id), preset });
    // a preset refused for its 2 s shows nothing: the first one went (I.3)
    if (!r.ok && r.reason === "failed") tell(FAILED, true, id);
    else if (!r.ok && (r.reason === "gone" || r.reason === "target-lifting" || r.reason === "target-finished")) {
      tell(REFUSED[r.reason](m?.name ?? "They"), false, id);
    }
  }

  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    const menu = menuEl();
    const actButton = t.closest?.<HTMLButtonElement>(".menu .act");
    if (actButton) {
      if (actButton.getAttribute("aria-disabled") === "true") return; // stays open, sends nothing
      if (actButton.value === "message") return showMessages(true);
      return void act(actButton.value);
    }
    if (t.closest?.(".menu .back")) return showMessages(false);
    const preset = t.closest?.<HTMLButtonElement>(".menu .preset");
    if (preset) return void sayPreset(preset.value);
    if (t.closest?.(".menu")) return;
    const other = t.closest?.<HTMLElement>(".map-panel .avatar:not(.me):not(.leaving)");
    const row = t.closest?.<HTMLElement>(".people .person");
    if (other || row) {
      const id = Number((other ?? row!.closest("li"))!.dataset.id);
      if (menu && menuOn?.id === id) return closeMenu();
      // Enter or Space on a button clicks it with a detail of 0
      return openMenu(id, other ? "map" : "row", (e as MouseEvent).detail === 0);
    }
  });
  // a tap anywhere outside closes the menu, and isn't swallowed (INT-1.3)
  document.addEventListener(
    "pointerdown",
    (e) => {
      const t = e.target as Element;
      if (menuEl() && !t.closest?.(".menu") && !t.closest?.(".map-panel .avatar:not(.me)") && !t.closest?.(".people .person")) {
        closeMenu(false);
      }
      if (!t.closest?.(".tray") && !t.closest?.(".dock .emote")) closeTray(false);
    },
    true,
  );

  // Keyboard (INT-1.2): Tab, Shift+Tab and the arrows go round the rows and
  // wrap; Home and End; Escape closes, from Message it goes Back first.
  document.addEventListener("keydown", (e) => {
    const menu = menuEl();
    if (!menu) return;
    if (!menu.contains(document.activeElement)) {
      if (e.key === "Escape") closeMenu();
      // opened by a tap, focus still on its opener: the menu's keys take it in
      else if (document.activeElement === opener() && ["Tab", "ArrowDown", "ArrowUp"].includes(e.key)) {
        e.preventDefault();
        menu.querySelector<HTMLElement>(".act")!.focus({ preventScroll: true });
      }
      return;
    }
    const rows = [...menu.querySelectorAll<HTMLElement>(menu.querySelector<HTMLElement>(".menu-message")!.hidden ? ".act" : ".back, .preset")];
    const i = rows.indexOf(document.activeElement as HTMLElement);
    const go = (j: number) => {
      e.preventDefault();
      rows[(j + rows.length) % rows.length].focus({ preventScroll: true });
    };
    if (e.key === "Escape") {
      e.preventDefault();
      if (!menu.querySelector<HTMLElement>(".menu-message")!.hidden) showMessages(false);
      else closeMenu();
    } else if (e.key === "Tab") go(e.shiftKey ? i - 1 : i + 1);
    else if (e.key === "ArrowDown") go(i + 1);
    else if (e.key === "ArrowUp") go(i - 1);
    else if (e.key === "Home") go(0);
    else if (e.key === "End") go(rows.length - 1);
  });

  // ---------- reactions and banners (INT-3; I.4, I.5) ----------
  const FX_FRAMES: Record<Kind, number> = { cheer: 3, poke: 3, slap: 4 };
  const FX_MS: Record<Kind, number> = { cheer: 600, poke: 720, slap: 800 };
  const SVG = "http://www.w3.org/2000/svg";
  function react(id: number, kind: Kind) {
    const b = avatarOf(id);
    if (!b) return;
    b.querySelector("svg.fx")?.remove();
    const fx = document.createElementNS(SVG, "svg");
    fx.setAttribute("class", `fx fx-${kind}`);
    fx.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    fx.setAttribute("aria-hidden", "true");
    // reduced motion: the middle frame alone, still (INT-3.9)
    const frames = reducedMotion.matches ? [2] : Array.from({ length: FX_FRAMES[kind] }, (_, i) => i + 1);
    for (const n of frames) {
      const use = document.createElementNS(SVG, "use");
      use.setAttribute("href", `#fx-${kind}-${n}`);
      fx.append(use);
    }
    b.append(fx);
    setTimeout(() => fx.remove(), reducedMotion.matches ? 800 : FX_MS[kind]);
  }

  const BANNER: Record<Kind, (from: string, resting: boolean) => string> = {
    cheer: (n) => `${n} is hyping you up 🔥`,
    poke: (n, resting) => (resting ? `${n} poked you. Rest's over? 👉` : `${n} poked you 👉`),
    slap: (n) => `${n} slapped you back to work 👋`,
  };
  let bannerTimer: ReturnType<typeof setTimeout> | undefined;
  function banner(text: string, from: number) {
    const slot = document.querySelector<HTMLElement>(".map-panel .banner-slot");
    if (!slot) return;
    const p = document.createElement("p");
    p.className = "banner";
    p.setAttribute("role", "status");
    const sender = personIn(from);
    if (sender) p.append(head(sender));
    const words = document.createElement("span");
    words.textContent = text;
    p.append(words);
    // the newest replaces the last and runs its own 4 s (D9); a new element,
    // so its animation starts again
    slot.replaceChildren(p);
    clearTimeout(bannerTimer);
    bannerTimer = setTimeout(() => p.remove(), 4000);
  }

  type Who = { id: number; name: string };
  function onInteraction(e: { kind: Kind; from: Who; to: Who; targetState: string; at: number }) {
    react(e.to.id, e.kind);
    if (e.to.id === meId()) banner(BANNER[e.kind](e.from.name, e.targetState === "resting" || e.targetState === "slacking"), e.from.id);
    if (e.from.id === meId()) limits.set(e.to.id, e.at + 10_000);
    addLog({ kind: e.kind, from: e.from, to: e.to, at: e.at });
    if (menuOn) drawMenu();
  }

  // ---------- preset bubbles (INT-5; I.6) ----------
  const bubbleTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
  function bubble(from: number, to: string, text: string, at: number) {
    const says = document.querySelector<HTMLElement>(".map .says");
    const b = avatarOf(from);
    const left = at + 5000 - nowServer();
    if (!says || !b || left <= 0) return;
    // a newer one from the same sender replaces theirs (INT-5.5)
    says.querySelector(`.say[data-id="${from}"]`)?.remove();
    const p = document.createElement("p");
    p.className = "say";
    p.dataset.id = String(from);
    const name = document.createElement("span");
    name.className = "to";
    name.textContent = `@${to}`;
    p.append(name, text);
    says.append(p); // the newer draws on top (D19)
    placeBubble(p);
    bubbleTimers.set(p, setTimeout(() => p.remove(), left));
  }
  function placeBubble(p: HTMLElement) {
    const b = avatarOf(Number(p.dataset.id));
    if (!b) return p.remove();
    const [x, y] = tileOf(b);
    p.style.setProperty("--x", String(x));
    p.style.setProperty("--y", String(y));
    p.style.setProperty("--dy", b.classList.contains("on-station") && !b.classList.contains("on-machine") ? "0.375" : "0");
    p.classList.toggle("below", y <= 1);
    p.classList.toggle("west", x <= 2);
    p.classList.toggle("east", x >= 7);
    p.classList.toggle("over-pop", y > 1 && !!document.querySelector(`.map .pops .pop[data-id="${p.dataset.id}"]`));
  }

  function onSay(e: { preset: string; text: string; from: Who; to: Who; at: number }) {
    const me = meId();
    bubble(e.from.id, e.to.name, e.text, e.at);
    addLog({ kind: "say", from: e.from, to: e.to, text: e.text, at: e.at });
    // only the addressee hears it, once (INT-5.11); you hear your own
    const news = document.querySelector<HTMLElement>("#sheet-news");
    const line = e.to.id === me ? `${e.from.name}: ${e.text}` : e.from.id === me ? `Sent to ${e.to.name}: ${e.text}` : "";
    if (news && line) {
      news.textContent = "";
      setTimeout(() => (news.textContent = line), 50);
    }
  }

  // ---------- emoji pops (INT-8, BOT-6; I.8) ----------
  function onEmote(e: { emoji: string; from: Who; at: number }) {
    const pops = document.querySelector<HTMLElement>(".map .pops");
    const b = avatarOf(e.from.id);
    if (!pops || !b) return;
    pops.querySelector(`.pop[data-id="${e.from.id}"]`)?.remove();
    const pop = document.createElementNS(SVG, "svg");
    pop.setAttribute("class", "pop");
    pop.setAttribute("viewBox", "0 0 16 16");
    pop.dataset.id = String(e.from.id);
    const use = document.createElementNS(SVG, "use");
    use.setAttribute("href", `#em-${e.emoji}`);
    pop.append(use);
    pops.append(pop);
    placePop(pop);
    setTimeout(() => pop.remove(), 3000);
    document.querySelectorAll<HTMLElement>(`.map .says .say[data-id="${e.from.id}"]`).forEach(placeBubble);
  }
  function placePop(pop: SVGElement) {
    const b = avatarOf(Number(pop.dataset.id));
    if (!b) return pop.remove();
    const [x, y] = tileOf(b);
    pop.style.setProperty("--x", String(x));
    pop.style.setProperty("--y", String(y));
    pop.style.setProperty("--dy", b.classList.contains("on-station") && !b.classList.contains("on-machine") ? "0.375" : "0");
    pop.style.setProperty("--tag-w", `${b.querySelector<HTMLElement>(".tag")?.offsetWidth ?? TILE}px`);
    pop.classList.toggle("beside", y <= 1);
    pop.classList.toggle("west-side", y <= 1 && x >= 6);
  }
  // Pops and bubbles go where their senders go, and with them (INT-8.15)
  function followSenders() {
    document.querySelectorAll<SVGElement>(".map .pops .pop").forEach(placePop);
    document.querySelectorAll<HTMLElement>(".map .says .say").forEach(placeBubble);
  }
  // walks move avatars between room messages: keep up, cheaply
  setInterval(() => {
    if (document.querySelector(".map .pops .pop, .map .says .say")) followSenders();
  }, 125);

  // ---------- the emoji tab and tray (INT-8; I.7) ----------
  const tab = () => document.querySelector<HTMLButtonElement>(".dock .emote");
  const tray = () => document.querySelector<HTMLElement>(".tray");
  let coolUntil = 0;
  let coolTimer: ReturnType<typeof setTimeout> | undefined;
  function openTray() {
    const t = tray();
    if (!t) return;
    closeMenu(false);
    t.hidden = false;
    tab()!.setAttribute("aria-expanded", "true");
    t.toggleAttribute("data-cooling", Date.now() < coolUntil);
    t.querySelector<HTMLElement>("button")!.focus({ preventScroll: true });
  }
  function closeTray(refocus = true) {
    const t = tray();
    if (!t || t.hidden) return;
    t.hidden = true;
    tab()?.setAttribute("aria-expanded", "false");
    if (refocus) tab()?.focus({ preventScroll: true });
  }
  // the tab wears what you sent for the second you can't send another
  // (INT-8.6, INT-8.22); pending at half while the request is out
  function wear(emoji: string | null, pending = false) {
    const t = tab();
    if (!t) return;
    if (!t.dataset.icon) t.dataset.icon = t.innerHTML;
    if (emoji) {
      t.innerHTML = `<svg viewBox="0 0 16 16" width="32" height="32" aria-hidden="true"><use href="#em-${emoji}"/></svg>`;
      t.setAttribute("aria-label", `Send an emoji (sent: ${emoji})`);
      t.setAttribute("aria-disabled", "true");
    } else {
      t.innerHTML = t.dataset.icon;
      t.setAttribute("aria-label", "Send an emoji");
      t.removeAttribute("aria-disabled");
    }
    t.classList.toggle("pending", pending);
  }
  async function sendEmoji(emoji: string) {
    if (Date.now() < coolUntil) return; // nothing within the second (INT-8.8)
    closeTray();
    coolUntil = Date.now() + 1000;
    wear(emoji, true);
    const r = await send({ action: "emote", emoji });
    clearTimeout(coolTimer);
    if (r.ok) {
      wear(emoji);
      const news = document.querySelector<HTMLElement>("#sheet-news");
      if (news) {
        news.textContent = "";
        setTimeout(() => (news.textContent = `Sent: ${emoji}`), 50);
      }
      coolTimer = setTimeout(() => wear(null), Math.max(0, coolUntil - Date.now()));
    } else {
      coolUntil = 0;
      wear(null);
      if (r.reason === "failed") tell(FAILED, true, undefined, "emote-error");
    }
  }
  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest?.(".dock .emote")) {
      if (tab()!.getAttribute("aria-disabled") === "true") return;
      return tray()?.hidden ? openTray() : closeTray();
    }
    const b = t.closest?.<HTMLButtonElement>(".tray button");
    if (b) void sendEmoji(b.value);
  });
  // Keyboard (INT-8.12): arrows move in the 4 x 2 grid, Escape closes
  document.addEventListener("keydown", (e) => {
    const t = tray();
    if (!t || t.hidden || !t.contains(document.activeElement)) return;
    const buttons = [...t.querySelectorAll<HTMLElement>("button")];
    const i = buttons.indexOf(document.activeElement as HTMLElement);
    const row = Math.floor(i / 4);
    const go = (j: number) => {
      e.preventDefault();
      buttons[j].focus({ preventScroll: true });
    };
    if (e.key === "Escape") {
      e.preventDefault();
      closeTray();
    } else if (e.key === "ArrowRight") go(row * 4 + ((i % 4) + 1) % 4);
    else if (e.key === "ArrowLeft") go(row * 4 + ((i % 4) + 3) % 4);
    else if (e.key === "ArrowDown" || e.key === "ArrowUp") go((i + 4) % 8);
  });

  // ---------- the room log (INT-5.8; I.9) ----------
  // New lines arrive at the top within a second, quietly; the newest 50 are
  // kept, five showing and the rest behind "Show older".
  function addLog(entry: LogEntry) {
    const panel = document.querySelector<HTMLElement>(".room-log");
    if (!panel) return;
    const shown = panel.querySelector<HTMLOListElement>(":scope > ol")!;
    const older = panel.querySelector<HTMLDetailsElement>(".older")!;
    const olderList = older.querySelector("ol")!;
    const me = Number(shown.dataset.me);
    const li = document.createElement("li");
    li.dataset.at = String(entry.at);
    li.classList.toggle("you", entry.from.id === me || entry.to.id === me);
    li.append(tpl(`log-${entry.kind}`));
    const l = logLine(entry, me);
    const line = document.createElement("span");
    line.className = "line";
    if (l.text !== undefined) {
      const to = document.createElement("span");
      to.className = "to";
      to.textContent = l.to!;
      line.append(`${l.who} `, to, ` "${l.text}"`);
    } else line.append(l.who + l.rest);
    const t = document.createElement("span");
    t.className = "t";
    t.textContent = ago(entry.at, nowServer());
    li.append(line, t);
    shown.prepend(li);
    panel.querySelector(".empty")?.remove();
    // INT-5.23: "You walked in" once there are lines on both sides of it,
    // above the first line from before you came
    const joined = Number(shown.dataset.joined);
    if (shown.dataset.joined && entry.at >= joined && !panel.querySelector("li.joined")) {
      const before = [...panel.querySelectorAll<HTMLElement>("li[data-at]")].find((x) => Number(x.dataset.at) < joined);
      if (before) {
        const line = document.createElement("li");
        line.className = "joined";
        line.textContent = shown.dataset.joinedText ?? "";
        before.before(line);
      }
    }
    // keep five showing (the "You walked in" line rides along), the rest older
    const rows = () => [...shown.children].filter((c) => !c.classList.contains("joined"));
    while (rows().length > 5) olderList.prepend(shown.lastElementChild!);
    if (shown.lastElementChild?.classList.contains("joined")) olderList.prepend(shown.lastElementChild);
    const all = [...shown.children, ...olderList.children].filter((c) => !c.classList.contains("joined"));
    for (const extra of all.slice(50)) extra.remove();
    const n = [...olderList.children].filter((c) => !c.classList.contains("joined")).length;
    older.hidden = n === 0;
    older.querySelector("summary")!.textContent = `Show older (${n} more)`;
  }
  // the times on the right move on by themselves
  setInterval(() => {
    for (const li of document.querySelectorAll<HTMLElement>(".room-log li[data-at]")) {
      const t = li.querySelector(".t");
      if (t) t.textContent = ago(Number(li.dataset.at), nowServer());
    }
  }, 30_000);

  // ---------- on each room shown ----------
  // a bubble still within its 5 s shows for its time left (INT-5.6)
  document.addEventListener("astro:page-load", () => {
    readLimits();
    closeMenu(false);
    const gym = document.querySelector<HTMLElement>(".gym");
    if (!gym) return;
    for (const e of JSON.parse(gym.dataset.says ?? "[]") as Extract<LogEntry, { kind: "say" }>[]) {
      const at = e.at;
      // the room's people are only placed once the first message is in
      const show = () => bubble(e.from.id, e.to.name, e.text, at);
      if (avatarOf(e.from.id)) show();
      else setTimeout(show, 300);
    }
  });

  document.addEventListener(
    "click",
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element).closest?.<HTMLAnchorElement>("a[href]");
      if (!link?.closest(".gym")) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
      e.preventDefault();
      swap(url, {}, () => location.assign(url), firstField);
    },
    true,
  );
</script>

<style>
  /* .panel: the Night card (system 9). Lives here until another Night page
     needs it, then moves to the layout. Global, so the map's panel
     (GymMap.astro) is one too. */
  :global(.gym .panel) {
    position: relative;
    margin: 0 0 2rem;
    padding: 1.5rem 1.25rem 1.25rem;
    background: var(--panel);
    border: var(--px) solid var(--edge);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  :global(.gym .panel > :last-child) {
    margin-bottom: 0;
  }
  /* the panel's name sits on its top border, like an RPG menu box */
  .panel-title {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 16px;
    line-height: 1.5;
    color: var(--leaf);
    background: var(--panel);
  }
  /* the workout clock rides the sheet's top border, on the right, across
     from your state tab, so it's on screen from the moment you walk in */
  .panel-clock {
    display: flex;
    align-items: center;
    gap: var(--px);
    position: absolute;
    top: calc(var(--px) * -0.5);
    right: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 24px;
    line-height: 1;
    color: var(--leaf);
    background: var(--panel);
    font-variant-numeric: tabular-nums;
  }
  :global(.gym .vh) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phones: map, sheet, squad, log, room, top to bottom; only the sheet's
     dock (its primary button) is pinned. Laptops: two columns, the sheet
     alone on the right. */
  .gym {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .gym {
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: 2rem;
      align-items: start;
    }
    .gym > .sheet {
      grid-column: 2;
      grid-row: 1 / span 4;
      position: sticky;
      top: 2rem;
    }
  }

  /* ---------- the gym sign: passcode, spots, room actions ---------- */
  .sign .passcode-box {
    margin-bottom: 0.75rem;
  }
  .spots {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .pips {
    display: flex;
    gap: var(--px);
  }
  .pips i {
    width: calc(var(--px) * 2);
    height: calc(var(--px) * 3);
    background: var(--night);
    box-shadow: inset 0 0 0 2px var(--edge);
  }
  .pips i.in {
    background: var(--leaf);
    box-shadow: none;
  }
  .room-actions {
    margin-top: 0.75rem;
  }
  .room-actions form {
    margin: 0;
  }
  .sign .leave-note {
    margin: 0.25rem 0 0;
  }
  /* room and logbook actions: secondary, and quieter than anything in the
     sheet, so they never compete with Done (system 8) */
  .button.quiet {
    padding: 0.75rem 1rem;
    font-size: 8px;
  }

  /* ---------- one confirm pattern: End room, Delete set ----------
     The summary is the first tap; it turns into Cancel in place, so a
     second tap on the same spot backs out. Works without JS. */
  .confirm > summary {
    list-style: none;
  }
  .confirm > summary::-webkit-details-marker {
    display: none;
  }
  .confirm .if-open,
  .confirm[open] .if-closed {
    display: none;
  }
  .confirm[open] .if-open {
    display: inline;
  }
  /* a confirm always sits alone on its row, so opening it moves nothing */
  .confirm {
    margin: 0.75rem 0 0;
  }
  .confirm-box {
    margin: 0.75rem 0 0;
    padding: 1rem;
    background: var(--night);
    border: var(--px) solid var(--paper);
  }
  .confirm-box p {
    margin: 0 0 0.75rem;
  }

  /* ---------- the connection (GYM-13): Live, or Reconnecting ----------
     On the map's top border, opposite its sign (GymMap draws it, the script
     swaps it, so these reach it globally). */
  :global(.map-panel .conn) {
    position: absolute;
    top: calc(var(--px) * -0.5);
    right: 0.75rem;
    z-index: 20;
    transform: translateY(-50%);
    margin: 0;
    line-height: 1;
  }
  :global(.map-panel .conn .badge) {
    margin: 0;
    padding: 0.25rem 0.5rem;
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.conn .lost) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    font: 20px/28px var(--body);
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.conn .lost svg) {
    color: var(--dim);
  }

  /* ---------- people list (GYM-15): the room, in words ----------
     Same row as home's "What your squad sees": head, name over what
     they're doing, state chip on the right. */
  .people {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people :global(li) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border-top: var(--px) solid var(--night);
  }
  .people :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .people :global(li:last-child) {
    padding-bottom: 0;
  }
  /* the head crop of the avatar, as on home: 32 x 20 sprite pixels at 2x */
  .people :global(.av) {
    width: 64px;
    height: 40px;
  }
  .people :global(li.away .av) {
    opacity: 0.5;
  }
  .people :global(.who) {
    line-height: 1.2;
  }
  .people :global(.what) {
    display: block;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .people :global(.n) {
    white-space: nowrap;
  }
  .people :global(.badge) {
    margin: 0 0 0 0.25rem;
  }
  .people :global(.chips) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--px);
  }
  /* Away isn't a colour: a dashed chip with the phone-off icon */
  .people :global(.chip.away) {
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
  }
  .badge.host {
    color: var(--paper);
    background: var(--night);
    border-color: var(--edge);
  }
  .room-link {
    color: var(--paper);
    overflow-wrap: anywhere;
  }
  .alone {
    margin: 0.75rem 0 0;
  }

  /* ---------- this workout: a logbook page ---------- */
  .tally {
    margin: 0 0 1rem;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .tally b {
    font-weight: 400;
    color: var(--paper);
  }
  /* repeat lift names become ditto marks, like a paper logbook */
  .ditto {
    padding-left: 1.5rem;
    color: var(--dim);
  }
  /* one column per set, written the way a lifter writes it */
  .log td.set {
    white-space: nowrap;
  }
  .log .u {
    color: var(--dim);
  }
  .log .sub {
    display: block;
    font-size: 20px;
    line-height: 1.1;
    color: var(--dim);
  }
  .log th.fix,
  .log td.fix {
    width: 44px;
    padding: 0;
  }
  /* :global(.night): <body> carries it, outside this page's scope; the
     prefix out-ranks the layout's Night link and heading colours */
  :global(.night) .log .fix a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--leaf);
  }
  .log tr[aria-current="true"] td {
    background: var(--night);
  }
  .log tr[aria-current="true"] td:first-child {
    box-shadow: inset var(--px) 0 0 var(--leaf);
  }
  :global(.night) .log tr[aria-current="true"] .fix a {
    color: var(--ink);
    background: var(--leaf);
  }

  /* ---------- the sheet: your state, your next set ---------- */
  .sheet {
    border-color: var(--leaf);
  }
  /* your state chip is the sheet's name tab */
  .sheet > .tab {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  /* the dock: the sheet's one primary button (Done, Start set, Save,
     Choose). On a laptop it is the foot of the sheet. On a phone it is a bar
     fixed to the bottom of the screen, so the map can sit at the top of the
     page and the button is always in the thumb zone, wherever you scroll. */
  .dock {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem -1.25rem -1.25rem;
    padding: 0.75rem 1.25rem 0.5rem;
    background: var(--panel);
    border-top: var(--px) solid var(--night);
  }
  .sheet .dock .wide {
    flex: 1;
    width: auto;
    min-width: 0;
    margin: 0;
  }
  /* a copy of the rest timer, shown only while the big one is out of view
     (the script watches it); screen readers use the big one */
  /* Done's stamp: what was just logged, on the dock's top border for 4 s,
     rising out of it in steps and sinking back. Taps pass through it. */
  .stamp {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--px);
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0 0.5rem 0 0.25rem;
    font: 20px/24px var(--body);
    color: var(--leaf);
    background: var(--night);
    border: 2px solid var(--leaf);
    box-shadow: 0 0 0 var(--px) var(--panel);
    transform: translateY(-50%);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
    animation: stamp 4s steps(4) forwards;
  }
  .stamp :global(svg) {
    flex: none;
  }
  .stamp span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .stamp b {
    font-weight: 400;
    color: var(--paper);
  }
  @keyframes stamp {
    0% {
      clip-path: inset(100% -8px -8px -8px);
    }
    4%,
    96% {
      clip-path: inset(-8px);
    }
    100% {
      clip-path: inset(100% -8px -8px -8px);
      visibility: hidden;
    }
  }
  @keyframes stamp-still {
    100% {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp {
      animation-name: stamp-still;
      animation-timing-function: steps(1);
    }
  }
  .dock-timer {
    margin: 0 0 var(--px);
    font-size: 48px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .dock-timer.slacking {
    color: var(--slacking);
  }
  @media (max-width: 899px) {
    .dock {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 30;
      margin: 0;
      padding: 0.5rem 1rem max(0.5rem, env(safe-area-inset-bottom));
      border-top-color: var(--leaf);
      box-shadow: 0 calc(var(--px) * -1) 0 #000;
    }
    /* room under the bar for the last thing on the page */
    :global(body:has(.dock) footer) {
      padding-bottom: 7rem;
    }
  }
  /* LOG-5: rest over flashes the sheet's border, at most 2 a second, 3 times */
  .sheet.flash {
    animation: rest-flash 500ms steps(1) 3;
  }
  @keyframes rest-flash {
    0% {
      border-color: var(--night);
    }
    50% {
      border-color: var(--leaf);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet.flash {
      animation: none;
    }
  }
  /* cardio's logged block: where the rest block would be, in leaf */
  .set-done {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0 0 1rem;
    padding: 0.5rem;
    background: var(--night);
    border: var(--px) solid var(--leaf);
  }
  .set-done :global(svg) {
    color: var(--leaf);
  }
  .set-done-n {
    margin: 0;
    font-size: 32px;
    line-height: 1;
  }
  .set-done-say {
    grid-column: 1 / -1;
    margin: 0;
  }
  /* timed fields start empty; the placeholders read 0:00 */
  :global(.mmss input::placeholder) {
    color: var(--dim);
    opacity: 1;
  }
  .sheet-news {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ===== interactions, presets, emoji (criteria/int.md; room spec I.1 to I.9) =====
     Global: the script builds the menu, reactions, banners, bubbles and pops. */

  /* ---------- who the menu is for: a paper ring on their tag ---------- */
  :global(.map .avatar[aria-expanded="true"] .tag) {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }

  /* ---------- the menu (INT-1): the game's START menu (I.2) ----------
     Laptop: beside the avatar, or under the squad row. Phone: pinned 56 px
     above the dock, in the thumb zone, never over it. */
  :global(.menu) {
    position: absolute;
    z-index: 25;
    width: 20rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.75rem;
    background: var(--panel);
    border: var(--px) solid var(--paper);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  @media (max-width: 899px) {
    :global(.menu) {
      position: fixed;
      right: 1rem;
      bottom: calc(var(--dock-h, 92px) + 56px);
      left: 1rem;
      z-index: 35;
      width: auto;
      max-width: none;
      max-height: calc(100dvh - var(--dock-h, 92px) - 64px);
      overflow-y: auto;
    }
  }
  :global(.menu-who) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 0 0.75rem;
    margin: 0 0 0.75rem;
  }
  :global(.menu-who .av) {
    width: 64px;
    height: 40px;
  }
  :global(.menu-name) {
    display: block;
    margin: 0;
    font-size: 26px;
    line-height: 1;
    color: var(--paper);
  }
  :global(.menu-name .chips) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--px);
    margin-top: var(--px);
  }
  :global(.menu [hidden]) {
    display: none;
  }
  :global(.menu-acts) {
    display: grid;
    gap: var(--px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.night .menu .act) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 0 0.75rem 0 0.5rem;
    font: 16px/1 var(--display);
    color: var(--paper);
    background: var(--night);
    border: 2px solid var(--edge);
    box-shadow: none;
    transform: none;
  }
  :global(.night .menu .act:hover) {
    background: var(--floor);
  }
  :global(.night .menu .act:active) {
    transform: translateY(2px);
  }
  /* the cursor on the fitting move (INT-2.14, INT-2.15); a slot elsewhere.
     Drawn here, so a row's text is its word alone. */
  :global(.menu .cur::before) {
    content: "▶";
  }
  :global(.menu .act .cur) {
    visibility: hidden;
  }
  :global(.night .menu .act.hot) {
    color: var(--ink);
    background: var(--leaf);
    border-color: var(--ink);
  }
  :global(.menu .act.hot .cur) {
    visibility: visible;
  }
  /* not now (INT-2.13, INT-4.7): focusable, dashed, the reason under it */
  :global(.night .menu .act[aria-disabled="true"]) {
    color: var(--dim);
    background: transparent;
    border-style: dashed;
    border-color: var(--dim);
    cursor: not-allowed;
  }
  :global(.night .menu .act[aria-disabled="true"] .cur) {
    visibility: hidden;
  }
  :global(.menu-why) {
    margin: 0.5rem 0 0;
    color: var(--dim);
  }
  /* Message: the same box, its rows swapped for the ten presets */
  :global(.menu-sub) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  :global(.night .menu .back) {
    width: auto;
    min-height: 44px;
    margin: 0;
    padding: 0 0.75rem 0 0.5rem;
    font-size: 8px;
  }
  :global(.menu .back .cur) {
    display: inline-block;
    visibility: visible;
    transform: scaleX(-1);
  }
  :global(.menu-to) {
    margin: 0;
    font-size: 24px;
    line-height: 1;
    color: var(--paper);
  }
  :global(.menu-group) {
    margin: 0.75rem 0 0.5rem;
    font: 8px/1 var(--display);
    text-transform: uppercase;
    color: var(--leaf);
  }
  :global(.menu-sub + .menu-group) {
    margin-top: 0;
  }
  :global(.presets) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.night .menu .preset) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    min-height: 52px;
    margin: 0;
    padding: var(--px) 0.5rem;
    font: 20px/1 var(--body);
    text-align: left;
    text-transform: none;
    color: var(--paper);
    background: var(--night);
    border: 2px solid var(--edge);
    box-shadow: none;
    transform: none;
  }
  :global(.night .menu .preset:hover) {
    background: var(--floor);
  }

  /* ---------- the squad list opens the same menu (INT-1.10) ----------
     Each other person's row is one button laid out as the row was. */
  .people :global(li:has(> .person)) {
    display: block;
  }
  :global(.night .people .person) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 0.75rem;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font: inherit;
    text-align: left;
    text-transform: none;
    color: inherit;
    background: none;
    box-shadow: none;
    transform: none;
  }
  :global(.night .people .person:hover),
  :global(.night .people .person[aria-expanded="true"]) {
    background: var(--night);
    box-shadow: 0 0 0 var(--px) var(--night);
  }

  /* ---------- reactions (INT-3): one svg over the tile, frames in turn (I.4) ---------- */
  :global(.map .avatar .fx) {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 3;
    width: var(--t);
    height: var(--t);
    overflow: visible;
    transform: translateX(-50%);
    pointer-events: none;
  }
  :global(.map .avatar.on-station:not(.on-machine) .fx) {
    bottom: calc(var(--t) * -0.375);
  }
  :global(.fx use) {
    visibility: hidden;
    animation: fx-frame var(--f) steps(1) forwards;
  }
  :global(.fx use:nth-child(2)) {
    animation-delay: var(--f);
  }
  :global(.fx use:nth-child(3)) {
    animation-delay: calc(var(--f) * 2);
  }
  :global(.fx use:nth-child(4)) {
    animation-delay: calc(var(--f) * 3);
  }
  :global(.fx-cheer) {
    --f: 200ms;
  }
  :global(.fx-poke) {
    --f: 240ms;
  }
  :global(.fx-slap) {
    --f: 200ms;
  }
  @keyframes fx-frame {
    0% {
      visibility: visible;
    }
    100% {
      visibility: hidden;
    }
  }
  /* reduced motion: the middle frame, still (INT-3.9); the script removes it */
  @media (prefers-reduced-motion: reduce) {
    :global(.fx use) {
      animation: none;
    }
    :global(.fx use:nth-child(2)) {
      visibility: visible;
    }
  }

  /* ---------- the banner (INT-3): a game text box, 4 s (I.5) ----------
     Laptop: centred at the top of the map panel. Phone: fixed at the top of
     the screen, wherever you've scrolled. */
  :global(.map-panel .banner-slot) {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    z-index: 24;
    width: max-content;
    max-width: calc(100% - 2rem);
    transform: translateX(-50%);
    pointer-events: none;
  }
  @media (max-width: 899px) {
    :global(.map-panel .banner-slot) {
      position: fixed;
      top: 0.5rem;
      right: 0.5rem;
      left: 0.5rem;
      z-index: 40;
      width: auto;
      max-width: none;
      transform: none;
    }
  }
  :global(.banner) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: var(--px) 0.75rem var(--px) var(--px);
    font: 22px/1.1 var(--body);
    color: var(--ink);
    background: var(--paper);
    border: var(--px) solid var(--ink);
    box-shadow:
      0 0 0 var(--px) var(--edge),
      var(--px) calc(var(--px) * 2) 0 var(--px) #000;
    animation: banner 4s steps(4) forwards;
  }
  :global(.banner .av) {
    flex: none;
    width: 64px;
    height: 40px;
  }
  @keyframes banner {
    0% {
      clip-path: inset(0 -16px 100% -16px);
    }
    4%,
    96% {
      clip-path: inset(-16px);
    }
    100% {
      clip-path: inset(0 -16px 100% -16px);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.banner) {
      animation: none;
    }
  }

  /* ---------- a refusal or a failure, where the menu was (I.3) ----------
     A refusal is news: dashed, like Reconnecting. A failure is an error. */
  :global(.note) {
    width: max-content;
    max-width: 18rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    font: 20px/1.1 var(--body);
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.map .note),
  :global(.map .error) {
    position: absolute;
    z-index: 24;
    width: max-content;
    max-width: 18rem;
    margin: 0;
    pointer-events: none;
  }
  :global(.dock .note),
  :global(.dock .error) {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0.75rem;
    z-index: 3;
    max-width: calc(100% - 5.5rem);
    margin: 0;
    pointer-events: none;
  }

  /* ---------- bubbles and pops: two layers over the map (I.6, I.8) ----------
     Each placed from its sender's tile (--x, --y; --dy for the slacker's
     drop). Pops draw under every avatar, so a tag is never covered;
     bubbles draw over them. Neither takes taps. */
  :global(.map .says),
  :global(.map .pops) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(.map .pops) {
    z-index: 0;
  }
  :global(.map .says) {
    z-index: 18;
  }
  /* the anchor: the top of the sender's tag (20 px of tag over the tile) */
  :global(.map .say),
  :global(.map .pop) {
    --top: calc((var(--y) + 1 + var(--dy, 0)) * var(--t) - var(--t) - 24px);
    position: absolute;
    left: calc((var(--x) + 0.5) * var(--t));
  }
  /* the preset bubble (INT-5): above the sender, 5 s; "@Ji-woo" first */
  :global(.map .say) {
    bottom: calc(100% - var(--top) + 0.75rem);
    width: max-content;
    max-width: min(9.5rem, calc(var(--t) * 4));
    margin: 0;
    padding: 2px 0.5rem;
    font: 20px/1 var(--body);
    color: var(--ink);
    background: var(--leaf);
    border: 2px solid var(--ink);
    transform: translateX(-50%);
  }
  :global(.say .to) {
    display: block;
    color: var(--deep);
  }
  :global(.say::after),
  :global(.say::before) {
    content: "";
    position: absolute;
    top: 100%;
    left: calc(50% - 4px);
    width: 8px;
    height: 4px;
    background: var(--ink);
  }
  :global(.say::before) {
    top: calc(100% + 4px);
    left: calc(50% - 2px);
    width: 4px;
  }
  /* near a side wall it hangs inwards, its tail over the sender */
  :global(.map .say.west) {
    transform: translateX(-16px);
  }
  :global(.map .say.east) {
    transform: translateX(calc(-100% + 16px));
  }
  :global(.say.west::after),
  :global(.say.east::after) {
    left: 10px;
  }
  :global(.say.west::before),
  :global(.say.east::before) {
    left: 12px;
  }
  :global(.say.east::after) {
    right: 10px;
    left: auto;
  }
  :global(.say.east::before) {
    right: 12px;
    left: auto;
  }
  /* the back row: no room above at 1x, so under the tile, tail up */
  :global(.map .say.below) {
    top: calc((var(--y) + 1 + var(--dy, 0)) * var(--t) + 0.5rem);
    bottom: auto;
  }
  :global(.say.below::after) {
    top: auto;
    bottom: 100%;
  }
  :global(.say.below::before) {
    top: auto;
    bottom: calc(100% + 4px);
  }
  /* a pop above the same person: the bubble steps up over it */
  :global(.map .say.over-pop) {
    bottom: calc(100% - var(--top) + 32px + 1rem);
  }
  /* the emoji pop (INT-8, BOT-6): 32 px, 4 px above the tag, 3 s */
  :global(.map .pop) {
    bottom: calc(100% - var(--top) + 4px);
    width: 32px;
    height: 32px;
    translate: -50% 0;
    animation: pop 180ms steps(1, end) forwards;
  }
  /* the back row: beside the tag, on the side away from the nearer wall */
  :global(.map .pop.beside) {
    bottom: calc(100% - var(--top) - 28px);
    translate: calc(var(--tag-w, var(--t)) / 2 + 2px) 0;
  }
  :global(.map .pop.beside.west-side) {
    translate: calc(-100% - var(--tag-w, var(--t)) / 2 - 2px) 0;
  }
  @keyframes pop {
    0% {
      transform: translateY(8px);
    }
    50% {
      transform: translateY(4px);
    }
    100% {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.map .pop) {
      animation: none;
    }
  }

  /* ---------- the emoji tab and tray (INT-8; I.7) ----------
     The tab rises from the dock's top border on the right, so it takes no
     width from the button; the tray opens above it, 48 px clear. */
  :global(.night .dock .emote) {
    position: absolute;
    right: 0.75rem;
    /* 100% is inside the dock's top border: the tab stands on it */
    bottom: 100%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 48px;
    min-height: 44px;
    margin: 0;
    padding: 0 0 var(--px);
    color: var(--leaf);
    background: var(--panel);
    border: var(--px) solid var(--leaf);
    border-bottom: 0;
    box-shadow: none;
    transform: none;
  }
  :global(.night .dock .emote:hover) {
    background: var(--night);
  }
  :global(.night .dock .emote[aria-expanded="true"]) {
    color: var(--ink);
    background: var(--leaf);
  }
  :global(.night .dock .emote[aria-disabled="true"]) {
    cursor: default;
  }
  :global(.dock .emote.pending svg) {
    opacity: 0.5;
  }
  @media (min-width: 900px) {
    .dock {
      margin-top: 4rem;
    }
  }
  /* the stamp stops short of the tab */
  .dock .stamp {
    max-width: calc(100% - 5.5rem);
  }
  @media (max-width: 899px) {
    :global(body:has(.dock .emote) footer) {
      padding-bottom: 10rem;
    }
  }
  .tray {
    position: absolute;
    right: 0.75rem;
    /* 48 px clear of the dock's outer edge, past its top border */
    bottom: calc(100% + 48px + var(--px));
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, 64px);
    gap: var(--px);
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--panel);
    border: var(--px) solid var(--leaf);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  .tray[hidden] {
    display: none;
  }
  :global(.night) .tray button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 64px;
    height: 64px;
    min-height: 0;
    margin: 0;
    padding: var(--px) 0 0;
    font: 20px/1 var(--body);
    text-transform: none;
    color: var(--paper);
    background: var(--night);
    box-shadow: none;
    transform: none;
  }
  :global(.night) .tray button:hover {
    background: var(--floor);
  }
  :global(.night) .tray button:active {
    transform: translateY(2px);
  }
  :global(.night) .tray[data-cooling] button {
    color: var(--dim);
    cursor: default;
  }
  .tray[data-cooling] svg {
    opacity: 0.5;
  }
  :global(.dock .emote-error) {
    right: calc(0.75rem + 60px);
    left: auto;
  }

  /* ---------- the room log (INT-5.8; I.9): presets and interactions ----------
     Newest first: five, then the rest of the newest 50 behind one tap.
     Lines about you wear the leaf edge, as an edited log row does. */
  .room-log ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .room-log :global(li) {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    align-items: start;
    gap: 0 0.5rem;
    padding: 0.5rem 0;
    border-top: 2px solid var(--night);
  }
  .room-log :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .room-log :global(li > svg) {
    margin-top: 4px;
    color: var(--dim);
  }
  .room-log :global(li.you) {
    padding-left: 0.5rem;
    box-shadow: inset var(--px) 0 0 var(--leaf);
  }
  .room-log :global(li.you > svg) {
    color: var(--leaf);
  }
  .room-log :global(.t) {
    color: var(--dim);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .room-log :global(.to) {
    color: var(--leaf);
  }
  .room-log :global(li.joined) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dim);
  }
  .room-log :global(li.joined::before),
  .room-log :global(li.joined::after) {
    content: "";
    flex: 1;
    border-top: 2px dashed var(--edge);
  }
  .room-log .older {
    margin: 0.5rem 0 0;
  }
  .room-log .older > summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--leaf);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .room-log .older > summary::-webkit-details-marker {
    display: none;
  }
  .room-log .older[open] > summary {
    display: none;
  }
  .room-log .empty {
    margin: 0;
    color: var(--dim);
  }

  /* the rest block: water blue while resting, slacking red once it's over */
  .rest {
    margin: 0 0 1rem;
    padding: 0.5rem 0.5rem 0.25rem;
    background: var(--night);
    border: var(--px) solid var(--resting);
  }
  .rest.slacking {
    border-color: var(--slacking);
  }
  .rest-say {
    margin: 0.25rem 0 0;
  }
  /* the timer, and beside it (or under it, on a narrow phone) what it's for */
  .rest-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.75rem;
  }
  .timer {
    margin: 0;
    font-size: 80px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rest.slacking .timer {
    color: var(--slacking);
  }
