                  {e.word}
                </button>
              </li>
            ))
          }
        </ul>
        {
          justLogged && (
            <p class:list={["stamp", { pb: isPb }]} data-n={loggedNo}>
              <Sprite sprite={isPb ? pbIcon : tickIcon} scale={2} />
              {isPb ? (
                <>
                  <span>
                    New PB: <b>{setLabel(latest!)}</b>
                  </span>
                  <span class="pb-mark">🏆</span>
                </>
