          <div class="menu-message" hidden>
            <div class="menu-sub">
              <button type="button" class="back button secondary" role="menuitem"><span class="cur" aria-hidden="true"></span>Back</button>
              <p class="menu-to"></p>
            </div>
            {
              (
                [
                  ["Hype", "hype"],
                  ["Nudge", "nudge"],
                ] as const
              ).map(([title, group]) => (
                <>
                  <p class="menu-group" id={`menu-group-${group}`}>{title}</p>
                  <ul class="presets" role="group" aria-labelledby={`menu-group-${group}`}>
                    {Object.entries(PRESETS)
                      .filter(([key]) => key.startsWith(group))
                      .map(([key, text]) => (
                        <li>
                          <button type="button" class="preset" role="menuitem" value={key}>{text}</button>
                        </li>
                      ))}
                  </ul>
                </>
              ))
            }
          </div>
        </div>
      </template>
      <template data-part="log-cheer"><Sprite sprite={cheerIcon} scale={2} /></template>
      <template data-part="log-poke"><Sprite sprite={pokeIcon} scale={2} /></template>
      <template data-part="log-slap"><Sprite sprite={slapIcon} scale={2} /></template>
      <template data-part="log-say"><Sprite sprite={sayIcon} scale={2} /></template>
      <template data-part="log-thanks"><Sprite sprite={thanksIcon} scale={2} /></template>
      <template data-part="log-high-five"><Sprite sprite={highFiveIcon} scale={2} /></template>
      <template data-part="log-pb"><Sprite sprite={pbIcon} scale={2} /></template>
      <template data-part="tick"><Sprite sprite={tickIcon} scale={2} /></template>
      {/* INT-12: the sound setting's icons, by value (F.11) */}
      <template data-part="sound-all"><Sprite sprite={soundIcon} scale={2} /></template>
      <template data-part="sound-rest"><Sprite sprite={bellIcon} scale={2} /></template>
      <template data-part="sound-off"><Sprite sprite={soundOffIcon} scale={2} /></template>
      <template data-part="lost">
        <span class="lost"><Sprite sprite={signalIcon} scale={2} />Reconnecting…</span>
      </template>
