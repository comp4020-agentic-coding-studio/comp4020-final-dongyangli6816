    <section class="panel room-log" aria-labelledby="roomlog-title">
      <h2 class="panel-title" id="roomlog-title">Room log</h2>
      {log50.length === 0 && <p class="empty">Quiet in here. Tap someone on the map to cheer them on 👀</p>}
      <ol
        class="log-lines"
        data-me={user.id}
        data-joined={walkedIn}
        data-joined-text={walkedIn === undefined ? undefined : `You walked in · ${timeOfDay(walkedIn)}`}
      >
        {logShown.map((r: LogRow) =>
            "walkedIn" in r ? (
              <li class="joined">You walked in · {timeOfDay(r.walkedIn)}</li>
            ) : (
              <li class:list={{ you: isAboutMe(r.entry), pb: r.entry.kind === "pb" }} data-at={r.entry.at}>
                <Sprite sprite={LOG_ICON[r.entry.kind]} scale={2} />
                {(() => {
                  const l = logLine(r.entry, user.id);
                  return l.text !== undefined ? (
                    <span class="line">
                      {l.who} <span class="to">{l.to}</span> "{l.text}"
                    </span>
                  ) : (
                    <span class="line">
                      {l.who}
                      {l.rest}
                    </span>
                  );
                })()}
                <span class="t">{ago(r.entry.at, now)}</span>
              </li>
            ))}
      </ol>
      <details class="older" hidden={logOlder.length === 0}>
        <summary>Show older ({logOlder.length} more)</summary>
        <ol class="log-lines">{logOlder.map((r: LogRow) =>
            "walkedIn" in r ? (
              <li class="joined">You walked in · {timeOfDay(r.walkedIn)}</li>
            ) : (
              <li class:list={{ you: isAboutMe(r.entry), pb: r.entry.kind === "pb" }} data-at={r.entry.at}>
                <Sprite sprite={LOG_ICON[r.entry.kind]} scale={2} />
                {(() => {
                  const l = logLine(r.entry, user.id);
                  return l.text !== undefined ? (
                    <span class="line">
                      {l.who} <span class="to">{l.to}</span> "{l.text}"
                    </span>
                  ) : (
                    <span class="line">
                      {l.who}
                      {l.rest}
                    </span>
                  );
                })()}
                <span class="t">{ago(r.entry.at, now)}</span>
              </li>
            ))}</ol>
      </details>
    </section>

    {
      mySets.length > 0 && startedAt && (
        <section class="panel" aria-labelledby="log-title">
          <h2 class="panel-title" id="log-title">This workout</h2>
          <p class="tally">
            <b>{mySets.length}</b> set{mySets.length === 1 ? "" : "s"}
            {vol > 0 && (
              <>
                {" "}
                · <b>{kg(vol)} kg</b> moved
              </>
            )}
            {dist > 0 && (
              <>
                {" "}
                · <b>{km(dist)} km</b> covered
              </>
            )}{" "}
            so far
          </p>
          <table class="log">
            <thead>
              <tr>
                <th>Exercise</th>
                <th class="num">Set</th>
                <th class="fix">
                  <span class="vh">Edit</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {mySets.map((s, i) => {
                const label = setLabel(s);
                const current = editing?.id === s.id;
                return (
                  <tr aria-current={current ? "true" : undefined}>
                    {i > 0 && mySets[i - 1].exerciseId === s.exerciseId ? (
                      <td class="ditto">
                        <span aria-hidden="true">"</span>
                        <span class="vh">{s.name}</span>
                      </td>
                    ) : (
                      <td>{s.name}</td>
                    )}
                    <td class="num set">
                      {s.distanceM !== null && s.durationS !== null ? (
                        <>
                          {km(s.distanceM / 1000)} <span class="u">km</span> · {clock(s.durationS)}
                          <span class="sub">{pace(s.durationS, s.distanceM)} /km</span>
                        </>
                      ) : (
                        unitSplit(label).map((part) =>
                          part === " kg" || part === " km" ? (
                            <>
                              {" "}
                              <span class="u">{part.trim()}</span>
                            </>
                          ) : (
                            part
                          ),
                        )
                      )}
                    </td>
                    <td class="fix">
                      {current ? (
                        <a href={`?exercise=${s.exerciseId}`} aria-label="Editing this set. Cancel">
                          <Sprite sprite={pencilIcon} scale={2} />
                        </a>
                      ) : (
                        <a href={`?edit=${s.id}`}>
                          <Sprite sprite={pencilIcon} scale={2} />
                          <span class="vh">
                            Edit {s.name}, {label}
                          </span>
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <form method="post">
            <input type="hidden" name="action" value="finish" />
            <div class="actions">
              <button type="submit" class="secondary button quiet">Finish workout</button>
            </div>
          </form>
        </section>
      )
    }

    <section class="panel sign" aria-labelledby="room-panel-title">
      <h2 class="panel-title" id="room-panel-title">Room</h2>
      <div class="passcode-box">
        <p class="spots">
          <span class="pips" aria-hidden="true">
            {Array.from({ length: ROOM_SIZE }, (_, i) => <i class:list={{ in: i < members.length }} />)}
          </span>
          <span class="count">{members.length} of {ROOM_SIZE} in</span>
        </p>
      </div>
      <p class="hint">Send the code to the squad, or this link: <span class="room-link">{inviteUrl}</span></p>
      <div class="actions room-actions">
        <form method="post">
          <input type="hidden" name="action" value="leave" />
          <button type="submit" class="button secondary quiet" aria-describedby="leave-note">Leave room</button>
        </form>
      </div>
      <p class="hint leave-note" id="leave-note">
        {
          members.length === 1
            ? "You're the last one in, so leaving closes the room."
            : mySets.length === 0
              ? "Nothing logged yet, so there's no workout to save."
              : "Leaving finishes your workout. Your sets stay in the book."
        }
      </p>
      {
        isHost && others.length > 0 && (
          <details class="confirm end-room">
            <summary class="button secondary quiet">
              <span class="if-closed">End room</span>
              <span class="if-open">Cancel</span>
            </summary>
            <form method="post" class="confirm-box">
              <input type="hidden" name="action" value="end" />
              <p>
                End the room for everyone? {othersText} get{others.length === 1 ? "s" : ""} sent home and{" "}
                {others.length === 1 ? "their workout finishes" : "their workouts finish"}. Every set is kept.
              </p>
              <button type="submit" class="button secondary quiet">End room</button>
            </form>
          </details>
        )
      }
    </section>
  </div>
  {/* outside the room, so an in-place swap keeps it: what Done logged, said once */}
  <p class="sheet-news" id="sheet-news" role="status"></p>
  {/* BOT-1, BOT-4: what Dony's poster on the map submits */}
  <form method="post" id="dony"><input type="hidden" name="action" value="dony" /></form>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import type { RoomView } from "../../lib/presence.ts";
  import { STATE_WORD, stateAt, whatParts } from "../../lib/squad.ts";
  import { avatarLabel, DOOR, everyone, floorLine, route, spots, UNDER_POSTER, type Tile } from "../../lib/floor.ts";
  import { lookFromKey, lookKey, lookVars, type Look } from "../../sprites/avatar.ts";
  import { STATIONS } from "../../sprites/gym.ts";
  import { isMachine } from "../../sprites/poses.ts";
  import { TILE } from "../../sprites/sprite.ts";
  import {
    ago,
    LOG_ICON,
    logLine,
    PB_MS,
    REPLY,
    REPLY_MS,
    slapRefusal,
    type Kind,
    type LogEntry,
    type Move,
    type Refusal,
    type Reply,
  } from "../../lib/moves.ts";
  import type { MemberView, State } from "../../lib/presence.ts";

  // Every timer here is worked out from Date.now() on each tick, never
  // counted, so a phone that slept wakes up showing the right time (GYM-12).
  const clock = (totalS: number) => {
    const s = Math.max(0, Math.floor(totalS));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = String(s % 60).padStart(2, "0");
    return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
  };

  // ---------- sound (LOG-5, INT-12; room spec F.11, F.13) ----------
  // The browser lets a page play sound only after a gesture on it: the first
  // tap or key press (INT-12.11) unlocks it. Before that a sound is skipped
  // silently (INT-12.10). Everything goes through one gain node, so Sound
  // off can silence what is already playing (INT-12.7).
  type SoundSetting = "all" | "rest" | "off";
  const SOUND_KEY = "spotter-sound";
  let audio: AudioContext | undefined;
  let master: GainNode | undefined;
  let unlocked = false;
  const unlock = () => {
    if (unlocked) return;
    unlocked = true;
    try {
      audio ??= new AudioContext();
      void audio.resume();
    } catch {
      // no sound here; nothing else depends on it
    }
  };
  addEventListener("pointerdown", unlock, { once: true });
  addEventListener("keydown", unlock, { once: true });

  // INT-12.5, INT-12.6: kept in this browser only; a browser that won't
  // keep it starts on All sounds each time
  function soundSetting(): SoundSetting {
    try {
      const v = localStorage.getItem(SOUND_KEY);
      return v === "rest" || v === "off" ? v : "all";
    } catch {
      return "all";
    }
  }
  let sound: SoundSetting = soundSetting();
  function setSound(v: SoundSetting) {
    sound = v;
    try {
      localStorage.setItem(SOUND_KEY, v);
    } catch {
      // not kept; it still holds for this page
    }
    // a sound already playing stops at once when it's turned off
    if (v === "off" && master && audio) {
      master.disconnect();
      master = undefined;
    }
  }

  // One note: a frequency (or a slide from one to another), a start, a length
  type Note = { f: number; to?: number; at: number; ms: number; wave?: OscillatorType };
  function play(notes: Note[], gain: number, noiseAt?: number) {
    if (!unlocked || sound === "off") return;
    try {
      audio ??= new AudioContext();
      if (!master) {
        master = audio.createGain();
        master.connect(audio.destination);
      }
      const t0 = audio.currentTime;
      for (const n of notes) {
        const osc = audio.createOscillator();
        const g = audio.createGain();
        osc.type = n.wave ?? "square";
        osc.frequency.setValueAtTime(n.f, t0 + n.at / 1000);
        if (n.to) osc.frequency.linearRampToValueAtTime(n.to, t0 + (n.at + n.ms) / 1000);
        g.gain.value = gain;
        osc.connect(g).connect(master);
        osc.start(t0 + n.at / 1000);
        osc.stop(t0 + (n.at + n.ms) / 1000);
      }
      // the High-five's smack: 30 ms of noise
      if (noiseAt !== undefined) {
        const len = Math.round(audio.sampleRate * 0.03);
        const buf = audio.createBuffer(1, len, audio.sampleRate);
        const data = buf.getChannelData(0);
        for (let i = 0; i < len; i++) data[i] = Math.random() * 2 - 1;
        const src = audio.createBufferSource();
        const g = audio.createGain();
        src.buffer = buf;
        g.gain.value = gain;
        src.connect(g).connect(master);
        src.start(t0 + noiseAt / 1000);
      }
    } catch {
      // no sound available; what is on screen still says it
    }
  }

  // F.13's palette, by what happened. Interaction sounds are capped at one a
  // second, and never start under the fanfare or the rest-over beep, which
  // always play (INT-12.9, R8).
  const SOUNDS = {
    cheer: { notes: [{ f: 660, at: 0, ms: 70 }, { f: 990, at: 70, ms: 70 }], gain: 0.04 },
    poke: { notes: [{ f: 520, at: 0, ms: 50 }, { f: 520, at: 110, ms: 50 }], gain: 0.04 },
    slap: { notes: [{ f: 300, to: 150, at: 0, ms: 90, wave: "triangle" as const }], gain: 0.04 },
    thanks: { notes: [{ f: 880, at: 0, ms: 80 }, { f: 660, at: 80, ms: 80 }], gain: 0.04 },
    offer: { notes: [{ f: 784, at: 0, ms: 60 }, { f: 784, at: 120, ms: 60 }], gain: 0.04 },
    say: { notes: [{ f: 440, at: 0, ms: 40 }], gain: 0.03 },
    sent: { notes: [{ f: 1320, at: 0, ms: 25 }], gain: 0.03 },
    highfive: { notes: [{ f: 523, at: 0, ms: 50 }, { f: 659, at: 50, ms: 50 }, { f: 784, at: 100, ms: 50 }], gain: 0.04, noiseAt: 150 },
  } satisfies Record<string, { notes: Note[]; gain: number; noiseAt?: number }>;
  type SoundName = keyof typeof SOUNDS;
  let lastBlip = -Infinity;
  let loudUntil = -Infinity;
  function blip(name: SoundName) {
    if (sound !== "all") return;
    const now = performance.now();
    if (now - lastBlip < 1000 || now < loudUntil) return;
    lastBlip = now;
    const s: { notes: Note[]; gain: number; noiseAt?: number } = SOUNDS[name];
    play(s.notes, s.gain, s.noiseAt);
  }
  // GYM-18, INT-12.1: the PB fanfare, for everyone in the room
  function fanfare() {
    if (sound !== "all") return;
    loudUntil = performance.now() + 560;
    play(
      [
        { f: 523, at: 0, ms: 90 },
        { f: 659, at: 90, ms: 90 },
        { f: 784, at: 180, ms: 90 },
        { f: 1047, at: 270, ms: 290 },
      ],
      0.06,
    );
  }
  // LOG-5: rest over, unchanged, unless sound is off
  function beep() {
    if (sound === "off") return;
    loudUntil = performance.now() + 400;
    play(
      [
        { f: 880, at: 0, ms: 150 },
        { f: 880, at: 250, ms: 150 },
      ],
      0.08,
    );
  }

  // Binds the timers, the stopwatch and the pending state to the room as it
  // is in the page, and returns what to run each second. Runs again after
  // each in-place update (below), on the new content.
  function init(): () => void {
    const roomId = document.querySelector<HTMLElement>(".gym")!.dataset.room;
    const sheet = document.querySelector<HTMLElement>(".sheet")!;

    // ---------- the workout clock ----------
    const workoutClock = document.querySelector<HTMLTimeElement>("time[data-start]");
    const tickClock = () => {
      if (workoutClock) workoutClock.textContent = clock((Date.now() - Number(workoutClock.dataset.start)) / 1000);
    };

    // ---------- the rest timer (LOG-4, LOG-5) ----------
    const rest = document.querySelector<HTMLElement>(".rest");
    const timer = rest?.querySelector<HTMLElement>(".timer");
    rest?.querySelector(".rest-static")?.remove();
    if (timer) timer.hidden = false;
    const tab = sheet.querySelector<HTMLElement>(".tab")!;
    const setTab = (state: string) => {
      const t = sheet.querySelector<HTMLTemplateElement>(`template[data-tab="${state}"]`);
      if (!t || tab.classList.contains(`state-${state}`)) return;
      tab.className = `chip state-${state} tab`;
      tab.replaceChildren(t.content.cloneNode(true));
    };
    // the page was open when rest ran out, so this one gets the beep and flash
    let wasOver = rest?.classList.contains("over") ?? true;
    function say(text: string) {
      let line = rest!.querySelector<HTMLElement>(".rest-say");
      if (!line) {
        line = document.createElement("p");
        line.className = "rest-say";
        line.setAttribute("role", "status");
        rest!.prepend(line);
      }
      if (line.textContent !== text) line.textContent = text;
    }
    // the dock's copy of the timer, shown on a phone only while the big one
    // isn't fully in view (above the pinned dock)
    const dockTimer = document.querySelector<HTMLElement>(".dock-timer");
    const copy = (red: boolean) => {
      if (!dockTimer || !timer) return;
      dockTimer.textContent = timer.textContent;
      dockTimer.classList.toggle("slacking", red);
    };
    dockWatch?.disconnect();
    if (dockTimer && timer && "IntersectionObserver" in window) {
      const dock = dockTimer.closest<HTMLElement>(".dock")!;
      const phone = matchMedia("(max-width: 899px)");
      dockWatch = new IntersectionObserver(
        ([e]) => {
          dockTimer.hidden = !phone.matches || e.intersectionRatio >= 1;
        },
        { rootMargin: `0px 0px -${dock.offsetHeight}px 0px`, threshold: 1 },
      );
      dockWatch.observe(timer);
    }
    const tickRest = () => {
      if (!rest || !timer || !rest.isConnected) return;
      const left = (Number(rest.dataset.end) - Date.now()) / 1000;
      const over = left <= 0;
      rest.classList.toggle("over", over);
      rest.querySelector(".rest-what span")!.firstChild!.textContent = over ? "over a " : "of ";
      if (!over) {
        timer.textContent = clock(Math.ceil(left));
        copy(false);
        rest.querySelector(".rest-say")?.remove();
        setTab("resting");
        wasOver = false;
        return;
      }
      timer.textContent = `+${clock(-left)}`;
      // GYM-11: blue for the first 30 s over, red once the squad sees Slacking
      const slacking = -left >= 30;
      rest.classList.toggle("slacking", slacking);
      setTab(slacking ? "slacking" : "resting");
      say(slacking ? "Your squad can see you 👀" : "Rest's up. Back under the bar 🔔");
      copy(slacking);
      if (!wasOver) {
        wasOver = true;
        beep();
        sheet.classList.remove("flash");
        void sheet.offsetWidth;
        sheet.classList.add("flash");
      }
    };

    // ---------- the stopwatch, for holds and cardio ----------
    const setForm = document.querySelector<HTMLFormElement>("form.set-form[data-exercise]");
    const watch = setForm?.querySelector<HTMLElement>(".stopwatch");
    const minutes = setForm?.querySelector<HTMLInputElement>("#minutes");
    const seconds = setForm?.querySelector<HTMLInputElement>("#seconds");
    const distance = setForm?.querySelector<HTMLInputElement>("#distance_km");
    const key = `spotter:stopwatch:${roomId}:${setForm?.dataset.exercise}`;
    const store = {
      get: () => {
        try {
          return Number(sessionStorage.getItem(key)) || 0;
        } catch {
          return 0;
        }
      },
      set: (v: number) => {
        try {
          if (v) sessionStorage.setItem(key, String(v));
          else sessionStorage.removeItem(key);
        } catch {
          // private mode: the stopwatch just won't survive a reload
        }
      },
    };
    let startedAt = 0;
    const fieldSeconds = () => Number(minutes!.value || 0) * 60 + Number(seconds!.value || 0);
    const writeTime = (s: number) => {
      minutes!.value = String(Math.floor(s / 60));
      seconds!.value = String(Math.floor(s % 60));
    };
    const sayLine = watch?.querySelector<HTMLElement>(".say");
    function sayPace() {
      if (!sayLine || startedAt) return;
      if (setForm!.dataset.kind === "duration") return (sayLine.textContent = "Start, hold, Stop.");
      const km = Number(distance!.value);
      const s = fieldSeconds();
      // rounded, as the server's pace() is, so both lines agree
      if (km >= 0.01 && s > 0) sayLine.innerHTML = `Pace <b>${clock(Math.round(s / km))} /km</b>`;
      else sayLine.textContent = "Pace shows once there's a distance.";
    }
    function showRunning(on: boolean) {
      const toggle = watch!.querySelector<HTMLButtonElement>(".sw-toggle")!;
      toggle.querySelector<HTMLElement>(".sw-start")!.hidden = on;
      toggle.querySelector<HTMLElement>(".sw-stop")!.hidden = !on;
      toggle.setAttribute("aria-pressed", String(on));
      minutes!.readOnly = seconds!.readOnly = on;
      minutes!.closest(".big-time")!.classList.toggle("running", on);
      if (on) sayLine!.textContent = "Clock's running. Stop fills the time.";
      else sayPace();
    }
    function stopWatch() {
      if (!startedAt) return;
      writeTime((Date.now() - startedAt) / 1000);
      startedAt = 0;
      store.set(0);
      showRunning(false);
    }
    if (watch && minutes && seconds) {
      for (const el of watch.querySelectorAll<HTMLElement>("[hidden]:not(.sw-stop)")) el.hidden = false;
      watch.querySelector(".sw-toggle")!.addEventListener("click", () => {
        if (startedAt) return stopWatch();
        // carries on from whatever time is already in the fields
        startedAt = Date.now() - fieldSeconds() * 1000;
        store.set(startedAt);
        showRunning(true);
      });
      watch.querySelector(".sw-reset")!.addEventListener("click", () => {
        startedAt = 0;
        store.set(0);
        writeTime(0);
        showRunning(false);
      });
      for (const input of [minutes, seconds, distance]) input?.addEventListener("input", sayPace);
      startedAt = store.get();
      showRunning(!!startedAt);
    }
    const tickWatch = () => {
      if (startedAt) writeTime((Date.now() - startedAt) / 1000);
    };

    // ---------- pending: Done and Save keep their label while the post is out ----------
    const editForm = document.querySelector<HTMLFormElement>("#set-edit");
    for (const form of [setForm, editForm]) {
      form?.addEventListener("submit", () => {
        if (form === setForm) {
          stopWatch();
          store.set(0);
        }
        submitButton(form)!.disabled = true;
        for (const input of form.querySelectorAll("input")) input.readOnly = true;
        sheet.setAttribute("aria-busy", "true");
      });
    }
    unbusy = () => {
      for (const form of [setForm, editForm]) {
        if (!form) continue;
        submitButton(form)!.disabled = false;
        for (const input of form.querySelectorAll("input")) {
          input.readOnly = form === setForm && !!startedAt && input.closest(".mmss") !== null;
        }
      }
      sheet.removeAttribute("aria-busy");
    };

    return () => {
      tickClock();
      tickRest();
      tickWatch();
    };
  }

  const submitButton = (form: HTMLFormElement) =>
    form.querySelector<HTMLButtonElement>("button[type=submit]") ??
    document.querySelector<HTMLButtonElement>(`button[form="${form.id}"]`);
  let unbusy = () => {};
  let dockWatch: IntersectionObserver | undefined;
  // Back restores the page from cache, button and all
  addEventListener("pageshow", () => unbusy());

  // This script runs once, however many times the room is shown; the client
  // router (ADR 0003) says when a room is on screen, after the first load and
  // after every swap.
  let tick = () => {};
  document.addEventListener("astro:page-load", () => {
    const gym = document.querySelector<HTMLElement>(".gym");
    posterDrawn = undefined; // a new page: read the poster as the server drew it
    tick = gym ? init() : () => {};
    if (gym) connect(gym.dataset.room!);
    else disconnect();
    tick();
    liveTick();
  });
  setInterval(() => {
    tick();
    liveTick();
  }, 1000);

  // ---------- the room, live (GYM-13, GYM-15) ----------
  // One stream per room on screen. Each message is the whole room, so the
  // squad list is redrawn from it rather than patched; a stream that
  // reconnects is right again with its first message. The server's clock
  // decides when someone turns Slacking, so its offset from this one is kept.
  let live: { roomId: string; source: EventSource } | undefined;
  let view: RoomView | undefined;
  let offset = 0;
  let connected = true;
  let lostTimer: ReturnType<typeof setTimeout> | undefined;

  function connect(roomId: string) {
    if (live?.roomId === roomId) return;
    disconnect();
    const source = new EventSource(`/rooms/${roomId}/events`);
    live = { roomId, source };
    source.addEventListener("room", (e) => {
      view = JSON.parse((e as MessageEvent<string>).data) as RoomView;
      offset = view.now - Date.now();
      // the host ended it, or it closed: the room page says where to go
      if (view.closed) {
        disconnect();
        return navigate(location.pathname);
      }
      checkErrands();
      liveTick();
      readMoments(view);
      catchingUp = false;
    });
    source.addEventListener("interaction", (e) => onInteraction(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("highfive", (e) => onHighFive(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("pb", (e) => onPb(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("say", (e) => onSay(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("emote", (e) => onEmote(JSON.parse((e as MessageEvent<string>).data)));
    source.addEventListener("open", () => {
      clearTimeout(lostTimer);
      lostTimer = undefined;
      connected = true;
      // the first message on a new stream is news we missed: everyone is put
      // where it says, with no walk replayed (GYM-10.21), errands included
      // (INT-13.21)
      for (const id of [...errands.keys()]) cutShort(id, "left");
      reacting.clear();
      catchingUp = true;
      liveTick();
    });
    source.addEventListener("error", () => {
      // refused outright (no longer a member): the room page says why
      if (source.readyState === EventSource.CLOSED) {
        disconnect();
        return navigate(location.pathname);
      }
      // a blip isn't worth a word; a stream down for 3 s is
      lostTimer ??= setTimeout(() => {
        connected = false;
        liveTick();
      }, 3000);
    });
  }

  function disconnect() {
    live?.source.close();
    live = undefined;
    view = undefined;
    clearTimeout(lostTimer);
    lostTimer = undefined;
    connected = true;
  }

  // Draws the connection badge, the headcount and the squad list from the
  // newest message, at this second.
  function liveTick() {
    const conn = document.querySelector<HTMLElement>(".conn");
    if (conn && conn.dataset.connected !== String(connected)) {
      conn.dataset.connected = String(connected);
      const lost = document.querySelector<HTMLTemplateElement>('template[data-part="lost"]')!;
      if (connected) conn.innerHTML = '<span class="badge">Live</span>';
      else conn.replaceChildren(lost.content.cloneNode(true));
    }
    const list = document.querySelector<HTMLUListElement>(".people");
    if (!view || !list) return;
    const now = Date.now() + offset;
    const me = Number(list.dataset.me);
    const part = (name: string) =>
      document.querySelector<HTMLTemplateElement>(`template[data-part="${name}"]`)!.content.cloneNode(true);
    const el = (tag: string, className: string, ...children: (Node | string)[]) => {
      const node = document.createElement(tag);
      node.className = className;
      node.append(...children);
      return node;
    };
    const people = [...view.members].sort((a, b) => Number(b.id === me) - Number(a.id === me));
    // Dony, while he's out, is last, and counted nowhere (BOT-5)
    const members = view.dony.member ? [...people, view.dony.member] : people;
    // Rows are patched in place, not rebuilt: a head is only redrawn when
    // that person's look changes, and the words and chips only when they
    // read differently, so nothing repaints every second (a freshly inserted
    // svg can flash black for a frame before its colours apply).
    const rows = new Map([...list.querySelectorAll<HTMLLIElement>(":scope > li")].map((li) => [li.dataset.id, li]));
    const ordered = members.map((m) => {
      const li = rows.get(String(m.id)) ?? el("li", "");
      li.dataset.id = String(m.id);
      li.className = [m.id === me && "me", m.away && "away"].filter(Boolean).join(" ");
      const dony = "dony" in m;
      const look = dony ? "dony" : lookKey(m.look);
      // someone else's row is one button that opens the menu (INT-1.10)
      let row: HTMLElement = li;
      if (m.id !== me) {
        let button = li.querySelector<HTMLButtonElement>(":scope > .person");
        if (!button) {
          button = el("button", "person") as HTMLButtonElement;
          button.type = "button";
          button.setAttribute("aria-haspopup", "menu");
          button.setAttribute("aria-expanded", String(menuOn?.id === m.id && menuOn.from === "row"));
          button.append(...li.childNodes);
          li.append(button);
        }
        button.setAttribute("aria-label", avatarLabel(m, stateAt(m, now), false));
        row = button;
      }
      if (li.dataset.look !== look || !row.querySelector(".av")) {
        // the head is drawn with every hair style; the look picks one and its
        // colours. Dony's is his own.
        const head = part(dony ? "dony-head" : "head") as DocumentFragment;
        if (!dony) {
          const svg = head.querySelector("svg")!;
          svg.setAttribute("style", lookVars(m.look));
          svg.dataset.hair = m.look.hair;
        }
        row.querySelector(".av")?.remove();
        row.prepend(head);
        li.dataset.look = look;
      }
      const state = stateAt(m, now);
      const parts = whatParts(m, now);
      const words = [m.name, m.id === me, m.host, ...parts.flat()].join("|");
      if (li.dataset.words !== words || !row.querySelector(".who")) {
        const what = el("span", "what", ...parts.map(([text, keep]) => (keep ? el("span", "n", text) : text)));
        const who = el(
          "span",
          "who",
          m.name,
          ...(m.id === me ? [" ", el("span", "badge", "You")] : []),
          ...(m.host ? [" ", el("span", "badge host", "Host")] : []),
          what,
        );
        row.querySelector(".who")?.remove();
        row.querySelector(".av")!.after(who);
        li.dataset.words = words;
      }
      const flags = `${state}|${m.away}`;
      if (li.dataset.flags !== flags || !row.querySelector(".chips")) {
        const chips = el("span", "chips", el("span", `chip state-${state}`, part(state), STATE_WORD[state]));
        if (m.away) chips.append(el("span", "chip away", part("away"), "Away"));
        row.querySelector(".chips")?.remove();
        row.append(chips);
        li.dataset.flags = flags;
      }
      return li;
    });
    // only reorder (which moves nodes) when the order or the people changed
    const current = [...list.children];
    if (current.length !== ordered.length || ordered.some((li, i) => current[i] !== li)) list.replaceChildren(...ordered);
    const alone = document.querySelector<HTMLElement>(".alone");
    if (alone) {
      alone.hidden = people.length > 1;
      const line = view.dony.out
        ? "Your squad's not in yet. Send them the passcode 📲"
        : "Just you so far. Send the passcode to the squad 📲";
      if (alone.textContent!.trim() !== line) alone.textContent = line;
    }
    const count = document.querySelector<HTMLElement>(".spots .count");
    if (count) count.textContent = `${people.length} of 12 in`;
    document.querySelectorAll(".spots .pips i").forEach((pip, i) => pip.classList.toggle("in", i < people.length));
    drawMap(now);
    drawPoster();
    drawMenu();
    followSenders();
  }

  // ---------- the map (GYM-1, GYM-9, GYM-10) ----------
  // Stations and avatars are patched from the newest message, like the list:
  // equipment is swapped when a station's changes, an avatar's sprite when
  // its pose or look does, and an avatar whose tile changes walks there,
  // showing the walk, and takes its pose when it arrives (GYM-10.17). Someone
  // on a machine carries its back and front layers, and the station's own
  // drawing steps aside until they get off (GYM-10.13).
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const STEP_MS = 125; // about 8 tiles a second
  let catchingUp = false; // a stream just (re)opened: place, don't walk
  // Dony mid-hop out of his poster, and where he goes once he lands
  const landing = new WeakMap<HTMLElement, { tile: Tile; onStation: boolean; pose: string }>();

  function drawMap(now: number) {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map || !view) return;
    const me = Number(map.dataset.me);
    const panel = map.closest(".map-panel")!;
    const copy = (attr: string) =>
      panel.querySelector<HTMLTemplateElement>(`template[${attr}]`)!.content.cloneNode(true) as DocumentFragment;

    const mine = view.members.find((m) => m.id === me)?.station?.slot;
    for (const s of view.stations) {
      const div = map.querySelector<HTMLElement>(`.station[data-slot="${s.slot}"]`);
      if (!div) continue;
      const equipment = s.equipment ?? "";
      if ((div.dataset.equipment ?? "") !== equipment) {
        // new equipment simply appears this week; the worker carries it in next
        div.replaceChildren(copy(equipment ? `data-gear="${equipment}"` : `data-bay="${s.slot}"`));
        if (equipment) div.dataset.equipment = equipment;
        else delete div.dataset.equipment;
        div.classList.remove("mine");
      }
      if (div.classList.contains("mine") !== (s.slot === mine)) {
        div.classList.toggle("mine", s.slot === mine);
        div.querySelector(".claim")?.remove();
        if (s.slot === mine) div.append(copy("data-claim"));
      }
    }
    const floor = document.querySelector<HTMLElement>("#floor");
    if (floor) floor.textContent = floorLine(view.stations);

    const left = new Map(
      [...map.querySelectorAll<HTMLButtonElement>(".avatar:not(.leaving)")].map((b) => [b.dataset.id!, b]),
    );
    const all = everyone(view);
    for (const p of spots(view, now)) {
      const m = all.find((x) => x.id === p.id)!;
      const dony = "dony" in m;
      let b = left.get(String(p.id));
      left.delete(String(p.id));
      if (!b) {
        // someone new walks in from the door; Dony hops down from his poster,
        // once it has shaken (3.2a), or is simply there under reduced motion
        b = document.createElement("button");
        b.type = "button";
        b.className = "avatar";
        b.dataset.id = String(p.id);
        b.append(Object.assign(document.createElement("span"), { className: "tag" }));
        place(b, dony && !reducedMotion.matches ? UNDER_POSTER : dony ? p.tile : DOOR);
        if (dony && !reducedMotion.matches && posterDrawn === false) {
          // hidden while the poster shakes, then one hop frame, then he walks
          // to wherever the newest message puts him (landing holds it)
          b.hidden = true;
          const arriving = b;
          landing.set(arriving, { tile: p.tile, onStation: p.onStation, pose: p.pose });
          setTimeout(() => {
            arriving.hidden = false;
            show(arriving, "hop");
            arriving.classList.add("hop");
            setTimeout(() => {
              arriving.classList.remove("hop");
              const to = landing.get(arriving)!;
              landing.delete(arriving);
              walk(arriving, to.tile, to.onStation, to.pose);
            }, STEP_MS);
          }, 250);
        }
        map.append(b);
      }
      b.classList.toggle("me", m.id === me);
      b.classList.toggle("away", m.away);
      // someone else opens the menu (INT-1.9); you don't (INT-1.8)
      if (m.id === me) b.removeAttribute("aria-haspopup");
      else {
        b.setAttribute("aria-haspopup", "menu");
        if (!b.hasAttribute("aria-expanded")) b.setAttribute("aria-expanded", "false");
      }
      b.dataset.state = p.state;
      b.setAttribute("aria-label", avatarLabel(m, p.state, m.id === me));
      const tag = b.querySelector<HTMLElement>(".tag")!;
      const tagKey = `${p.state}|${m.name}|${m.away}`;
      if (tag.dataset.key !== tagKey) {
        tag.className = `tag state-${p.state}`;
        tag.replaceChildren(Object.assign(document.createElement("span"), { className: "nm", textContent: m.name }));
        if (m.away) tag.append(copy("data-tag-away"));
        tag.dataset.key = tagKey;
      }
      const look = dony ? "dony" : lookKey(m.look);
      if (b.dataset.look !== look) {
        b.dataset.look = look;
        delete b.dataset.pose; // redraw in the new look
      }
      // he waits on the walkway until the hop, then walks like anyone
      if (landing.has(b)) {
        landing.set(b, { tile: p.tile, onStation: p.onStation, pose: p.pose });
        if (!b.querySelector(".av")) show(b, "stand");
      } else if (!busy(p.id)) {
        // a flex, an errand or a reaction holds them until it ends (F.5, A.2, A.4)
        if (!b.querySelector(".av")) show(b, p.pose);
        walk(b, p.tile, p.onStation, p.pose);
      }
    }
    for (const b of left.values()) {
      if (b.dataset.look !== "dony" || reducedMotion.matches) {
        b.remove();
        continue;
      }
      // Dony sent back: he gets off any machine at once (BOT-2.5), walks to
      // the walkway under his poster and hops in; his row has already gone,
      // and the poster fills once he's in (3.2a)
      b.classList.add("leaving");
      b.inert = true;
      walk(b, UNDER_POSTER, false, "stand", () => {
        show(b, "hop");
        b.classList.add("hop");
        setTimeout(() => {
          b.remove();
          drawPoster();
        }, STEP_MS);
      });
    }
    drawStations();
  }

  // A station hides its machine while someone is on it, not while they walk
  // to it or from it.
  function drawStations() {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map) return;
    const using = new Set(
      [...map.querySelectorAll<HTMLElement>(".avatar:not(.leaving)")]
        .filter((b) => isMachine(b.dataset.pose ?? ""))
        .map((b) => STATIONS.findIndex(([x, y]) => tileOf(b).join(",") === `${x},${y}`) + 1),
    );
    for (const div of map.querySelectorAll<HTMLElement>(".station")) {
      div.classList.toggle("occupied", using.has(Number(div.dataset.slot)));
    }
  }

  // An avatar's sprite in a pose, with the machine's layers round it on a
  // machine. Same pose, same look: nothing redrawn, so the frames keep their
  // beat (GYM-10.20).
  function show(b: HTMLElement, pose: string) {
    if (b.dataset.pose === pose && b.querySelector(".av")) return;
    const panel = b.closest(".map-panel")!;
    const copy = (attr: string) =>
      panel.querySelector<HTMLTemplateElement>(`template[${attr}]`)!.content.cloneNode(true) as DocumentFragment;
    const dony = b.dataset.look === "dony";
    const sprite = copy(dony ? `data-dony="${pose}"` : `data-pose="${pose}"`);
    if (!dony) {
      const m = view && everyone(view).find((x) => String(x.id) === b.dataset.id);
      const svg = sprite.querySelector("svg")!;
      if (m && !("dony" in m)) {
        svg.setAttribute("style", lookVars(m.look));
        svg.dataset.hair = m.look.hair;
      }
    }
    b.querySelectorAll(".av, .machine").forEach((el) => el.remove());
    if (isMachine(pose)) {
      const [back, front] = copy(`data-layers="${pose}"`).querySelectorAll("svg");
      b.append(back, sprite, front);
    } else b.append(sprite);
    b.dataset.pose = pose;
    b.classList.toggle("on-machine", isMachine(pose));
  }

  // ---------- Dony's poster (BOT-1, BOT-4; spec 3.2a) ----------
  // Full while he's in it, empty while he's out. It changes when a room
  // message says so: a shake, then the swap, and the dim for 30 s. While he
  // is walking back, it waits for him to hop in.
  let posterDrawn: boolean | undefined; // what the poster shows: out or not
  let posterRest: ReturnType<typeof setTimeout> | undefined;
  function drawPoster() {
    const button = document.querySelector<HTMLButtonElement>(".map-panel .poster");
    if (!button || !view) return;
    const out = view.dony.out;
    if (posterDrawn === undefined) posterDrawn = button.dataset.out === "true";
    const leaving = document.querySelector(".map-panel .avatar.leaving");
    if (out !== posterDrawn && !(!out && leaving)) {
      const svg = button.querySelector("svg")!;
      const swap = () => {
        svg.innerHTML = out ? '<use href="#poster-empty" />' : '<use href="#poster-full" /><use href="#poster-glint" class="glint" />';
      };
      if (reducedMotion.matches) swap();
      else {
        button.classList.remove("shake");
        void button.offsetWidth;
        button.classList.add("shake");
        setTimeout(() => {
          button.classList.remove("shake");
          swap();
        }, 250);
      }
      posterDrawn = out;
      button.dataset.out = String(out);
      button.classList.remove("pending");
      clearTimeout(pendingTimer);
    }
    button.value = out ? "send-back" : "summon";
    const resting = Date.now() + offset < view.dony.restingUntil;
    button.classList.toggle("resting", resting);
    if (resting || button.classList.contains("pending")) button.setAttribute("aria-disabled", "true");
    else button.removeAttribute("aria-disabled");
    button.setAttribute(
      "aria-label",
      (out ? "Send Dony back to his poster" : "Call Dony out of his poster") + (resting ? " (not ready yet)" : ""),
    );
    // one timer, not a tick: nothing counts down on screen
    clearTimeout(posterRest);
    if (resting) posterRest = setTimeout(drawPoster, view.dony.restingUntil - (Date.now() + offset) + 50);
  }

  // A tap posts in the background; the room's next message, which every
  // screen gets, is the answer. Without JS the form posts and the page comes
  // back with the result.
  let pendingTimer: ReturnType<typeof setTimeout> | undefined;
  document.addEventListener(
    "click",
    (e) => {
      const button = (e.target as Element).closest?.<HTMLButtonElement>(".map-panel .poster");
      if (!button) return;
      e.preventDefault();
      document.querySelector(".map-panel .poster-error")?.remove();
      if (button.getAttribute("aria-disabled") === "true") return;
      const form = document.querySelector<HTMLFormElement>("#dony")!;
      const body = new URLSearchParams([...new FormData(form, button)] as [string, string][]);
      button.classList.add("pending");
      button.setAttribute("aria-disabled", "true");
      const settle = () => {
        button.classList.remove("pending");
        drawPoster();
      };
      fetch(location.pathname, { method: "POST", body, headers: { "x-spotter": "poster" } })
        .then((res) => {
          if (!res.ok) throw new Error(String(res.status));
          // a tap that did nothing gets no message: stop waiting after 3 s
          clearTimeout(pendingTimer);
          pendingTimer = setTimeout(settle, 3000);
        })
        .catch(() => {
          settle();
          const error = Object.assign(document.createElement("p"), {
            className: "error poster-error",
            textContent: "Dony didn't hear you. Try again.",
          });
          error.setAttribute("role", "alert");
          button.closest(".map-panel")!.append(error);
          setTimeout(() => error.remove(), 8000);
        });
    },
    true,
  );

  const tileOf = (b: HTMLElement): Tile => [Number(b.style.getPropertyValue("--x")), Number(b.style.getPropertyValue("--y"))];
  function place(b: HTMLElement, [x, y]: Tile) {
    b.style.setProperty("--x", String(x));
    b.style.setProperty("--y", String(y));
  }
  // Steps an avatar along the aisles to its tile, one tile a step, showing the
  // walk and holding nothing, and puts it in its pose when it arrives; a new
  // target mid-walk sets off again from wherever it has got to (GYM-10.17,
  // GYM-10.18).
  const walks = new WeakMap<HTMLElement, { to: string; pose: string; timer: ReturnType<typeof setInterval> }>();
  function walk(b: HTMLElement, to: Tile, onStation: boolean, pose: string, then?: () => void) {
    const key = to.join(",");
    const going = walks.get(b);
    if (going?.to === key) {
      going.pose = pose; // same place, new pose: taken on arrival
      return;
    }
    if (going) clearInterval(going.timer);
    const arrive = () => {
      place(b, to);
      b.classList.toggle("on-station", onStation);
      show(b, walks.get(b)?.pose ?? pose);
      walks.delete(b);
      then?.();
      drawStations();
    };
    const path = route(tileOf(b), to);
    if (path.length === 0 || reducedMotion.matches || catchingUp) {
      walks.delete(b);
      place(b, to);
      b.classList.toggle("on-station", onStation);
      show(b, pose);
      then?.();
      return;
    }
    b.classList.remove("on-station");
    show(b, "walk");
    const timer = setInterval(() => {
      const next = path.shift();
      if (next) place(b, next);
      if (path.length === 0) {
        clearInterval(timer);
        arrive();
      }
    }, STEP_MS);
    walks.set(b, { to: key, pose, timer });
  }

  // GYM-1: the map at the largest whole-number scale that fits the panel and
  // the screen, so its pixels stay square
  function fitMap() {
    const map = document.querySelector<HTMLElement>(".map-panel .map");
    if (!map) return;
    const panel = map.closest<HTMLElement>(".map-panel")!;
    const style = getComputedStyle(panel);
    const width = panel.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    const bar = document.querySelector<HTMLElement>(".topbar")?.offsetHeight ?? 0;
    const size = 10 * TILE;
    const s = Math.max(1, Math.floor(Math.min(width / size, (innerHeight - bar - 48) / size)));
    map.style.setProperty("--s", String(s));
  }
  addEventListener("resize", fitMap);
  document.addEventListener("astro:page-load", fitMap);

  // your own avatar is a shortcut to the sheet's button (Done, Start set…)
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest?.(".map-panel .avatar.me");
    if (b) document.querySelector<HTMLElement>(".dock button.wide")?.focus();
  });

  // ---------- staying in place ----------
  // Everything that stays in this room swaps only the room, in place, so the
  // scroll, the focus and anything typed but not yet logged stay where they
  // were: logging, editing, deleting, the rest buttons, choosing a lift and
  // Start set (POSTs), and the pencil and Cancel (GETs). The client router would
  // load them as a new page and scroll to the top. Finish, Leave and End room
  // go to another page, so the router takes them. Without JS all of these
  // are plain forms and links.
  const STAY = new Set(["log", "edit", "delete", "rest", "choose", "start"]);

  // after() runs once the new room is in, and names the control to focus
  // (the request is not called `init`, which would hide init() below)
  async function swap(url: URL, request: RequestInit, fallback: () => void, after: () => HTMLElement | null) {
    const focused = !!document.activeElement?.closest(".gym");
    let res: Response;
    try {
      res = await fetch(url, request);
    } catch {
      return fallback(); // offline or dropped: let the browser try
    }
    // the room closed under us, or anything unexpected: go where it says
    if (new URL(res.url).pathname !== location.pathname || (res.status !== 200 && res.status !== 400)) {
      return navigate(res.url);
    }
    const next = new DOMParser().parseFromString(await res.text(), "text/html");
    const gym = next.querySelector(".gym");
    if (!gym) return navigate(res.url);
    // the map carries on as it is: everyone walks on from where they are
    // (GYM-10.16) rather than jumping to where the new page draws them
    const oldMap = document.querySelector(".gym .map-panel .map");
    const newMap = gym.querySelector(".map-panel .map");
    if (oldMap && newMap) {
      newMap.querySelectorAll(".avatar").forEach((b) => b.remove());
      newMap.append(...oldMap.querySelectorAll(".avatar"));
      // pops, bubbles, a banner, an open menu and a refusal carry on too
      for (const sel of [".pops", ".says:not(.offers)", ".says.offers", ".banner-slot"]) newMap.querySelector(sel)?.replaceWith(oldMap.querySelector(sel)!);
      newMap.append(...oldMap.querySelectorAll(":scope > .menu, :scope > .note, :scope > .error"));
      for (const div of oldMap.querySelectorAll<HTMLElement>(".station")) {
        newMap.querySelector(`.station[data-slot="${div.dataset.slot}"]`)?.replaceWith(div);
      }
    }
    // the room log is the server's again, with the menu's limits; an open
    // menu on the old page goes with it
    const opened = menuOn;
    closeMenu(false);
    document.querySelector(".gym")!.replaceWith(document.adoptNode(gym));
    if (opened) reopenMenu(opened);
    document.title = next.title;
    // keep the router's own history state, so Back still works
    if (res.url !== location.href) history.replaceState(history.state, "", res.url);
    posterDrawn = undefined;
    tick = init();
    tick();
    liveTick();
    const target = after();
    // keyboard and screen-reader users carry on from where they were
    if (focused) (document.querySelector<HTMLElement>(".sheet [aria-invalid]") ?? target)?.focus({ preventScroll: true });
  }

  const firstField = () => document.querySelector<HTMLElement>(".sheet form input:not([type=hidden]), .sheet select");

  // Done landed (a 400 has no stamp): say what was logged, and on a phone,
  // if the sheet's top was scrolled away, jump it back to just under the top
  function afterDone() {
    const stamp = document.querySelector<HTMLElement>(".dock .stamp");
    if (!stamp) return;
    const news = document.querySelector<HTMLElement>("#sheet-news");
    // GYM-17.9: a PB says the set number too, and says it in words (F.7)
    const pb = stamp.classList.contains("pb");
    const set = stamp.querySelector("b")?.textContent ?? "";
    const line = pb ? `Set ${stamp.dataset.n} logged: ${set}. New personal best` : stamp.textContent!.replace(/\s+/g, " ").trim();
    if (news) {
      news.textContent = "";
      setTimeout(() => (news.textContent = line), 50);
    }
    const top = document.querySelector<HTMLElement>(".sheet")!.getBoundingClientRect().top;
    if (matchMedia("(max-width: 899px)").matches && top < 24) scrollBy({ top: top - 24, behavior: "instant" });
    // a reload shouldn't stamp the same set again
    const url = new URL(location.href);
    url.searchParams.delete("rested");
    url.searchParams.delete("pb");
    history.replaceState(history.state, "", url);
  }

  document.addEventListener(
    "submit",
    (e) => {
      const form = e.target as HTMLFormElement;
      if (!form.closest(".gym")) return;
      // not form.action or form.method: these forms have a field named "action", which shadows it
      const url = new URL(form.getAttribute("action") ?? "", location.href);
      const data = new FormData(form, e.submitter);
      if ((form.getAttribute("method") ?? "get").toLowerCase() === "get") {
        url.search = new URLSearchParams([...data] as [string, string][]).toString();
        e.preventDefault();
        return swap(url, {}, () => location.assign(url), firstField);
      }
      const action = String(data.get("action") ?? "log");
      if (!STAY.has(action)) return;
      e.preventDefault(); // the form's own listeners still run: pending, the stopwatch

      // what was typed and not logged, to put back after a rest button
      const typed = new Map<string, string>();
      if (action === "rest") {
        for (const input of document.querySelectorAll<HTMLInputElement>(".set-form input:not([type=hidden])")) {
          typed.set(input.id, input.value);
        }
      }
      const delta = (e.submitter as HTMLButtonElement | null)?.value;
      swap(url, { method: "POST", body: new URLSearchParams([...data] as [string, string][]) }, () => form.submit(), () => {
        for (const [id, value] of typed) {
          const input = document.querySelector<HTMLInputElement>(`.set-form #${id}`);
          if (input && !input.readOnly) input.value = value;
        }
        if (action === "log") afterDone();
        return action === "rest"
          ? document.querySelector<HTMLElement>(`.rest-adjust button[value="${delta}"]`)
          : document.querySelector<HTMLElement>(".sheet .wide");
      });
    },
    true,
  );

  // ======================================================================
  // Interactions, presets and emoji (criteria/int.md; room spec I.2 to I.9)
  // ======================================================================
  // Everything here is a second layer over the room: it never sits between
  // the person and their set. Moves are posted in the background and answered
  // in JSON; what plays comes from the room's stream, so a screen only ever
  // plays what the server accepted (INT-3.10).

  const meId = () => Number(document.querySelector<HTMLElement>(".map-panel .map")?.dataset.me);
  const phone = matchMedia("(max-width: 899px)");
  const tpl = (name: string) =>
    document.querySelector<HTMLTemplateElement>(`template[data-part="${name}"]`)!.content.cloneNode(true) as DocumentFragment;
  // someone in the room, from the newest message, or before the first one
  // arrives (or with the stream down) from the room as the server drew it
  type Someone = { id: number; name: string; state: State; away: boolean; look?: Look; dony?: true };
  function personIn(id: number): Someone | undefined {
    if (view) {
      const m = everyone(view).find((m) => m.id === id) as MemberView | undefined;
      if (!m) return undefined;
      return { id: m.id, name: m.name, state: stateAt(m, nowServer()), away: m.away, ...("dony" in m ? { dony: true as const } : { look: m.look }) };
    }
    const b = avatarOf(id);
    const row = document.querySelector<HTMLElement>(`.people li[data-id="${id}"]`);
    if (!b) return undefined;
    const look = row?.dataset.look ?? b.dataset.look;
    return {
      id,
      name: b.querySelector(".tag .nm")?.textContent ?? "",
      state: b.dataset.state as State,
      away: b.classList.contains("away"),
      ...(look === "dony" ? { dony: true as const } : { look: lookFromKey(look) ?? undefined }),
    };
  }
  const avatarOf = (id: number) => document.querySelector<HTMLElement>(`.map-panel .avatar[data-id="${id}"]:not(.leaving)`);
  const nowServer = () => Date.now() + offset;

  // someone's head, as their squad row draws it
  function head(m: Someone): DocumentFragment {
    const h = tpl(m.dony ? "dony-head" : "head");
    if (!m.dony && m.look) {
      const svg = h.querySelector("svg")!;
      svg.setAttribute("style", lookVars(m.look));
      svg.dataset.hair = m.look.hair;
    }
    return h;
  }

  // the copy bank's words (system.md section 3)
  const REFUSED: Record<Refusal, (name: string) => string> = {
    "target-lifting": (n) => `${n} is mid-set. Cheer instead?`,
    "target-finished": (n) => `${n}'s done for today. Cheer instead?`,
    gone: (n) => `${n}'s left the gym.`,
    "rate-limit": () => "Easy, give them 10 seconds.",
    self: () => "",
    // INT-9, INT-10 (room spec F.9)
    "too-late": () => "Too late to answer that one.",
    answered: () => "Already answered.",
    "nothing-to-answer": () => "Too late to answer that one.",
    "target-away": (n) => `${n}'s away right now.`,
    "too-slow": (n) => `Too slow. ${n}'s hand is down.`,
  };
  const FAILED = "That didn't send. Try again.";

  // INT-11.5: what the sender did, for the confirmation line and its screen
  // reader line (room spec F.9)
  const SENT: Record<Move | "offer", (n: string) => [line: string, said: string]> = {
    cheer: (n) => [`You cheered ${n} 🔥`, `Cheered ${n}`],
    poke: (n) => [`You poked ${n} 👉`, `Poked ${n}`],
    slap: (n) => [`You slapped ${n} 👋`, `Slapped ${n}`],
    thanks: (n) => [`You thanked ${n} 🙏`, `Thanked ${n}`],
    "poke-back": (n) => [`You poked ${n} back 👉`, `Poked ${n} back`],
    "slap-back": (n) => [`You returned ${n}'s slap 👋`, `Returned ${n}'s slap`],
    offer: (n) => [`You offered ${n} a high-five ✋`, `Offered ${n} a high-five`],
    highfive: (n) => [`You high-fived ${n} 🙌`, `High-fived ${n}`],
  };
  function say(line: string) {
    const news = document.querySelector<HTMLElement>("#sheet-news");
    if (!news) return;
    news.textContent = "";
    setTimeout(() => (news.textContent = line), 50);
  }
  // R9: the line shows only when their avatar is out of view; the screen
  // reader hears it either way. A soft sound says it landed (INT-12.1).
  function landed(what: Move | "offer", id: number, name: string) {
    const [line, said] = SENT[what](name);
    say(said);
    blip("sent");
    const b = avatarOf(id);
    const r = b?.getBoundingClientRect();
    const inView = !!r && r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth && r.width > 0;
    if (!inView) tell(line, false, undefined, "", true);
  }

  // Posts a move as the page's forms would, and reads the JSON answer.
  async function send(
    fields: Record<string, string>,
  ): Promise<{ ok: true; at: number; offer?: number; until?: number; done?: boolean } | { ok: false; reason: Refusal | "failed" }> {
    try {
      const res = await fetch(location.pathname, { method: "POST", body: new URLSearchParams(fields) });
      const body = res.headers.get("content-type")?.includes("json") ? await res.json() : null;
      if (body && typeof body.ok === "boolean") return body;
      return { ok: false, reason: "failed" };
    } catch {
      return { ok: false, reason: "failed" };
    }
  }

  // ---------- what is open between you and each person (INT-9, INT-10, GYM-18) ----------
  // From the room's lists (a reload, a reconnect: INT-9.13, INT-10.12),
  // brought up to date by each event in between. Each runs out at its own
  // `until`, server time.
  // `taken`: an offer to Dony he's going to accept at `until` (BOT-7.2)
  type Open = { id: number; from: number; to: number; until: number; taken?: boolean };
  let answers: (Open & { kind: Reply })[] = [];
  let offers: Open[] = [];
  let pbs: { userId: number; exercise: { id: number; name: string }; until: number }[] = [];
  function readMoments(v: RoomView) {
    answers = v.answerable;
    offers = v.offers;
    pbs = v.pbs;
    for (const o of offers) if (o.from === meId() && !lapseTimers.has(o.id)) watchLapse(o);
    drawOffers();
    redrawAnswers();
  }
  const stillOpen = <T extends { until: number }>(xs: T[]) => xs.filter((x) => x.until > nowServer());
  // what you can answer from this person now: their offer first, then their
  // interaction (INT-9.10's order)
  function answerFrom(id: number): { offer: Open } | { reply: Open & { kind: Reply } } | undefined {
    const me = meId();
    const offer = stillOpen(offers).find((o) => o.from === id && o.to === me);
    if (offer) return { offer };
    const reply = stillOpen(answers).find((a) => a.from === id && a.to === me);
    return reply && { reply };
  }
  const freshPb = (id: number) => stillOpen(pbs).find((p) => p.userId === id);
  // one timer brings the menu and banner in line when the next thing runs out
  let momentTimer: ReturnType<typeof setTimeout> | undefined;
  function redrawAnswers() {
    if (menuOn) drawMenu();
    // the banner's button goes early when its answer stops being possible (F.2)
    const act = document.querySelector<HTMLButtonElement>(".banner-act");
    if (act?.dataset.from && !act.dataset.room) {
      const a = answerFrom(Number(act.dataset.from));
      const still = act.dataset.offer ? a && "offer" in a && a.offer.id === Number(act.dataset.offer) : a && "reply" in a && a.reply.id === Number(act.dataset.answers);
      if (!still) act.closest(".banner")?.remove();
    }
    clearTimeout(momentTimer);
    const next = [...answers, ...offers, ...pbs].map((x) => x.until).filter((t) => t > nowServer());
    if (next.length) momentTimer = setTimeout(() => {
      drawOffers();
      redrawAnswers();
    }, Math.min(...next) - nowServer() + 20);
  }

  // ---------- the menu (INT-1, INT-2; I.2) ----------
  let menuOn: { id: number; from: "map" | "row" } | undefined;
  // the menu's rows that are drawn: the answer row and High-five come and go (F.3)
  const ROW = "li:not([hidden]) > .act";
  // INT-4.7: when your 10 s on each person run out, from the page, then
  // from each accepted interaction
  let limits = new Map<number, number>();
  const readLimits = () => {
    const gym = document.querySelector<HTMLElement>(".gym");
    limits = new Map(Object.entries(JSON.parse(gym?.dataset.limits ?? "{}")).map(([k, v]) => [Number(k), Number(v)]));
  };
  let limitTimer: ReturnType<typeof setTimeout> | undefined;
  const menuEl = () => document.querySelector<HTMLElement>(".menu");
  const opener = () =>
    menuOn &&
    (menuOn.from === "row"
      ? document.querySelector<HTMLElement>(`.people li[data-id="${menuOn.id}"] > .person`)
      : avatarOf(menuOn.id));

  // By keyboard (Enter or Space on the avatar or row), focus moves into the
  // menu (INT-1.2); a tap or click leaves it on the avatar, as before, and the
  // menu's own keys still work from there (INT-1.1).
  function openMenu(id: number, from: "map" | "row", byKeyboard = true) {
    if (id === meId() || !personIn(id)) return;
    closeMenu(false);
    menuOn = { id, from };
    const menu = tpl("menu").firstElementChild as HTMLElement;
    const map = document.querySelector<HTMLElement>(".map-panel .map")!;
    map.append(menu);
    drawMenu();
    placeMenu();
    for (const el of [avatarOf(id), document.querySelector(`.people li[data-id="${id}"] > .person`)]) el?.setAttribute("aria-expanded", "true");
    if (byKeyboard) (menu.querySelector<HTMLElement>(`${ROW}.hot:not([aria-disabled])`) ?? menu.querySelector<HTMLElement>(ROW))!.focus({ preventScroll: true });
  }
  // after a swap: the same person, if they're still here
  function reopenMenu(was: { id: number; from: "map" | "row" }) {
    if (personIn(was.id)) openMenu(was.id, was.from);
  }

  function closeMenu(refocus = true) {
    const menu = menuEl();
    if (!menu) return void (menuOn = undefined);
    const back = opener();
    menu.remove();
    clearTimeout(limitTimer);
    document.querySelectorAll('[aria-haspopup="menu"][aria-expanded="true"]').forEach((el) => el.setAttribute("aria-expanded", "false"));
    menuOn = undefined;
    if (refocus) back?.focus({ preventScroll: true });
  }

  // The menu as the newest room message has it: the person's head, name and
  // state, which move fits, and why anything is unavailable (INT-1.6).
  function drawMenu() {
    const menu = menuEl();
    if (!menu || !menuOn) return;
    const m = personIn(menuOn.id);
    if (!m) {
      // they left (INT-1.7): focus the next avatar in tab order, else the dock's button
      const avatars = [...document.querySelectorAll<HTMLElement>(".map-panel .avatar:not(.leaving):not(.me)")];
      const was = menuOn.id;
      closeMenu(false);
      const next = avatars.find((a) => Number(a.dataset.id) !== was);
      (next ?? document.querySelector<HTMLElement>(".dock button.wide"))?.focus({ preventScroll: true });
      return;
    }
    const state = m.state;
    const who = menu.querySelector<HTMLElement>(".menu-who")!;
    const key = `${m.id}|${m.dony ? "dony" : m.look ? lookKey(m.look) : ""}`;
    if (who.dataset.key !== key) {
      who.querySelector(".av")?.remove();
      who.prepend(head(m));
      who.dataset.key = key;
    }
    const name = menu.querySelector<HTMLElement>(".menu-name")!;
    const chips = document.createElement("span");
    chips.className = "chips";
    const chip = document.createElement("span");
    chip.className = `chip state-${state}`;
    chip.append(tpl(state), STATE_WORD[state]);
    chips.append(chip);
    if (m.away) {
      const away = document.createElement("span");
      away.className = "chip away";
      away.append(tpl("away"), "Away");
      chips.append(away);
    }
    name.replaceChildren(m.name, chips);
    menu.querySelector(".menu-to")!.textContent = `To ${m.name}`;

    const limited = (limits.get(m.id) ?? 0) > nowServer();
    const slapNo = slapRefusal(state);
    // F.3: the answer row (their offer, else their interaction), the PB
    // window, then I.2's rule by state; with an answer row it alone is hot
    const answer = answerFrom(m.id);
    const pb = freshPb(m.id);
    const awayNo = m.away && !m.dony;
    const hot = answer ? [] : pb ? ["cheer", "highfive"] : state === "slacking" ? ["poke", "slap"] : state === "lifting" ? ["cheer"] : [];
    const row = menu.querySelector<HTMLLIElement>("li.answer")!;
    row.hidden = !answer;
    // never two High-fives (F.3): while their offer is open, the permanent row goes
    menu.querySelector<HTMLElement>('.act[value="highfive"]')!.closest("li")!.hidden = !!answer && "offer" in answer;
    let answerNo: Refusal | null = null;
    if (answer) {
      const b = row.querySelector<HTMLButtonElement>(".act")!;
      const kind = "offer" in answer ? "highfive" : answer.reply.kind;
      b.value = kind;
      b.dataset.id = String("offer" in answer ? answer.offer.id : answer.reply.id);
      const word = ANSWER_WORD[kind];
      b.setAttribute("aria-label", `${word} ${m.name}`);
      const icon = row.querySelector<HTMLElement>(".answer-icon")!;
      if (icon.dataset.kind !== kind) {
        icon.replaceChildren(tpl(`log-${LOG_ICON[kind]}`));
        icon.dataset.kind = kind;
      }
      row.querySelector(".answer-word")!.textContent = word;
      // Slap back follows Slap's rule; the row stays, dashed (F.3)
      answerNo = kind === "slap-back" ? slapNo : null;
      if (answerNo) b.setAttribute("aria-disabled", "true");
      else b.removeAttribute("aria-disabled");
      b.classList.toggle("hot", !answerNo);
    }
    for (const b of menu.querySelectorAll<HTMLButtonElement>("li:not(.answer) > .act")) {
      const kind = b.value;
      const off = kind !== "message" && (limited || (kind === "slap" && !!slapNo) || (kind === "highfive" && awayNo));
      if (off) b.setAttribute("aria-disabled", "true");
      else b.removeAttribute("aria-disabled");
      b.classList.toggle("hot", hot.includes(kind) && !off);
    }
    // GYM-18.6: one gold line while their PB is fresh
    const news = menu.querySelector<HTMLElement>(".menu-news")!;
    news.hidden = !pb;
    if (pb) news.querySelector("span")!.textContent = `Just hit a PB on ${pb.exercise.name.toLowerCase()}`;
    const why = menu.querySelector<HTMLElement>(".menu-why")!;
    const text = answerNo
      ? REFUSED[answerNo](m.name)
      : limited
        ? REFUSED["rate-limit"](m.name)
        : slapNo
          ? REFUSED[slapNo](m.name)
          : awayNo
            ? REFUSED["target-away"](m.name)
            : "";
    why.textContent = text;
    why.hidden = !text;
    // back by themselves when the 10 s run out, without reopening
    clearTimeout(limitTimer);
    if (limited) limitTimer = setTimeout(drawMenu, limits.get(m.id)! - nowServer() + 20);
  }
  const ANSWER_WORD: Record<Reply | "highfive", string> = { thanks: "Thanks", "poke-back": "Poke back", "slap-back": "Slap back", highfive: "High-five" };

  // Laptop: beside the avatar (the side away from the nearer wall), or
  // under the squad row. Phone: CSS pins it above the dock.
  function placeMenu() {
    const menu = menuEl();
    const from = opener();
    if (!menu || !from || phone.matches) {
      if (menu) {
        menu.style.left = menu.style.top = "";
        document.documentElement.style.setProperty("--dock-h", `${document.querySelector<HTMLElement>(".dock")?.offsetHeight ?? 92}px`);
      }
      return;
    }
    const map = menu.parentElement!.getBoundingClientRect();
    const r = from.getBoundingClientRect();
    if (menuOn?.from === "row") {
      menu.style.left = `${r.left - map.left}px`;
      menu.style.top = `${r.bottom - map.top + 8}px`;
      return;
    }
    const tag = from.querySelector(".tag")?.getBoundingClientRect() ?? r;
    const left = Math.min(r.left, tag.left);
    const right = Math.max(r.right, tag.right);
    const west = r.left + r.width / 2 > map.left + map.width / 2;
    const x = west ? left - map.left - menu.offsetWidth - 16 : right - map.left + 16;
    const top = Math.min(Math.max(0, r.top - map.top), Math.max(0, map.height - menu.offsetHeight));
    menu.style.left = `${Math.max(-map.left + 8, x)}px`;
    menu.style.top = `${top}px`;
  }
  addEventListener("resize", () => placeMenu());

  // the message view, and back
  function showMessages(on: boolean) {
    const menu = menuEl();
    if (!menu) return;
    menu.querySelector<HTMLElement>(".menu-acts")!.hidden = on;
    menu.querySelector<HTMLElement>(".menu-why")!.hidden = on || !menu.querySelector(".menu-why")!.textContent;
    menu.querySelector<HTMLElement>(".menu-message")!.hidden = !on;
    menu.querySelector<HTMLElement>(on ? ".preset" : '.act[value="message"]')!.focus({ preventScroll: true });
    if (!on) drawMenu();
  }

  // A refusal (dashed) or a failure (red) where the menu was: beside the
  // target on a laptop, just above the dock on a phone (INT-3.14).
  function tell(text: string, failed: boolean, near: number | undefined, className = "", sent = false) {
    document.querySelectorAll(`.gym .note, .gym .error${className ? "" : ":not(.emote-error)"}`).forEach((n) => {
      if (!className || n.classList.contains(className)) n.remove();
    });
    const line = document.createElement("p");
    line.className = [failed ? "error" : "note", sent && "sent", className].filter(Boolean).join(" ");
    line.setAttribute("role", failed ? "alert" : "status");
    // the confirmation line (F.9): a tick first, solid leaf, 2 s, and its
    // words already said once through #sheet-news
    if (sent) {
      line.removeAttribute("role");
      line.setAttribute("aria-hidden", "true");
      line.append(tpl("tick"));
    }
    line.append(text);
    const target = near !== undefined ? avatarOf(near) : null;
    if (!phone.matches && target && !className) {
      const map = document.querySelector<HTMLElement>(".map-panel .map")!;
      map.append(line);
      const m = map.getBoundingClientRect();
      const r = target.getBoundingClientRect();
      const west = r.left + r.width / 2 > m.left + m.width / 2;
      line.style.top = `${Math.max(0, r.top - m.top + 8)}px`;
      line.style.left = west ? `${r.left - m.left - line.offsetWidth - 12}px` : `${r.right - m.left + 12}px`;
    } else document.querySelector(".dock")!.append(line);
    setTimeout(() => line.remove(), sent ? 2000 : 4000);
  }

  let sending = false;
  // A move from the menu (or a banner's button, `answering` set): Cheer,
  // Poke, Slap, a High-five offer, or an answer to their offer or move.
  async function act(kind: string, answering?: { id: number; offer: boolean; to: number }, to?: number) {
    const id = answering?.to ?? to ?? menuOn?.id;
    if (id === undefined) return;
    const m = personIn(id);
    if (!answering && to === undefined) closeMenu(); // at once (INT-3.10)
    if (sending) return; // a double tap sends one (INT-4.5, INT-9.6)
    sending = true;
    const fields: Record<string, string> = answering
      ? answering.offer
        ? { action: "accept", offer: String(answering.id) }
        : { action: "reply", answers: String(answering.id) }
      : { action: "interact", to: String(id), kind };
    const r = await send(fields);
    sending = false;
    const name = m?.name ?? "They";
    if (r.ok) {
      // a reply or an acceptance counts as your latest with them (F10)
      limits.set(id, r.at + 10_000);
      if (answering) {
        if (answering.offer) offers = offers.filter((o) => o.id !== answering.id);
        else answers = answers.filter((a) => a.id !== answering.id);
      }
      // for an answer, `kind` is the answer's own (thanks, poke-back, slap-back)
      const what: Move | "offer" = kind === "highfive" ? (r.done ? "highfive" : "offer") : (kind as Move);
      landed(what, id, name);
      if (what === "offer" && r.offer && r.until) offers = [...offers.filter((o) => o.id !== r.offer), { id: r.offer, from: meId(), to: id, until: r.until }];
      redrawAnswers();
    } else if (r.reason === "failed") tell(FAILED, true, id);
    // a double tap's second, already answered, shows nothing (INT-9.6)
    else if (r.reason !== "self" && !(r.reason === "answered" && Date.now() - lastAnswerTap < 1500)) {
      if (r.reason === "rate-limit") limits.set(id, Math.max(limits.get(id) ?? 0, nowServer() + 1000));
      if (answering && r.reason !== "target-lifting" && r.reason !== "target-finished") {
        if (answering.offer) offers = offers.filter((o) => o.id !== answering.id);
        else answers = answers.filter((a) => a.id !== answering.id);
        redrawAnswers();
      }
      tell(REFUSED[r.reason](name), false, id);
    }
  }
  let lastAnswerTap = 0;

  async function sayPreset(preset: string) {
    if (!menuOn) return;
    const id = menuOn.id;
    const m = personIn(id);
    closeMenu();
    const r = await send({ action: "say", to: String(id), preset });
    // a preset refused for its 2 s shows nothing: the first one went (I.3)
    if (!r.ok && r.reason === "failed") tell(FAILED, true, id);
    else if (!r.ok && (r.reason === "gone" || r.reason === "target-lifting" || r.reason === "target-finished")) {
      tell(REFUSED[r.reason](m?.name ?? "They"), false, id);
    }
  }

  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    const menu = menuEl();
    const actButton = t.closest?.<HTMLButtonElement>(".menu .act");
    if (actButton) {
      if (actButton.getAttribute("aria-disabled") === "true") return; // stays open, sends nothing
      if (actButton.value === "message") return showMessages(true);
      // the answer row: accept their offer, or answer their move
      if (actButton.closest("li.answer") && menuOn) {
        const to = menuOn.id;
        closeMenu();
        lastAnswerTap = Date.now();
        return void act(actButton.value, { id: Number(actButton.dataset.id), offer: actButton.value === "highfive", to });
      }
      return void act(actButton.value);
    }
    // a banner's one button (F.2): live after its first half second
    const bannerAct = t.closest?.<HTMLButtonElement>(".banner-act");
    if (bannerAct) {
      if (Date.now() - Number(bannerAct.dataset.shown) < 500 || bannerAct.disabled) return;
      const to = Number(bannerAct.dataset.from);
      bannerAct.closest(".banner")?.remove();
      lastAnswerTap = Date.now();
      if (bannerAct.dataset.room) return void act("cheer", undefined, to);
      const offer = !!bannerAct.dataset.offer;
      return void act(offer ? "highfive" : bannerAct.dataset.kind!, { id: Number(bannerAct.dataset.offer ?? bannerAct.dataset.answers), offer, to });
    }
    if (t.closest?.(".menu .back")) return showMessages(false);
    const preset = t.closest?.<HTMLButtonElement>(".menu .preset");
    if (preset) return void sayPreset(preset.value);
    if (t.closest?.(".menu")) return;
    const other = t.closest?.<HTMLElement>(".map-panel .avatar:not(.me):not(.leaving)");
    const row = t.closest?.<HTMLElement>(".people .person");
    if (other || row) {
      const id = Number((other ?? row!.closest("li"))!.dataset.id);
      if (menu && menuOn?.id === id) return closeMenu();
      // Enter or Space on a button clicks it with a detail of 0
      return openMenu(id, other ? "map" : "row", (e as MouseEvent).detail === 0);
    }
  });
  // a tap anywhere outside closes the menu, and isn't swallowed (INT-1.3)
  document.addEventListener(
    "pointerdown",
    (e) => {
      const t = e.target as Element;
      if (menuEl() && !t.closest?.(".menu") && !t.closest?.(".map-panel .avatar:not(.me)") && !t.closest?.(".people .person")) {
        closeMenu(false);
      }
      if (!t.closest?.(".tray") && !t.closest?.(".dock .emote")) closeTray(false);
    },
    true,
  );

  // Keyboard (INT-1.2): Tab, Shift+Tab and the arrows go round the rows and
  // wrap; Home and End; Escape closes, from Message it goes Back first.
  document.addEventListener("keydown", (e) => {
    const menu = menuEl();
    if (!menu) return;
    if (!menu.contains(document.activeElement)) {
      if (e.key === "Escape") closeMenu();
      // opened by a tap, focus still on its opener: the menu's keys take it in
      else if (document.activeElement === opener() && ["Tab", "ArrowDown", "ArrowUp"].includes(e.key)) {
        e.preventDefault();
        menu.querySelector<HTMLElement>(ROW)!.focus({ preventScroll: true });
      }
      return;
    }
    const rows = [...menu.querySelectorAll<HTMLElement>(menu.querySelector<HTMLElement>(".menu-message")!.hidden ? ROW : ".back, .preset")];
    const i = rows.indexOf(document.activeElement as HTMLElement);
    const go = (j: number) => {
      e.preventDefault();
      rows[(j + rows.length) % rows.length].focus({ preventScroll: true });
    };
    if (e.key === "Escape") {
      e.preventDefault();
      if (!menu.querySelector<HTMLElement>(".menu-message")!.hidden) showMessages(false);
      else closeMenu();
    } else if (e.key === "Tab") go(e.shiftKey ? i - 1 : i + 1);
    else if (e.key === "ArrowDown") go(i + 1);
    else if (e.key === "ArrowUp") go(i - 1);
    else if (e.key === "Home") go(0);
    else if (e.key === "End") go(rows.length - 1);
  });

  // ---------- reactions and banners (INT-3; I.4, I.5) ----------
  // F.6: each frame with its own start and length (ms), the jolt the whole
  // sprite does, the total, and the ★ frames reduced motion shows still
  type Frame = [href: string, at: number, ms: number];
  type Reaction = { frames: Frame[]; jolt?: "hop" | "nudge" | "shake"; total: number; still: string[] };
  const POKE: Frame[] = [["poke-1", 0, 250], ["poke-2", 250, 350], ["poke-3", 600, 400]];
  const SLAP: Frame[] = [["slap-1", 0, 150], ["slap-2", 150, 300], ["slap-3", 450, 350], ["slap-4", 800, 400]];
  const REACTION: Record<Move, Reaction> = {
    cheer: { frames: [["cheer-1", 0, 200], ["cheer-2", 200, 250], ["cheer-4", 450, 350], ["cheer-3", 800, 300]], jolt: "hop", total: 1100, still: ["cheer-4"] },
    poke: { frames: POKE, jolt: "nudge", total: 1000, still: ["poke-2"] },
    slap: { frames: SLAP, jolt: "shake", total: 1200, still: ["slap-2"] },
    thanks: { frames: [["thanks-1", 0, 300], ["thanks-2", 300, 450], ["thanks-3", 750, 350]], jolt: "hop", total: 1100, still: ["thanks-2"] },
    "poke-back": { frames: [...POKE, ["back-1", 0, 1000]], jolt: "nudge", total: 1000, still: ["poke-2", "back-1"] },
    "slap-back": { frames: [...SLAP, ["back-1", 0, 450]], jolt: "shake", total: 1200, still: ["slap-2", "back-1"] },
    highfive: { frames: [["highfive-1", 0, 250], ["highfive-2", 250, 350], ["highfive-3", 600, 400]], jolt: "nudge", total: 1000, still: ["highfive-2"] },
  };
  const SVG = "http://www.w3.org/2000/svg";
  const fxTimers = new WeakMap<Element, ReturnType<typeof setTimeout>>();
  // `west`: drawn mirrored, for a High-five partner to the west (F.4)
  function react(id: number, kind: Move, west = false) {
    const b = avatarOf(id);
    if (!b) return;
    b.querySelector("svg.fx")?.remove();
    const r = REACTION[kind];
    const still = reducedMotion.matches;
    const fx = document.createElementNS(SVG, "svg");
    // the replies are drawn as what they answer, plus their own mark
    const base = kind === "poke-back" ? "poke" : kind === "slap-back" ? "slap" : kind;
    fx.setAttribute("class", `fx fx-${base} fx-${kind}${west ? " face-west" : ""}${still ? " still" : ""}`);
    fx.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    fx.setAttribute("aria-hidden", "true");
    // reduced motion: the ★ frames alone, still, for a second (INT-11.6)
    const frames: Frame[] = still ? r.still.map((h) => [h, 0, 1000]) : r.frames;
    for (const [href, at, ms] of frames) {
      const use = document.createElementNS(SVG, "use");
      use.setAttribute("href", `#fx-${href}`);
      use.style.setProperty("--at", `${at}ms`);
      use.style.setProperty("--d", `${ms}ms`);
      // Slap back's hook sits top right (F.6)
      if (href === "back-1" && kind === "slap-back") use.setAttribute("x", String((22 / 32) * TILE));
      fx.append(use);
    }
    b.append(fx);
    // the whole sprite moves with it; the tag never does (INT-11.2)
    const av = b.querySelector<SVGElement>("svg.av");
    if (av && r.jolt && !still) {
      av.classList.remove("jolt-hop", "jolt-nudge", "jolt-shake");
      void av.getBoundingClientRect(); // restart it
      av.style.setProperty("--dir", west ? "-1" : "1");
      av.style.animationDuration = `${r.total}ms`;
      av.classList.add(`jolt-${r.jolt}`);
      clearTimeout(fxTimers.get(av));
      fxTimers.set(av, setTimeout(() => av.classList.remove(`jolt-${r.jolt}`), r.total));
    }
    setTimeout(() => fx.remove(), still ? 1000 : r.total);
  }

  const BANNER: Record<Move, (from: string, resting: boolean) => string> = {
    cheer: (n) => `${n} is hyping you up 🔥`,
    poke: (n, resting) => (resting ? `${n} poked you. Rest's over? 👉` : `${n} poked you 👉`),
    slap: (n) => `${n} slapped you back to work 👋`,
    thanks: (n) => `${n} says thanks 🙏`,
    "poke-back": (n) => `${n} poked you back 👉`,
    "slap-back": (n) => `${n} returned the slap 👋`,
    highfive: (n) => `${n} wants a high-five ✋`,
  };
  // A banner (I.5, F.2): who it's from, the line, and at most one button.
  // With a button it stays 6 s and the button wakes after half a second;
  // without, 4 s. The newest replaces the last (D9). A room banner (F.8)
  // has the gold ring and the PB tab. `low` when its person stands in the
  // top three rows, so it never covers them on a laptop.
  type BannerAct = { word: string; icon: string; data: Record<string, string> };
  let bannerTimer: ReturnType<typeof setTimeout> | undefined;
  function banner(text: string, from: number, opts: { act?: BannerAct; room?: boolean; label?: string } = {}) {
    const slot = document.querySelector<HTMLElement>(".map-panel .banner-slot");
    if (!slot) return;
    const box = document.createElement("div");
    box.className = ["banner", opts.act && "has-act", opts.room && "room"].filter(Boolean).join(" ");
    if (opts.room) {
      const tab = document.createElement("span");
      tab.className = "banner-tab";
      tab.setAttribute("aria-hidden", "true");
      tab.append(tpl("log-pb"), "PB");
      box.append(tab);
    }
    const sender = personIn(from);
    if (sender) box.append(head(sender));
    const words = document.createElement("span");
    words.className = "banner-line";
    words.setAttribute("role", "status");
    if (opts.label) words.setAttribute("aria-label", opts.label);
    words.textContent = text;
    box.append(words);
    // whoever had focus gets it back if the button had it when it goes (F.2)
    const before = document.activeElement as HTMLElement | null;
    if (opts.act) {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "banner-act";
      Object.assign(b.dataset, opts.act.data, { from: String(from), shown: String(Date.now()) });
      const cur = document.createElement("span");
      cur.className = "cur";
      cur.setAttribute("aria-hidden", "true");
      cur.textContent = "▶";
      const vh = document.createElement("span");
      vh.className = "vh";
      vh.textContent = ` ${sender?.name ?? ""}`;
      b.append(cur, tpl(`log-${opts.act.icon}`), opts.act.word, vh);
      box.append(b);
    }
    const b = avatarOf(from);
    slot.classList.toggle("low", !!b && tileOf(b)[1] <= 2);
    slot.replaceChildren(box);
    clearTimeout(bannerTimer);
    const ms = opts.act ? 6000 : 4000;
    bannerTimer = setTimeout(() => {
      const hadFocus = box.contains(document.activeElement);
      box.remove();
      if (hadFocus) before?.focus({ preventScroll: true });
    }, ms);
  }

  // ---------- acting it out (INT-13 to INT-16, BOT-8; room spec A.2 to A.10) ----------
  // A move is acted out on every screen from its event: a sender who isn't
  // Lifting walks to beside the target and does it there (an errand); a
  // Lifting sender waves from their machine and the move flies over. The
  // target's reaction, banner and sound wait for the hit (A1), at most 3 s
  // after the event. Nothing here touches the server: it only draws.
  type Base = "cheer" | "poke" | "slap" | "thanks" | "highfive";
  const baseOf = (m: Move): Base => (m === "poke-back" ? "poke" : m === "slap-back" ? "slap" : m);
  // A.5: the walker's frames [pose, from ms], when the hit is, and the length
  const WALKER: Record<Base, { frames: [string, number][]; hit: number; ms: number }> = {
    cheer: { frames: [["cheer", 0], ["stand", 450]], hit: 0, ms: 1000 },
    poke: { frames: [["point", 0], ["stand", 600]], hit: 0, ms: 900 },
    slap: { frames: [["reach", 0], ["swing", 150], ["stand", 800]], hit: 150, ms: 1200 },
    thanks: { frames: [["bow", 0], ["stand", 500]], hit: 0, ms: 1000 },
    highfive: { frames: [["reach", 0], ["stand", 600]], hit: 250, ms: 1000 },
  };
  // A.4, A.5: the target's body off a machine, from the hit [pose, from ms,
  // lift px]; "pose" is their own pose. ★ frames for reduced motion.
  type ReactFrame = [pose: string, at: number, lift: 0 | 2 | 4];
  const REACT_STAND: Record<Base, { frames: ReactFrame[]; ms: number; still: string; lean?: boolean }> = {
    cheer: { frames: [["pose", 0, 0], ["crouch", 200, 0], ["cheer", 450, 4], ["pose", 800, 0]], ms: 1100, still: "cheer" },
    poke: { frames: [["pose", 0, 0], ["startle", 250, 4], ["startle", 600, 0], ["pose", 900, 0]], ms: 1000, still: "startle" },
    slap: { frames: [["recoil", 0, 0], ["pose", 650, 0]], ms: 1050, still: "recoil", lean: true },
    thanks: { frames: [["pose", 0, 0], ["crouch", 300, 0], ["pose", 500, 4], ["pose", 750, 0]], ms: 1100, still: "pose" },
    highfive: { frames: [["reach", 0, 0], ["pose", 350, 0]], ms: 750, still: "reach" },
  };
  const REACT_SIT: Record<Base, { frames: ReactFrame[]; ms: number; still: string; lean?: boolean }> = {
    cheer: { frames: [["pose", 0, 0], ["sit-cheer", 450, 2], ["pose", 800, 0]], ms: 1100, still: "sit-cheer" },
    poke: { frames: [["pose", 0, 0], ["sit-startle", 250, 0], ["pose", 900, 0]], ms: 1000, still: "sit-startle" },
    slap: { frames: [["sit-recoil", 0, 0], ["pose", 650, 0]], ms: 1050, still: "sit-recoil", lean: true },
    thanks: { frames: [["pose", 0, 0], ["pose", 500, 2], ["pose", 750, 0]], ms: 1100, still: "pose" },
    highfive: { frames: [["sit-reach", 0, 0], ["pose", 350, 0]], ms: 750, still: "sit-reach" },
  };
  const FLIGHT: Record<Base, string> = { cheer: "star", poke: "finger", slap: "glove", thanks: "heart", highfive: "palm" };
  const HIT_CAP_MS = 3000; // INT-13.9: the hit lands at most 3 s after the event

  // Whoever is on an errand, so drawMap leaves them be until it ends and
  // then walks them to where their state puts them (that's the walk back)
  type Errand = { to: number; move: Move; hit: () => void; done: boolean; timers: ReturnType<typeof setTimeout>[] };
  const errands = new Map<number, Errand>();
  // reacting avatars, so drawMap doesn't redraw their pose under the reaction
  const reacting = new Map<number, number>();
  const busy = (id: number) => errands.has(id) || reacting.has(id) || flexing.has(id);

  const notMoving = (state: string) => state !== "lifting";

  // A.2 rule 2: the meeting spot, diagonally in front of the target, on the
  // walker's side; the other diagonal, then straight in front, then beside
  function meetingSpot(target: HTMLElement, walker: HTMLElement): Tile {
    const [tx, ty] = tileOf(target);
    const [wx] = tileOf(walker);
    const side = wx < tx ? -1 : 1;
    const down = ty >= 8 ? -1 : 1;
    const clamp = (x: number) => Math.min(8, Math.max(1, x));
    const taken = new Set(
      [...document.querySelectorAll<HTMLElement>(".map-panel .avatar:not(.leaving)")]
        .filter((b) => b !== walker && b !== target)
        .map((b) => tileOf(b).join(",")),
    );
    // and the spots other walkers are heading for
    const reserved = new Set([...document.querySelectorAll<HTMLElement>(".map .avatar.errand")].filter((b) => b !== walker).map((b) => b.dataset.spot ?? ""));
    const options: Tile[] = [
      [clamp(tx + side), ty + down],
      [clamp(tx - side), ty + down],
      [tx, ty + down],
      [clamp(tx + side), ty],
    ];
    return options.find((t) => !taken.has(t.join(",")) && !reserved.has(t.join(","))) ?? options[0];
  }
  // already beside the target (A.2, INT-13.6): on or next to the meeting spot
  const near = (a: Tile, b: Tile) => Math.abs(a[0] - b[0]) <= 1 && Math.abs(a[1] - b[1]) <= 1;

  // The target's body reaction at the hit (A.4): body frames off a machine,
  // F.6's effect over them; on a machine or walking, effect and jolt only
  function hitTarget(id: number, move: Move, west: boolean) {
    react(id, move, west);
    const b = avatarOf(id);
    // a walker plays their own move's frames; on a machine or walking, the
    // effect and its jolt alone (INT-15.2, INT-15.3)
    if (!b || errands.has(id) || b.classList.contains("on-machine") || walks.get(b)) return;
    const pose = b.dataset.pose ?? "stand";
    const table = (pose === "sit" ? REACT_SIT : REACT_STAND)[baseOf(move)];
    const av = () => b.querySelector<SVGElement>("svg.av");
    const lift = (px: number) => {
      av()?.classList.remove("lift-2", "lift-4");
      if (px) av()?.classList.add(`lift-${px}`);
    };
    const end = performance.now() + (reducedMotion.matches ? 1000 : table.ms);
    reacting.set(id, end);
    const draw = (p: string) => {
      show(b, p === "pose" ? pose : p);
      // facing whoever hit them; the lean is away from them
      av()?.classList.toggle("face-west", west && p !== "pose");
      if (table.lean && p !== "pose") {
        av()?.style.setProperty("--dir", west ? "-1" : "1");
        av()?.classList.add("lean-2");
      }
    };
    if (reducedMotion.matches) draw(table.still);
    else
      for (const [p, at, px] of table.frames)
        setTimeout(() => {
          if (reacting.get(id) !== end) return; // a newer hit restarted it
          draw(p);
          lift(px);
        }, at);
    setTimeout(() => {
      if (reacting.get(id) !== end) return;
      reacting.delete(id);
      const a = av();
      a?.classList.remove("lift-2", "lift-4", "lean-2", "face-west");
      show(b, pose);
      liveTick();
    }, reducedMotion.matches ? 1000 : table.ms);
  }

  // A.6: the lifter's hand over their machine, two frames, 400 ms
  function gesture(id: number, west: boolean) {
    const b = avatarOf(id);
    if (!b) return;
    b.querySelector("svg.gesture")?.remove();
    const panel = b.closest(".map-panel")!;
    const dony = b.dataset.look === "dony";
    const frame = (n: 1 | 2) => {
      const t = panel.querySelector<HTMLTemplateElement>(dony ? `template[data-dony="hand${n}"]` : `template[data-pose="hand${n}"]`);
      const svg = t?.content.querySelector("svg")?.cloneNode(true) as SVGElement | undefined;
      if (!svg) return;
      svg.classList.add("gesture");
      svg.classList.toggle("face-west", west);
      svg.setAttribute("aria-hidden", "true");
      const m = view && everyone(view).find((x) => String(x.id) === b.dataset.id);
      if (m && !("dony" in m)) {
        svg.setAttribute("style", lookVars(m.look));
        svg.dataset.hair = m.look.hair;
      }
      b.querySelector("svg.gesture")?.remove();
      b.append(svg);
    };
    frame(1);
    if (reducedMotion.matches) return void setTimeout(() => b.querySelector("svg.gesture")?.remove(), 1000);
    setTimeout(() => frame(2), 200);
    setTimeout(() => b.querySelector("svg.gesture")?.remove(), 400);
  }

  // A.7: a move flying from a tile to the target's, a tile a step, 125 ms a
  // step, at most 8 steps (so within 1 s), dropping to the aisle row between
  // two back-row ends; lands on the target, calling `landed`
  function fly(base: Base, from: Tile, toId: number, landed: () => void) {
    const layer = document.querySelector<HTMLElement>(".map .flights");
    const target = avatarOf(toId);
    if (!layer || !target || reducedMotion.matches) return landed();
    const to = tileOf(target);
    const n = Math.min(8, Math.max(1, Math.max(Math.abs(to[0] - from[0]), Math.abs(to[1] - from[1]))));
    const backRow = from[1] <= 1 && to[1] <= 1;
    const svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("class", `flight${to[0] < from[0] ? " face-west" : ""}`);
    svg.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    const use = document.createElementNS(SVG, "use");
    svg.append(use);
    layer.append(svg);
    let i = 0;
    const step = () => {
      const f = i / n;
      const x = from[0] + (to[0] - from[0]) * f;
      const y = backRow && i > 0 && i < n ? 2 : from[1] + (to[1] - from[1]) * f;
      svg.style.setProperty("--fx", String(x));
      svg.style.setProperty("--fy", String(y + 0.5));
      use.setAttribute("href", `#fx-${FLIGHT[base]}-${(i % 2) + 1}`);
      if (i++ >= n) {
        svg.remove();
        return landed();
      }
      setTimeout(step, Math.min(125, 1000 / n));
    };
    step();
  }

  // The High-five's smack, on the corner between two tiles (A.9)
  function smack(a: Tile, b: Tile) {
    const layer = document.querySelector<HTMLElement>(".map .flights");
    if (!layer) return;
    const svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("class", "smack");
    svg.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    svg.style.setProperty("--fx", String((a[0] + b[0]) / 2 + 0.5));
    svg.style.setProperty("--fy", String((a[1] + b[1]) / 2 + 0.5));
    const use = document.createElementNS(SVG, "use");
    use.setAttribute("href", "#fx-smack-1");
    svg.append(use);
    layer.append(svg);
    setTimeout(() => svg.remove(), 350);
  }

  // Ends an errand early (A.8): the move flies from where the walker is, if
  // it hasn't landed, and the walker goes where its state puts it
  function cutShort(id: number, why: "next" | "state" | "cap" | "left") {
    const e = errands.get(id);
    if (!e) return;
    errands.delete(id);
    for (const t of e.timers) clearTimeout(t);
    const b = avatarOf(id);
    b?.classList.remove("errand", "at-spot");
    b?.querySelector("svg.av")?.classList.remove("face-west");
    if (b) delete b.dataset.spot;
    // not landed yet: it flies from here, and its landing is the hit (e.hit
    // marks it done, so it plays exactly once, INT-13.14)
    if (!e.done && why !== "left") {
      if (b) fly(baseOf(e.move), tileOf(b), e.to, e.hit);
      else e.hit();
    }
    liveTick();
  }

  // Acts one move out (INT-13, INT-14): returns at once; calls `onHit`
  // exactly once, at the hit, within 3 s
  function actOut(move: Move, fromId: number, toId: number, fromState: string, onHit: () => void) {
    const walker = avatarOf(fromId);
    const target = avatarOf(toId);
    const base = baseOf(move);
    let hitDone = false;
    const hit = () => {
      if (hitDone) return;
      hitDone = true;
      onHit();
    };
    if (!walker || !target) return hit();
    // a newer move from the same walker cuts their errand short (A2)
    cutShort(fromId, "next");
    const west = tileOf(target)[0] < tileOf(walker)[0];
    // reduced motion (A.10): the sender's ★ frame where they are, the hit at once
    if (reducedMotion.matches) {
      if (notMoving(fromState)) {
        const still = WALKER[base].frames.find(([, at]) => at <= WALKER[base].hit)?.[0] ?? "stand";
        const was = walker.dataset.pose ?? "stand";
        if (!walker.classList.contains("on-machine")) {
          show(walker, still);
          reacting.set(fromId, performance.now() + 1000);
          setTimeout(() => {
            reacting.delete(fromId);
            show(walker, was);
            liveTick();
          }, 1000);
        }
      } else gesture(fromId, west);
      return hit();
    }
    // a Lifting sender stays on their machine (INT-14)
    if (!notMoving(fromState) || walker.classList.contains("on-machine")) {
      gesture(fromId, west);
      fly(base, tileOf(walker), toId, hit);
      return;
    }
    // the errand (INT-13)
    const e: Errand = { to: toId, move, hit: () => {}, done: false, timers: [] };
    e.hit = () => {
      if (e.done) return;
      e.done = true;
      hit();
    };
    errands.set(fromId, e);
    walker.classList.add("errand");
    const spot = meetingSpot(target, walker);
    walker.dataset.spot = spot.join(",");
    // the 3 s cap (INT-13.9): if the hit hasn't come, it flies from here
    e.timers.push(setTimeout(() => errands.get(fromId) === e && !e.done && cutShort(fromId, "cap"), HIT_CAP_MS));
    const play = () => {
      if (errands.get(fromId) !== e) return;
      const t = avatarOf(toId);
      if (!t) return cutShort(fromId, "left");
      const faceWest = tileOf(t)[0] < tileOf(walker)[0];
      walker.classList.add("at-spot");
      const av = () => walker.querySelector<SVGElement>("svg.av");
      walker.style.setProperty("--dir", faceWest ? "-1" : "1");
      const w = WALKER[base];
      for (const [pose, at] of w.frames)
        e.timers.push(
          setTimeout(() => {
            if (errands.get(fromId) !== e) return;
            show(walker, pose);
            av()?.classList.toggle("face-west", faceWest);
          }, at),
        );
      e.timers.push(setTimeout(() => errands.get(fromId) === e && e.hit(), w.hit));
      // the walk back: the errand ends and drawMap takes them home
      e.timers.push(
        setTimeout(() => {
          if (errands.get(fromId) !== e) return;
          errands.delete(fromId);
          walker.classList.remove("errand", "at-spot");
          av()?.classList.remove("face-west");
          delete walker.dataset.spot;
          liveTick();
        }, w.ms),
      );
    };
    if (near(tileOf(walker), spot)) play();
    else walk(walker, spot, false, "stand", play);
  }

  // A walker whose state changes, or who leaves, cuts their errand short
  // (INT-13.11, INT-13.13): checked against each new room
  function checkErrands() {
    if (!view) return;
    const all = everyone(view);
    for (const [id, e] of errands) {
      const m = all.find((x) => x.id === id);
      if (!m) {
        cutShort(id, "left");
        continue;
      }
      if (stateAt(m, nowServer()) === "lifting") cutShort(id, "state");
      if (!all.some((x) => x.id === e.to)) cutShort(id, "left");
    }
  }

  type Who = { id: number; name: string };
  const DONY = 0; // his id (dony.ts)
  // BOT-8.8: while a move is on its way to Dony, his pops wait, and go half
  // a second after it hits him; never later than 3.5 s after its event
  const DONY_WAIT_MAX = 3500;
  const DONY_AFTER_HIT = 500;
  type DonyHold = { releaseBy: number; hitAt?: number; queue: Parameters<typeof onEmote>[0][]; timer?: ReturnType<typeof setTimeout> };
  let donyHold: DonyHold | undefined;
  function releaseDony(hold: DonyHold) {
    if (donyHold !== hold) return;
    clearTimeout(hold.timer);
    donyHold = undefined;
    for (const e of hold.queue) onEmote({ ...e, held: true });
  }
  // the hold's timer: half a second after the hit, else the 3.5 s cap
  function armDony(hold: DonyHold) {
    clearTimeout(hold.timer);
    const at = Math.min(hold.hitAt !== undefined ? hold.hitAt + DONY_AFTER_HIT : Infinity, hold.releaseBy);
    hold.timer = setTimeout(() => releaseDony(hold), Math.max(0, at - performance.now()));
  }
  function onInteraction(e: { id: number; kind: Kind | Reply; from: Who; to: Who; targetState: string; fromState?: string; at: number; answers?: number }) {
    const me = meId();
    const toDony = e.to.id === DONY;
    let hold: DonyHold | undefined;
    if (toDony && !reducedMotion.matches) {
      // a newer move to him starts a new hold; what the old one held goes now
      if (donyHold) releaseDony(donyHold);
      hold = donyHold = { releaseBy: performance.now() + DONY_WAIT_MAX, queue: [] };
      armDony(hold);
    }
    // INT-13.9: the reaction, banner and sound land with the hit
    actOut(e.kind, e.from.id, e.to.id, e.fromState ?? "idle", () => {
      if (hold) {
        hold.hitAt = performance.now();
        armDony(hold);
      }
      const a = avatarOf(e.from.id);
      const b = avatarOf(e.to.id);
      hitTarget(e.to.id, e.kind, !!a && !!b && tileOf(a)[0] < tileOf(b)[0]);
      if (e.to.id === me && personIn(e.to.id)) {
        const resting = e.targetState === "resting" || e.targetState === "slacking";
        // INT-9.1: a Cheer, Poke or Slap carries its answer; an answer none
        const answer = e.kind in REPLY ? REPLY[e.kind as Kind] : undefined;
        banner(BANNER[e.kind](e.from.name, resting), e.from.id, {
          act: answer && { word: ANSWER_WORD[answer], icon: LOG_ICON[answer], data: { answers: String(e.id), kind: answer } },
        });
        blip(e.kind === "cheer" ? "cheer" : e.kind === "thanks" ? "thanks" : e.kind.startsWith("poke") ? "poke" : "slap");
      }
    });
    if (e.from.id === me) limits.set(e.to.id, e.at + 10_000);
    // what's answerable changed: the answered one goes, a new one comes
    if (e.answers !== undefined) answers = answers.filter((a) => a.id !== e.answers);
    if (e.kind in REPLY) {
      answers = [...answers.filter((a) => !(a.from === e.from.id && a.to === e.to.id)), { id: e.id, from: e.from.id, to: e.to.id, kind: REPLY[e.kind as Kind], until: e.at + REPLY_MS }];
    }
    addLog({ kind: e.kind, from: e.from, to: e.to, at: e.at });
    redrawAnswers();
  }

  // ---------- the High-five (INT-10; F.4) ----------
  // An open offer: the offerer's palm up towards the target, and an
  // "@Ji-woo · Up top ✋" bubble, for as long as it's open, on every screen
  function drawOffers() {
    const open = stillOpen(offers);
    for (const fx of document.querySelectorAll<SVGElement>(".map .avatar svg.fx-offer")) {
      const id = Number(fx.closest<HTMLElement>(".avatar")!.dataset.id);
      if (!open.some((o) => o.from === id)) fx.remove();
    }
    for (const say of document.querySelectorAll<HTMLElement>(".map .says .say.offer")) {
      if (!open.some((o) => o.from === Number(say.dataset.id))) say.remove();
    }
    for (const o of open) {
      const b = avatarOf(o.from);
      const to = avatarOf(o.to);
      if (!b) continue;
      if (!b.querySelector("svg.fx-offer")) {
        const fx = document.createElementNS(SVG, "svg");
        const west = !!to && tileOf(to)[0] < tileOf(b)[0];
        fx.setAttribute("class", `fx fx-offer${west ? " face-west" : ""}`);
        fx.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
        fx.setAttribute("aria-hidden", "true");
        const use = document.createElementNS(SVG, "use");
        use.setAttribute("href", "#fx-highfive-1");
        fx.append(use);
        b.append(fx);
      }
      const says = document.querySelector<HTMLElement>(".map .says.offers");
      if (says && !says.querySelector(`.say.offer[data-id="${o.from}"]`)) {
        document.querySelectorAll(`.map .says .say[data-id="${o.from}"]`).forEach((s) => s.remove());
        const p = document.createElement("p");
        p.className = "say offer";
        p.dataset.id = String(o.from);
        const name = document.createElement("span");
        name.className = "to";
        name.textContent = `@${personIn(o.to)?.name ?? ""}`;
        p.append(name, "Up top ✋");
        p.style.animationDuration = `${Math.max(0, o.until - nowServer())}ms`;
        says.append(p);
        placeBubble(p);
      }
    }
  }

  // A lapse is told only to the offerer, when their own offer runs out with
  // no answer (INT-10.10); no event comes for it
  const lapseTimers = new Map<number, ReturnType<typeof setTimeout>>();
  function watchLapse(o: Open) {
    clearTimeout(lapseTimers.get(o.id));
    // one Dony will take ends with his High-five, not a lapse (BOT-7.2)
    if (o.taken) return;
    lapseTimers.set(
      o.id,
      setTimeout(() => {
        lapseTimers.delete(o.id);
        offers = offers.filter((x) => x.id !== o.id);
        drawOffers();
        // it happened (its timer was cleared), or either of them left: no line
        const m = personIn(o.to);
        if (m && personIn(o.from)) tell(`${m.name} left you hanging ✋`, false, o.to);
      }, Math.max(0, o.until - nowServer()) + 50),
    );
  }

  function onHighFive(e: {
    id: number;
    from: Who;
    to: Who;
    at: number;
    until?: number;
    done?: number;
    taken?: boolean;
    fromState?: string;
    toState?: string;
  }) {
    const me = meId();
    if (e.done === undefined) {
      // an offer
      offers = [...offers.filter((o) => o.id !== e.id), { id: e.id, from: e.from.id, to: e.to.id, until: e.until! }];
      drawOffers();
      if (e.from.id === me) {
        watchLapse({ id: e.id, from: e.from.id, to: e.to.id, until: e.until!, taken: e.taken });
        limits.set(e.to.id, e.at + 10_000);
      }
      if (e.to.id === me) {
        banner(BANNER.highfive(e.from.name, false), e.from.id, {
          act: { word: "High-five", icon: "high-five", data: { offer: String(e.id), kind: "highfive" } },
        });
        blip("offer");
      }
      redrawAnswers();
      return;
    }
    // it happened (INT-16, A.9): the offerer walks if they can, else the
    // accepter; both Lifting, both wave and the palms meet halfway
    offers = offers.filter((o) => o.id !== e.id);
    clearTimeout(lapseTimers.get(e.id));
    drawOffers();
    document.querySelector(".banner-act[data-offer]")?.closest(".banner")?.remove();
    if (e.to.id === me) limits.set(e.from.id, Math.max(limits.get(e.from.id) ?? 0, e.done + 10_000));
    if (e.from.id === me) limits.set(e.to.id, Math.max(limits.get(e.to.id) ?? 0, e.at + 10_000));
    addLog({ kind: "highfive", from: e.from, to: e.to, at: e.done });
    redrawAnswers();
    // at the smack: both play it, and the banners, line and sound
    const smacked = () => {
      const a = avatarOf(e.from.id);
      const b = avatarOf(e.to.id);
      const fromWest = !!a && !!b && tileOf(a)[0] <= tileOf(b)[0];
      if (a && b && !reducedMotion.matches) smack(tileOf(a), tileOf(b));
      hitTarget(e.from.id, "highfive", !fromWest);
      hitTarget(e.to.id, "highfive", fromWest);
      if (e.from.id === me) banner(`${e.to.name} high-fived you 🙌`, e.to.id);
      if (e.to.id === me) say(`You high-fived ${e.from.name}`);
      if (e.from.id === me || e.to.id === me) {
        lastBlip = -Infinity; // the High-five always gets its own sound
        blip("highfive");
      }
    };
    const fromState = e.fromState ?? "idle";
    const toState = e.toState ?? "idle";
    if (notMoving(fromState)) return actOut("highfive", e.from.id, e.to.id, fromState, smacked);
    if (notMoving(toState)) return actOut("highfive", e.to.id, e.from.id, toState, smacked);
    // both Lifting: each waves, the palms fly to meet in the middle
    const a = avatarOf(e.from.id);
    const b = avatarOf(e.to.id);
    if (!a || !b || reducedMotion.matches) {
      if (a && b) {
        gesture(e.from.id, tileOf(b)[0] < tileOf(a)[0]);
        gesture(e.to.id, tileOf(a)[0] < tileOf(b)[0]);
      }
      return smacked();
    }
    gesture(e.from.id, tileOf(b)[0] < tileOf(a)[0]);
    gesture(e.to.id, tileOf(a)[0] < tileOf(b)[0]);
    const [ax, ay] = tileOf(a);
    const [bx, by] = tileOf(b);
    const mid: Tile = [Math.round((ax + bx) / 2), Math.max(Math.round((ay + by) / 2), ay <= 1 && by <= 1 ? 2 : 0)];
    let landed = 0;
    const meet = () => ++landed === 2 && smacked();
    flyTo("highfive", tileOf(a), mid, meet);
    flyTo("highfive", tileOf(b), mid, meet);
  }

  // a flight to a tile, not a person: the two palms meeting halfway (A.9)
  function flyTo(base: Base, from: Tile, to: Tile, landed: () => void) {
    const layer = document.querySelector<HTMLElement>(".map .flights");
    if (!layer) return landed();
    const n = Math.min(8, Math.max(1, Math.max(Math.abs(to[0] - from[0]), Math.abs(to[1] - from[1]))));
    const svg = document.createElementNS(SVG, "svg");
    svg.setAttribute("class", `flight${to[0] < from[0] ? " face-west" : ""}`);
    svg.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    const use = document.createElementNS(SVG, "use");
    svg.append(use);
    layer.append(svg);
    let i = 0;
    const step = () => {
      const f = i / n;
      svg.style.setProperty("--fx", String(from[0] + (to[0] - from[0]) * f));
      svg.style.setProperty("--fy", String(from[1] + (to[1] - from[1]) * f + 0.5));
      use.setAttribute("href", `#fx-${FLIGHT[base]}-${(i % 2) + 1}`);
      if (i++ >= n) {
        svg.remove();
        return landed();
      }
      setTimeout(step, Math.min(125, 1000 / n));
    };
    step();
  }

  // ---------- a personal best (GYM-17, GYM-18; F.5, F.8) ----------
  const flexing = new Map<number, number>(); // who is flexing, until when (local ms)
  function onPb(e: { from: Who; exercise: { id: number; name: string }; at: number }) {
    const me = meId();
    pbs = [...pbs.filter((p) => p.userId !== e.from.id), { userId: e.from.id, exercise: e.exercise, until: e.at + PB_MS }];
    flex(e.from.id);
    fanfare();
    if (e.from.id !== me) {
      const lift = e.exercise.name.toLowerCase();
      banner(`${e.from.name} hit a PB on ${lift} 🏆`, e.from.id, {
        room: true,
        label: `${e.from.name} hit a personal best on ${lift}`,
        act: { word: "Cheer", icon: "cheer", data: { room: "1" } },
      });
    }
    // never Dony's in the log (BOT-5)
    if (e.from.id !== 0) addLog({ kind: "pb", from: e.from, exercise: e.exercise.name, at: e.at });
    redrawAnswers();
  }

  // F.5: on the aisle tile in front of their station, flex1 and flex2 in
  // turn for 1.9 s, then on to where their state puts them. Reduced motion:
  // flex2 still for a second. Only from the live event, never replayed.
  const FLEX: [figure: "flex1" | "flex2", at: number][] = [
    ["flex1", 0],
    ["flex2", 300],
    ["flex2", 700],
    ["flex1", 1100],
    ["flex2", 1500],
  ];
  function flex(id: number) {
    const b = avatarOf(id);
    if (!b) return;
    const still = reducedMotion.matches;
    const ms = still ? 1000 : 1900;
    flexing.set(id, performance.now() + ms);
    // stop any walk, and stand on the aisle in front of the station, off the
    // machine, which goes back to idle (drawStations); the walk resumes after
    const going = walks.get(b);
    if (going) clearInterval(going.timer);
    walks.delete(b);
    const [x, y] = tileOf(b);
    if (b.classList.contains("on-station") || b.classList.contains("on-machine")) place(b, [x, y + 1]);
    b.classList.remove("on-station");
    b.classList.add("flexing");
    const swap = (figure: "flex1" | "flex2") => {
      show(b, figure);
      drawStations();
    };
    if (still) swap("flex2");
    else for (const [figure, at] of FLEX) setTimeout(() => flexing.has(id) && swap(figure), at);
    // the confetti
    b.querySelector("svg.fx")?.remove();
    const fx = document.createElementNS(SVG, "svg");
    fx.setAttribute("class", `fx fx-pb${still ? " still" : ""}`);
    fx.setAttribute("viewBox", `0 0 ${TILE} ${TILE}`);
    fx.setAttribute("aria-hidden", "true");
    const frames: Frame[] = still ? [["pb-1", 0, 1000]] : [["pb-1", 300, 400], ["pb-2", 700, 400], ["pb-1", 1100, 400], ["pb-2", 1500, 400]];
    for (const [href, at, d] of frames) {
      const use = document.createElementNS(SVG, "use");
      use.setAttribute("href", `#fx-${href}`);
      use.style.setProperty("--at", `${at}ms`);
      use.style.setProperty("--d", `${d}ms`);
      fx.append(use);
    }
    b.append(fx);
    const av = b.querySelector<SVGElement>("svg.av");
    if (av && !still) {
      av.style.animationDuration = "1000ms";
      setTimeout(() => av.classList.add("jolt-hop"), 300);
      setTimeout(() => av.classList.remove("jolt-hop"), 1300);
    }
    setTimeout(() => {
      flexing.delete(id);
      fx.remove();
      b.classList.remove("flexing");
      // back to what the room says they're doing, walking there as always
      liveTick();
    }, ms);
  }

  // ---------- preset bubbles (INT-5; I.6) ----------
  const bubbleTimers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
  function bubble(from: number, to: string, text: string, at: number) {
    const says = document.querySelector<HTMLElement>(".map .says:not(.offers)");
    const b = avatarOf(from);
    const left = at + 5000 - nowServer();
    if (!says || !b || left <= 0) return;
    // a newer one from the same sender replaces theirs (INT-5.5)
    document.querySelectorAll(`.map .says .say[data-id="${from}"]`).forEach((s) => s.remove());
    const p = document.createElement("p");
    p.className = "say";
    p.dataset.id = String(from);
    const name = document.createElement("span");
    name.className = "to";
    name.textContent = `@${to}`;
    p.append(name, text);
    says.append(p); // the newer draws on top (D19)
    placeBubble(p);
    bubbleTimers.set(p, setTimeout(() => p.remove(), left));
  }
  function placeBubble(p: HTMLElement) {
    const b = avatarOf(Number(p.dataset.id));
    if (!b) return p.remove();
    const [x, y] = tileOf(b);
    p.style.setProperty("--x", String(x));
    p.style.setProperty("--y", String(y));
    p.style.setProperty("--dy", b.classList.contains("on-station") && !b.classList.contains("on-machine") ? "0.375" : "0");
    p.classList.toggle("below", y <= 1);
    p.classList.toggle("west", x <= 2);
    p.classList.toggle("east", x >= 7);
    p.classList.toggle("over-pop", y > 1 && !!document.querySelector(`.map .pops .pop[data-id="${p.dataset.id}"]`));
  }

  function onSay(e: { preset: string; text: string; from: Who; to: Who; at: number }) {
    const me = meId();
    bubble(e.from.id, e.to.name, e.text, e.at);
    addLog({ kind: "say", from: e.from, to: e.to, text: e.text, at: e.at });
    // only the addressee hears it, once (INT-5.11); you hear your own
    const news = document.querySelector<HTMLElement>("#sheet-news");
    const line = e.to.id === me ? `${e.from.name}: ${e.text}` : e.from.id === me ? `Sent to ${e.to.name}: ${e.text}` : "";
    // INT-12.1: a soft one for a preset to you, the landed blip for your own
    if (e.to.id === me) blip("say");
    else if (e.from.id === me) blip("sent");
    if (news && line) {
      news.textContent = "";
      setTimeout(() => (news.textContent = line), 50);
    }
  }

  // ---------- emoji pops (INT-8, BOT-6; I.8) ----------
  function onEmote(e: { emoji: string; from: Who; at: number; held?: boolean }) {
    // BOT-8.8 (settled 5 Nov): Dony answers after the move reaches him, so
    // while one is on its way to him his pop waits for its hit, plus half a
    // second, never more than 3.5 s
    if (e.from.id === DONY && donyHold && !e.held) return void donyHold.queue.push(e);
    const pops = document.querySelector<HTMLElement>(".map .pops");
    const b = avatarOf(e.from.id);
    if (!pops || !b) return;
    pops.querySelector(`.pop[data-id="${e.from.id}"]`)?.remove();
    const pop = document.createElementNS(SVG, "svg");
    pop.setAttribute("class", "pop");
    pop.setAttribute("viewBox", "0 0 16 16");
    pop.dataset.id = String(e.from.id);
    const use = document.createElementNS(SVG, "use");
    use.setAttribute("href", `#em-${e.emoji}`);
    pop.append(use);
    pops.append(pop);
    placePop(pop);
    setTimeout(() => pop.remove(), 3000);
    document.querySelectorAll<HTMLElement>(`.map .says .say[data-id="${e.from.id}"]`).forEach(placeBubble);
  }
  function placePop(pop: SVGElement) {
    const b = avatarOf(Number(pop.dataset.id));
    if (!b) return pop.remove();
    const [x, y] = tileOf(b);
    pop.style.setProperty("--x", String(x));
    pop.style.setProperty("--y", String(y));
    pop.style.setProperty("--dy", b.classList.contains("on-station") && !b.classList.contains("on-machine") ? "0.375" : "0");
    pop.style.setProperty("--tag-w", `${b.querySelector<HTMLElement>(".tag")?.offsetWidth ?? TILE}px`);
    pop.classList.toggle("beside", y <= 1);
    pop.classList.toggle("west-side", y <= 1 && x >= 6);
  }
  // Pops and bubbles go where their senders go, and with them (INT-8.15)
  function followSenders() {
    document.querySelectorAll<SVGElement>(".map .pops .pop").forEach(placePop);
    document.querySelectorAll<HTMLElement>(".map .says .say").forEach(placeBubble);
  }
  // walks move avatars between room messages: keep up, cheaply
  setInterval(() => {
    if (document.querySelector(".map .pops .pop, .map .says .say")) followSenders();
  }, 125);

  // ---------- the emoji tab and tray (INT-8; I.7) ----------
  const tab = () => document.querySelector<HTMLButtonElement>(".dock .emote");
  const tray = () => document.querySelector<HTMLElement>(".tray");
  let coolUntil = 0;
  let coolTimer: ReturnType<typeof setTimeout> | undefined;
  function openTray() {
    const t = tray();
    if (!t) return;
    closeMenu(false);
    t.hidden = false;
    tab()!.setAttribute("aria-expanded", "true");
    t.toggleAttribute("data-cooling", Date.now() < coolUntil);
    t.querySelector<HTMLElement>("button")!.focus({ preventScroll: true });
  }
  function closeTray(refocus = true) {
    const t = tray();
    if (!t || t.hidden) return;
    t.hidden = true;
    tab()?.setAttribute("aria-expanded", "false");
    if (refocus) tab()?.focus({ preventScroll: true });
  }
  // the tab wears what you sent for the second you can't send another
  // (INT-8.6, INT-8.22); pending at half while the request is out
  function wear(emoji: string | null, pending = false) {
    const t = tab();
    if (!t) return;
    if (!t.dataset.icon) t.dataset.icon = t.innerHTML;
    if (emoji) {
      t.innerHTML = `<svg viewBox="0 0 16 16" width="32" height="32" aria-hidden="true"><use href="#em-${emoji}"/></svg>`;
      t.setAttribute("aria-label", `Send an emoji (sent: ${emoji})`);
      t.setAttribute("aria-disabled", "true");
    } else {
      t.innerHTML = t.dataset.icon;
      t.setAttribute("aria-label", "Send an emoji");
      t.removeAttribute("aria-disabled");
    }
    t.classList.toggle("pending", pending);
  }
  async function sendEmoji(emoji: string) {
    if (Date.now() < coolUntil) return; // nothing within the second (INT-8.8)
    closeTray();
    coolUntil = Date.now() + 1000;
    wear(emoji, true);
    const r = await send({ action: "emote", emoji });
    clearTimeout(coolTimer);
    if (r.ok) {
      wear(emoji);
      blip("sent"); // INT-12.1: a soft pop for your own emoji landing
      const news = document.querySelector<HTMLElement>("#sheet-news");
      if (news) {
        news.textContent = "";
        setTimeout(() => (news.textContent = `Sent: ${emoji}`), 50);
      }
      coolTimer = setTimeout(() => wear(null), Math.max(0, coolUntil - Date.now()));
    } else {
      coolUntil = 0;
      wear(null);
      if (r.reason === "failed") tell(FAILED, true, undefined, "emote-error");
    }
  }
  document.addEventListener("click", (e) => {
    const t = e.target as Element;
    if (t.closest?.(".dock .emote")) {
      if (tab()!.getAttribute("aria-disabled") === "true") return;
      return tray()?.hidden ? openTray() : closeTray();
    }
    const b = t.closest?.<HTMLButtonElement>(".tray button");
    if (b) void sendEmoji(b.value);
  });
  // Keyboard (INT-8.12): arrows move in the 4 x 2 grid, Escape closes
  document.addEventListener("keydown", (e) => {
    const t = tray();
    if (!t || t.hidden || !t.contains(document.activeElement)) return;
    const buttons = [...t.querySelectorAll<HTMLElement>("button")];
    const i = buttons.indexOf(document.activeElement as HTMLElement);
    const row = Math.floor(i / 4);
    const go = (j: number) => {
      e.preventDefault();
      buttons[j].focus({ preventScroll: true });
    };
    if (e.key === "Escape") {
      e.preventDefault();
      closeTray();
    } else if (e.key === "ArrowRight") go(row * 4 + ((i % 4) + 1) % 4);
    else if (e.key === "ArrowLeft") go(row * 4 + ((i % 4) + 3) % 4);
    else if (e.key === "ArrowDown" || e.key === "ArrowUp") go((i + 4) % 8);
  });

  // ---------- the room log (INT-5.8; I.9) ----------
  // New lines arrive at the top within a second, quietly; the newest 50 are
  // kept, five showing and the rest behind "Show older".
  function addLog(entry: LogEntry) {
    const panel = document.querySelector<HTMLElement>(".room-log");
    if (!panel) return;
    const shown = panel.querySelector<HTMLOListElement>(":scope > ol")!;
    const older = panel.querySelector<HTMLDetailsElement>(".older")!;
    const olderList = older.querySelector("ol")!;
    const me = Number(shown.dataset.me);
    const li = document.createElement("li");
    li.dataset.at = String(entry.at);
    li.classList.toggle("you", entry.from.id === me || ("to" in entry && entry.to.id === me));
    li.classList.toggle("pb", entry.kind === "pb");
    li.append(tpl(`log-${LOG_ICON[entry.kind]}`));
    const l = logLine(entry, me);
    const line = document.createElement("span");
    line.className = "line";
    if (l.text !== undefined) {
      const to = document.createElement("span");
      to.className = "to";
      to.textContent = l.to!;
      line.append(`${l.who} `, to, ` "${l.text}"`);
    } else line.append(l.who + l.rest);
    const t = document.createElement("span");
    t.className = "t";
    t.textContent = ago(entry.at, nowServer());
    li.append(line, t);
    shown.prepend(li);
    panel.querySelector(".empty")?.remove();
    // INT-5.23: "You walked in" once there are lines on both sides of it,
    // above the first line from before you came
    const joined = Number(shown.dataset.joined);
    if (shown.dataset.joined && entry.at >= joined && !panel.querySelector("li.joined")) {
      const before = [...panel.querySelectorAll<HTMLElement>("li[data-at]")].find((x) => Number(x.dataset.at) < joined);
      if (before) {
        const line = document.createElement("li");
        line.className = "joined";
        line.textContent = shown.dataset.joinedText ?? "";
        before.before(line);
      }
    }
    // keep five showing (the "You walked in" line rides along), the rest older
    const rows = () => [...shown.children].filter((c) => !c.classList.contains("joined"));
    while (rows().length > 5) olderList.prepend(shown.lastElementChild!);
    if (shown.lastElementChild?.classList.contains("joined")) olderList.prepend(shown.lastElementChild);
    const all = [...shown.children, ...olderList.children].filter((c) => !c.classList.contains("joined"));
    for (const extra of all.slice(50)) extra.remove();
    const n = [...olderList.children].filter((c) => !c.classList.contains("joined")).length;
    older.hidden = n === 0;
    older.querySelector("summary")!.textContent = `Show older (${n} more)`;
  }
  // the times on the right move on by themselves
  setInterval(() => {
    for (const li of document.querySelectorAll<HTMLElement>(".room-log li[data-at]")) {
      const t = li.querySelector(".t");
      if (t) t.textContent = ago(Number(li.dataset.at), nowServer());
    }
  }, 30_000);

  // ---------- the sound setting (INT-12.3 to INT-12.8; F.11) ----------
  const SOUND_WORD: Record<SoundSetting, string> = { all: "All sounds", rest: "Rest timer only", off: "Sound off" };
  const NEXT_SOUND: Record<SoundSetting, SoundSetting> = { all: "rest", rest: "off", off: "all" };
  function drawSound() {
    const b = document.querySelector<HTMLButtonElement>(".map-panel .sound");
    if (!b || b.dataset.sound === sound) return;
    b.dataset.sound = sound;
    b.querySelector(".sound-box > svg")?.replaceWith(tpl(`sound-${sound}`));
    b.querySelector(".sound-word")!.textContent = SOUND_WORD[sound];
  }
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest?.<HTMLButtonElement>(".map-panel .sound");
    if (!b) return;
    setSound(NEXT_SOUND[sound]);
    drawSound();
    say(`Sound: ${SOUND_WORD[sound].toLowerCase()}`);
  });

  // ---------- on each room shown ----------
  // a bubble still within its 5 s shows for its time left (INT-5.6)
  document.addEventListener("astro:page-load", () => {
    readLimits();
    closeMenu(false);
    drawSound();
    const gym = document.querySelector<HTMLElement>(".gym");
    if (!gym) return;
    // what's open as the server drew the room, until the stream's first message
    if (!view && gym.dataset.moments) {
      const m = JSON.parse(gym.dataset.moments) as Pick<RoomView, "offers" | "answerable" | "pbs">;
      answers = m.answerable;
      offers = m.offers;
      pbs = m.pbs;
      setTimeout(drawOffers, 300); // once the people are placed
      redrawAnswers();
    }
    // a lapse is only told to the offerer, so their own open offers are watched
    for (const o of offers) if (o.from === meId()) watchLapse(o);
    for (const e of JSON.parse(gym.dataset.says ?? "[]") as Extract<LogEntry, { kind: "say" }>[]) {
      const at = e.at;
      // the room's people are only placed once the first message is in
      const show = () => bubble(e.from.id, e.to.name, e.text, at);
      if (avatarOf(e.from.id)) show();
      else setTimeout(show, 300);
    }
  });

  document.addEventListener(
    "click",
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element).closest?.<HTMLAnchorElement>("a[href]");
      if (!link?.closest(".gym")) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
      e.preventDefault();
      swap(url, {}, () => location.assign(url), firstField);
    },
    true,
  );
</script>

<style>
  /* .panel: the Night card (system 9). Lives here until another Night page
     needs it, then moves to the layout. Global, so the map's panel
     (GymMap.astro) is one too. */
  :global(.gym .panel) {
    position: relative;
    margin: 0 0 2rem;
    padding: 1.5rem 1.25rem 1.25rem;
    background: var(--panel);
    border: var(--px) solid var(--edge);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  :global(.gym .panel > :last-child) {
    margin-bottom: 0;
  }
  /* the panel's name sits on its top border, like an RPG menu box */
  .panel-title {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 16px;
    line-height: 1.5;
    color: var(--leaf);
    background: var(--panel);
  }
  /* the workout clock rides the sheet's top border, on the right, across
     from your state tab, so it's on screen from the moment you walk in */
  .panel-clock {
    display: flex;
    align-items: center;
    gap: var(--px);
    position: absolute;
    top: calc(var(--px) * -0.5);
    right: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 24px;
    line-height: 1;
    color: var(--leaf);
    background: var(--panel);
    font-variant-numeric: tabular-nums;
  }
  :global(.gym .vh) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Phones: map, sheet, squad, log, room, top to bottom; only the sheet's
     dock (its primary button) is pinned. Laptops: two columns, the sheet
     alone on the right. */
  .gym {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .gym {
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: 2rem;
      align-items: start;
    }
    .gym > .sheet {
      grid-column: 2;
      grid-row: 1 / span 4;
      position: sticky;
      top: 2rem;
    }
  }

  /* ---------- the gym sign: passcode, spots, room actions ---------- */
  .sign .passcode-box {
    margin-bottom: 0.75rem;
  }
  .spots {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .pips {
    display: flex;
    gap: var(--px);
  }
  .pips i {
    width: calc(var(--px) * 2);
    height: calc(var(--px) * 3);
    background: var(--night);
    box-shadow: inset 0 0 0 2px var(--edge);
  }
  .pips i.in {
    background: var(--leaf);
    box-shadow: none;
  }
  .room-actions {
    margin-top: 0.75rem;
  }
  .room-actions form {
    margin: 0;
  }
  .sign .leave-note {
    margin: 0.25rem 0 0;
  }
  /* room and logbook actions: secondary, and quieter than anything in the
     sheet, so they never compete with Done (system 8) */
  .button.quiet {
    padding: 0.75rem 1rem;
    font-size: 8px;
  }

  /* ---------- one confirm pattern: End room, Delete set ----------
     The summary is the first tap; it turns into Cancel in place, so a
     second tap on the same spot backs out. Works without JS. */
  .confirm > summary {
    list-style: none;
  }
  .confirm > summary::-webkit-details-marker {
    display: none;
  }
  .confirm .if-open,
  .confirm[open] .if-closed {
    display: none;
  }
  .confirm[open] .if-open {
    display: inline;
  }
  /* a confirm always sits alone on its row, so opening it moves nothing */
  .confirm {
    margin: 0.75rem 0 0;
  }
  .confirm-box {
    margin: 0.75rem 0 0;
    padding: 1rem;
    background: var(--night);
    border: var(--px) solid var(--paper);
  }
  .confirm-box p {
    margin: 0 0 0.75rem;
  }

  /* ---------- the connection (GYM-13): Live, or Reconnecting ----------
     On the map's top border, opposite its sign (GymMap draws it, the script
     swaps it, so these reach it globally). */
  :global(.map-panel .conn) {
    position: absolute;
    top: calc(var(--px) * -0.5);
    right: 0.75rem;
    z-index: 20;
    transform: translateY(-50%);
    margin: 0;
    line-height: 1;
  }
  :global(.map-panel .conn .badge) {
    margin: 0;
    padding: 0.25rem 0.5rem;
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.conn .lost) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    font: 20px/28px var(--body);
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.conn .lost svg) {
    color: var(--dim);
  }

  /* ---------- people list (GYM-15): the room, in words ----------
     Same row as home's "What your squad sees": head, name over what
     they're doing, state chip on the right. */
  .people {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people :global(li) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 0.75rem;
    min-height: 44px;
    padding: 0.5rem 0;
    border-top: var(--px) solid var(--night);
  }
  .people :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .people :global(li:last-child) {
    padding-bottom: 0;
  }
  /* the head crop of the avatar, as on home: 32 x 20 sprite pixels at 2x */
  .people :global(.av) {
    width: 64px;
    height: 40px;
  }
  .people :global(li.away .av) {
    opacity: 0.5;
  }
  .people :global(.who) {
    line-height: 1.2;
  }
  .people :global(.what) {
    display: block;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .people :global(.n) {
    white-space: nowrap;
  }
  .people :global(.badge) {
    margin: 0 0 0 0.25rem;
  }
  .people :global(.chips) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--px);
  }
  /* Away isn't a colour: a dashed chip with the phone-off icon */
  .people :global(.chip.away) {
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
  }
  .badge.host {
    color: var(--paper);
    background: var(--night);
    border-color: var(--edge);
  }
  .room-link {
    color: var(--paper);
    overflow-wrap: anywhere;
  }
  .alone {
    margin: 0.75rem 0 0;
  }

  /* ---------- this workout: a logbook page ---------- */
  .tally {
    margin: 0 0 1rem;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .tally b {
    font-weight: 400;
    color: var(--paper);
  }
  /* repeat lift names become ditto marks, like a paper logbook */
  .ditto {
    padding-left: 1.5rem;
    color: var(--dim);
  }
  /* one column per set, written the way a lifter writes it */
  .log td.set {
    white-space: nowrap;
  }
  .log .u {
    color: var(--dim);
  }
  .log .sub {
    display: block;
    font-size: 20px;
    line-height: 1.1;
    color: var(--dim);
  }
  .log th.fix,
  .log td.fix {
    width: 44px;
    padding: 0;
  }
  /* :global(.night): <body> carries it, outside this page's scope; the
     prefix out-ranks the layout's Night link and heading colours */
  :global(.night) .log .fix a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--leaf);
  }
  .log tr[aria-current="true"] td {
    background: var(--night);
  }
  .log tr[aria-current="true"] td:first-child {
    box-shadow: inset var(--px) 0 0 var(--leaf);
  }
  :global(.night) .log tr[aria-current="true"] .fix a {
    color: var(--ink);
    background: var(--leaf);
  }

  /* ---------- the sheet: your state, your next set ---------- */
  .sheet {
    border-color: var(--leaf);
  }
  /* your state chip is the sheet's name tab */
  .sheet > .tab {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  /* the dock: the sheet's one primary button (Done, Start set, Save,
     Choose). On a laptop it is the foot of the sheet. On a phone it is a bar
     fixed to the bottom of the screen, so the map can sit at the top of the
     page and the button is always in the thumb zone, wherever you scroll. */
  .dock {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.25rem -1.25rem -1.25rem;
    padding: 0.75rem 1.25rem 0.5rem;
    background: var(--panel);
    border-top: var(--px) solid var(--night);
  }
  .sheet .dock .wide {
    flex: 1;
    width: auto;
    min-width: 0;
    margin: 0;
  }
  /* a copy of the rest timer, shown only while the big one is out of view
     (the script watches it); screen readers use the big one */
  /* Done's stamp: what was just logged, on the dock's top border for 4 s,
     rising out of it in steps and sinking back. Taps pass through it. */
  .stamp {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--px);
    max-width: calc(100% - 1.5rem);
    margin: 0;
    padding: 0 0.5rem 0 0.25rem;
    font: 20px/24px var(--body);
    color: var(--leaf);
    background: var(--night);
    border: 2px solid var(--leaf);
    box-shadow: 0 0 0 var(--px) var(--panel);
    transform: translateY(-50%);
    pointer-events: none;
    font-variant-numeric: tabular-nums;
    animation: stamp 4s steps(4) forwards;
  }
  .stamp :global(svg) {
    flex: none;
  }
  .stamp span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .stamp b {
    font-weight: 400;
    color: var(--paper);
  }
  @keyframes stamp {
    0% {
      clip-path: inset(100% -8px -8px -8px);
    }
    4%,
    96% {
      clip-path: inset(-8px);
    }
    100% {
      clip-path: inset(100% -8px -8px -8px);
      visibility: hidden;
    }
  }
  @keyframes stamp-still {
    100% {
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp {
      animation-name: stamp-still;
      animation-timing-function: steps(1);
    }
  }
  .dock-timer {
    margin: 0 0 var(--px);
    font-size: 48px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .dock-timer.slacking {
    color: var(--slacking);
  }
  @media (max-width: 899px) {
    .dock {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 30;
      margin: 0;
      padding: 0.5rem 1rem max(0.5rem, env(safe-area-inset-bottom));
      border-top-color: var(--leaf);
      box-shadow: 0 calc(var(--px) * -1) 0 #000;
    }
    /* room under the bar for the last thing on the page */
    :global(body:has(.dock) footer) {
      padding-bottom: 7rem;
    }
  }
  /* LOG-5: rest over flashes the sheet's border, at most 2 a second, 3 times */
  .sheet.flash {
    animation: rest-flash 500ms steps(1) 3;
  }
  @keyframes rest-flash {
    0% {
      border-color: var(--night);
    }
    50% {
      border-color: var(--leaf);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet.flash {
      animation: none;
    }
  }
  /* cardio's logged block: where the rest block would be, in leaf */
  .set-done {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin: 0 0 1rem;
    padding: 0.5rem;
    background: var(--night);
    border: var(--px) solid var(--leaf);
  }
  .set-done :global(svg) {
    color: var(--leaf);
  }
  .set-done-n {
    margin: 0;
    font-size: 32px;
    line-height: 1;
  }
  .set-done-say {
    grid-column: 1 / -1;
    margin: 0;
  }
  /* timed fields start empty; the placeholders read 0:00 */
  :global(.mmss input::placeholder) {
    color: var(--dim);
    opacity: 1;
  }
  .sheet-news {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ===== interactions, presets, emoji (criteria/int.md; room spec I.1 to I.9) =====
     Global: the script builds the menu, reactions, banners, bubbles and pops. */

  /* ---------- who the menu is for: a paper ring on their tag ---------- */
  :global(.map .avatar[aria-expanded="true"] .tag) {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }

  /* ---------- the menu (INT-1): the game's START menu (I.2) ----------
     Laptop: beside the avatar, or under the squad row. Phone: pinned 56 px
     above the dock, in the thumb zone, never over it. */
  :global(.menu) {
    position: absolute;
    z-index: 25;
    width: 20rem;
    max-width: calc(100vw - 2rem);
    margin: 0;
    padding: 0.75rem;
    background: var(--panel);
    border: var(--px) solid var(--paper);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  @media (max-width: 899px) {
    :global(.menu) {
      position: fixed;
      right: 1rem;
      bottom: calc(var(--dock-h, 92px) + 56px);
      left: 1rem;
      z-index: 35;
      width: auto;
      max-width: none;
      max-height: calc(100dvh - var(--dock-h, 92px) - 64px);
      overflow-y: auto;
    }
  }
  :global(.menu-who) {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 0 0.75rem;
    margin: 0 0 0.75rem;
  }
  :global(.menu-who .av) {
    width: 64px;
    height: 40px;
  }
  :global(.menu-name) {
    display: block;
    margin: 0;
    font-size: 26px;
    line-height: 1;
    color: var(--paper);
  }
  :global(.menu-name .chips) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--px);
    margin-top: var(--px);
  }
  :global(.menu [hidden]) {
    display: none;
  }
  :global(.menu-acts) {
    display: grid;
    gap: var(--px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.night .menu .act) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    width: 100%;
    min-height: 48px;
    margin: 0;
    padding: 0 0.75rem 0 0.5rem;
    font: 16px/1 var(--display);
    color: var(--paper);
    background: var(--night);
    border: 2px solid var(--edge);
    box-shadow: none;
    transform: none;
  }
  :global(.night .menu .act:hover) {
    background: var(--floor);
  }
  :global(.night .menu .act:active) {
    transform: translateY(2px);
  }
  /* the cursor on the fitting move (INT-2.14, INT-2.15); a slot elsewhere.
     Drawn here, so a row's text is its word alone. */
  :global(.menu .cur::before) {
    content: "▶";
  }
  :global(.menu .act .cur) {
    visibility: hidden;
  }
  :global(.night .menu .act.hot) {
    color: var(--ink);
    background: var(--leaf);
    border-color: var(--ink);
  }
  :global(.menu .act.hot .cur) {
    visibility: visible;
  }
  /* not now (INT-2.13, INT-4.7): focusable, dashed, the reason under it */
  :global(.night .menu .act[aria-disabled="true"]) {
    color: var(--dim);
    background: transparent;
    border-style: dashed;
    border-color: var(--dim);
    cursor: not-allowed;
  }
  :global(.night .menu .act[aria-disabled="true"] .cur) {
    visibility: hidden;
  }
  :global(.menu-why) {
    margin: 0.5rem 0 0;
    color: var(--dim);
  }
  /* Message: the same box, its rows swapped for the ten presets */
  :global(.menu-sub) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  :global(.night .menu .back) {
    width: auto;
    min-height: 44px;
    margin: 0;
    padding: 0 0.75rem 0 0.5rem;
    font-size: 8px;
  }
  :global(.menu .back .cur) {
    display: inline-block;
    visibility: visible;
    transform: scaleX(-1);
  }
  :global(.menu-to) {
    margin: 0;
    font-size: 24px;
    line-height: 1;
    color: var(--paper);
  }
  :global(.menu-group) {
    margin: 0.75rem 0 0.5rem;
    font: 8px/1 var(--display);
    text-transform: uppercase;
    color: var(--leaf);
  }
  :global(.menu-sub + .menu-group) {
    margin-top: 0;
  }
  :global(.presets) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  :global(.night .menu .preset) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    height: 100%;
    min-height: 52px;
    margin: 0;
    padding: var(--px) 0.5rem;
    font: 20px/1 var(--body);
    text-align: left;
    text-transform: none;
    color: var(--paper);
    background: var(--night);
    border: 2px solid var(--edge);
    box-shadow: none;
    transform: none;
  }
  :global(.night .menu .preset:hover) {
    background: var(--floor);
  }

  /* ---------- the squad list opens the same menu (INT-1.10) ----------
     Each other person's row is one button laid out as the row was. */
  .people :global(li:has(> .person)) {
    display: block;
  }
  :global(.night .people .person) {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 0 0.75rem;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font: inherit;
    text-align: left;
    text-transform: none;
    color: inherit;
    background: none;
    box-shadow: none;
    transform: none;
  }
  :global(.night .people .person:hover),
  :global(.night .people .person[aria-expanded="true"]) {
    background: var(--night);
    box-shadow: 0 0 0 var(--px) var(--night);
  }

  /* ---------- reactions (INT-3): one svg over the tile, frames in turn (I.4) ---------- */
  :global(.map .avatar .fx) {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 3;
    width: var(--t);
    height: var(--t);
    overflow: visible;
    transform: translateX(-50%);
    pointer-events: none;
  }
  :global(.map .avatar.on-station:not(.on-machine) .fx) {
    bottom: calc(var(--t) * -0.375);
  }
  :global(.fx use) {
    visibility: hidden;
    animation: fx-frame var(--f) steps(1) forwards;
  }
  :global(.fx use:nth-child(2)) {
    animation-delay: var(--f);
  }
  :global(.fx use:nth-child(3)) {
    animation-delay: calc(var(--f) * 2);
  }
  :global(.fx use:nth-child(4)) {
    animation-delay: calc(var(--f) * 3);
  }
  :global(.fx-cheer) {
    --f: 200ms;
  }
  :global(.fx-poke) {
    --f: 240ms;
  }
  :global(.fx-slap) {
    --f: 200ms;
  }
  @keyframes fx-frame {
    0% {
      visibility: visible;
    }
    100% {
      visibility: hidden;
    }
  }
  /* reduced motion: the middle frame, still (INT-3.9); the script removes it */
  @media (prefers-reduced-motion: reduce) {
    :global(.fx use) {
      animation: none;
    }
    :global(.fx use:nth-child(2)) {
      visibility: visible;
    }
  }

  /* ---------- the banner (INT-3): a game text box, 4 s (I.5) ----------
     Laptop: centred at the top of the map panel. Phone: fixed at the top of
     the screen, wherever you've scrolled. */
  :global(.map-panel .banner-slot) {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    z-index: 24;
    width: max-content;
    max-width: calc(100% - 2rem);
    transform: translateX(-50%);
    pointer-events: none;
  }
  @media (max-width: 899px) {
    :global(.map-panel .banner-slot) {
      position: fixed;
      top: 0.5rem;
      right: 0.5rem;
      left: 0.5rem;
      z-index: 40;
      width: auto;
      max-width: none;
      transform: none;
    }
  }
  :global(.banner) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: var(--px) 0.75rem var(--px) var(--px);
    font: 22px/1.1 var(--body);
    color: var(--ink);
    background: var(--paper);
    border: var(--px) solid var(--ink);
    box-shadow:
      0 0 0 var(--px) var(--edge),
      var(--px) calc(var(--px) * 2) 0 var(--px) #000;
    animation: banner 4s steps(4) forwards;
  }
  :global(.banner .av) {
    flex: none;
    width: 64px;
    height: 40px;
  }
  @keyframes banner {
    0% {
      clip-path: inset(0 -16px 100% -16px);
    }
    4%,
    96% {
      clip-path: inset(-16px);
    }
    100% {
      clip-path: inset(0 -16px 100% -16px);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.banner) {
      animation: none;
    }
  }

  /* ---------- a refusal or a failure, where the menu was (I.3) ----------
     A refusal is news: dashed, like Reconnecting. A failure is an error. */
  :global(.note) {
    width: max-content;
    max-width: 18rem;
    margin: 0;
    padding: 0.25rem 0.5rem;
    font: 20px/1.1 var(--body);
    color: var(--paper);
    background: var(--night);
    border: 2px dashed var(--dim);
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.map .note),
  :global(.map .error) {
    position: absolute;
    z-index: 24;
    width: max-content;
    max-width: 18rem;
    margin: 0;
    pointer-events: none;
  }
  :global(.dock .note),
  :global(.dock .error) {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0.75rem;
    z-index: 3;
    max-width: calc(100% - 5.5rem);
    margin: 0;
    pointer-events: none;
  }

  /* ===== room feel (4 Nov; criteria/room-feel.md; room spec "Room feel, Nov 4") ===== */

  /* a banner with one button (INT-9.1, INT-10.2, GYM-18.1; F.2): the text
     box's ▶ prompt becomes the answer, drawn as a highlighted menu row; the
     box still lets taps through; 6 s */
  :global(.banner.has-act) {
    flex-wrap: wrap;
    padding-right: var(--px);
    animation-name: banner-6;
    animation-duration: 6s;
  }
  :global(.banner-line) {
    flex: 1 1 10rem;
    min-width: 0;
  }
  :global(.night .banner-act) {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin: 0 0 0 auto;
    padding: 0 0.75rem 0 0.5rem;
    font: 16px/1 var(--display);
    color: var(--ink);
    background: var(--leaf);
    border: 2px solid var(--ink);
    box-shadow: none;
    transform: none;
    pointer-events: auto;
  }
  :global(.night .banner-act:hover) {
    background: var(--leaf-hover);
  }
  :global(.night .banner-act:active) {
    transform: translateY(2px);
  }
  /* its first half second it ignores taps (R1); the cursor shows when it's live */
  :global(.banner-act .cur) {
    animation: banner-arm 500ms steps(1) both;
  }
  @keyframes banner-arm {
    0% {
      visibility: hidden;
    }
    100% {
      visibility: visible;
    }
  }
  @keyframes banner-6 {
    0% {
      clip-path: inset(0 -16px 100% -16px);
    }
    2.667%,
    97.333% {
      clip-path: inset(-16px);
    }
    100% {
      clip-path: inset(0 -16px 100% -16px);
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.banner.has-act) {
      animation: none;
    }
  }
  /* the room's banner for a PB (GYM-18.1; F.8): a gold ring and a PB tab */
  :global(.banner.room) {
    position: relative;
    margin-top: 0.75rem;
    box-shadow:
      0 0 0 var(--px) var(--finished),
      var(--px) calc(var(--px) * 2) 0 var(--px) #000;
  }
  :global(.banner-tab) {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    font: 8px/1 var(--display);
    color: var(--ink);
    background: var(--finished);
    border: 2px solid var(--ink);
    transform: translateY(-50%);
  }
  :global(.banner-tab svg) {
    width: 8px;
    height: 8px;
  }
  /* never over the person it's about (F.2): on a laptop, when they stand in
     the top three rows, the slot drops to the map's bottom wall */
  @media (min-width: 900px) {
    :global(.map .banner-slot.low) {
      top: auto;
      bottom: calc(var(--t) * 0.25);
    }
  }

  /* the menu: an answer as its first row (INT-9.10; F.3), and the PB line */
  :global(.menu-acts li.answer) {
    padding-bottom: var(--px);
    border-bottom: 2px dashed var(--edge);
  }
  :global(.menu-acts li[hidden]) {
    display: none;
  }
  :global(.menu-acts .answer-icon) {
    display: contents;
  }
  :global(.menu-news) {
    display: flex;
    align-items: center;
    gap: var(--px);
    margin: 0 0 0.5rem;
    color: var(--finished);
  }
  :global(.menu-news[hidden]) {
    display: none;
  }

  /* reactions, livelier (INT-11; F.6): each frame its own start and length,
     and the whole sprite may move with it (.jolt-*); the tag never moves */
  :global(.fx use) {
    animation-duration: var(--d, var(--f));
    animation-delay: var(--at, 0s);
  }
  :global(.fx.still use) {
    visibility: visible;
    animation: none;
  }
  :global(.map .avatar .av.jolt-hop) {
    animation: jolt-hop 1s steps(1);
  }
  :global(.map .avatar .av.jolt-nudge) {
    animation: jolt-nudge 1s steps(1);
  }
  :global(.map .avatar .av.jolt-shake) {
    animation: jolt-shake 1.2s steps(1);
  }
  @keyframes jolt-hop {
    20% {
      translate: 0 calc(var(--s) * -2px);
    }
    45% {
      translate: 0;
    }
  }
  /* --dir: 1 east (poke: away from the finger; the western High-five
     partner), -1 west (the eastern partner) */
  @keyframes jolt-nudge {
    25% {
      translate: calc(var(--s) * var(--dir, 1) * 1px) 0;
    }
    45% {
      translate: 0;
    }
  }
  @keyframes jolt-shake {
    12.5% {
      translate: calc(var(--s) * 2px) 0;
    }
    19% {
      translate: calc(var(--s) * -1px) 0;
    }
    26% {
      translate: calc(var(--s) * 1px) 0;
    }
    32.5% {
      translate: 0;
    }
  }
  /* the High-five is drawn for a partner to the east; mirrored for the west */
  :global(.map .avatar .fx.face-west) {
    transform: translateX(-50%) scaleX(-1);
  }
  /* an open offer: the palm held up, bobbing a sprite pixel */
  :global(.fx-offer use) {
    visibility: visible;
    animation: offer-bob 800ms steps(1) infinite;
  }
  @keyframes offer-bob {
    50% {
      translate: 0 -1px;
    }
  }
  /* the offer's bubble lasts as long as the offer; the script sets the time left */
  :global(.map .says .say.offer) {
    animation-duration: 10s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.map .avatar .av[class*="jolt-"]),
    :global(.fx-offer use) {
      animation: none;
    }
  }

  /* the lifter's PB, in the logged stamp (GYM-17.9; F.7): gold, the medal,
     "New PB: <set> 🏆"; a long set is cut at the end, the 🏆 never is */
  .stamp.pb {
    color: var(--finished);
    border-color: var(--finished);
  }
  .stamp .pb-mark {
    flex: none;
    margin-left: 0.25rem;
  }

  /* the sender's confirmation line (INT-11.5; F.9): where refusals go,
     solid leaf with a tick */
  :global(.note.sent) {
    display: flex;
    align-items: center;
    gap: var(--px);
    color: var(--leaf);
    border-style: solid;
    border-color: var(--leaf);
  }
  :global(.note.sent svg) {
    flex: none;
  }

  /* the room log's PB line (F.10) */
  .room-log :global(li.pb > svg) {
    color: var(--finished);
  }

  /* the sound setting (INT-12.8; F.11): a sign on the map panel's bottom
     border, at the right; the button 44 px tall, the sign in it 28 px */
  :global(.map-panel:has(.sound)) {
    margin-bottom: 2.5rem;
  }
  :global(.night .map-panel .sound) {
    position: absolute;
    right: 0.75rem;
    bottom: calc(var(--px) * -0.5);
    z-index: 20;
    min-height: 44px;
    margin: 0;
    padding: 0;
    font: 20px/24px var(--body);
    text-transform: none;
    color: var(--paper);
    background: none;
    box-shadow: none;
    transform: translateY(50%);
  }
  :global(.sound-box) {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.5rem;
    background: var(--night);
    border: 2px solid var(--edge);
    box-shadow: 0 0 0 var(--px) var(--panel);
  }
  :global(.night .map-panel .sound:hover .sound-box) {
    background: var(--floor);
  }
  :global(.sound svg) {
    flex: none;
    color: var(--leaf);
  }
  :global(.night .map-panel .sound[data-sound="off"]),
  :global(.sound[data-sound="off"] svg) {
    color: var(--dim);
  }
  :global(.night .map-panel .sound:focus-visible) {
    outline: none;
  }
  :global(.sound:focus-visible .sound-box) {
    outline: var(--px) solid var(--focus);
    outline-offset: 2px;
  }
  /* ===== room feel end ===== */

  /* ===== acting it out (5 Nov; criteria/room-acting.md; room spec "Acting it out, Nov 5") ===== */
  /* the errand (INT-13; A.2): a walker is the same button, stepped by walk() */
  :global(.map .avatar.errand) {
    z-index: calc(var(--y) + 0.5);
  }
  /* at the meeting spot the body leans towards the target; the tag stays */
  :global(.map .avatar.errand.at-spot .av) {
    translate: calc(var(--t) * var(--lean, 0.25) * var(--dir, 1)) 0;
  }
  /* the tag draws over its own body and effects (INT-15.5) */
  :global(.map .avatar .tag) {
    position: relative;
    z-index: 1;
  }
  /* bodies are drawn facing east, flipped to face a partner to the west */
  :global(.map .avatar .av.face-west) {
    scale: -1 1;
  }
  /* the target's body reaction (INT-15; A.4): the hop and the lean */
  :global(.map .avatar .av.lift-2) {
    translate: 0 calc(var(--s) * -2px);
  }
  :global(.map .avatar .av.lift-4) {
    translate: 0 calc(var(--s) * -4px);
  }
  :global(.map .avatar .av.lean-2) {
    translate: calc(var(--s) * -2px * var(--dir, 1)) 0;
  }
  /* the lifter's gesture (INT-14; A.6): a hand over the machine's front */
  :global(.map .avatar .gesture) {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 1;
    width: var(--t);
    height: var(--t);
    transform: translateX(-50%);
    pointer-events: none;
  }
  :global(.map .avatar .gesture.face-west) {
    transform: translateX(-50%) scaleX(-1);
  }
  :global(.map .avatar.on-station:not(.on-machine) .gesture) {
    bottom: calc(var(--t) * -0.375);
  }
  /* the travelling effect (INT-14.4, INT-13.14; A.7): over avatars, under
     bubbles, banners and menus; stepped a tile at a time by the script */
  :global(.map .flights) {
    position: absolute;
    inset: 0;
    z-index: 16;
    pointer-events: none;
  }
  :global(.map .flight),
  :global(.map .smack) {
    position: absolute;
    left: calc(var(--fx) * var(--t));
    top: calc(var(--fy) * var(--t) - var(--t) * 0.5);
    width: var(--t);
    height: var(--t);
    overflow: visible;
  }
  :global(.map .smack) {
    left: calc(var(--fx) * var(--t) - var(--t) * 0.5);
  }
  :global(.map .flight.face-west) {
    transform: scaleX(-1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.map .flights) {
      display: none;
    }
    :global(.map .avatar.errand.at-spot .av),
    :global(.map .avatar .av[class*="lift-"]),
    :global(.map .avatar .av.lean-2) {
      translate: none;
    }
  }
  /* ===== acting it out end ===== */

  /* ---------- bubbles and pops: two layers over the map (I.6, I.8) ----------
     Each placed from its sender's tile (--x, --y; --dy for the slacker's
     drop). Pops draw under every avatar, so a tag is never covered;
     bubbles draw over them. Neither takes taps. */
  :global(.map .says),
  :global(.map .pops) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(.map .pops) {
    z-index: 0;
  }
  :global(.map .says) {
    z-index: 18;
  }
  /* an offer's bubble lasts 10 s, so it goes under every avatar, as pops do:
     a neighbour's tag and head always draw over it (INT-11.3, settled 5 Nov) */
  :global(.map .says.offers) {
    z-index: 0;
  }
  /* the anchor: the top of the sender's tag (20 px of tag over the tile) */
  :global(.map .say),
  :global(.map .pop) {
    --top: calc((var(--y) + 1 + var(--dy, 0)) * var(--t) - var(--t) - 24px);
    position: absolute;
    left: calc((var(--x) + 0.5) * var(--t));
  }
  /* the preset bubble (INT-5): above the sender, 5 s; "@Ji-woo" first */
  :global(.map .say) {
    bottom: calc(100% - var(--top) + 0.75rem);
    width: max-content;
    max-width: min(9.5rem, calc(var(--t) * 4));
    margin: 0;
    padding: 2px 0.5rem;
    font: 20px/1 var(--body);
    color: var(--ink);
    background: var(--leaf);
    border: 2px solid var(--ink);
    transform: translateX(-50%);
  }
  :global(.say .to) {
    display: block;
    color: var(--deep);
  }
  :global(.say::after),
  :global(.say::before) {
    content: "";
    position: absolute;
    top: 100%;
    left: calc(50% - 4px);
    width: 8px;
    height: 4px;
    background: var(--ink);
  }
  :global(.say::before) {
    top: calc(100% + 4px);
    left: calc(50% - 2px);
    width: 4px;
  }
  /* near a side wall it hangs inwards, its tail over the sender */
  :global(.map .say.west) {
    transform: translateX(-16px);
  }
  :global(.map .say.east) {
    transform: translateX(calc(-100% + 16px));
  }
  :global(.say.west::after),
  :global(.say.east::after) {
    left: 10px;
  }
  :global(.say.west::before),
  :global(.say.east::before) {
    left: 12px;
  }
  :global(.say.east::after) {
    right: 10px;
    left: auto;
  }
  :global(.say.east::before) {
    right: 12px;
    left: auto;
  }
  /* the back row: no room above at 1x, so under the tile, tail up */
  :global(.map .say.below) {
    top: calc((var(--y) + 1 + var(--dy, 0)) * var(--t) + 0.5rem);
    bottom: auto;
  }
  :global(.say.below::after) {
    top: auto;
    bottom: 100%;
  }
  :global(.say.below::before) {
    top: auto;
    bottom: calc(100% + 4px);
  }
  /* a pop above the same person: the bubble steps up over it */
  :global(.map .say.over-pop) {
    bottom: calc(100% - var(--top) + 32px + 1rem);
  }
  /* the emoji pop (INT-8, BOT-6): 32 px, 4 px above the tag, 3 s */
  :global(.map .pop) {
    bottom: calc(100% - var(--top) + 4px);
    width: 32px;
    height: 32px;
    translate: -50% 0;
    animation: pop 180ms steps(1, end) forwards;
  }
  /* the back row: beside the tag, on the side away from the nearer wall */
  :global(.map .pop.beside) {
    bottom: calc(100% - var(--top) - 28px);
    translate: calc(var(--tag-w, var(--t)) / 2 + 2px) 0;
  }
  :global(.map .pop.beside.west-side) {
    translate: calc(-100% - var(--tag-w, var(--t)) / 2 - 2px) 0;
  }
  @keyframes pop {
    0% {
      transform: translateY(8px);
    }
    50% {
      transform: translateY(4px);
    }
    100% {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.map .pop) {
      animation: none;
    }
  }

  /* ---------- the emoji tab and tray (INT-8; I.7) ----------
     The tab rises from the dock's top border on the right, so it takes no
     width from the button; the tray opens above it, 48 px clear. */
  :global(.night .dock .emote) {
    position: absolute;
    right: 0.75rem;
    /* 100% is inside the dock's top border: the tab stands on it */
    bottom: 100%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 48px;
    min-height: 44px;
    margin: 0;
    padding: 0 0 var(--px);
    color: var(--leaf);
    background: var(--panel);
    border: var(--px) solid var(--leaf);
    border-bottom: 0;
    box-shadow: none;
    transform: none;
  }
  :global(.night .dock .emote:hover) {
    background: var(--night);
  }
  :global(.night .dock .emote[aria-expanded="true"]) {
    color: var(--ink);
    background: var(--leaf);
  }
  :global(.night .dock .emote[aria-disabled="true"]) {
    cursor: default;
  }
  :global(.dock .emote.pending svg) {
    opacity: 0.5;
  }
  @media (min-width: 900px) {
    .dock {
      margin-top: 4rem;
    }
  }
  /* the stamp stops short of the tab */
  .dock .stamp {
    max-width: calc(100% - 5.5rem);
  }
  @media (max-width: 899px) {
    :global(body:has(.dock .emote) footer) {
      padding-bottom: 10rem;
    }
  }
  .tray {
    position: absolute;
    right: 0.75rem;
    /* 48 px clear of the dock's outer edge, past its top border */
    bottom: calc(100% + 48px + var(--px));
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(4, 64px);
    gap: var(--px);
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--panel);
    border: var(--px) solid var(--leaf);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  .tray[hidden] {
    display: none;
  }
  :global(.night) .tray button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 64px;
    height: 64px;
    min-height: 0;
    margin: 0;
    padding: var(--px) 0 0;
    font: 20px/1 var(--body);
    text-transform: none;
    color: var(--paper);
    background: var(--night);
    box-shadow: none;
    transform: none;
  }
  :global(.night) .tray button:hover {
    background: var(--floor);
  }
  :global(.night) .tray button:active {
    transform: translateY(2px);
  }
  :global(.night) .tray[data-cooling] button {
    color: var(--dim);
    cursor: default;
  }
  .tray[data-cooling] svg {
    opacity: 0.5;
  }
  :global(.dock .emote-error) {
    right: calc(0.75rem + 60px);
    left: auto;
  }

  /* ---------- the room log (INT-5.8; I.9): presets and interactions ----------
     Newest first: five, then the rest of the newest 50 behind one tap.
     Lines about you wear the leaf edge, as an edited log row does. */
  .room-log ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .room-log :global(li) {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    align-items: start;
    gap: 0 0.5rem;
    padding: 0.5rem 0;
    border-top: 2px solid var(--night);
  }
  .room-log :global(li:first-child) {
    border-top: 0;
    padding-top: 0;
  }
  .room-log :global(li > svg) {
    margin-top: 4px;
    color: var(--dim);
  }
  .room-log :global(li.you) {
    padding-left: 0.5rem;
    box-shadow: inset var(--px) 0 0 var(--leaf);
  }
  .room-log :global(li.you > svg) {
    color: var(--leaf);
  }
  .room-log :global(.t) {
    color: var(--dim);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .room-log :global(.to) {
    color: var(--leaf);
  }
  .room-log :global(li.joined) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--dim);
  }
  .room-log :global(li.joined::before),
  .room-log :global(li.joined::after) {
    content: "";
    flex: 1;
    border-top: 2px dashed var(--edge);
  }
  .room-log .older {
    margin: 0.5rem 0 0;
  }
  .room-log .older > summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--leaf);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .room-log .older > summary::-webkit-details-marker {
    display: none;
  }
  .room-log .older[open] > summary {
    display: none;
  }
  .room-log .empty {
    margin: 0;
    color: var(--dim);
  }

  /* the rest block: water blue while resting, slacking red once it's over */
  .rest {
    margin: 0 0 1rem;
    padding: 0.5rem 0.5rem 0.25rem;
    background: var(--night);
    border: var(--px) solid var(--resting);
  }
  .rest.slacking {
    border-color: var(--slacking);
  }
  .rest-say {
    margin: 0.25rem 0 0;
  }
  /* the timer, and beside it (or under it, on a narrow phone) what it's for */
  .rest-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.75rem;
  }
  .timer {
    margin: 0;
    font-size: 80px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .rest.slacking .timer {
    color: var(--slacking);
  }
  .rest-what {
    margin: 0;
    line-height: 1.2;
    color: var(--dim);
    font-variant-numeric: tabular-nums;
  }
  .rest-what span {
    display: block;
    white-space: nowrap;
  }
  .rest-what b {
    font-weight: 400;
    color: var(--paper);
  }
  /* without JS: the end time, as text, instead of a frozen timer */
  .rest-static {
    margin: 0.25rem 0;
    font-size: 32px;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .rest-adjust {
    display: flex;
    gap: 0 0.5rem;
    margin: 0.5rem 0 0;
  }
  .rest-adjust .tool {
    flex: 1;
  }
  /* small tool buttons inside the sheet (rest ±15 s, Skip, stopwatch):
     VT323 because they carry numbers, and secondary so Done stays loudest */
  .sheet .tool {
    min-width: 48px;
    min-height: 48px;
    padding: 0 0.75rem;
    font: 24px/1 var(--body);
    text-transform: none;
  }
  .sw-toggle span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sw-toggle span[hidden] {
    display: none;
  }

  /* the lift name is the button that opens the exercise picker */
  .switch {
    margin: 0 0 0.75rem;
  }
  .switch summary,
  .lift-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    margin: 0 0 0.75rem;
  }
  .switch summary {
    margin: 0;
    cursor: pointer;
    list-style: none;
  }
  .switch summary::-webkit-details-marker {
    display: none;
  }
  .lift,
  :global(.night) h2.lift {
    font: 16px/1.5 var(--display);
    text-transform: uppercase;
    color: var(--paper);
  }
