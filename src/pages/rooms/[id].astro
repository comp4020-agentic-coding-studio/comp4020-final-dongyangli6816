---
import { and, eq, isNull } from "drizzle-orm";
import SetFields, { type FieldValues } from "../../components/SetFields.astro";
import Sprite from "../../components/Sprite.astro";
import { db } from "../../lib/db.ts";
import { EQUIPMENT, EXERCISES, exerciseById, type Exercise } from "../../lib/exercises.ts";
import { clock, distanceKm, kg, km, pace, setLabel, timeOfDay, volume } from "../../lib/logbook.ts";
import { roomView, setFinished, setLifting, SLACK_GRACE_S, type State } from "../../lib/presence.ts";
import { STATE_WORD, stateAt, whatParts } from "../../lib/squad.ts";
import { broadcast } from "../../lib/realtime.ts";
import { endRoom, isMember, leaveRoom, ROOM_SIZE, touchRoom, wasMember } from "../../lib/rooms.ts";
import { roomMembers, rooms, users, workouts } from "../../lib/schema.ts";
import {
  adjustRest,
  deleteSet,
  editSet,
  finishWorkout,
  lastSet,
  logSet,
  openWorkoutStart,
  readSet,
  setsInOpenWorkout,
  setToEdit,
  type SetValues,
} from "../../lib/workouts.ts";
import Layout from "../../layouts/Layout.astro";
import Avatar from "../../components/Avatar.astro";
import { lookOf } from "../../lib/avatars.ts";
import { lookKey } from "../../sprites/avatar.ts";
import {
  dropIcon,
  dumbbellIcon,
  idleIcon,
  pencilIcon,
  phoneIcon,
  phoneOffIcon,
  playIcon,
  signalIcon,
  stopIcon,
  trophyIcon,
  claimIcon,
} from "../../sprites/icons.ts";

const user = Astro.locals.user;
if (!user) return Astro.redirect(`/signin?next=${encodeURIComponent(Astro.url.pathname)}`, 303);

const roomId = Number(Astro.params.id);
const room = Number.isInteger(roomId) ? db.select().from(rooms).where(eq(rooms.id, roomId)).get() : undefined;
// ROOM-6: someone the room was closed on is told so, on home
if (room?.closedAt && wasMember(roomId, user.id)) {
  const hadWorkout = db
    .select({ id: workouts.id })
    .from(workouts)
    .where(and(eq(workouts.roomId, roomId), eq(workouts.userId, user.id)))
    .get();
  return Astro.redirect(`/?ended=${room.passcode}${hadWorkout ? "&logged=1" : ""}`, 303);
}
// someone without the passcode can't see that the room exists
if (!room || !isMember(roomId, user.id)) return new Response("Not found", { status: 404 });
touchRoom(roomId, user.id);
const isHost = room.hostUserId === user.id;
const here = Astro.url.pathname;
const summary = (workoutId: number | undefined, otherwise: string) =>
  Astro.redirect(workoutId ? `/workouts/${workoutId}?done=1` : otherwise, 303);

let error = "";
let errorField = "";
let submitted: FormData | undefined;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "log");
  const setId = Number(form.get("set_id"));

  // GYM-13: whatever this request changes, everyone watching the room sees it
  const changed = <T,>(result: T): T => (broadcast(roomId), result);

  if (action === "finish") {
    const workoutId = finishWorkout(user.id, roomId);
    setFinished(user.id, roomId);
    return changed(summary(workoutId, "/"));
  }
  if (action === "choose") {
    const ex = exerciseById(Number(form.get("exercise")));
    if (!ex) return Astro.redirect(here, 303);
    setLifting(user.id, roomId, ex.id);
    return changed(Astro.redirect(`${here}?exercise=${ex.id}`, 303));
  }
  if (action === "leave") return summary(leaveRoom(user.id, roomId), `/?left=${room.passcode}`);
  if (action === "end") {
    const ended = endRoom(user.id, roomId);
    if (!ended) return new Response("Only the host can end the room", { status: 403 });
    return summary(ended.workoutId, "/");
  }
  if (action === "rest") {
    const delta = String(form.get("delta"));
    if (delta === "-15" || delta === "15" || delta === "skip") adjustRest(user.id, roomId, delta);
    return changed(Astro.redirect(here + Astro.url.search.replace(/[?&]rested=1/, ""), 303));
  }
  if (action === "delete") {
    const own = Number.isInteger(setId) ? setToEdit(user.id, roomId, setId) : undefined;
    if (!own || !deleteSet(user.id, roomId, setId)) return new Response("Not found", { status: 404 });
    return changed(Astro.redirect(`${here}?exercise=${own.exerciseId}`, 303));
  }
  // GYM-10: Start set ends the rest and puts you on the lift. The page comes
  // back as Lifting with whatever was typed still in the fields, ready for Done.
  if (action === "start") {
    const ex = exerciseById(Number(form.get("exercise_id")));
    adjustRest(user.id, roomId, "skip");
    if (ex) setLifting(user.id, roomId, ex.id);
    broadcast(roomId);
    submitted = form;
  } else if (action === "edit") {
    const own = Number.isInteger(setId) ? setToEdit(user.id, roomId, setId) : undefined;
    const ex = own && exerciseById(own.exerciseId);
    if (!own || !ex) return new Response("Not found", { status: 404 });
    const read = readSet(ex.kind, form);
    if ("values" in read) {
      editSet(user.id, roomId, setId, read.values);
      return changed(Astro.redirect(`${here}?exercise=${ex.id}`, 303));
    }
    ({ error, field: errorField } = read);
  } else {
    const ex = exerciseById(Number(form.get("exercise_id")));
    if (!ex) error = "Pick an exercise.";
    else {
      const read = readSet(ex.kind, form);
      if ("values" in read) {
        logSet(user.id, roomId, ex, read.values);
        setLifting(user.id, roomId, ex.id);
        return changed(Astro.redirect(`${here}?exercise=${ex.id}&rested=1`, 303));
      }
      ({ error, field: errorField } = read);
    }
  }
  if (action !== "start") {
    submitted = form;
    Astro.response.status = 400;
  }
}

const now = Date.now();
const mySets = setsInOpenWorkout(user.id, roomId);
const startedAt = openWorkoutStart(user.id, roomId);
const members = db
  .select({ id: users.id, name: users.displayName })
  .from(roomMembers)
  .innerJoin(users, eq(users.id, roomMembers.userId))
  .where(and(eq(roomMembers.roomId, roomId), isNull(roomMembers.leftAt)))
  .all();
const others = members.filter((m) => m.id !== user.id).map((m) => m.name);
const othersText = others.length > 1 ? `${others.slice(0, -1).join(", ")} and ${others.at(-1)}` : (others[0] ?? "");
// ROOM-3: the invite link joins whoever opens it, after signing up if need be
const inviteUrl = `${Astro.url.host}/join/${room.passcode}`;

// LOG-8: ?edit=<id> opens one of your sets in this workout; anything else
// falls back to the normal sheet
const editId = Number(Astro.url.searchParams.get("edit") ?? submitted?.get("set_id"));
const editing = Number.isInteger(editId) && editId > 0 ? setToEdit(user.id, roomId, editId) : undefined;
const exercise: Exercise | undefined = exerciseById(
  editing ? editing.exerciseId : Number(Astro.url.searchParams.get("exercise") ?? submitted?.get("exercise_id")),
);
const prefill = exercise && !editing ? lastSet(user.id, exercise.id) : undefined;

// LOG-4: the rest after your newest set runs until it's skipped or the next
// set is logged. Past half an hour over it's no longer a rest, just a gap.
const latest = mySets.at(-1);
const restEnd = latest ? latest.completedAt + latest.restTargetS * 1000 : 0;
const resting = !!latest && latest.restTargetS > 0 && latest.restEndedAt === null && now < restEnd + 30 * 60_000;
const over = resting && now >= restEnd;
// GYM-11: red only once the server would call it Slacking, so your screen and
// your squad's turn at the same moment
const slacking = over && now >= restEnd + SLACK_GRACE_S * 1000;
const state = slacking ? "slacking" : resting ? "resting" : exercise ? "lifting" : "idle";
const baseState = exercise ? "lifting" : "idle";
const STATE_ICON: Record<State, typeof idleIcon> = {
  idle: idleIcon,
  lifting: dumbbellIcon,
  resting: dropIcon,
  slacking: phoneIcon,
  finished: trophyIcon,
};
const TAB = {
  idle: { icon: idleIcon, word: "Idle" },
  lifting: { icon: dumbbellIcon, word: "Lifting" },
  resting: { icon: dropIcon, word: "Resting" },
  slacking: { icon: phoneIcon, word: "Slacking" },
};

// GYM-15: everyone in the room as the server sees them, you first, then in
// the order they came in; the script keeps it live from the event stream
const view = roomView(roomId, now);
const squad = [...view.members].sort((a, b) => Number(b.id === user.id) - Number(a.id === user.id));
// GYM-4: the station you claimed, shown in the sheet while you're on a lift
const myStation = !editing && exercise ? view.members.find((m) => m.id === user.id)?.station : undefined;

// The fields: what was just submitted after an error, the set being edited,
// or the last set of this exercise (LOG-3).
const str = (n: number | null | undefined) => (n === null || n === undefined ? "" : String(n));
function fieldsFrom(v: Partial<SetValues> | undefined, ex: Exercise): FieldValues {
  const first = !v;
  return {
    weight_kg: str(v?.weightKg ?? 0),
    reps: str(v?.reps ?? (first && ex.kind === "weight" ? 8 : null)),
    minutes: v?.durationS != null ? String(Math.floor(v.durationS / 60)) : "",
    seconds: v?.durationS != null ? String(v.durationS % 60) : "",
    distance_km: v?.distanceM != null ? String(v.distanceM / 1000) : "",
  };
}
const values: FieldValues | undefined =
  exercise &&
  (submitted
    ? {
        weight_kg: String(submitted.get("weight_kg") ?? ""),
        reps: String(submitted.get("reps") ?? ""),
        minutes: String(submitted.get("minutes") ?? ""),
        seconds: String(submitted.get("seconds") ?? ""),
        distance_km: String(submitted.get("distance_km") ?? ""),
      }
    : fieldsFrom(editing ?? prefill, exercise));

const groups = Object.entries(EQUIPMENT).map(([key, label]) => ({
  label,
  exercises: EXERCISES.filter((e) => e.equipment === key),
}));
// lifts already done this session, in first-done order, as one-tap chips
const recent = [...new Set(mySets.map((s) => s.exerciseId))].flatMap((id) => exerciseById(id) ?? []);
const setNo = editing
  ? mySets.filter((s) => s.exerciseId === editing.exerciseId).findIndex((s) => s.id === editing.id) + 1
  : exercise
    ? mySets.filter((s) => s.exerciseId === exercise.id).length + 1
    : 0;
const editingLabel = editing && exercise ? setLabel({ ...editing, name: exercise.name, kind: exercise.kind }) : "";
const showLast = !!exercise && !editing && !(resting && latest?.exerciseId === exercise.id);
const timed = exercise?.kind === "duration" || exercise?.kind === "cardio";

const vol = volume(mySets);
const dist = distanceKm(mySets);
const elapsedS = startedAt ? Math.floor((now - startedAt) / 1000) : 0;
// a set in the log with its units dimmed: "62.5 kg × 7" splits around " kg"
const unitSplit = (label: string) => label.split(/( kg| km)/);
---

<Layout title={`Room ${room.passcode}`} surface="night">
  <div class="gym" data-room={roomId}>
    <section class="panel sign" aria-labelledby="room-title">
      <h1 class="panel-title" id="room-title">Room</h1>
      <div class="passcode-box">
        <span class="passcode">{room.passcode}</span>
        <p class="spots">
          <span class="pips" aria-hidden="true">
            {Array.from({ length: ROOM_SIZE }, (_, i) => <i class:list={{ in: i < members.length }} />)}
          </span>
          <span class="count">{members.length} of {ROOM_SIZE} in</span>
        </p>
      </div>
      <p class="hint">Send the code to the squad, or this link: <span class="room-link">{inviteUrl}</span></p>
      <div class="actions room-actions">
        <form method="post">
          <input type="hidden" name="action" value="leave" />
          <button type="submit" class="button secondary quiet" aria-describedby="leave-note">Leave room</button>
        </form>
      </div>
      <p class="hint leave-note" id="leave-note">
        {
          members.length === 1
            ? "You're the last one in, so leaving closes the room."
            : "Leaving finishes your workout. Your sets stay in the book."
        }
      </p>
      {
        isHost && others.length > 0 && (
          <details class="confirm end-room">
            <summary class="button secondary quiet">
              <span class="if-closed">End room</span>
              <span class="if-open">Cancel</span>
            </summary>
            <form method="post" class="confirm-box">
              <input type="hidden" name="action" value="end" />
              <p>
                End the room for everyone? {othersText} get{others.length === 1 ? "s" : ""} sent home and{" "}
                {others.length === 1 ? "their workout finishes" : "their workouts finish"}. Every set is kept.
              </p>
              <button type="submit" class="button secondary quiet">End room</button>
            </form>
          </details>
        )
      }
    </section>

    <section class="panel squad" aria-labelledby="people-title">
      <h2 class="panel-title" id="people-title">Squad</h2>
      <p class="conn" role="status"><span class="badge">Live</span></p>
      <ul class="people" data-me={user.id}>
        {
          squad.map((m) => (
            <li class:list={{ me: m.id === user.id, away: m.away }} data-id={m.id} data-look={lookKey(m.look)}>
              <Avatar look={m.look} head />
              <span class="who">
                {m.name}
                {m.id === user.id && <span class="badge">You</span>}
                {m.host && <span class="badge host">Host</span>}
                <span class="what">
                  {whatParts(m, now).map(([text, keep]) => (keep ? <span class="n">{text}</span> : text))}
                </span>
              </span>
              <span class="chips">
                <span class={`chip state-${stateAt(m, now)}`}>
                  <Sprite sprite={STATE_ICON[stateAt(m, now)]} scale={2} />
                  {STATE_WORD[stateAt(m, now)]}
                </span>
                {m.away && (
                  <span class="chip away">
                    <Sprite sprite={phoneOffIcon} scale={2} />
                    Away
                  </span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="alone" hidden={members.length > 1}>Just you so far. Send the passcode to the squad 📲</p>
      {/* what the script builds rows and the connection badge from */}
      <template data-part="head"><Avatar look={lookOf(user.id)} head allHair vars={false} /></template>
      {
        (Object.keys(STATE_WORD) as State[]).map((s) => (
          <template data-part={s}>
            <Sprite sprite={STATE_ICON[s]} scale={2} />
          </template>
        ))
      }
      <template data-part="away"><Sprite sprite={phoneOffIcon} scale={2} /></template>
      <template data-part="lost">
        <span class="lost"><Sprite sprite={signalIcon} scale={2} />Reconnecting…</span>
      </template>
    </section>

    {
      mySets.length > 0 && startedAt && (
        <section class="panel" aria-labelledby="log-title">
          <h2 class="panel-title" id="log-title">This workout</h2>
          <p class="panel-clock">
            <span class="vh">Workout time </span>
            <time datetime={`PT${elapsedS}S`} data-start={startedAt}>
              {clock(elapsedS)}
            </time>
          </p>
          <p class="tally">
            <b>{mySets.length}</b> set{mySets.length === 1 ? "" : "s"}
            {vol > 0 && (
              <>
                {" "}
                · <b>{kg(vol)} kg</b> moved
              </>
            )}
            {dist > 0 && (
              <>
                {" "}
                · <b>{km(dist)} km</b> covered
              </>
            )}{" "}
            so far
          </p>
          <table class="log">
            <thead>
              <tr>
                <th>Exercise</th>
                <th class="num">Set</th>
                <th class="fix">
                  <span class="vh">Edit</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {mySets.map((s, i) => {
                const label = setLabel(s);
                const current = editing?.id === s.id;
                return (
                  <tr aria-current={current ? "true" : undefined}>
                    {i > 0 && mySets[i - 1].exerciseId === s.exerciseId ? (
                      <td class="ditto">
                        <span aria-hidden="true">"</span>
                        <span class="vh">{s.name}</span>
                      </td>
                    ) : (
                      <td>{s.name}</td>
                    )}
                    <td class="num set">
                      {s.distanceM !== null && s.durationS !== null ? (
                        <>
                          {km(s.distanceM / 1000)} <span class="u">km</span> · {clock(s.durationS)}
                          <span class="sub">{pace(s.durationS, s.distanceM)} /km</span>
                        </>
                      ) : (
                        unitSplit(label).map((part) =>
                          part === " kg" || part === " km" ? (
                            <>
                              {" "}
                              <span class="u">{part.trim()}</span>
                            </>
                          ) : (
                            part
                          ),
                        )
                      )}
                    </td>
                    <td class="fix">
                      {current ? (
                        <a href={`?exercise=${s.exerciseId}`} aria-label="Editing this set. Cancel">
                          <Sprite sprite={pencilIcon} scale={2} />
                        </a>
                      ) : (
                        <a href={`?edit=${s.id}`}>
                          <Sprite sprite={pencilIcon} scale={2} />
                          <span class="vh">
                            Edit {s.name}, {label}
                          </span>
                        </a>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <form method="post">
            <input type="hidden" name="action" value="finish" />
            <div class="actions">
              <button type="submit" class="secondary button quiet">Finish workout</button>
            </div>
          </form>
        </section>
      )
    }

    <section class="panel sheet" aria-labelledby="sheet-title" data-base-state={baseState}>
      <span class={`chip state-${state} tab`}>
        <Sprite sprite={TAB[state].icon} scale={2} />
        {TAB[state].word}
      </span>
      {
        resting && (
          <>
            {(["resting", "slacking", baseState] as const).map((s) => (
              <template data-tab={s}>
                <Sprite sprite={TAB[s].icon} scale={2} />
                {TAB[s].word}
              </template>
            ))}
          </>
        )
      }
      {!editing && exercise && <h2 class="vh" id="sheet-title">Log a set</h2>}
      {
        Astro.url.searchParams.get("rested") && latest?.kind === "cardio" && !resting && (
          <p class="bubble" role="status">
            Logged! No rest timer after cardio 🏃
          </p>
        )
      }
      {
        resting && latest && (
          <div class:list={["rest", { over, slacking }]} data-end={restEnd} data-rest-target={latest.restTargetS}>
            {over && (
              <p class="rest-say" role="status">
                {slacking ? "Your squad can see you 👀" : "Rest's up. Back under the bar 🔔"}
              </p>
            )}
            <div class="rest-top">
              <p class="timer" role="timer" aria-label="Rest left" hidden>
                {over ? `+${clock((now - restEnd) / 1000)}` : clock((restEnd - now) / 1000)}
              </p>
              <p class="rest-what">
                <span>
                  {over ? "over a " : "of "}
                  <b class="rest-of">{clock(latest.restTargetS)}</b> rest
                </span>
                <span>
                  after{" "}
                  <b>
                    {latest.exerciseId !== exercise?.id && `${latest.name} `}
                    {setLabel(latest)}
                  </b>
                </span>
              </p>
            </div>
            <p class="rest-static">
              Rest {clock(latest.restTargetS)} · next set at {timeOfDay(restEnd).toLowerCase()}
            </p>
            <form method="post" class="rest-adjust">
              <input type="hidden" name="action" value="rest" />
              <button type="submit" name="delta" value="-15" class="button secondary tool" aria-label="15 seconds less rest">
                -15 s
              </button>
              <button type="submit" name="delta" value="15" class="button secondary tool" aria-label="15 seconds more rest">
                +15 s
              </button>
            </form>
          </div>
        )
      }
      {
        editing && exercise && values ? (
          <>
            <div class="lift-row">
              <h2 class="lift" id="sheet-title">
                {exercise.name}
              </h2>
              <span class="set-no">Set {setNo}</span>
              <span class="badge">Editing</span>
              <a href={`?exercise=${exercise.id}`} class="lift-cancel">
                Cancel
              </a>
            </div>
            <p class="hint logged-at">Logged at {timeOfDay(editing.completedAt).toLowerCase()}</p>
            <form method="post" id="set-edit" class="set-form">
              <input type="hidden" name="action" value="edit" />
              <input type="hidden" name="set_id" value={editing.id} />
              <SetFields kind={exercise.kind} values={values} invalid={errorField} />
              {error && (
                <p class="error" id="set-error" role="alert">
                  {error}
                </p>
              )}
            </form>
            <details class="confirm">
              <summary class="button secondary quiet">
                <span class="if-closed">Delete</span>
                <span class="if-open">Keep it</span>
              </summary>
              <form method="post" class="confirm-box">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="set_id" value={editing.id} />
                <p>
                  Delete {exercise.name} set {setNo}, {editingLabel}? It can't be undone.
                </p>
                <button type="submit" class="button secondary quiet">Delete set</button>
              </form>
            </details>
            <button type="submit" form="set-edit" class="wide">Save</button>
          </>
        ) : exercise && values ? (
          <>
            <details class="switch">
              <summary>
                <span class="lift">{exercise.name}</span>
                <span class="set-no">Set {setNo}</span>
                <span class="change">Change</span>
              </summary>
              <form method="post" class="picker">
                <input type="hidden" name="action" value="choose" />
                {recent.length > 0 && (
                  <>
                    <p class="recent-label">From this workout</p>
                    <ul class="recent">
                      {recent.map((e) => (
                        <li>
                          <button
                            type="submit"
                            name="exercise"
                            value={e.id}
                            aria-current={e.id === exercise.id ? "true" : undefined}
                          >
                            {e.name}
                          </button>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                <label for="exercise">Exercise</label>
                <select id="exercise" name="exercise">
                  {groups.map((g) => (
                    <optgroup label={g.label}>
                      {g.exercises.map((e) => (
                        <option value={e.id} selected={e.id === exercise.id}>
                          {e.name}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <div class="actions">
                  <button type="submit" class="secondary button">Choose</button>
                </div>
              </form>
            </details>
            {myStation && (
              <p class="spot">
                <Sprite sprite={claimIcon} scale={2} />
                <span>
                  Your spot:{" "}
                  <b>
                    {myStation.equipment} {myStation.slot}
                  </b>
                </span>
              </p>
            )}
            <form method="post" class="set-form" data-kind={exercise.kind} data-exercise={exercise.id}>
              <input type="hidden" name="exercise_id" value={exercise.id} />
              {showLast &&
                (prefill ? (
                  <p class="last">
                    Last time <b>{setLabel({ ...prefill, name: exercise.name, kind: exercise.kind })}</b>
                  </p>
                ) : (
                  <p class="last">First time on this one. Ease into it.</p>
                ))}
              <SetFields kind={exercise.kind} values={values} invalid={errorField} />
              {error && (
                <p class="error" id="set-error" role="alert">
                  {error}
                </p>
              )}
              {timed && (
                <div class="stopwatch">
                  <button type="button" class="button secondary tool sw-toggle" hidden>
                    <span class="sw-start">
                      <Sprite sprite={playIcon} scale={2} />
                      Start
                    </span>
                    <span class="sw-stop" hidden>
                      <Sprite sprite={stopIcon} scale={2} />
                      Stop
                    </span>
                  </button>
                  <button type="button" class="button secondary tool sw-reset" hidden>
                    Reset
                  </button>
                  <p class="say" hidden>
                    {exercise.kind === "duration" ? "Start, hold, Stop." : "Pace shows once there's a distance."}
                  </p>
                </div>
              )}
              {/* a set is Start set, then Done (GYM-10) */}
              {resting ? (
                <button type="submit" name="action" value="start" class="wide">
                  Start set
                </button>
              ) : (
                <button type="submit" class="wide">
                  Done
                </button>
              )}
            </form>
          </>
        ) : (
          <form method="post" class="pick">
            <input type="hidden" name="action" value="choose" />
            <h2 class="lift lift-row" id="sheet-title">Pick a lift</h2>
            {recent.length > 0 && (
              <>
                <p class="recent-label">From this workout</p>
                <ul class="recent">
                  {recent.map((e) => (
                    <li>
                      <button type="submit" name="exercise" value={e.id}>
                        {e.name}
                      </button>
                    </li>
                  ))}
                </ul>
              </>
            )}
            <label for="exercise">Exercise</label>
            <select id="exercise" name="exercise" aria-describedby="pick-hint">
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.exercises.map((e) => (
                    <option value={e.id}>{e.name}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="hint" id="pick-hint">
              Choosing one claims a station in the gym.
            </p>
            {error && (
              <p class="error" id="set-error" role="alert">
                {error}
              </p>
            )}
            <button type="submit" class="wide">Choose</button>
          </form>
        )
      }
    </section>
  </div>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import type { RoomView } from "../../lib/presence.ts";
  import { STATE_WORD, stateAt, whatParts } from "../../lib/squad.ts";
  import { lookKey, lookVars } from "../../sprites/avatar.ts";

  // Every timer here is worked out from Date.now() on each tick, never
  // counted, so a phone that slept wakes up showing the right time (GYM-12).
  const clock = (totalS: number) => {
    const s = Math.max(0, Math.floor(totalS));
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const ss = String(s % 60).padStart(2, "0");
    return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${ss}` : `${m}:${ss}`;
  };

  let audio: AudioContext | undefined;
  addEventListener("pointerdown", () => (audio ??= new AudioContext()).resume(), { once: true });
  function beep() {
    try {
      audio ??= new AudioContext();
      for (const at of [0, 0.25]) {
        const osc = audio.createOscillator();
        const gain = audio.createGain();
        osc.type = "square";
        osc.frequency.value = 880;
        gain.gain.value = 0.08;
        osc.connect(gain).connect(audio.destination);
        osc.start(audio.currentTime + at);
        osc.stop(audio.currentTime + at + 0.15);
      }
    } catch {
      // no sound available; the flash and the red still say it
    }
  }

  // Binds the timers, the stopwatch and the pending state to the room as it
  // is in the page, and returns what to run each second. Runs again after
  // each in-place update (below), on the new content.
  function init(): () => void {
    const roomId = document.querySelector<HTMLElement>(".gym")!.dataset.room;
    const sheet = document.querySelector<HTMLElement>(".sheet")!;

    // ---------- the workout clock ----------
    const workoutClock = document.querySelector<HTMLTimeElement>("time[data-start]");
    const tickClock = () => {
      if (workoutClock) workoutClock.textContent = clock((Date.now() - Number(workoutClock.dataset.start)) / 1000);
    };

    // ---------- the rest timer (LOG-4, LOG-5) ----------
    const rest = document.querySelector<HTMLElement>(".rest");
    const timer = rest?.querySelector<HTMLElement>(".timer");
    rest?.querySelector(".rest-static")?.remove();
    if (timer) timer.hidden = false;
    const tab = sheet.querySelector<HTMLElement>(".tab")!;
    const setTab = (state: string) => {
      const t = sheet.querySelector<HTMLTemplateElement>(`template[data-tab="${state}"]`);
      if (!t || tab.classList.contains(`state-${state}`)) return;
      tab.className = `chip state-${state} tab`;
      tab.replaceChildren(t.content.cloneNode(true));
    };
    // the page was open when rest ran out, so this one gets the beep and flash
    let wasOver = rest?.classList.contains("over") ?? true;
    function say(text: string) {
      let line = rest!.querySelector<HTMLElement>(".rest-say");
      if (!line) {
        line = document.createElement("p");
        line.className = "rest-say";
        line.setAttribute("role", "status");
        rest!.prepend(line);
      }
      if (line.textContent !== text) line.textContent = text;
    }
    const tickRest = () => {
      if (!rest || !timer || !rest.isConnected) return;
      const left = (Number(rest.dataset.end) - Date.now()) / 1000;
      const over = left <= 0;
      rest.classList.toggle("over", over);
      rest.querySelector(".rest-what span")!.firstChild!.textContent = over ? "over a " : "of ";
      if (!over) {
        timer.textContent = clock(Math.ceil(left));
        rest.querySelector(".rest-say")?.remove();
        setTab("resting");
        wasOver = false;
        return;
      }
      timer.textContent = `+${clock(-left)}`;
      // GYM-11: blue for the first 30 s over, red once the squad sees Slacking
      const slacking = -left >= 30;
      rest.classList.toggle("slacking", slacking);
      setTab(slacking ? "slacking" : "resting");
      say(slacking ? "Your squad can see you 👀" : "Rest's up. Back under the bar 🔔");
      if (!wasOver) {
        wasOver = true;
        beep();
        sheet.classList.remove("flash");
        void sheet.offsetWidth;
        sheet.classList.add("flash");
      }
    };

    // ---------- the stopwatch, for holds and cardio ----------
    const setForm = document.querySelector<HTMLFormElement>("form.set-form[data-exercise]");
    const watch = setForm?.querySelector<HTMLElement>(".stopwatch");
    const minutes = setForm?.querySelector<HTMLInputElement>("#minutes");
    const seconds = setForm?.querySelector<HTMLInputElement>("#seconds");
    const distance = setForm?.querySelector<HTMLInputElement>("#distance_km");
    const key = `spotter:stopwatch:${roomId}:${setForm?.dataset.exercise}`;
    const store = {
      get: () => {
        try {
          return Number(sessionStorage.getItem(key)) || 0;
        } catch {
          return 0;
        }
      },
      set: (v: number) => {
        try {
          if (v) sessionStorage.setItem(key, String(v));
          else sessionStorage.removeItem(key);
        } catch {
          // private mode: the stopwatch just won't survive a reload
        }
      },
    };
    let startedAt = 0;
    const fieldSeconds = () => Number(minutes!.value || 0) * 60 + Number(seconds!.value || 0);
    const writeTime = (s: number) => {
      minutes!.value = String(Math.floor(s / 60));
      seconds!.value = String(Math.floor(s % 60));
    };
    const sayLine = watch?.querySelector<HTMLElement>(".say");
    function sayPace() {
      if (!sayLine || startedAt) return;
      if (setForm!.dataset.kind === "duration") return (sayLine.textContent = "Start, hold, Stop.");
      const km = Number(distance!.value);
      const s = fieldSeconds();
      // rounded, as the server's pace() is, so both lines agree
      if (km >= 0.01 && s > 0) sayLine.innerHTML = `Pace <b>${clock(Math.round(s / km))} /km</b>`;
      else sayLine.textContent = "Pace shows once there's a distance.";
    }
    function showRunning(on: boolean) {
      const toggle = watch!.querySelector<HTMLButtonElement>(".sw-toggle")!;
      toggle.querySelector<HTMLElement>(".sw-start")!.hidden = on;
      toggle.querySelector<HTMLElement>(".sw-stop")!.hidden = !on;
      toggle.setAttribute("aria-pressed", String(on));
      minutes!.readOnly = seconds!.readOnly = on;
      minutes!.closest(".big-time")!.classList.toggle("running", on);
      if (on) sayLine!.textContent = "Clock's running. Stop fills the time.";
      else sayPace();
    }
    function stopWatch() {
      if (!startedAt) return;
      writeTime((Date.now() - startedAt) / 1000);
      startedAt = 0;
      store.set(0);
      showRunning(false);
    }
    if (watch && minutes && seconds) {
      for (const el of watch.querySelectorAll<HTMLElement>("[hidden]:not(.sw-stop)")) el.hidden = false;
      watch.querySelector(".sw-toggle")!.addEventListener("click", () => {
        if (startedAt) return stopWatch();
        // carries on from whatever time is already in the fields
        startedAt = Date.now() - fieldSeconds() * 1000;
        store.set(startedAt);
        showRunning(true);
      });
      watch.querySelector(".sw-reset")!.addEventListener("click", () => {
        startedAt = 0;
        store.set(0);
        writeTime(0);
        showRunning(false);
      });
      for (const input of [minutes, seconds, distance]) input?.addEventListener("input", sayPace);
      startedAt = store.get();
      showRunning(!!startedAt);
    }
    const tickWatch = () => {
      if (startedAt) writeTime((Date.now() - startedAt) / 1000);
    };

    // ---------- pending: Done and Save keep their label while the post is out ----------
    const editForm = document.querySelector<HTMLFormElement>("#set-edit");
    for (const form of [setForm, editForm]) {
      form?.addEventListener("submit", () => {
        if (form === setForm) {
          stopWatch();
          store.set(0);
        }
        submitButton(form)!.disabled = true;
        for (const input of form.querySelectorAll("input")) input.readOnly = true;
        sheet.setAttribute("aria-busy", "true");
      });
    }
    unbusy = () => {
      for (const form of [setForm, editForm]) {
        if (!form) continue;
        submitButton(form)!.disabled = false;
        for (const input of form.querySelectorAll("input")) {
          input.readOnly = form === setForm && !!startedAt && input.closest(".mmss") !== null;
        }
      }
      sheet.removeAttribute("aria-busy");
    };

    return () => {
      tickClock();
      tickRest();
      tickWatch();
    };
  }

  const submitButton = (form: HTMLFormElement) =>
    form.querySelector<HTMLButtonElement>("button[type=submit]") ??
    document.querySelector<HTMLButtonElement>(`button[form="${form.id}"]`);
  let unbusy = () => {};
  // Back restores the page from cache, button and all
  addEventListener("pageshow", () => unbusy());

  // This script runs once, however many times the room is shown; the client
  // router (ADR 0003) says when a room is on screen, after the first load and
  // after every swap.
  let tick = () => {};
  document.addEventListener("astro:page-load", () => {
    const gym = document.querySelector<HTMLElement>(".gym");
    tick = gym ? init() : () => {};
    if (gym) connect(gym.dataset.room!);
    else disconnect();
    tick();
    liveTick();
  });
  setInterval(() => {
    tick();
    liveTick();
  }, 1000);

  // ---------- the room, live (GYM-13, GYM-15) ----------
  // One stream per room on screen. Each message is the whole room, so the
  // squad list is redrawn from it rather than patched; a stream that
  // reconnects is right again with its first message. The server's clock
  // decides when someone turns Slacking, so its offset from this one is kept.
  let live: { roomId: string; source: EventSource } | undefined;
  let view: RoomView | undefined;
  let offset = 0;
  let connected = true;
  let lostTimer: ReturnType<typeof setTimeout> | undefined;

  function connect(roomId: string) {
    if (live?.roomId === roomId) return;
    disconnect();
    const source = new EventSource(`/rooms/${roomId}/events`);
    live = { roomId, source };
    source.addEventListener("room", (e) => {
      view = JSON.parse((e as MessageEvent<string>).data) as RoomView;
      offset = view.now - Date.now();
      // the host ended it, or it closed: the room page says where to go
      if (view.closed) {
        disconnect();
        return navigate(location.pathname);
      }
      liveTick();
    });
    source.addEventListener("open", () => {
      clearTimeout(lostTimer);
      lostTimer = undefined;
      connected = true;
      liveTick();
    });
    source.addEventListener("error", () => {
      // refused outright (no longer a member): the room page says why
      if (source.readyState === EventSource.CLOSED) {
        disconnect();
        return navigate(location.pathname);
      }
      // a blip isn't worth a word; a stream down for 3 s is
      lostTimer ??= setTimeout(() => {
        connected = false;
        liveTick();
      }, 3000);
    });
  }

  function disconnect() {
    live?.source.close();
    live = undefined;
    view = undefined;
    clearTimeout(lostTimer);
    lostTimer = undefined;
    connected = true;
  }

  // Draws the connection badge, the headcount and the squad list from the
  // newest message, at this second.
  function liveTick() {
    const conn = document.querySelector<HTMLElement>(".conn");
    if (conn && conn.dataset.connected !== String(connected)) {
      conn.dataset.connected = String(connected);
      const lost = document.querySelector<HTMLTemplateElement>('template[data-part="lost"]')!;
      if (connected) conn.innerHTML = '<span class="badge">Live</span>';
      else conn.replaceChildren(lost.content.cloneNode(true));
    }
    const list = document.querySelector<HTMLUListElement>(".people");
    if (!view || !list) return;
    const now = Date.now() + offset;
    const me = Number(list.dataset.me);
    const part = (name: string) =>
      document.querySelector<HTMLTemplateElement>(`template[data-part="${name}"]`)!.content.cloneNode(true);
    const el = (tag: string, className: string, ...children: (Node | string)[]) => {
      const node = document.createElement(tag);
      node.className = className;
      node.append(...children);
      return node;
    };
    const members = [...view.members].sort((a, b) => Number(b.id === me) - Number(a.id === me));
    // Rows are patched in place, not rebuilt: a head is only redrawn when
    // that person's look changes, and the words and chips only when they
    // read differently, so nothing repaints every second (a freshly inserted
    // svg can flash black for a frame before its colours apply).
    const rows = new Map([...list.querySelectorAll<HTMLLIElement>(":scope > li")].map((li) => [li.dataset.id, li]));
    const ordered = members.map((m) => {
      const li = rows.get(String(m.id)) ?? el("li", "");
      li.dataset.id = String(m.id);
      li.className = [m.id === me && "me", m.away && "away"].filter(Boolean).join(" ");
      const look = lookKey(m.look);
      if (li.dataset.look !== look || !li.querySelector(".av")) {
        // the head is drawn with every hair style; the look picks one and its colours
        const head = part("head") as DocumentFragment;
        const svg = head.querySelector("svg")!;
        svg.setAttribute("style", lookVars(m.look));
        svg.dataset.hair = m.look.hair;
        li.querySelector(".av")?.remove();
        li.prepend(head);
        li.dataset.look = look;
      }
      const state = stateAt(m, now);
      const parts = whatParts(m, now);
      const words = [m.name, m.id === me, m.host, ...parts.flat()].join("|");
      if (li.dataset.words !== words || !li.querySelector(".who")) {
        const what = el("span", "what", ...parts.map(([text, keep]) => (keep ? el("span", "n", text) : text)));
        const who = el(
          "span",
          "who",
          m.name,
          ...(m.id === me ? [" ", el("span", "badge", "You")] : []),
          ...(m.host ? [" ", el("span", "badge host", "Host")] : []),
          what,
        );
        li.querySelector(".who")?.remove();
        li.querySelector(".av")!.after(who);
        li.dataset.words = words;
      }
      const flags = `${state}|${m.away}`;
      if (li.dataset.flags !== flags || !li.querySelector(".chips")) {
        const chips = el("span", "chips", el("span", `chip state-${state}`, part(state), STATE_WORD[state]));
        if (m.away) chips.append(el("span", "chip away", part("away"), "Away"));
        li.querySelector(".chips")?.remove();
        li.append(chips);
        li.dataset.flags = flags;
      }
      return li;
    });
    // only reorder (which moves nodes) when the order or the people changed
    const current = [...list.children];
    if (current.length !== ordered.length || ordered.some((li, i) => current[i] !== li)) list.replaceChildren(...ordered);
    const alone = document.querySelector<HTMLElement>(".alone");
    if (alone) alone.hidden = members.length > 1;
    const count = document.querySelector<HTMLElement>(".spots .count");
    if (count) count.textContent = `${members.length} of 12 in`;
    document.querySelectorAll(".spots .pips i").forEach((pip, i) => pip.classList.toggle("in", i < members.length));
  }

  // ---------- staying in place ----------
  // Everything that stays in this room swaps only the room, in place, so the
  // scroll, the focus and anything typed but not yet logged stay where they
  // were: logging, editing, deleting, the rest buttons, choosing a lift and
  // Start set (POSTs), and the pencil and Cancel (GETs). The client router would
  // load them as a new page and scroll to the top. Finish, Leave and End room
  // go to another page, so the router takes them. Without JS all of these
  // are plain forms and links.
  const STAY = new Set(["log", "edit", "delete", "rest", "choose", "start"]);

  // after() runs once the new room is in, and names the control to focus
  // (the request is not called `init`, which would hide init() below)
  async function swap(url: URL, request: RequestInit, fallback: () => void, after: () => HTMLElement | null) {
    const focused = !!document.activeElement?.closest(".gym");
    let res: Response;
    try {
      res = await fetch(url, request);
    } catch {
      return fallback(); // offline or dropped: let the browser try
    }
    // the room closed under us, or anything unexpected: go where it says
    if (new URL(res.url).pathname !== location.pathname || (res.status !== 200 && res.status !== 400)) {
      return navigate(res.url);
    }
    const next = new DOMParser().parseFromString(await res.text(), "text/html");
    const gym = next.querySelector(".gym");
    if (!gym) return navigate(res.url);
    document.querySelector(".gym")!.replaceWith(document.adoptNode(gym));
    document.title = next.title;
    // keep the router's own history state, so Back still works
    if (res.url !== location.href) history.replaceState(history.state, "", res.url);
    tick = init();
    tick();
    liveTick();
    const target = after();
    // keyboard and screen-reader users carry on from where they were
    if (focused) (document.querySelector<HTMLElement>(".sheet [aria-invalid]") ?? target)?.focus({ preventScroll: true });
  }

  const firstField = () => document.querySelector<HTMLElement>(".sheet form input:not([type=hidden]), .sheet select");

  document.addEventListener(
    "submit",
    (e) => {
      const form = e.target as HTMLFormElement;
      if (!form.closest(".gym")) return;
      // not form.action or form.method: these forms have a field named "action", which shadows it
      const url = new URL(form.getAttribute("action") ?? "", location.href);
      const data = new FormData(form, e.submitter);
      if ((form.getAttribute("method") ?? "get").toLowerCase() === "get") {
        url.search = new URLSearchParams([...data] as [string, string][]).toString();
        e.preventDefault();
        return swap(url, {}, () => location.assign(url), firstField);
      }
      const action = String(data.get("action") ?? "log");
      if (!STAY.has(action)) return;
      e.preventDefault(); // the form's own listeners still run: pending, the stopwatch

      // what was typed and not logged, to put back after a rest button
      const typed = new Map<string, string>();
      if (action === "rest") {
        for (const input of document.querySelectorAll<HTMLInputElement>(".set-form input:not([type=hidden])")) {
          typed.set(input.id, input.value);
        }
      }
      const delta = (e.submitter as HTMLButtonElement | null)?.value;
      swap(url, { method: "POST", body: new URLSearchParams([...data] as [string, string][]) }, () => form.submit(), () => {
        for (const [id, value] of typed) {
          const input = document.querySelector<HTMLInputElement>(`.set-form #${id}`);
          if (input && !input.readOnly) input.value = value;
        }
        return action === "rest"
          ? document.querySelector<HTMLElement>(`.rest-adjust button[value="${delta}"]`)
          : document.querySelector<HTMLElement>(".sheet .wide");
      });
    },
    true,
  );

  document.addEventListener(
    "click",
    (e) => {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      const link = (e.target as Element).closest?.<HTMLAnchorElement>("a[href]");
      if (!link?.closest(".gym")) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== location.pathname) return;
      e.preventDefault();
      swap(url, {}, () => location.assign(url), firstField);
    },
    true,
  );
</script>

<style>
  /* .panel: the Night card (system 9). Lives here until another Night page
     needs it, then moves to the layout. */
  .panel {
    position: relative;
    margin: 0 0 2rem;
    padding: 1.5rem 1.25rem 1.25rem;
    background: var(--panel);
    border: var(--px) solid var(--edge);
    box-shadow: var(--px) var(--px) 0 #000;
  }
  .panel > :last-child {
    margin-bottom: 0;
  }
  /* the panel's name sits on its top border, like an RPG menu box */
  .panel-title {
    position: absolute;
    top: calc(var(--px) * -0.5);
    left: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 16px;
    line-height: 1.5;
    color: var(--leaf);
    background: var(--panel);
  }
  /* the workout clock rides the log panel's top border, on the right */
  .panel-clock {
    position: absolute;
    top: calc(var(--px) * -0.5);
    right: 0.75rem;
    transform: translateY(-50%);
    margin: 0;
    padding: 0 0.5rem;
    font-size: 24px;
    line-height: 1;
    color: var(--leaf);
    background: var(--panel);
    font-variant-numeric: tabular-nums;
  }
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* two columns on a laptop: room, squad and log left, the sheet right */
  .gym {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .gym {
      grid-template-columns: minmax(0, 1fr) 24rem;
      column-gap: 2rem;
      align-items: start;
    }
    .gym > .sheet {
      grid-column: 2;
      grid-row: 1 / span 3;
      position: sticky;
      top: 2rem;
    }
  }

  /* ---------- the gym sign: passcode, spots, room actions ---------- */
  .sign .passcode-box {
    margin-bottom: 0.75rem;
  }
  .spots {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .pips {
    display: flex;
    gap: var(--px);
  }
  .pips i {
    width: calc(var(--px) * 2);
    height: calc(var(--px) * 3);
    background: var(--night);
    box-shadow: inset 0 0 0 2px var(--edge);
  }
  .pips i.in {
    background: var(--leaf);
    box-shadow: none;
  }
  .room-actions {
    margin-top: 0.75rem;
  }
  .room-actions form {
    margin: 0;
  }
  .sign .leave-note {
    margin: 0.25rem 0 0;
  }
  /* room and logbook actions: secondary, and quieter than anything in the
     sheet, so they never compete with Done (system 8) */
  .button.quiet {
    padding: 0.75rem 1rem;
    font-size: 8px;
  }

  /* ---------- one confirm pattern: End room, Delete set ----------
     The summary is the first tap; it turns into Cancel in place, so a
     second tap on the same spot backs out. Works without JS. */
  .confirm > summary {
    list-style: none;
  }
  .confirm > summary::-webkit-details-marker {
    display: none;
  }
  .confirm .if-open,
  .confirm[open] .if-closed {
    display: none;
  }
  .confirm[open] .if-open {
    display: inline;
  }
  /* a confirm always sits alone on its row, so opening it moves nothing */
  .confirm {
    margin: 0.75rem 0 0;
  }
  .confirm-box {
    margin: 0.75rem 0 0;
    padding: 1rem;
    background: var(--night);
    border: var(--px) solid var(--paper);
