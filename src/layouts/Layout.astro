---
// Self-hosted pixel fonts: Press Start 2P for display text, VT323 for
// everything you read. VT323 keeps 5/S, B/8 and 0/O distinct, which matters
// when the text is a weight you're about to lift. No third-party requests.
import "@fontsource/press-start-2p/400.css";
import "@fontsource/vt323/400.css";
// Links and forms load in the background and swap the page in place, so
// moving around doesn't flash a reload (ADR 0003). Without JS they're plain
// links and forms again. Page scripts run on "astro:page-load", not once.
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  // Paper for forms and lists; Night for the gym (docs/design/system.md, section 4)
  surface?: "paper" | "night";
}
const { title, surface = "paper" } = Astro.props;
const user = Astro.locals.user;
// the top bar and footer mark the page you're on, in leaf with an underline
const here = (href: string) => (Astro.url.pathname.replace(/\/$/, "") === href ? "page" : undefined);
---

<!doctype html>
<!-- no fade between pages: a pixel screen cuts, it doesn't dissolve -->
<html lang="en-AU" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f3d22" />
    <title>{title} · Spotter</title>
    <ClientRouter fallback="swap" />
  </head>
  <body class:list={{ night: surface === "night" }}>
    <header class="topbar">
      <a href="/" class="brand" aria-label="Spotter home">
        <svg class="logo" viewBox="0 0 16 8" width="40" height="20" aria-hidden="true" shape-rendering="crispEdges">
          <rect x="0" y="2" width="2" height="4" fill="#c8e66b" />
          <rect x="2" y="0" width="2" height="8" fill="#c8e66b" />
          <rect x="4" y="3" width="8" height="2" fill="#e8f0d8" />
          <rect x="12" y="0" width="2" height="8" fill="#c8e66b" />
          <rect x="14" y="2" width="2" height="4" fill="#c8e66b" />
        </svg>
        <span>Spotter</span>
      </a>
      <nav>
        {
          user ? (
            <>
              <a href="/history" aria-current={here("/history")}>History</a>
              <form method="post" action="/signout">
                <button type="submit" class="linklike">Sign out</button>
              </form>
            </>
          ) : (
            <>
              <a href="/signin" aria-current={here("/signin")}>Sign in</a>
              <a href="/signup" aria-current={here("/signup")}>Sign up</a>
            </>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href="/readme/" aria-current={here("/readme")}>What Spotter is for</a>
    </footer>
  </body>
</html>

<style is:global>
  /* Deep green, after the Game Boy's four-shade screen. One "pixel" of
     decoration is --px, so borders and shadows stay on the same grid. */
  :root {
    --ink: #0b2416;
    --deep: #0f3d22;
    --green: #1f6b3a;
    --leaf: #c8e66b;
    --paper: #e8f0d8;
    --card: #f7fbef;
    --muted: #3d5a45;
    --error: #a3241b;
    --focus: #f2c94c;
    --green-hover: #1a5c32;
    --leaf-hover: #d6ef86;
    --tile: #dbe7c6;
    --row: #eef5e1;
    /* person states (GYM-9): always a fill under ink text, with an icon and a word */
    --idle: #e8f0d8;
    --lifting: #c8e66b;
    --resting: #7cc6e8;
    --slacking: #ff6b5e;
    --finished: #f2c94c;
    /* Night: the gym after hours */
    --night: #081a10;
    --floor: #0f2a1a;
    --panel: #143822;
    --edge: #3f8f5a;
    --dim: #8fa896;
    --px: 4px;
    --display: "Press Start 2P", ui-monospace, monospace;
    --body: "VT323", ui-monospace, monospace;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    color: var(--ink);
    font: 22px/1.35 var(--body);
    /* pixel fonts have one weight; a faked bold smears them */
    font-synthesis: none;
    /* a faint 16 px checker, like gym floor tiles */
    background-color: var(--paper);
    background-image: conic-gradient(var(--tile) 25%, transparent 0 50%, var(--tile) 0 75%, transparent 0);
    background-size: 32px 32px;
  }

  /* ---------- top bar ---------- */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    background: var(--deep);
    border-bottom: var(--px) solid var(--ink);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--paper);
    text-decoration: none;
    font: 16px/1 var(--display);
    text-transform: uppercase;
  }
  .logo {
    image-rendering: pixelated;
  }
  .topbar nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .topbar nav a,
  .topbar .linklike {
    color: var(--paper);
    font: 24px/1 var(--body);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .topbar nav a:hover,
  .topbar .linklike:hover {
    color: var(--leaf);
  }
  .topbar nav a[aria-current="page"] {
    color: var(--leaf);
    text-decoration: underline;
    text-decoration-thickness: var(--px);
    text-underline-offset: 6px;
  }
  .topbar form {
    margin: 0;
  }

  /* ---------- page ---------- */
  main {
    flex: 1;
    width: 100%;
    max-width: 44rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 2rem;
  }
  footer {
    padding: 1rem;
    text-align: center;
    border-top: var(--px) solid var(--ink);
    background: var(--deep);
  }
  footer a {
    color: var(--leaf);
  }
  footer a[aria-current="page"] {
    text-decoration: none;
  }
  footer a[aria-current="page"]::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    background: var(--leaf);
    vertical-align: middle;
  }
  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 400;
    line-height: 1.4;
    margin: 0 0 1rem;
  }
  /* Press Start 2P is drawn on an 8 px grid: crisp only at 8, 16, 24, 32 */
  h1 {
    font-size: 24px;
  }
  h2 {
    font-size: 16px;
    color: var(--green);
  }
  h3 {
    font-size: 16px;
  }
  p {
    margin: 0 0 1rem;
  }
  a {
    color: var(--green);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* ---------- pixel panels ---------- */
  .card {
    position: relative;
    margin: 0 0 1.5rem;
    padding: 1.25rem;
    background: var(--card);
    border: var(--px) solid var(--ink);
    box-shadow: var(--px) var(--px) 0 var(--green), calc(var(--px) * 2) calc(var(--px) * 2) 0 var(--ink);
  }
  .card > :last-child {
    margin-bottom: 0;
  }

  /* ---------- forms ---------- */
  label {
    display: block;
    margin: 1rem 0 0.35rem;
    color: var(--deep);
  }
  input,
  select {
    width: 100%;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    font: 26px/1.1 var(--body);
    color: var(--ink);
    background: #fff;
    border: var(--px) solid var(--ink);
    border-radius: 0;
    box-shadow: inset var(--px) var(--px) 0 var(--tile);
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%),
      linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position: calc(100% - 22px) 50%, calc(100% - 14px) 50%;
    background-size: 8px 8px;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }
  button,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    font: 16px/1.4 var(--display);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper);
    background: var(--green);
    border: 0;
    cursor: pointer;
    /* a notched pixel outline plus a drop shadow; pressing moves it down */
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--ink),
      0 var(--px) 0 var(--ink),
      calc(var(--px) * -1) 0 0 var(--ink),
      var(--px) 0 0 var(--ink),
      0 calc(var(--px) * 2) 0 var(--ink),
      inset 0 calc(var(--px) * -1) 0 var(--deep);
    margin: var(--px) var(--px) calc(var(--px) * 2);
    transition: transform 60ms steps(1);
  }
  button:hover,
  .button:hover {
    background: var(--green-hover);
  }
  button:active,
  .button:active {
    transform: translateY(var(--px));
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--ink),
      0 var(--px) 0 var(--ink),
      calc(var(--px) * -1) 0 0 var(--ink),
      var(--px) 0 0 var(--ink);
  }
  .button.secondary {
    color: var(--ink);
    background: var(--leaf);
  }
  .button.secondary:hover {
    background: var(--leaf-hover);
  }
  /* pending: held down, label kept, never a spinner */
  button:disabled,
  button:disabled:hover {
    cursor: progress;
    color: var(--paper);
    background: var(--muted);
    transform: translateY(var(--px));
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--ink),
      0 var(--px) 0 var(--ink),
      calc(var(--px) * -1) 0 0 var(--ink),
      var(--px) 0 0 var(--ink);
  }
  .wide {
    width: calc(100% - var(--px) * 2);
  }
  .topbar .linklike {
    background: none;
    box-shadow: none;
    margin: 0;
    padding: 0;
    text-transform: none;
  }
  /* ink ring on Paper; the yellow one fails contrast there (1.4:1) and is
     kept for the dark bars and Night */
  :focus-visible {
    outline: var(--px) solid var(--ink);
    outline-offset: var(--px);
  }
  .topbar :focus-visible,
  footer :focus-visible,
  body.night :focus-visible {
    outline-color: var(--focus);
  }
  input[aria-invalid="true"] {
    box-shadow: inset var(--px) var(--px) 0 var(--error);
  }
  /* the ring reaches 8 px past a field, so the error sits 12 px below it */
  .error {
    margin: 0.75rem 0 0;
    padding: 0.4rem 0.6rem;
    color: #fff;
    background: var(--error);
    border-left: calc(var(--px) * 2) solid var(--ink);
  }
  .error a {
    color: #fff;
  }
  .hint {
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  /* ---------- Night: same components, surface colours swapped ---------- */
  body.night {
    color: var(--paper);
    color-scheme: dark;
    background-color: var(--night);
    background-image: conic-gradient(var(--floor) 25%, transparent 0 50%, var(--floor) 0 75%, transparent 0);
  }
  /* the gym needs room for two columns at 900 px and up */
  body.night main {
    max-width: 64rem;
  }
  .night h2 {
    color: var(--leaf);
  }
  .night label {
    color: var(--paper);
  }
  .night .bubble {
    color: var(--ink);
  }
  .night .hint {
    color: var(--dim);
  }
  .night main a {
    color: var(--leaf);
  }
  /* --green disappears on the dark floor, so primary is leaf with ink */
  .night button,
  .night .button {
    color: var(--ink);
    background: var(--leaf);
  }
  .night button:hover,
  .night .button:hover {
    background: var(--leaf-hover);
  }
  /* secondary on Night: night fill, paper label, the notch in --edge */
  .night .button.secondary {
    color: var(--paper);
    background: var(--night);
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--edge),
      0 var(--px) 0 var(--edge),
      calc(var(--px) * -1) 0 0 var(--edge),
      var(--px) 0 0 var(--edge),
      0 calc(var(--px) * 2) 0 #000;
  }
  .night .button.secondary:hover {
    background: var(--floor);
  }
  .night .button.secondary:active {
    box-shadow:
      0 calc(var(--px) * -1) 0 var(--edge),
      0 var(--px) 0 var(--edge),
      calc(var(--px) * -1) 0 0 var(--edge),
      var(--px) 0 0 var(--edge);
  }
  .night button:disabled {
    color: var(--ink);
    background: var(--dim);
  }
  .night input,
  .night select {
    color: var(--paper);
    background-color: var(--night);
    border-color: var(--edge);
    box-shadow: inset var(--px) var(--px) 0 #000;
  }
  .night select {
    background-image:
      linear-gradient(45deg, transparent 50%, var(--paper) 50%),
      linear-gradient(135deg, var(--paper) 50%, transparent 50%);
  }
  .night th,
  .night td {
    border-color: var(--edge);
  }
  .night tbody tr:nth-child(even) td {
    background: var(--floor);
  }

  /* ---------- bits ---------- */
  .passcode-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .passcode {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    font: 24px/1 var(--display);
    letter-spacing: 0.12em;
    color: var(--leaf);
    background: var(--ink);
    border: var(--px) solid var(--green);
  }
  .bubble {
    position: relative;
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem;
    background: var(--leaf);
    border: var(--px) solid var(--ink);
  }
  .bubble::after {
    content: "";
    position: absolute;
    left: 1.5rem;
    bottom: calc(var(--px) * -3);
    width: calc(var(--px) * 3);
    height: calc(var(--px) * 3);
    background: var(--leaf);
    border-right: var(--px) solid var(--ink);
    border-bottom: var(--px) solid var(--ink);
    transform: skewY(45deg);
  }
  .roster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .roster li {
    padding: 0.25rem 0.6rem;
    background: var(--paper);
    border: var(--px) solid var(--ink);
  }
  .roster li::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    background: var(--green);
    vertical-align: middle;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 24px;
  }
  th {
    font: 8px/2 var(--display);
    text-transform: uppercase;
    color: var(--paper);
    background: var(--deep);
  }
  th,
  td {
    text-align: left;
    padding: 0.5rem 0.6rem;
    border: 2px solid var(--ink);
  }
  td.num,
  th.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  tbody tr:nth-child(even) td {
    background: var(--row);
  }
  .stat {
    font-family: var(--display);
    font-size: 8px;
    color: var(--muted);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    font: 8px/1 var(--display);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    border: 2px solid var(--ink);
  }
  .chip svg {
    flex: none;
  }
  .state-idle {
    background: var(--idle);
  }
  .state-lifting {
    background: var(--lifting);
  }
  .state-resting {
    background: var(--resting);
  }
  .state-slacking {
    background: var(--slacking);
  }
  .state-finished {
    background: var(--finished);
  }
  .badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.15rem 0.4rem;
    font: 8px/1.4 var(--display);
    vertical-align: middle;
    color: var(--ink);
    background: var(--leaf);
    border: 2px solid var(--ink);
  }

  @media (max-width: 420px) {
    body {
      font-size: 21px;
    }
    h1 {
      font-size: 16px;
    }
    .card {
      padding: 1rem;
    }
    .passcode {
      font-size: 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button,
    .button {
      transition: none;
    }
  }
</style>
