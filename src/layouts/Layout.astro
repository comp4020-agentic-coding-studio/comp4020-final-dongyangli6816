---
interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Spotter</title>
  </head>
  <body>
    <header>
      <a href="/" class="brand">Spotter</a>
      <nav>
        {
          user ? (
            <>
              <a href="/history">History</a>
              <form method="post" action="/signout">
                <button type="submit">Sign out</button>
              </form>
            </>
          ) : (
            <>
              <a href="/signin">Sign in</a>
              <a href="/signup">Sign up</a>
            </>
          )
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5ef;
    --fg: #1d1d1b;
    --muted: #5d5b55;
    --accent: #2f6b3f;
    --error: #a3241b;
    --line: #d9d5c8;
    color-scheme: light;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.5 system-ui, sans-serif;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--line);
  }
  header nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  header form {
    margin: 0;
  }
  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--fg);
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
  }
  a {
    color: var(--accent);
  }
  label {
    display: block;
    margin: 0.75rem 0 0.25rem;
  }
  input,
  select,
  button {
    font: inherit;
    min-height: 44px;
  }
  input,
  select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--muted);
    border-radius: 6px;
    background: #fff;
  }
  button {
    padding: 0.5rem 1rem;
    border: 0;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }
  header button {
    background: none;
    color: var(--accent);
    text-decoration: underline;
    padding: 0;
  }
  :focus-visible {
    outline: 3px solid #e0a100;
    outline-offset: 2px;
  }
  .error {
    color: var(--error);
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    margin: 1rem 0;
    background: #fff;
  }
  .passcode {
    font: 700 1.75rem/1 ui-monospace, monospace;
    letter-spacing: 0.15em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    text-align: left;
    padding: 0.25rem 0.5rem 0.25rem 0;
    border-bottom: 1px solid var(--line);
  }
</style>
