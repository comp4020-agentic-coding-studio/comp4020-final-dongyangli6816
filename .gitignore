node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
# The subagent definitions in .claude/agents/ are harness too, and hold no
# secrets, so they're tracked.
.claude/*
!.claude/agents/

# the local SQLite database (the deployed one lives on the /data volume) and
# Astro's generated types
data/
.astro/

# working screenshots from scripts/shot.mjs; they can be regenerated, and the
# ones kept as evidence are copied into docs/evidence/
.shots/
